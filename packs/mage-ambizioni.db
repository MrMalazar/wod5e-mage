{"_id": "dc1207f559f7066d", "name": "La Ricerca", "pages": [{"_id": "5cb50fbc5284cdb2", "name": "La Ricerca", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Ricerca</em></p><p>Trovare chi ha fatto sparire mia sorella e riportarla a casa.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 0, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Legami", "name": "La Ricerca", "text": "Trovare chi ha fatto sparire mia sorella e riportarla a casa.", "title": "La Ricerca"}}}}
{"_id": "d0702c60866f55f9", "name": "La Protezione Assoluta", "pages": [{"_id": "70481945cdb7f682", "name": "La Protezione Assoluta", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Protezione Assoluta</em></p><p>Rendere la mia famiglia inattaccabile, per sempre. Ambizione-trappola: l'Hubris comincia esattamente qui.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 10, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Legami", "name": "La Protezione Assoluta", "text": "Rendere la mia famiglia inattaccabile, per sempre. Ambizione-trappola: l'Hubris comincia esattamente qui.", "title": "La Protezione Assoluta"}}}}
{"_id": "a1f8fbce381046c9", "name": "La Redenzione Relazionale", "pages": [{"_id": "9c7484d8f93d94d6", "name": "La Redenzione Relazionale", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Redenzione Relazionale</em></p><p>Riconquistare la fiducia del partner a cui ho distrutto la vita prima di risvegliarmi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 20, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Legami", "name": "La Redenzione Relazionale", "text": "Riconquistare la fiducia del partner a cui ho distrutto la vita prima di risvegliarmi.", "title": "La Redenzione Relazionale"}}}}
{"_id": "cf599e52f7d622d1", "name": "L'Approvazione", "pages": [{"_id": "4a99126e30a73f38", "name": "L'Approvazione", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Approvazione</em></p><p>Diventare qualcuno che mio padre non potrebbe ignorare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 30, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Legami", "name": "L'Approvazione", "text": "Diventare qualcuno che mio padre non potrebbe ignorare.", "title": "L'Approvazione"}}}}
{"_id": "6579766eb3cde3cf", "name": "Il Ritorno", "pages": [{"_id": "ee1e62cd593ac496", "name": "Il Ritorno", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Ritorno</em></p><p>Riportare a casa mio figlio, cresciuto dalla fazione che me lo ha tolto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 40, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Legami", "name": "Il Ritorno", "text": "Riportare a casa mio figlio, cresciuto dalla fazione che me lo ha tolto.", "title": "Il Ritorno"}}}}
{"_id": "d28746fc979ffc0b", "name": "La Promessa", "pages": [{"_id": "981844225efa6e2f", "name": "La Promessa", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Promessa</em></p><p>Mantenere il giuramento fatto a un morente, costi quello che costi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 50, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Legami", "name": "La Promessa", "text": "Mantenere il giuramento fatto a un morente, costi quello che costi.", "title": "La Promessa"}}}}
{"_id": "eee1ab00fb07b608", "name": "L'Erede", "pages": [{"_id": "b095ec57e7160697", "name": "L'Erede", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Erede</em></p><p>Crescere mia nipote tenendola fuori, per sempre, dal mondo Risvegliato.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 60, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Legami", "name": "L'Erede", "text": "Crescere mia nipote tenendola fuori, per sempre, dal mondo Risvegliato.", "title": "L'Erede"}}}}
{"_id": "c722dbc92427f5ad", "name": "Il Perdono", "pages": [{"_id": "a225a7a58e6cd93e", "name": "Il Perdono", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Perdono</em></p><p>Trovare la persona a cui feci del male da Dormiente, e ripagarla senza farmi riconoscere.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 70, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Legami", "name": "Il Perdono", "text": "Trovare la persona a cui feci del male da Dormiente, e ripagarla senza farmi riconoscere.", "title": "Il Perdono"}}}}
{"_id": "8d0024140b16d5d9", "name": "Il Samaritano", "pages": [{"_id": "9d2a19973181353e", "name": "Il Samaritano", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Samaritano</em></p><p>Aprire una clinica dove nessuno paga, nel quartiere dove sono cresciuto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 80, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Carriera", "name": "Il Samaritano", "text": "Aprire una clinica dove nessuno paga, nel quartiere dove sono cresciuto.", "title": "Il Samaritano"}}}}
{"_id": "ae09804a0685c0ac", "name": "Il Veritiero", "pages": [{"_id": "2cafc961e6bf7922", "name": "Il Veritiero", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Veritiero</em></p><p>Vincere il Pulitzer smascherando la multinazionale che ha avvelenato la mia città, e incrociare il Sindacato.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 90, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Carriera", "name": "Il Veritiero", "text": "Vincere il Pulitzer smascherando la multinazionale che ha avvelenato la mia città, e incrociare il Sindacato.", "title": "Il Veritiero"}}}}
{"_id": "16e70319183dc122", "name": "L'Opera", "pages": [{"_id": "817dd46e8e19fda6", "name": "L'Opera", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Opera</em></p><p>Diventare un artista di fama mondiale senza un grammo di magia Volgare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 100, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Carriera", "name": "L'Opera", "text": "Diventare un artista di fama mondiale senza un grammo di magia Volgare.", "title": "L'Opera"}}}}
{"_id": "f0c3d9465bd1044c", "name": "L'Innovatore", "pages": [{"_id": "46240ec513d1d0db", "name": "L'Innovatore", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Innovatore</em></p><p>Brevettare un'invenzione rivoluzionaria agli occhi della scienza ufficiale.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 110, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Carriera", "name": "L'Innovatore", "text": "Brevettare un'invenzione rivoluzionaria agli occhi della scienza ufficiale.", "title": "L'Innovatore"}}}}
{"_id": "051dc28999571cad", "name": "La Cattedra", "pages": [{"_id": "dace5fd044c1b398", "name": "La Cattedra", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Cattedra</em></p><p>Ottenere la cattedra da cui fui cacciato, con le stesse teorie che allora chiamarono follia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 120, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Carriera", "name": "La Cattedra", "text": "Ottenere la cattedra da cui fui cacciato, con le stesse teorie che allora chiamarono follia.", "title": "La Cattedra"}}}}
{"_id": "b870e82ea9dc0c18", "name": "Il Sindaco", "pages": [{"_id": "582483e00960d554", "name": "Il Sindaco", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Sindaco</em></p><p>Vincere le elezioni del mio municipio senza toccare una mente.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 130, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Carriera", "name": "Il Sindaco", "text": "Vincere le elezioni del mio municipio senza toccare una mente.", "title": "Il Sindaco"}}}}
{"_id": "55964e66179baf7e", "name": "La Bottega", "pages": [{"_id": "29366291de8058b8", "name": "La Bottega", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Bottega</em></p><p>Rendere la mia officina il posto dove tutta la città porta ciò che nessun altro sa riparare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 140, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Carriera", "name": "La Bottega", "text": "Rendere la mia officina il posto dove tutta la città porta ciò che nessun altro sa riparare.", "title": "La Bottega"}}}}
{"_id": "55e4bb0e4e3ae727", "name": "Il Testimone", "pages": [{"_id": "550f5abfc8ec32d2", "name": "Il Testimone", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Testimone</em></p><p>Scrivere il libro che racconta la verità della mia gente, e vederlo stampato.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 150, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Carriera", "name": "Il Testimone", "text": "Scrivere il libro che racconta la verità della mia gente, e vederlo stampato.", "title": "Il Testimone"}}}}
{"_id": "e47471b36e50fac1", "name": "Fuga dalla povertà", "pages": [{"_id": "00f783c2cd9ddc07", "name": "Fuga dalla povertà", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Fuga dalla povertà</em></p><p>Estinguere i debiti di famiglia e non temere mai più una bolletta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 160, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Riscatto", "name": "Fuga dalla povertà", "text": "Estinguere i debiti di famiglia e non temere mai più una bolletta.", "title": "Fuga dalla povertà"}}}}
{"_id": "f5d6d167d0bef147", "name": "Fedina pulita", "pages": [{"_id": "5530e9df5c177102", "name": "Fedina pulita", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Fedina pulita</em></p><p>Dimostrare la mia innocenza e riprendermi l'identità da cui sono fuggito.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 170, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Riscatto", "name": "Fedina pulita", "text": "Dimostrare la mia innocenza e riprendermi l'identità da cui sono fuggito.", "title": "Fedina pulita"}}}}
{"_id": "ce582a679d9607a3", "name": "Vendetta urbana", "pages": [{"_id": "e47bc39448463f70", "name": "Vendetta urbana", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Vendetta urbana</em></p><p>Smantellare il cartello che terrorizza la mia strada e ha ucciso i miei amici.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 180, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Riscatto", "name": "Vendetta urbana", "text": "Smantellare il cartello che terrorizza la mia strada e ha ucciso i miei amici.", "title": "Vendetta urbana"}}}}
{"_id": "81e1dfbbdfca85c4", "name": "Sopravvivere", "pages": [{"_id": "40d2ac1a26276e7d", "name": "Sopravvivere", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Sopravvivere</em></p><p>Sconfiggere la malattia terminale che divora il mio corpo, o quello di un'Ancora.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 190, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Riscatto", "name": "Sopravvivere", "text": "Sconfiggere la malattia terminale che divora il mio corpo, o quello di un'Ancora.", "title": "Sopravvivere"}}}}
{"_id": "d7fa1411f2401f6f", "name": "L'Espatrio", "pages": [{"_id": "5f5a4799677f5b91", "name": "L'Espatrio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Espatrio</em></p><p>Portare tutta la mia famiglia fuori dal paese che ci vuole morti, con documenti veri.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 200, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Riscatto", "name": "L'Espatrio", "text": "Portare tutta la mia famiglia fuori dal paese che ci vuole morti, con documenti veri.", "title": "L'Espatrio"}}}}
{"_id": "aeda081d316505d4", "name": "Il Riscatto del Quartiere", "pages": [{"_id": "0844100717ddd8ac", "name": "Il Riscatto del Quartiere", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Riscatto del Quartiere</em></p><p>Fermare la gentrificazione che sta cancellando la mia strada: legalmente, almeno sulla carta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 210, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Riscatto", "name": "Il Riscatto del Quartiere", "text": "Fermare la gentrificazione che sta cancellando la mia strada: legalmente, almeno sulla carta.", "title": "Il Riscatto del Quartiere"}}}}
{"_id": "9711c8f02130d855", "name": "La Casa", "pages": [{"_id": "4b2efe80884944a0", "name": "La Casa", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Casa</em></p><p>Comprare il palazzo dove facevo il portiere, e non chiamare più nessuno «signore».</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 220, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Riscatto", "name": "La Casa", "text": "Comprare il palazzo dove facevo il portiere, e non chiamare più nessuno «signore».", "title": "La Casa"}}}}
{"_id": "5f80b4573f02e044", "name": "L'Uscita", "pages": [{"_id": "ba90c672ab3bd57f", "name": "L'Uscita", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Uscita</em></p><p>Uscire vivo dall'organizzazione criminale che mi considera proprietà sua.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 230, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Riscatto", "name": "L'Uscita", "text": "Uscire vivo dall'organizzazione criminale che mi considera proprietà sua.", "title": "L'Uscita"}}}}
{"_id": "8fae68191211dca6", "name": "La doppia vita perfetta", "pages": [{"_id": "7920849be5cd87c5", "name": "La doppia vita perfetta", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La doppia vita perfetta</em></p><p>Bilanciare magia, lavoro e matrimonio, invecchiando in pace senza che i miei scoprano nulla.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 240, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Equilibrio", "name": "La doppia vita perfetta", "text": "Bilanciare magia, lavoro e matrimonio, invecchiando in pace senza che i miei scoprano nulla.", "title": "La doppia vita perfetta"}}}}
{"_id": "2210074579aa1880", "name": "L'evasione totale", "pages": [{"_id": "fa828f1ed960afff", "name": "L'evasione totale", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'evasione totale</em></p><p>Trovare il modo di «spegnere» il mio Avatar e tornare un Dormiente felice. (L'Avatar cosa ne pensa?)</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 250, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Equilibrio", "name": "L'evasione totale", "text": "Trovare il modo di «spegnere» il mio Avatar e tornare un Dormiente felice. (L'Avatar cosa ne pensa?)", "title": "L'evasione totale"}}}}
{"_id": "9e2f3b9391097e43", "name": "La Pensione", "pages": [{"_id": "f556223036ca133b", "name": "La Pensione", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Pensione</em></p><p>Arrivare a sessant'anni vivo, sano e dimenticato da entrambe le fazioni.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 260, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Equilibrio", "name": "La Pensione", "text": "Arrivare a sessant'anni vivo, sano e dimenticato da entrambe le fazioni.", "title": "La Pensione"}}}}
{"_id": "bb2e9e7ac45f89a5", "name": "Il Giardino", "pages": [{"_id": "f70c0862bed1c192", "name": "Il Giardino", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Giardino</em></p><p>Costruire un luogo (una casa, una comune, un bar) dove Risvegliati e Dormienti vivano insieme senza saperlo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 270, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Equilibrio", "name": "Il Giardino", "text": "Costruire un luogo (una casa, una comune, un bar) dove Risvegliati e Dormienti vivano insieme senza saperlo.", "title": "Il Giardino"}}}}
{"_id": "0b44be5c479df507", "name": "La Misura", "pages": [{"_id": "908b65b88ff58bed", "name": "La Misura", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Misura</em></p><p>Passare un anno intero senza un solo lancio Volgare, e scoprire chi sono senza.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 280, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Equilibrio", "name": "La Misura", "text": "Passare un anno intero senza un solo lancio Volgare, e scoprire chi sono senza.", "title": "La Misura"}}}}
{"_id": "c7268a21610a23a7", "name": "Il Silenzio Buono", "pages": [{"_id": "5e7417307ed9379b", "name": "Il Silenzio Buono", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Silenzio Buono</em></p><p>Fare pace con il mio Avatar: smettere di combatterci e trovare un accordo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 290, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Equilibrio", "name": "Il Silenzio Buono", "text": "Fare pace con il mio Avatar: smettere di combatterci e trovare un accordo.", "title": "Il Silenzio Buono"}}}}
{"_id": "87291371c0b43d15", "name": "L'Ascensione Personale", "pages": [{"_id": "c99fc019b475e7fa", "name": "L'Ascensione Personale", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Ascensione Personale</em></p><p>Trascendere la carne e diventare pura entità: spirito, o dati nel codice dell'universo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 300, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Ascensione", "name": "L'Ascensione Personale", "text": "Trascendere la carne e diventare pura entità: spirito, o dati nel codice dell'universo.", "title": "L'Ascensione Personale"}}}}
{"_id": "378f9eddb77b123d", "name": "Il Dominio", "pages": [{"_id": "519bea744ec584ce", "name": "Il Dominio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Dominio</em></p><p>Diventare l'indiscusso maestro di una Sfera, per riscrivere una tragedia del mio passato.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 310, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Ascensione", "name": "Il Dominio", "text": "Diventare l'indiscusso maestro di una Sfera, per riscrivere una tragedia del mio passato.", "title": "Il Dominio"}}}}
{"_id": "39ff4409c3459628", "name": "L'Opera Magna", "pages": [{"_id": "29d72d8ac11224b3", "name": "L'Opera Magna", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Opera Magna</em></p><p>Forgiare una Meraviglia senza precedenti: una vera IA dotata di Avatar, un Feticcio che intrappoli un dio.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 320, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Ascensione", "name": "L'Opera Magna", "text": "Forgiare una Meraviglia senza precedenti: una vera IA dotata di Avatar, un Feticcio che intrappoli un dio.", "title": "L'Opera Magna"}}}}
{"_id": "7d74b6a1cbba09c5", "name": "La Fonte", "pages": [{"_id": "01e8058489819af2", "name": "La Fonte", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Fonte</em></p><p>Rivendicare il più grande Nodo del continente e non temere mai più di restare a secco.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 330, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Ascensione", "name": "La Fonte", "text": "Rivendicare il più grande Nodo del continente e non temere mai più di restare a secco.", "title": "La Fonte"}}}}
{"_id": "9ebba1fa5d7faa78", "name": "Il Maestro", "pages": [{"_id": "5a2adeee9fc5f5b6", "name": "Il Maestro", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Maestro</em></p><p>Crescere tre allievi fino al Risveglio pieno, senza violare la Tregua, senza perderne nemmeno uno.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 340, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Ascensione", "name": "Il Maestro", "text": "Crescere tre allievi fino al Risveglio pieno, senza violare la Tregua, senza perderne nemmeno uno.", "title": "Il Maestro"}}}}
{"_id": "72688529e8b2504d", "name": "La Biblioteca Perduta", "pages": [{"_id": "6a650405506e53f8", "name": "La Biblioteca Perduta", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Biblioteca Perduta</em></p><p>Ritrovare gli archivi bruciati della mia Casa e restituirli al mondo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 350, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Ascensione", "name": "La Biblioteca Perduta", "text": "Ritrovare gli archivi bruciati della mia Casa e restituirli al mondo.", "title": "La Biblioteca Perduta"}}}}
{"_id": "cbbbd1b3d1bff4c9", "name": "La Cura", "pages": [{"_id": "9a93bbfaa4a1db65", "name": "La Cura", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Cura</em></p><p>Trovare il modo di guarire un'Ustione da Paradosso permanente. Nessuno c'è mai riuscito.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 360, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Ascensione", "name": "La Cura", "text": "Trovare il modo di guarire un'Ustione da Paradosso permanente. Nessuno c'è mai riuscito.", "title": "La Cura"}}}}
{"_id": "80b530afd33805a1", "name": "Il Cartografo", "pages": [{"_id": "7e6e2f4a6fc17476", "name": "Il Cartografo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Cartografo</em></p><p>Mappare una regione dell'Umbra dove nessun vivo è tornato a raccontare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 370, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Ascensione", "name": "Il Cartografo", "text": "Mappare una regione dell'Umbra dove nessun vivo è tornato a raccontare.", "title": "Il Cartografo"}}}}
{"_id": "d505a9236a71c296", "name": "La Resurrezione", "pages": [{"_id": "8d8021423544f4fb", "name": "La Resurrezione", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Resurrezione</em></p><p>Riportare indietro chi ho perso. La più antica delle trappole, e il tavolo lo sa.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 380, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Ascensione", "name": "La Resurrezione", "text": "Riportare indietro chi ho perso. La più antica delle trappole, e il tavolo lo sa.", "title": "La Resurrezione"}}}}
{"_id": "1e44351f4a485f53", "name": "Il Nome Vero", "pages": [{"_id": "c63f359a62c88a0c", "name": "Il Nome Vero", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Nome Vero</em></p><p>Scoprire il mio vero nome nella lingua della realtà, e sopravvivere a ciò che risponde.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 390, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Ascensione", "name": "Il Nome Vero", "text": "Scoprire il mio vero nome nella lingua della realtà, e sopravvivere a ciò che risponde.", "title": "Il Nome Vero"}}}}
{"_id": "6a703bf234b08f92", "name": "Il Diplomatico", "pages": [{"_id": "e24bf5574b7b6af0", "name": "Il Diplomatico", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Diplomatico</em></p><p>Negoziare una tregua vera, anche solo locale, tra il Concilio e l'Unione nella mia città.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 400, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Guerra", "name": "Il Diplomatico", "text": "Negoziare una tregua vera, anche solo locale, tra il Concilio e l'Unione nella mia città.", "title": "Il Diplomatico"}}}}
{"_id": "bb3c2bfbcc6b08ce", "name": "La Talpa", "pages": [{"_id": "c3e90b01af1efbf2", "name": "La Talpa", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Talpa</em></p><p>Infiltrarmi in un Costrutto e uscirne con la prova di cosa fanno ai Risvegliati catturati.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 410, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Guerra", "name": "La Talpa", "text": "Infiltrarmi in un Costrutto e uscirne con la prova di cosa fanno ai Risvegliati catturati.", "title": "La Talpa"}}}}
{"_id": "5601955c34dd5770", "name": "Il Faro", "pages": [{"_id": "f6196529e70b4a46", "name": "Il Faro", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Faro</em></p><p>Rifondare il Capitolo della mia Tradizione nella città da cui fu estirpato.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 420, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Guerra", "name": "Il Faro", "text": "Rifondare il Capitolo della mia Tradizione nella città da cui fu estirpato.", "title": "Il Faro"}}}}
{"_id": "4939b707908c5a86", "name": "L'Abolizionista", "pages": [{"_id": "c4bb825347e01b63", "name": "L'Abolizionista", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Abolizionista</em></p><p>Liberare ogni mago detenuto nella struttura di contenimento della regione.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 430, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Guerra", "name": "L'Abolizionista", "text": "Liberare ogni mago detenuto nella struttura di contenimento della regione.", "title": "L'Abolizionista"}}}}
{"_id": "89b23ef36c5137f5", "name": "Il Giudice", "pages": [{"_id": "40463aabd84879ce", "name": "Il Giudice", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Giudice</em></p><p>Trovare chi ha venduto la mia Cabala all'Unione, e processarlo davanti ai suoi pari.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 440, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Guerra", "name": "Il Giudice", "text": "Trovare chi ha venduto la mia Cabala all'Unione, e processarlo davanti ai suoi pari.", "title": "Il Giudice"}}}}
{"_id": "64882abca92cf428", "name": "Il Costruttore di Ponti", "pages": [{"_id": "516ad0d1ceaf726d", "name": "Il Costruttore di Ponti", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Costruttore di Ponti</em></p><p>Convincere un intero Costrutto a disertare: non un agente, tutti.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 450, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Guerra", "name": "Il Costruttore di Ponti", "text": "Convincere un intero Costrutto a disertare: non un agente, tutti.", "title": "Il Costruttore di Ponti"}}}}
{"_id": "395578af06bbcf9f", "name": "La Terza Via", "pages": [{"_id": "5e23ff5e8ce8da89", "name": "La Terza Via", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Terza Via</em></p><p>Fondare una comunità di Orfani abbastanza forte da dire no a entrambe le parti.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 460, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Guerra", "name": "La Terza Via", "text": "Fondare una comunità di Orfani abbastanza forte da dire no a entrambe le parti.", "title": "La Terza Via"}}}}
{"_id": "b2e05972326a06ff", "name": "Il Custode", "pages": [{"_id": "d67890b050e9fa27", "name": "Il Custode", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Custode</em></p><p>Difendere il Nodo della mia famiglia, conteso da tre fazioni, senza cederlo a nessuna.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 470, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Guerra", "name": "Il Custode", "text": "Difendere il Nodo della mia famiglia, conteso da tre fazioni, senza cederlo a nessuna.", "title": "Il Custode"}}}}
{"_id": "b2d76b21bce129df", "name": "La Memoria", "pages": [{"_id": "81a7407786058797", "name": "La Memoria", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Memoria</em></p><p>Documentare i crimini della guerra, di tutte le parti, perché un giorno qualcuno risponda.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 480, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Guerra", "name": "La Memoria", "text": "Documentare i crimini della guerra, di tutte le parti, perché un giorno qualcuno risponda.", "title": "La Memoria"}}}}
{"_id": "85d6c3b3fcfcd1ca", "name": "L'Ultima Missione", "pages": [{"_id": "66aab0786d2f46c3", "name": "L'Ultima Missione", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Ultima Missione</em></p><p>Completare l'operazione per cui la mia mentore è morta, e poi appendere la guerra al chiodo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 490, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Guerra", "name": "L'Ultima Missione", "text": "Completare l'operazione per cui la mia mentore è morta, e poi appendere la guerra al chiodo.", "title": "L'Ultima Missione"}}}}
{"_id": "4618c00505d7f635", "name": "L'Opera", "pages": [{"_id": "67ca3c8122af4a50", "name": "L'Opera", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Opera</em></p><p>Diventare un artista di fama mondiale senza un grammo di magia Volgare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 500, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Arte", "name": "L'Opera", "text": "Diventare un artista di fama mondiale senza un grammo di magia Volgare.", "title": "L'Opera", "credo": "arte"}}}}
{"_id": "a83dba4b6a284881", "name": "La Sala", "pages": [{"_id": "aaac8a80e3c207d9", "name": "La Sala", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Sala</em></p><p>Ottenere che il museo che mi ha rifiutato esponga una mia sala.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 510, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Arte", "name": "La Sala", "text": "Ottenere che il museo che mi ha rifiutato esponga una mia sala.", "title": "La Sala", "credo": "arte"}}}}
{"_id": "3257501490da293f", "name": "Il Falso", "pages": [{"_id": "77fbb7c7dfa630c1", "name": "Il Falso", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Falso</em></p><p>Far autenticare, dagli esperti che stimo, un quadro che ho dipinto io.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 520, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Arte", "name": "Il Falso", "text": "Far autenticare, dagli esperti che stimo, un quadro che ho dipinto io.", "title": "Il Falso", "credo": "arte"}}}}
{"_id": "c7eb5cd2e1e2a037", "name": "L'Intonaco", "pages": [{"_id": "affa92c3a9db4f0e", "name": "L'Intonaco", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Intonaco</em></p><p>Riportare alla luce l'affresco sotto l'intonaco della chiesa del mio quartiere, prima che la demoliscano.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 530, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Arte", "name": "L'Intonaco", "text": "Riportare alla luce l'affresco sotto l'intonaco della chiesa del mio quartiere, prima che la demoliscano.", "title": "L'Intonaco", "credo": "arte"}}}}
{"_id": "1921ddec6a6107ca", "name": "L'Allievo", "pages": [{"_id": "6612f1b1f8c40549", "name": "L'Allievo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Allievo</em></p><p>Portare a superarmi il ragazzo che ho preso a bottega, e reggere il giorno in cui succede.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 540, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Arte", "name": "L'Allievo", "text": "Portare a superarmi il ragazzo che ho preso a bottega, e reggere il giorno in cui succede.", "title": "L'Allievo", "credo": "arte"}}}}
{"_id": "7f3a979e171538b0", "name": "La Cancellatura", "pages": [{"_id": "046ba75c76cf88be", "name": "La Cancellatura", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Cancellatura</em></p><p>Ritirare dal mondo, una per una, tutte le opere che ho firmato prima del Risveglio.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 550, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Arte", "name": "La Cancellatura", "text": "Ritirare dal mondo, una per una, tutte le opere che ho firmato prima del Risveglio.", "title": "La Cancellatura", "credo": "arte"}}}}
{"_id": "6332ec077924542a", "name": "Il Mazzo", "pages": [{"_id": "335d466ebab27b36", "name": "Il Mazzo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Mazzo</em></p><p>Diventare quello che nessuna delle Sette riesce a calcolare, e che tutte finiscono per chiamare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 560, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Caos", "name": "Il Mazzo", "text": "Diventare quello che nessuna delle Sette riesce a calcolare, e che tutte finiscono per chiamare.", "title": "Il Mazzo", "credo": "caos"}}}}
{"_id": "b5b961e70c5798b3", "name": "La Corrente", "pages": [{"_id": "a0f883a6e6ab33d9", "name": "La Corrente", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Corrente</em></p><p>Trovare il punto stretto di Milano, quello da cui si muove tutta la città, e metterci una mano.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 570, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Caos", "name": "La Corrente", "text": "Trovare il punto stretto di Milano, quello da cui si muove tutta la città, e metterci una mano.", "title": "La Corrente", "credo": "caos"}}}}
{"_id": "dd6493075c3ea989", "name": "Il Piano", "pages": [{"_id": "ac6d0664cc50b3bd", "name": "Il Piano", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Piano</em></p><p>Far saltare il piano decennale di una Cabala con una cosa piccola, lasciata cadere al momento giusto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 580, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Caos", "name": "Il Piano", "text": "Far saltare il piano decennale di una Cabala con una cosa piccola, lasciata cadere al momento giusto.", "title": "Il Piano", "credo": "caos"}}}}
{"_id": "7837d2413ebd3dc7", "name": "La Colonna", "pages": [{"_id": "476a8f826df6d417", "name": "La Colonna", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Colonna</em></p><p>Vedere una volta il tratto liscio del mondo intero, prima che si sfrangi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 590, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Caos", "name": "La Colonna", "text": "Vedere una volta il tratto liscio del mondo intero, prima che si sfrangi.", "title": "La Colonna", "credo": "caos"}}}}
{"_id": "2e69197001120114", "name": "Il Joker", "pages": [{"_id": "f3fa8ec8e97e0170", "name": "Il Joker", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Joker</em></p><p>Entrare in una partita che vale tutto senza essere stato invitato, e vincerla.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 600, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Caos", "name": "Il Joker", "text": "Entrare in una partita che vale tutto senza essere stato invitato, e vincerla.", "title": "Il Joker", "credo": "caos"}}}}
{"_id": "92c5bbb2a275aefc", "name": "La Gabbia", "pages": [{"_id": "3c1f35926f2346a8", "name": "La Gabbia", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Gabbia</em></p><p>Aprire la gabbia più grande che conosco, e restare a vedere cosa ne esce.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 610, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Caos", "name": "La Gabbia", "text": "Aprire la gabbia più grande che conosco, e restare a vedere cosa ne esce.", "title": "La Gabbia", "credo": "caos"}}}}
{"_id": "a9021a33b4983cee", "name": "Il Sorgente", "pages": [{"_id": "414f1bf9df045643", "name": "Il Sorgente", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Sorgente</em></p><p>Leggere una volta il codice sorgente, anche una riga sola, e tornare indietro.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 620, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Dati", "name": "Il Sorgente", "text": "Leggere una volta il codice sorgente, anche una riga sola, e tornare indietro.", "title": "Il Sorgente", "credo": "dati"}}}}
{"_id": "ed54707b6bd3848c", "name": "L'Utenza", "pages": [{"_id": "529598ab240d5ac2", "name": "L'Utenza", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Utenza</em></p><p>Ottenere un'utenza con permessi più alti di quelli con cui sono nato.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 630, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Dati", "name": "L'Utenza", "text": "Ottenere un'utenza con permessi più alti di quelli con cui sono nato.", "title": "L'Utenza", "credo": "dati"}}}}
{"_id": "49a24fb4d95eae98", "name": "Il Daemon", "pages": [{"_id": "57bee10eee626c05", "name": "Il Daemon", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Daemon</em></p><p>Terminare un processo che gira da prima dell'avvio, o farlo rispondere.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 640, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Dati", "name": "Il Daemon", "text": "Terminare un processo che gira da prima dell'avvio, o farlo rispondere.", "title": "Il Daemon", "credo": "dati"}}}}
{"_id": "f2a45d0f9b003fe6", "name": "La Documentazione", "pages": [{"_id": "35a6aba19f0eabe8", "name": "La Documentazione", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Documentazione</em></p><p>Scrivere la documentazione che manca, e lasciarla a chi viene dopo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 650, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Dati", "name": "La Documentazione", "text": "Scrivere la documentazione che manca, e lasciarla a chi viene dopo.", "title": "La Documentazione", "credo": "dati"}}}}
{"_id": "74741ac8c4ff0052", "name": "Il Confine", "pages": [{"_id": "6c327d72a31868e5", "name": "Il Confine", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Confine</em></p><p>Arrivare al confine della mappa e vedere cosa c'è dove non si carica.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 660, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Dati", "name": "Il Confine", "text": "Arrivare al confine della mappa e vedere cosa c'è dove non si carica.", "title": "Il Confine", "credo": "dati"}}}}
{"_id": "e634b267ef1d5703", "name": "Il Nodo", "pages": [{"_id": "131325bfeb78c3f8", "name": "Il Nodo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Nodo</em></p><p>Prendere il controllo di un Nodo e decidere io chi scrive.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 670, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Dati", "name": "Il Nodo", "text": "Prendere il controllo di un Nodo e decidere io chi scrive.", "title": "Il Nodo", "credo": "dati"}}}}
{"_id": "cfef3b4cdd4f07b7", "name": "La Provvidenza", "pages": [{"_id": "8ea62e52d5ebc83f", "name": "La Provvidenza", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Provvidenza</em></p><p>Vedere una volta la mano che distribuisce il caso, e stringerla.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 680, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Fede", "name": "La Provvidenza", "text": "Vedere una volta la mano che distribuisce il caso, e stringerla.", "title": "La Provvidenza", "credo": "fede"}}}}
{"_id": "1f097f8eeac35b34", "name": "L'Ospedale", "pages": [{"_id": "b62da6b4190a7073", "name": "L'Ospedale", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Ospedale</em></p><p>Far chiudere il reparto in cui mi hanno curato perché non ci sono più pazienti.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 690, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Fede", "name": "L'Ospedale", "text": "Far chiudere il reparto in cui mi hanno curato perché non ci sono più pazienti.", "title": "L'Ospedale", "credo": "fede"}}}}
{"_id": "1733ad3283338e49", "name": "Il Nemico", "pages": [{"_id": "0223124e51e80f96", "name": "Il Nemico", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Nemico</em></p><p>Portare a tavola, a casa mia, chi mi ha fatto più male di tutti.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 700, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Fede", "name": "Il Nemico", "text": "Portare a tavola, a casa mia, chi mi ha fatto più male di tutti.", "title": "Il Nemico", "credo": "fede"}}}}
{"_id": "c9e13193cf2bec8a", "name": "Il Giorno", "pages": [{"_id": "37014dc33e46d0fa", "name": "Il Giorno", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Giorno</em></p><p>Restare fedele il giorno in cui la Provvidenza tarda davvero, e non è un esercizio.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 710, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Fede", "name": "Il Giorno", "text": "Restare fedele il giorno in cui la Provvidenza tarda davvero, e non è un esercizio.", "title": "Il Giorno", "credo": "fede"}}}}
{"_id": "91ffc7409b1f6516", "name": "La Casa", "pages": [{"_id": "1d67fb1982fc8fdb", "name": "La Casa", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Casa</em></p><p>Aprire un posto dove chi arriva a mani vuote viene servito prima di chi paga.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 720, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Fede", "name": "La Casa", "text": "Aprire un posto dove chi arriva a mani vuote viene servito prima di chi paga.", "title": "La Casa", "credo": "fede"}}}}
{"_id": "fa3bd9b8cf4bd969", "name": "Il Dono", "pages": [{"_id": "3efbd8c6c1d5ea82", "name": "Il Dono", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Dono</em></p><p>Restituire la vita che mi è stata affidata al momento giusto, e sapere quale.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 730, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Fede", "name": "Il Dono", "text": "Restituire la vita che mi è stata affidata al momento giusto, e sapere quale.", "title": "Il Dono", "credo": "fede"}}}}
{"_id": "4cc9f9ce1cb7378f", "name": "Il Risveglio", "pages": [{"_id": "ae6946b2a207c208", "name": "Il Risveglio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Risveglio</em></p><p>Uscire dal sogno una volta per intero, e ricordarmi cosa c'era.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 740, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Illusione", "name": "Il Risveglio", "text": "Uscire dal sogno una volta per intero, e ricordarmi cosa c'era.", "title": "Il Risveglio", "credo": "illusione"}}}}
{"_id": "72fd96abb7cfe882", "name": "Il Muro", "pages": [{"_id": "2f5bfa2034a8a0cb", "name": "Il Muro", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Muro</em></p><p>Attraversare un muro davanti a cento persone, e che nessuna torni a crederci.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 750, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Illusione", "name": "Il Muro", "text": "Attraversare un muro davanti a cento persone, e che nessuna torni a crederci.", "title": "Il Muro", "credo": "illusione"}}}}
{"_id": "356aa0885cb87950", "name": "La Stanza", "pages": [{"_id": "3c543cc9e4526fde", "name": "La Stanza", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Stanza</em></p><p>Scoprire se anche questa è una stanza, e chi l'ha dipinta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 760, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Illusione", "name": "La Stanza", "text": "Scoprire se anche questa è una stanza, e chi l'ha dipinta.", "title": "La Stanza", "credo": "illusione"}}}}
{"_id": "c3da9384fcca4eba", "name": "Il Sognatore", "pages": [{"_id": "84ff5f693ee11c2a", "name": "Il Sognatore", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Sognatore</em></p><p>Trovare chi sogna il Consenso, e parlargli.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 770, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Illusione", "name": "Il Sognatore", "text": "Trovare chi sogna il Consenso, e parlargli.", "title": "Il Sognatore", "credo": "illusione"}}}}
{"_id": "b72cb4064d8d7930", "name": "La Scuola", "pages": [{"_id": "5b437bdcf2dc2729", "name": "La Scuola", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Scuola</em></p><p>Insegnare a vedere a qualcuno che non se ne farà una stanza.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 780, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Illusione", "name": "La Scuola", "text": "Insegnare a vedere a qualcuno che non se ne farà una stanza.", "title": "La Scuola", "credo": "illusione"}}}}
{"_id": "df87a11ca7d8a567", "name": "Il Dolore", "pages": [{"_id": "435f7a68cbd9a343", "name": "Il Dolore", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Dolore</em></p><p>Smettere di credere al dolore per un anno intero, e vedere cosa resta di me.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 790, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Illusione", "name": "Il Dolore", "text": "Smettere di credere al dolore per un anno intero, e vedere cosa resta di me.", "title": "Il Dolore", "credo": "illusione"}}}}
{"_id": "fcf2be28100ec2f7", "name": "La Copia", "pages": [{"_id": "76a8950833a54473", "name": "La Copia", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Copia</em></p><p>Riportare un quartiere intero a somigliare all'originale, una strada per volta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 800, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Legge", "name": "La Copia", "text": "Riportare un quartiere intero a somigliare all'originale, una strada per volta.", "title": "La Copia", "credo": "legge"}}}}
{"_id": "5cf163ccdfc647e6", "name": "Il Titolo", "pages": [{"_id": "eea29364df1ee9ec", "name": "Il Titolo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Titolo</em></p><p>Ottenere dal cosmo un ufficio con un nome, e vederlo riconosciuto da chi conta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 810, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Legge", "name": "Il Titolo", "text": "Ottenere dal cosmo un ufficio con un nome, e vederlo riconosciuto da chi conta.", "title": "Il Titolo", "credo": "legge"}}}}
{"_id": "2b13f9d3758e8414", "name": "Il Corrotto", "pages": [{"_id": "ec6aea85f6667227", "name": "Il Corrotto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Corrotto</em></p><p>Portare davanti a una corte chi conosce la legge e ha scelto di corromperla.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 820, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Legge", "name": "Il Corrotto", "text": "Portare davanti a una corte chi conosce la legge e ha scelto di corromperla.", "title": "Il Corrotto", "credo": "legge"}}}}
{"_id": "70ca7e05f263eaf6", "name": "L'Ambasciata", "pages": [{"_id": "48839ca8b4631ab7", "name": "L'Ambasciata", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Ambasciata</em></p><p>Presentare un'istanza oltre il Velo, nelle forme, e ottenere risposta scritta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 830, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Legge", "name": "L'Ambasciata", "text": "Presentare un'istanza oltre il Velo, nelle forme, e ottenere risposta scritta.", "title": "L'Ambasciata", "credo": "legge"}}}}
{"_id": "0e7f73aa1855f03e", "name": "L'Archivio", "pages": [{"_id": "6a8aeddb0f335618", "name": "L'Archivio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Archivio</em></p><p>Trovare il testo della norma da cui le altre otto traggono validità.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 840, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Legge", "name": "L'Archivio", "text": "Trovare il testo della norma da cui le altre otto traggono validità.", "title": "L'Archivio", "credo": "legge"}}}}
{"_id": "882d1e01583b9bf9", "name": "Il Processo", "pages": [{"_id": "e2273f23c90cae5a", "name": "Il Processo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Processo</em></p><p>Istruire un processo a un Risvegliato che opera senza titolo, e arrivare a sentenza.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 850, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Legge", "name": "Il Processo", "text": "Istruire un processo a un Risvegliato che opera senza titolo, e arrivare a sentenza.", "title": "Il Processo", "credo": "legge"}}}}
{"_id": "63bee1ce53998249", "name": "Il Movimento", "pages": [{"_id": "72c205e2e15bb2bf", "name": "Il Movimento", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Movimento</em></p><p>Aprire una volta il movimento del cosmo, e vedere le parti cooperare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 860, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Macchina", "name": "Il Movimento", "text": "Aprire una volta il movimento del cosmo, e vedere le parti cooperare.", "title": "Il Movimento", "credo": "macchina"}}}}
{"_id": "012da5afc4597500", "name": "La Leva", "pages": [{"_id": "3c263e9aea33c6f6", "name": "La Leva", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Leva</em></p><p>Trovare la leva che sposta Milano, e sapere di non doverla toccare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 870, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Macchina", "name": "La Leva", "text": "Trovare la leva che sposta Milano, e sapere di non doverla toccare.", "title": "La Leva", "credo": "macchina"}}}}
{"_id": "032c39cc666e0312", "name": "Il Pezzo", "pages": [{"_id": "e96b2dd2de808761", "name": "Il Pezzo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Pezzo</em></p><p>Montare all'impianto un componente che non era previsto da nessuna parte.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 880, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Macchina", "name": "Il Pezzo", "text": "Montare all'impianto un componente che non era previsto da nessuna parte.", "title": "Il Pezzo", "credo": "macchina"}}}}
{"_id": "0763feb0303d5bc3", "name": "L'Allievo", "pages": [{"_id": "4d3b9df2e49afc87", "name": "L'Allievo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Allievo</em></p><p>Insegnare il metodo a uno che lo seguirà passo per passo, e vederlo ottenere lo stesso risultato.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 890, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Macchina", "name": "L'Allievo", "text": "Insegnare il metodo a uno che lo seguirà passo per passo, e vederlo ottenere lo stesso risultato.", "title": "L'Allievo", "credo": "macchina"}}}}
{"_id": "eef8f10a3f40afa5", "name": "Il Guasto", "pages": [{"_id": "2caa65c91a2b2930", "name": "Il Guasto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Guasto</em></p><p>Ripararne uno che tutti danno per irreparabile, senza forzare niente.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 900, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Macchina", "name": "Il Guasto", "text": "Ripararne uno che tutti danno per irreparabile, senza forzare niente.", "title": "Il Guasto", "credo": "macchina"}}}}
{"_id": "fc0d6fa8c4966715", "name": "La Cadenza", "pages": [{"_id": "01f5377d6f10bafe", "name": "La Cadenza", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Cadenza</em></p><p>Regolare il metronomo di una città intera per un giorno, e vedere cosa va in orario.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 910, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Macchina", "name": "La Cadenza", "text": "Regolare il metronomo di una città intera per un giorno, e vedere cosa va in orario.", "title": "La Cadenza", "credo": "macchina"}}}}
{"_id": "5af9a0c1c6812837", "name": "La Casa", "pages": [{"_id": "cdf31ec45b965a1c", "name": "La Casa", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Casa</em></p><p>Tenere in piedi la casa in cui sono cresciuto finché non ci abita di nuovo qualcuno.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 920, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Polvere", "name": "La Casa", "text": "Tenere in piedi la casa in cui sono cresciuto finché non ci abita di nuovo qualcuno.", "title": "La Casa", "credo": "polvere"}}}}
{"_id": "0792f4699402e569", "name": "Il Conto", "pages": [{"_id": "9c9b1a2fcf0d8b9a", "name": "Il Conto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Conto</em></p><p>Sapere quanto resta a me, e decidere cosa ne faccio.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 930, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Polvere", "name": "Il Conto", "text": "Sapere quanto resta a me, e decidere cosa ne faccio.", "title": "Il Conto", "credo": "polvere"}}}}
{"_id": "c717fc4dd413f627", "name": "L'Inventario", "pages": [{"_id": "cd098bb24911787d", "name": "L'Inventario", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Inventario</em></p><p>Chiudere in ordine la faccenda di una città intera, stanza per stanza, prima che cada da sola.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 940, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Polvere", "name": "L'Inventario", "text": "Chiudere in ordine la faccenda di una città intera, stanza per stanza, prima che cada da sola.", "title": "L'Inventario", "credo": "polvere"}}}}
{"_id": "43a9d095b83f82ef", "name": "Il Sostegno", "pages": [{"_id": "01d324dca95008b3", "name": "Il Sostegno", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Sostegno</em></p><p>Restare l'unico puntello di qualcuno per dieci anni, e non sfilarmi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 950, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Polvere", "name": "Il Sostegno", "text": "Restare l'unico puntello di qualcuno per dieci anni, e non sfilarmi.", "title": "Il Sostegno", "credo": "polvere"}}}}
{"_id": "b7e3548ff67dd278", "name": "La Data", "pages": [{"_id": "2f6372925db4db8f", "name": "La Data", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Data</em></p><p>Spostare una scadenza di una vita intera, e stare a vedere chi paga.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 960, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Polvere", "name": "La Data", "text": "Spostare una scadenza di una vita intera, e stare a vedere chi paga.", "title": "La Data", "credo": "polvere"}}}}
{"_id": "555a96083996aa1f", "name": "Il Fondo", "pages": [{"_id": "e8ae7a7932f0f951", "name": "Il Fondo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Fondo</em></p><p>Vedere una volta il fondo che non si ricarica, e sapere quanto c'è ancora.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 970, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Polvere", "name": "Il Fondo", "text": "Vedere una volta il fondo che non si ricarica, e sapere quanto c'è ancora.", "title": "Il Fondo", "credo": "polvere"}}}}
{"_id": "540594473b55b94b", "name": "Il Trono", "pages": [{"_id": "dcb22c065405a8d8", "name": "Il Trono", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Trono</em></p><p>Essere quello che a Milano nessuna delle Sette può ignorare, e che nessuna comanda.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 980, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Potere", "name": "Il Trono", "text": "Essere quello che a Milano nessuna delle Sette può ignorare, e che nessuna comanda.", "title": "Il Trono", "credo": "potere"}}}}
{"_id": "4fa4e1b092b5f5d8", "name": "Il Rivale", "pages": [{"_id": "ffb572d781740062", "name": "Il Rivale", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Rivale</em></p><p>Trovare l'unico che vale la pena rispettare, e batterlo davanti a testimoni.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 990, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Potere", "name": "Il Rivale", "text": "Trovare l'unico che vale la pena rispettare, e batterlo davanti a testimoni.", "title": "Il Rivale", "credo": "potere"}}}}
{"_id": "db2136d19f6538ae", "name": "La Favola", "pages": [{"_id": "246989ce3343e3d6", "name": "La Favola", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Favola</em></p><p>Strappare la storia a un forte che si vergogna della sua forza, e vedere cosa resta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1000, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Potere", "name": "La Favola", "text": "Strappare la storia a un forte che si vergogna della sua forza, e vedere cosa resta.", "title": "La Favola", "credo": "potere"}}}}
{"_id": "8767b619d1eaf8aa", "name": "Il Sonno", "pages": [{"_id": "aa1df272b4a8718e", "name": "Il Sonno", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Sonno</em></p><p>Chiudere l'unica riga dell'elenco che mi tiene sveglio la notte.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1010, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Potere", "name": "Il Sonno", "text": "Chiudere l'unica riga dell'elenco che mi tiene sveglio la notte.", "title": "Il Sonno", "credo": "potere"}}}}
{"_id": "97751101db89ebd8", "name": "La Corte", "pages": [{"_id": "f5a8ad6bae9c1fbc", "name": "La Corte", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Corte</em></p><p>Ottenere che di là qualcuno mi riceva senza doni e senza udienza.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1020, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Potere", "name": "La Corte", "text": "Ottenere che di là qualcuno mi riceva senza doni e senza udienza.", "title": "La Corte", "credo": "potere"}}}}
{"_id": "71096ce8c1d99684", "name": "Il Nome", "pages": [{"_id": "51ee56542430a7a9", "name": "Il Nome", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Nome</em></p><p>Far sapere al mondo di chi è, e non doverlo più ripetere.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1030, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Potere", "name": "Il Nome", "text": "Far sapere al mondo di chi è, e non doverlo più ripetere.", "title": "Il Nome", "credo": "potere"}}}}
{"_id": "8f659427b1eaa3f1", "name": "Il Nome", "pages": [{"_id": "afce440b873b0f75", "name": "Il Nome", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Nome</em></p><p>Conoscere il nome di chi tiene Milano, e sentirmelo chiedere il mio.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1040, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Sacro", "name": "Il Nome", "text": "Conoscere il nome di chi tiene Milano, e sentirmelo chiedere il mio.", "title": "Il Nome", "credo": "sacro"}}}}
{"_id": "de1c8a4c4dbd9264", "name": "La Guida", "pages": [{"_id": "d6d40a2838239965", "name": "La Guida", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Guida</em></p><p>Scrivere la mappa delle giurisdizioni della città, isolato per isolato, e lasciarla a chi viene dopo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1050, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Sacro", "name": "La Guida", "text": "Scrivere la mappa delle giurisdizioni della città, isolato per isolato, e lasciarla a chi viene dopo.", "title": "La Guida", "credo": "sacro"}}}}
{"_id": "5d6e9d3bd061499f", "name": "L'Udienza", "pages": [{"_id": "25a08092d912edc2", "name": "L'Udienza", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Udienza</em></p><p>Essere ricevuto da chi presiede alla fine, e uscirne.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1060, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Sacro", "name": "L'Udienza", "text": "Essere ricevuto da chi presiede alla fine, e uscirne.", "title": "L'Udienza", "credo": "sacro"}}}}
{"_id": "af35ebbdff48df6d", "name": "Il Debito", "pages": [{"_id": "5f381f9e6e9411ce", "name": "Il Debito", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Debito</em></p><p>Saldare l'ultimo debito che ho di là, e restare in credito per una volta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1070, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Sacro", "name": "Il Debito", "text": "Saldare l'ultimo debito che ho di là, e restare in credito per una volta.", "title": "Il Debito", "credo": "sacro"}}}}
{"_id": "75281ce4d1edb818", "name": "L'Ambasciata", "pages": [{"_id": "65977652d877fd8a", "name": "L'Ambasciata", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Ambasciata</em></p><p>Far parlare due potenze che non si salutano da un secolo, e stare in mezzo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1080, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Sacro", "name": "L'Ambasciata", "text": "Far parlare due potenze che non si salutano da un secolo, e stare in mezzo.", "title": "L'Ambasciata", "credo": "sacro"}}}}
{"_id": "8303bd4e13177413", "name": "La Porta", "pages": [{"_id": "23b797c4d35b1cec", "name": "La Porta", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Porta</em></p><p>Trovare la potenza che serve chi bussa alla porta sbagliata, e ringraziarla di persona.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1090, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Sacro", "name": "La Porta", "text": "Trovare la potenza che serve chi bussa alla porta sbagliata, e ringraziarla di persona.", "title": "La Porta", "credo": "sacro"}}}}
{"_id": "375be7b6dee1d743", "name": "La Pubblicazione", "pages": [{"_id": "d385ee92ec12c8fd", "name": "La Pubblicazione", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Pubblicazione</em></p><p>Far accettare a un pari una legge che il mondo chiama magia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1100, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Scienza", "name": "La Pubblicazione", "text": "Far accettare a un pari una legge che il mondo chiama magia.", "title": "La Pubblicazione", "credo": "scienza"}}}}
{"_id": "24e4b0f9457d6364", "name": "Il Corpus", "pages": [{"_id": "93a790e041050a80", "name": "Il Corpus", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Corpus</em></p><p>Separare l'oro dal fango di una tradizione intera, e restituirglielo pulito.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1110, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Scienza", "name": "Il Corpus", "text": "Separare l'oro dal fango di una tradizione intera, e restituirglielo pulito.", "title": "Il Corpus", "credo": "scienza"}}}}
{"_id": "e0988dc792ebf83f", "name": "La Legge", "pages": [{"_id": "222776d202863126", "name": "La Legge", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Legge</em></p><p>Scrivere la legge di un fenomeno che nessuno ha ancora scritto, e vederla replicare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1120, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Scienza", "name": "La Legge", "text": "Scrivere la legge di un fenomeno che nessuno ha ancora scritto, e vederla replicare.", "title": "La Legge", "credo": "scienza"}}}}
{"_id": "e18befdc7153cfc5", "name": "L'Esperimento", "pages": [{"_id": "fe88df6b7cfc8147", "name": "L'Esperimento", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Esperimento</em></p><p>Condurre su di me l'unico esperimento senza doppio cieco, e annotarlo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1130, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Scienza", "name": "L'Esperimento", "text": "Condurre su di me l'unico esperimento senza doppio cieco, e annotarlo.", "title": "L'Esperimento", "credo": "scienza"}}}}
{"_id": "fed98b10e95b92e2", "name": "Il Laboratorio", "pages": [{"_id": "5b53e94963df8721", "name": "Il Laboratorio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Laboratorio</em></p><p>Aprire un posto dove i Risvegliati verificano prima di credere.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1140, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Scienza", "name": "Il Laboratorio", "text": "Aprire un posto dove i Risvegliati verificano prima di credere.", "title": "Il Laboratorio", "credo": "scienza"}}}}
{"_id": "c12d04af5059fe44", "name": "La Domanda", "pages": [{"_id": "d01d4c1c03ccf33d", "name": "La Domanda", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Domanda</em></p><p>Sapere come fa a saperlo chi mi ha insegnato, e sentirmelo dire.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1150, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Scienza", "name": "La Domanda", "text": "Sapere come fa a saperlo chi mi ha insegnato, e sentirmelo dire.", "title": "La Domanda", "credo": "scienza"}}}}
{"_id": "3e1af94658461b6c", "name": "La Fondamentale", "pages": [{"_id": "a1fd9d0d76814e3e", "name": "La Fondamentale", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Fondamentale</em></p><p>Sentire una volta la nota tenuta per intero, e reggerla.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1160, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Suono", "name": "La Fondamentale", "text": "Sentire una volta la nota tenuta per intero, e reggerla.", "title": "La Fondamentale", "credo": "suono"}}}}
{"_id": "ce07cd320cc17364", "name": "L'Orchestra", "pages": [{"_id": "7d398fa9a2e326ce", "name": "L'Orchestra", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Orchestra</em></p><p>Mettere insieme un'orchestra di Risvegliati che entra in chiave, e dirigerla una sera.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1170, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Suono", "name": "L'Orchestra", "text": "Mettere insieme un'orchestra di Risvegliati che entra in chiave, e dirigerla una sera.", "title": "L'Orchestra", "credo": "suono"}}}}
{"_id": "1cdc32c458b913c5", "name": "Il Pezzo", "pages": [{"_id": "d96a415c878c915e", "name": "Il Pezzo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Pezzo</em></p><p>Scrivere una parte nel pezzo che il mondo suona, e sentirla ripresa da chi non mi conosce.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1180, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Suono", "name": "Il Pezzo", "text": "Scrivere una parte nel pezzo che il mondo suona, e sentirla ripresa da chi non mi conosce.", "title": "Il Pezzo", "credo": "suono"}}}}
{"_id": "297d676de0888aaf", "name": "La Sala", "pages": [{"_id": "99f7b3c9c7adcb45", "name": "La Sala", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Sala</em></p><p>Far voltare una città intera nello stesso istante, con una frase detta al momento giusto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1190, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Suono", "name": "La Sala", "text": "Far voltare una città intera nello stesso istante, con una frase detta al momento giusto.", "title": "La Sala", "credo": "suono"}}}}
{"_id": "2385e3125886d28a", "name": "L'Eco", "pages": [{"_id": "f40486b9e37c9b17", "name": "L'Eco", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Eco</em></p><p>Sentire l'eco rispondere con una voce che non è la mia, e sapere chi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1200, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Suono", "name": "L'Eco", "text": "Sentire l'eco rispondere con una voce che non è la mia, e sapere chi.", "title": "L'Eco", "credo": "suono"}}}}
{"_id": "773d2915de7e9985", "name": "Il Silenzio", "pages": [{"_id": "edf78dbedb5ea97e", "name": "Il Silenzio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Silenzio</em></p><p>Trovare il silenzio che non esiste, o dimostrare che non c'è.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1210, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Suono", "name": "Il Silenzio", "text": "Trovare il silenzio che non esiste, o dimostrare che non c'è.", "title": "Il Silenzio", "credo": "suono"}}}}
{"_id": "e84edb82b1840e2b", "name": "Il Giro", "pages": [{"_id": "0bac8dfcfc1645b2", "name": "Il Giro", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Giro</em></p><p>Sentire una volta il giro intero, dalla sorgente al ritorno, e restare distinto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1220, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Vivo", "name": "Il Giro", "text": "Sentire una volta il giro intero, dalla sorgente al ritorno, e restare distinto.", "title": "Il Giro", "credo": "vivo"}}}}
{"_id": "32729123b6f58afe", "name": "La Città", "pages": [{"_id": "517297bbfbd87d13", "name": "La Città", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Città</em></p><p>Guarire il punto malato di Milano che genera spiriti come sintomi, e vederli smettere.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1230, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Vivo", "name": "La Città", "text": "Guarire il punto malato di Milano che genera spiriti come sintomi, e vederli smettere.", "title": "La Città", "credo": "vivo"}}}}
{"_id": "93939396b6f2c822", "name": "Il Nodo", "pages": [{"_id": "34d00807b4463324", "name": "Il Nodo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Nodo</em></p><p>Trovare un Nodo prosciugato e riaprirgli la vena.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1240, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Vivo", "name": "Il Nodo", "text": "Trovare un Nodo prosciugato e riaprirgli la vena.", "title": "Il Nodo", "credo": "vivo"}}}}
{"_id": "79eaa274ebe2cce0", "name": "Il Bosco", "pages": [{"_id": "a975b5074d1ca41a", "name": "Il Bosco", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Bosco</em></p><p>Far crescere qualcosa di vivo dove non cresce niente da cent'anni, e tornarci a vedere.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1250, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Vivo", "name": "Il Bosco", "text": "Far crescere qualcosa di vivo dove non cresce niente da cent'anni, e tornarci a vedere.", "title": "Il Bosco", "credo": "vivo"}}}}
{"_id": "839cc921fb593c9d", "name": "L'Embolo", "pages": [{"_id": "cec8d4a5c0b03cdf", "name": "L'Embolo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Embolo</em></p><p>Fermare un Risvegliato che spinge il flusso nella direzione sbagliata, prima che il conto arrivi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1260, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Vivo", "name": "L'Embolo", "text": "Fermare un Risvegliato che spinge il flusso nella direzione sbagliata, prima che il conto arrivi.", "title": "L'Embolo", "credo": "vivo"}}}}
{"_id": "a85a0af3e33a3905", "name": "Il Paziente", "pages": [{"_id": "f11a029206d54fb8", "name": "Il Paziente", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Paziente</em></p><p>Guarire chi nessuno ascoltava più, e sentirmi dire che voleva vivere.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1270, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Vivo", "name": "Il Paziente", "text": "Guarire chi nessuno ascoltava più, e sentirmi dire che voleva vivere.", "title": "Il Paziente", "credo": "vivo"}}}}
