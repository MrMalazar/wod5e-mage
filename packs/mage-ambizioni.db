{"_id": "dc1207f559f7066d", "name": "La Ricerca", "pages": [{"_id": "5cb50fbc5284cdb2", "name": "La Ricerca", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Ricerca</em></p><p>Trovare e riportare a casa il mio affetto. Qualcuno l'ha fatta sparire, e qualcuno mi impedirà di cercarla.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 0, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Legami", "name": "La Ricerca", "text": "Trovare e riportare a casa il mio affetto. Qualcuno l'ha fatta sparire, e qualcuno mi impedirà di cercarla.", "title": "La Ricerca"}}}}
{"_id": "517fa25549af0fa4", "name": "La Protezione", "pages": [{"_id": "1824bb128992da1f", "name": "La Protezione", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Protezione</em></p><p>Riuscire a proteggere la mia famiglia, celando le loro tracce, a costo dello stesso legame.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 10, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Legami", "name": "La Protezione", "text": "Riuscire a proteggere la mia famiglia, celando le loro tracce, a costo dello stesso legame.", "title": "La Protezione"}}}}
{"_id": "6535878af4d92601", "name": "La Fiducia", "pages": [{"_id": "8db166da76ea7383", "name": "La Fiducia", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Fiducia</em></p><p>Riuscire a guarire il legame con la persona che mi manca.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 20, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Legami", "name": "La Fiducia", "text": "Riuscire a guarire il legame con la persona che mi manca.", "title": "La Fiducia"}}}}
{"_id": "cf599e52f7d622d1", "name": "L'Approvazione", "pages": [{"_id": "4a99126e30a73f38", "name": "L'Approvazione", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Approvazione</em></p><p>Ottenere da mio padre il riconoscimento che non mi ha mai dato, prima che sia troppo tardi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 30, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Legami", "name": "L'Approvazione", "text": "Ottenere da mio padre il riconoscimento che non mi ha mai dato, prima che sia troppo tardi.", "title": "L'Approvazione"}}}}
{"_id": "6579766eb3cde3cf", "name": "Il Ritorno", "pages": [{"_id": "ee1e62cd593ac496", "name": "Il Ritorno", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Ritorno</em></p><p>Riprendermi mio figlio da chi me lo ha tolto. Lui potrebbe non voler tornare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 40, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Legami", "name": "Il Ritorno", "text": "Riprendermi mio figlio da chi me lo ha tolto. Lui potrebbe non voler tornare.", "title": "Il Ritorno"}}}}
{"_id": "d28746fc979ffc0b", "name": "La Promessa", "pages": [{"_id": "981844225efa6e2f", "name": "La Promessa", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Promessa</em></p><p>Mantenere fino in fondo la promessa fatta a chi è morto, anche quando nessuno me la chiederà più.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 50, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Legami", "name": "La Promessa", "text": "Mantenere fino in fondo la promessa fatta a chi è morto, anche quando nessuno me la chiederà più.", "title": "La Promessa"}}}}
{"_id": "eee1ab00fb07b608", "name": "L'Erede", "pages": [{"_id": "b095ec57e7160697", "name": "L'Erede", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Erede</em></p><p>Crescere chi mi è stato affidato fuori dal mondo Risvegliato, contro chi lo vorrebbe dentro.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 60, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Legami", "name": "L'Erede", "text": "Crescere chi mi è stato affidato fuori dal mondo Risvegliato, contro chi lo vorrebbe dentro.", "title": "L'Erede"}}}}
{"_id": "c722dbc92427f5ad", "name": "Il Perdono", "pages": [{"_id": "a225a7a58e6cd93e", "name": "Il Perdono", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Perdono</em></p><p>Ripagare, senza farmi riconoscere, la persona a cui ho fatto del male prima del Risveglio.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 70, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Legami", "name": "Il Perdono", "text": "Ripagare, senza farmi riconoscere, la persona a cui ho fatto del male prima del Risveglio.", "title": "Il Perdono"}}}}
{"_id": "8d0024140b16d5d9", "name": "Il Samaritano", "pages": [{"_id": "9d2a19973181353e", "name": "Il Samaritano", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Samaritano</em></p><p>Aprire nel mio quartiere un posto dove chi non può pagare viene curato lo stesso.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 80, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Carriera", "name": "Il Samaritano", "text": "Aprire nel mio quartiere un posto dove chi non può pagare viene curato lo stesso.", "title": "Il Samaritano"}}}}
{"_id": "ae09804a0685c0ac", "name": "Il Veritiero", "pages": [{"_id": "2cafc961e6bf7922", "name": "Il Veritiero", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Veritiero</em></p><p>Portare alla luce la verità che la mia città non vuole sentire, e firmarla col mio nome, anche se dietro c'è il Sindacato.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 90, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Carriera", "name": "Il Veritiero", "text": "Portare alla luce la verità che la mia città non vuole sentire, e firmarla col mio nome, anche se dietro c'è il Sindacato.", "title": "Il Veritiero"}}}}
{"_id": "16e70319183dc122", "name": "L'Opera", "pages": [{"_id": "817dd46e8e19fda6", "name": "L'Opera", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Opera</em></p><p>Diventare un artista riconosciuto senza un grammo di Magick Volgare nel mio lavoro.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 100, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Carriera", "name": "L'Opera", "text": "Diventare un artista riconosciuto senza un grammo di Magick Volgare nel mio lavoro.", "title": "L'Opera"}}}}
{"_id": "f0c3d9465bd1044c", "name": "L'Innovatore", "pages": [{"_id": "46240ec513d1d0db", "name": "L'Innovatore", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Innovatore</em></p><p>Far riconoscere alla scienza ufficiale un'invenzione che ho costruito con la Magick.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 110, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Carriera", "name": "L'Innovatore", "text": "Far riconoscere alla scienza ufficiale un'invenzione che ho costruito con la Magick.", "title": "L'Innovatore"}}}}
{"_id": "051dc28999571cad", "name": "La Cattedra", "pages": [{"_id": "dace5fd044c1b398", "name": "La Cattedra", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Cattedra</em></p><p>Riprendermi la cattedra da cui mi hanno cacciato, con le stesse idee che allora chiamarono follia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 120, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Carriera", "name": "La Cattedra", "text": "Riprendermi la cattedra da cui mi hanno cacciato, con le stesse idee che allora chiamarono follia.", "title": "La Cattedra"}}}}
{"_id": "b870e82ea9dc0c18", "name": "Il Sindaco", "pages": [{"_id": "582483e00960d554", "name": "Il Sindaco", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Sindaco</em></p><p>Vincere le elezioni del mio quartiere senza toccare la mente di nessuno.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 130, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Carriera", "name": "Il Sindaco", "text": "Vincere le elezioni del mio quartiere senza toccare la mente di nessuno.", "title": "Il Sindaco"}}}}
{"_id": "55964e66179baf7e", "name": "La Bottega", "pages": [{"_id": "29366291de8058b8", "name": "La Bottega", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Bottega</em></p><p>Fare della mia officina il posto dove la città porta ciò che nessun altro sa riparare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 140, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Carriera", "name": "La Bottega", "text": "Fare della mia officina il posto dove la città porta ciò che nessun altro sa riparare.", "title": "La Bottega"}}}}
{"_id": "55e4bb0e4e3ae727", "name": "Il Testimone", "pages": [{"_id": "550f5abfc8ec32d2", "name": "Il Testimone", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Testimone</em></p><p>Scrivere e pubblicare la verità sulla mia gente, e reggere quello che ne segue.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 150, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Carriera", "name": "Il Testimone", "text": "Scrivere e pubblicare la verità sulla mia gente, e reggere quello che ne segue.", "title": "Il Testimone"}}}}
{"_id": "e47471b36e50fac1", "name": "Fuga dalla povertà", "pages": [{"_id": "00f783c2cd9ddc07", "name": "Fuga dalla povertà", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Fuga dalla povertà</em></p><p>Estinguere i debiti della mia famiglia e non temere mai più una bolletta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 160, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Riscatto", "name": "Fuga dalla povertà", "text": "Estinguere i debiti della mia famiglia e non temere mai più una bolletta.", "title": "Fuga dalla povertà"}}}}
{"_id": "f5d6d167d0bef147", "name": "Fedina pulita", "pages": [{"_id": "5530e9df5c177102", "name": "Fedina pulita", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Fedina pulita</em></p><p>Dimostrare la mia innocenza e riprendermi il mio nome.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 170, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Riscatto", "name": "Fedina pulita", "text": "Dimostrare la mia innocenza e riprendermi il mio nome.", "title": "Fedina pulita"}}}}
{"_id": "ce582a679d9607a3", "name": "Vendetta urbana", "pages": [{"_id": "e47bc39448463f70", "name": "Vendetta urbana", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Vendetta urbana</em></p><p>Smantellare il cartello che ha ucciso i miei amici, senza diventare come loro.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 180, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Riscatto", "name": "Vendetta urbana", "text": "Smantellare il cartello che ha ucciso i miei amici, senza diventare come loro.", "title": "Vendetta urbana"}}}}
{"_id": "81e1dfbbdfca85c4", "name": "Sopravvivere", "pages": [{"_id": "40d2ac1a26276e7d", "name": "Sopravvivere", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Sopravvivere</em></p><p>Sconfiggere la malattia che sta uccidendo me, o la mia Ancora.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 190, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Riscatto", "name": "Sopravvivere", "text": "Sconfiggere la malattia che sta uccidendo me, o la mia Ancora.", "title": "Sopravvivere"}}}}
{"_id": "d7fa1411f2401f6f", "name": "L'Espatrio", "pages": [{"_id": "5f5a4799677f5b91", "name": "L'Espatrio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Espatrio</em></p><p>Portare la mia famiglia fuori dal paese che ci vuole morti, con documenti veri.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 200, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Riscatto", "name": "L'Espatrio", "text": "Portare la mia famiglia fuori dal paese che ci vuole morti, con documenti veri.", "title": "L'Espatrio"}}}}
{"_id": "aeda081d316505d4", "name": "Il Riscatto del Quartiere", "pages": [{"_id": "0844100717ddd8ac", "name": "Il Riscatto del Quartiere", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Riscatto del Quartiere</em></p><p>Fermare chi sta comprando la mia strada un palazzo alla volta, restando dentro la legge.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 210, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Riscatto", "name": "Il Riscatto del Quartiere", "text": "Fermare chi sta comprando la mia strada un palazzo alla volta, restando dentro la legge.", "title": "Il Riscatto del Quartiere"}}}}
{"_id": "9711c8f02130d855", "name": "La Casa", "pages": [{"_id": "4b2efe80884944a0", "name": "La Casa", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Casa</em></p><p>Comprare il palazzo dove facevo il portiere, e non chiamare più nessuno «signore».</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 220, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Riscatto", "name": "La Casa", "text": "Comprare il palazzo dove facevo il portiere, e non chiamare più nessuno «signore».", "title": "La Casa"}}}}
{"_id": "5f80b4573f02e044", "name": "L'Uscita", "pages": [{"_id": "ba90c672ab3bd57f", "name": "L'Uscita", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Uscita</em></p><p>Uscire vivo dall'organizzazione che mi considera roba sua.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 230, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Riscatto", "name": "L'Uscita", "text": "Uscire vivo dall'organizzazione che mi considera roba sua.", "title": "L'Uscita"}}}}
{"_id": "c26db558f72dc59c", "name": "La doppia vita", "pages": [{"_id": "4666928fe4017fff", "name": "La doppia vita", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La doppia vita</em></p><p>Tenere insieme Magick, lavoro e famiglia senza che nessuno dei tre scopra gli altri due.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 240, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Equilibrio", "name": "La doppia vita", "text": "Tenere insieme Magick, lavoro e famiglia senza che nessuno dei tre scopra gli altri due.", "title": "La doppia vita"}}}}
{"_id": "c3b9582bd82572f8", "name": "L'evasione", "pages": [{"_id": "c4d0c5b45a3908af", "name": "L'evasione", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'evasione</em></p><p>Trovare il modo di mettere a tacere il mio Avatar e tornare a dormire.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 250, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Equilibrio", "name": "L'evasione", "text": "Trovare il modo di mettere a tacere il mio Avatar e tornare a dormire.", "title": "L'evasione"}}}}
{"_id": "9e2f3b9391097e43", "name": "La Pensione", "pages": [{"_id": "f556223036ca133b", "name": "La Pensione", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Pensione</em></p><p>Uscire dal gioco dei Risvegliati vivo, e dimenticato da tutte le fazioni.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 260, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Equilibrio", "name": "La Pensione", "text": "Uscire dal gioco dei Risvegliati vivo, e dimenticato da tutte le fazioni.", "title": "La Pensione"}}}}
{"_id": "bb2e9e7ac45f89a5", "name": "Il Giardino", "pages": [{"_id": "f70c0862bed1c192", "name": "Il Giardino", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Giardino</em></p><p>Costruire un posto dove Risvegliati e Dormienti vivano insieme senza saperlo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 270, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Equilibrio", "name": "Il Giardino", "text": "Costruire un posto dove Risvegliati e Dormienti vivano insieme senza saperlo.", "title": "Il Giardino"}}}}
{"_id": "0b44be5c479df507", "name": "La Misura", "pages": [{"_id": "908b65b88ff58bed", "name": "La Misura", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Misura</em></p><p>Passare un anno intero senza un solo lancio Volgare, e vedere chi sono senza.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 280, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Equilibrio", "name": "La Misura", "text": "Passare un anno intero senza un solo lancio Volgare, e vedere chi sono senza.", "title": "La Misura"}}}}
{"_id": "c7268a21610a23a7", "name": "Il Silenzio Buono", "pages": [{"_id": "5e7417307ed9379b", "name": "Il Silenzio Buono", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Silenzio Buono</em></p><p>Fare pace con il mio Avatar, alle sue condizioni o alle mie.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 290, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Equilibrio", "name": "Il Silenzio Buono", "text": "Fare pace con il mio Avatar, alle sue condizioni o alle mie.", "title": "Il Silenzio Buono"}}}}
{"_id": "c25b659c537fd127", "name": "L'Ascensione", "pages": [{"_id": "b12301beb79e4642", "name": "L'Ascensione", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Ascensione</em></p><p>Trascendere la carne e diventare pura entità, e riconoscere il momento in cui farlo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 300, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Ascensione", "name": "L'Ascensione", "text": "Trascendere la carne e diventare pura entità, e riconoscere il momento in cui farlo.", "title": "L'Ascensione"}}}}
{"_id": "378f9eddb77b123d", "name": "Il Dominio", "pages": [{"_id": "519bea744ec584ce", "name": "Il Dominio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Dominio</em></p><p>Diventare il primo nome che si fa quando si parla di una Sfera, per riscrivere il mio passato.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 310, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Ascensione", "name": "Il Dominio", "text": "Diventare il primo nome che si fa quando si parla di una Sfera, per riscrivere il mio passato.", "title": "Il Dominio"}}}}
{"_id": "39ff4409c3459628", "name": "L'Opera Magna", "pages": [{"_id": "29d72d8ac11224b3", "name": "L'Opera Magna", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Opera Magna</em></p><p>Forgiare una Meraviglia che nessuno ha mai costruito, e sopravvivere a quello che chiede.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 320, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Ascensione", "name": "L'Opera Magna", "text": "Forgiare una Meraviglia che nessuno ha mai costruito, e sopravvivere a quello che chiede.", "title": "L'Opera Magna"}}}}
{"_id": "7d74b6a1cbba09c5", "name": "La Fonte", "pages": [{"_id": "01e8058489819af2", "name": "La Fonte", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Fonte</em></p><p>Rivendicare il Nodo più grande che conosco, e non restare mai più a secco.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 330, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Ascensione", "name": "La Fonte", "text": "Rivendicare il Nodo più grande che conosco, e non restare mai più a secco.", "title": "La Fonte"}}}}
{"_id": "9ebba1fa5d7faa78", "name": "Il Maestro", "pages": [{"_id": "5a2adeee9fc5f5b6", "name": "Il Maestro", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Maestro</em></p><p>Portare tre allievi al Risveglio pieno senza perderne uno, e senza rompere la Tregua.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 340, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Ascensione", "name": "Il Maestro", "text": "Portare tre allievi al Risveglio pieno senza perderne uno, e senza rompere la Tregua.", "title": "Il Maestro"}}}}
{"_id": "72688529e8b2504d", "name": "La Biblioteca Perduta", "pages": [{"_id": "6a650405506e53f8", "name": "La Biblioteca Perduta", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Biblioteca Perduta</em></p><p>Ritrovare gli archivi bruciati della mia Casa e restituirli a chi resta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 350, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Ascensione", "name": "La Biblioteca Perduta", "text": "Ritrovare gli archivi bruciati della mia Casa e restituirli a chi resta.", "title": "La Biblioteca Perduta"}}}}
{"_id": "cbbbd1b3d1bff4c9", "name": "La Cura", "pages": [{"_id": "9a93bbfaa4a1db65", "name": "La Cura", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Cura</em></p><p>Guarire un'Ustione permanente. Nessuno c'è mai riuscito.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 360, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Ascensione", "name": "La Cura", "text": "Guarire un'Ustione permanente. Nessuno c'è mai riuscito.", "title": "La Cura"}}}}
{"_id": "80b530afd33805a1", "name": "Il Cartografo", "pages": [{"_id": "7e6e2f4a6fc17476", "name": "Il Cartografo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Cartografo</em></p><p>Mappare una regione dell'Umbra da cui nessuno è tornato a raccontare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 370, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Ascensione", "name": "Il Cartografo", "text": "Mappare una regione dell'Umbra da cui nessuno è tornato a raccontare.", "title": "Il Cartografo"}}}}
{"_id": "d505a9236a71c296", "name": "La Resurrezione", "pages": [{"_id": "8d8021423544f4fb", "name": "La Resurrezione", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Resurrezione</em></p><p>Riportare indietro chi ho perso. È la trappola più vecchia che c'è, e il tavolo lo sa.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 380, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Ascensione", "name": "La Resurrezione", "text": "Riportare indietro chi ho perso. È la trappola più vecchia che c'è, e il tavolo lo sa.", "title": "La Resurrezione"}}}}
{"_id": "1e44351f4a485f53", "name": "Il Nome Vero", "pages": [{"_id": "c63f359a62c88a0c", "name": "Il Nome Vero", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Nome Vero</em></p><p>Scoprire il mio Nome Vero nella lingua della realtà, e sopravvivere a ciò che risponde.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 390, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Ascensione", "name": "Il Nome Vero", "text": "Scoprire il mio Nome Vero nella lingua della realtà, e sopravvivere a ciò che risponde.", "title": "Il Nome Vero"}}}}
{"_id": "6a703bf234b08f92", "name": "Il Diplomatico", "pages": [{"_id": "e24bf5574b7b6af0", "name": "Il Diplomatico", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Diplomatico</em></p><p>Ottenere una tregua vera fra il Concilio e l'Unione, anche solo nella mia città.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 400, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Guerra", "name": "Il Diplomatico", "text": "Ottenere una tregua vera fra il Concilio e l'Unione, anche solo nella mia città.", "title": "Il Diplomatico"}}}}
{"_id": "bb3c2bfbcc6b08ce", "name": "La Talpa", "pages": [{"_id": "c3e90b01af1efbf2", "name": "La Talpa", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Talpa</em></p><p>Entrare in un Costrutto e uscirne con la prova di cosa fanno ai Risvegliati catturati.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 410, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Guerra", "name": "La Talpa", "text": "Entrare in un Costrutto e uscirne con la prova di cosa fanno ai Risvegliati catturati.", "title": "La Talpa"}}}}
{"_id": "5601955c34dd5770", "name": "Il Faro", "pages": [{"_id": "f6196529e70b4a46", "name": "Il Faro", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Faro</em></p><p>Rifondare il Capitolo della mia Tradizione nella città da cui fu estirpato.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 420, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Guerra", "name": "Il Faro", "text": "Rifondare il Capitolo della mia Tradizione nella città da cui fu estirpato.", "title": "Il Faro"}}}}
{"_id": "4939b707908c5a86", "name": "L'Abolizionista", "pages": [{"_id": "c4bb825347e01b63", "name": "L'Abolizionista", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Abolizionista</em></p><p>Liberare tutti i maghi detenuti nella struttura di contenimento della regione.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 430, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Guerra", "name": "L'Abolizionista", "text": "Liberare tutti i maghi detenuti nella struttura di contenimento della regione.", "title": "L'Abolizionista"}}}}
{"_id": "89b23ef36c5137f5", "name": "Il Giudice", "pages": [{"_id": "40463aabd84879ce", "name": "Il Giudice", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Giudice</em></p><p>Trovare chi ha venduto la mia Cabala all'Unione, e processarlo davanti ai suoi pari.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 440, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Guerra", "name": "Il Giudice", "text": "Trovare chi ha venduto la mia Cabala all'Unione, e processarlo davanti ai suoi pari.", "title": "Il Giudice"}}}}
{"_id": "64882abca92cf428", "name": "Il Costruttore di Ponti", "pages": [{"_id": "516ad0d1ceaf726d", "name": "Il Costruttore di Ponti", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Costruttore di Ponti</em></p><p>Convincere un Costrutto intero a disertare. Non un agente: tutti.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 450, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Guerra", "name": "Il Costruttore di Ponti", "text": "Convincere un Costrutto intero a disertare. Non un agente: tutti.", "title": "Il Costruttore di Ponti"}}}}
{"_id": "395578af06bbcf9f", "name": "La Terza Via", "pages": [{"_id": "5e23ff5e8ce8da89", "name": "La Terza Via", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Terza Via</em></p><p>Fondare una comunità di Orfani abbastanza forte da dire no a entrambe le parti.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 460, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Guerra", "name": "La Terza Via", "text": "Fondare una comunità di Orfani abbastanza forte da dire no a entrambe le parti.", "title": "La Terza Via"}}}}
{"_id": "b2e05972326a06ff", "name": "Il Custode", "pages": [{"_id": "d67890b050e9fa27", "name": "Il Custode", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Custode</em></p><p>Difendere il Nodo della mia famiglia, conteso da tre fazioni, senza cederlo a nessuna.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 470, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Guerra", "name": "Il Custode", "text": "Difendere il Nodo della mia famiglia, conteso da tre fazioni, senza cederlo a nessuna.", "title": "Il Custode"}}}}
{"_id": "b2d76b21bce129df", "name": "La Memoria", "pages": [{"_id": "81a7407786058797", "name": "La Memoria", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Memoria</em></p><p>Documentare i crimini della guerra, di tutte le parti, perché un giorno qualcuno risponda.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 480, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Guerra", "name": "La Memoria", "text": "Documentare i crimini della guerra, di tutte le parti, perché un giorno qualcuno risponda.", "title": "La Memoria"}}}}
{"_id": "85d6c3b3fcfcd1ca", "name": "L'Ultima Missione", "pages": [{"_id": "66aab0786d2f46c3", "name": "L'Ultima Missione", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Ultima Missione</em></p><p>Completare l'operazione per cui la mia mentore è morta, e poi appendere la guerra al chiodo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 490, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Guerra", "name": "L'Ultima Missione", "text": "Completare l'operazione per cui la mia mentore è morta, e poi appendere la guerra al chiodo.", "title": "L'Ultima Missione"}}}}
{"_id": "a83dba4b6a284881", "name": "La Sala", "pages": [{"_id": "aaac8a80e3c207d9", "name": "La Sala", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Sala</em></p><p>Ottenere che il museo che mi ha rifiutato esponga la mia opera, con il mio nome sotto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 500, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Arte", "name": "La Sala", "text": "Ottenere che il museo che mi ha rifiutato esponga la mia opera, con il mio nome sotto.", "title": "La Sala", "credo": "arte"}}}}
{"_id": "3257501490da293f", "name": "Il Falso", "pages": [{"_id": "77fbb7c7dfa630c1", "name": "Il Falso", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Falso</em></p><p>Far autenticare dagli esperti che stimo un'opera che ho fatto io.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 510, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Arte", "name": "Il Falso", "text": "Far autenticare dagli esperti che stimo un'opera che ho fatto io.", "title": "Il Falso", "credo": "arte"}}}}
{"_id": "c7eb5cd2e1e2a037", "name": "L'Intonaco", "pages": [{"_id": "affa92c3a9db4f0e", "name": "L'Intonaco", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Intonaco</em></p><p>Riportare alla luce l'opera nascosta sotto l'intonaco, prima che demoliscano il muro.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 520, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Arte", "name": "L'Intonaco", "text": "Riportare alla luce l'opera nascosta sotto l'intonaco, prima che demoliscano il muro.", "title": "L'Intonaco", "credo": "arte"}}}}
{"_id": "1921ddec6a6107ca", "name": "L'Allievo", "pages": [{"_id": "6612f1b1f8c40549", "name": "L'Allievo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Allievo</em></p><p>Portare il mio allievo a superarmi, e reggere il giorno in cui succede.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 530, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Arte", "name": "L'Allievo", "text": "Portare il mio allievo a superarmi, e reggere il giorno in cui succede.", "title": "L'Allievo", "credo": "arte"}}}}
{"_id": "7f3a979e171538b0", "name": "La Cancellatura", "pages": [{"_id": "046ba75c76cf88be", "name": "La Cancellatura", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Cancellatura</em></p><p>Ritirare dal mondo tutto quello che ho firmato prima del Risveglio.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 540, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Arte", "name": "La Cancellatura", "text": "Ritirare dal mondo tutto quello che ho firmato prima del Risveglio.", "title": "La Cancellatura", "credo": "arte"}}}}
{"_id": "23bbbcee445e85c3", "name": "Il Quartiere", "pages": [{"_id": "e2fa72f11b123952", "name": "Il Quartiere", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Quartiere</em></p><p>Cambiare la faccia del mio quartiere un muro alla volta, senza che nessuno sappia chi è stato.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 550, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Arte", "name": "Il Quartiere", "text": "Cambiare la faccia del mio quartiere un muro alla volta, senza che nessuno sappia chi è stato.", "title": "Il Quartiere", "credo": "arte"}}}}
{"_id": "6332ec077924542a", "name": "Il Mazzo", "pages": [{"_id": "335d466ebab27b36", "name": "Il Mazzo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Mazzo</em></p><p>Diventare quello che nessuna fazione riesce a calcolare, e che tutte finiscono per chiamare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 560, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Caos", "name": "Il Mazzo", "text": "Diventare quello che nessuna fazione riesce a calcolare, e che tutte finiscono per chiamare.", "title": "Il Mazzo", "credo": "caos"}}}}
{"_id": "b5b961e70c5798b3", "name": "La Corrente", "pages": [{"_id": "a0f883a6e6ab33d9", "name": "La Corrente", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Corrente</em></p><p>Trovare il punto della mia città da cui parte tutto il resto, e metterci una mano.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 570, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Caos", "name": "La Corrente", "text": "Trovare il punto della mia città da cui parte tutto il resto, e metterci una mano.", "title": "La Corrente", "credo": "caos"}}}}
{"_id": "dd6493075c3ea989", "name": "Il Piano", "pages": [{"_id": "ac6d0664cc50b3bd", "name": "Il Piano", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Piano</em></p><p>Far saltare il piano decennale di una Cabala con una cosa piccola, lasciata cadere al momento giusto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 580, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Caos", "name": "Il Piano", "text": "Far saltare il piano decennale di una Cabala con una cosa piccola, lasciata cadere al momento giusto.", "title": "Il Piano", "credo": "caos"}}}}
{"_id": "2e69197001120114", "name": "Il Joker", "pages": [{"_id": "f3fa8ec8e97e0170", "name": "Il Joker", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Joker</em></p><p>Entrare nella partita che vale tutto senza essere stato invitato, e vincerla.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 590, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Caos", "name": "Il Joker", "text": "Entrare nella partita che vale tutto senza essere stato invitato, e vincerla.", "title": "Il Joker", "credo": "caos"}}}}
{"_id": "92c5bbb2a275aefc", "name": "La Gabbia", "pages": [{"_id": "3c1f35926f2346a8", "name": "La Gabbia", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Gabbia</em></p><p>Aprire la gabbia più grande che conosco, e restare a vedere cosa ne esce.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 600, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Caos", "name": "La Gabbia", "text": "Aprire la gabbia più grande che conosco, e restare a vedere cosa ne esce.", "title": "La Gabbia", "credo": "caos"}}}}
{"_id": "72f0d7649832ed3d", "name": "Il Filo", "pages": [{"_id": "4ccec3e2e2941431", "name": "Il Filo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Filo</em></p><p>Scoprire quale gesto minuscolo ha rotto la mia vita, e rifarlo al contrario.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 610, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Caos", "name": "Il Filo", "text": "Scoprire quale gesto minuscolo ha rotto la mia vita, e rifarlo al contrario.", "title": "Il Filo", "credo": "caos"}}}}
{"_id": "ed54707b6bd3848c", "name": "L'Utenza", "pages": [{"_id": "529598ab240d5ac2", "name": "L'Utenza", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Utenza</em></p><p>Ottenere un'utenza con permessi più alti di quelli con cui sono nato.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 620, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Dati", "name": "L'Utenza", "text": "Ottenere un'utenza con permessi più alti di quelli con cui sono nato.", "title": "L'Utenza", "credo": "dati"}}}}
{"_id": "49a24fb4d95eae98", "name": "Il Daemon", "pages": [{"_id": "57bee10eee626c05", "name": "Il Daemon", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Daemon</em></p><p>Terminare un processo che gira da prima del mio arrivo, o farlo rispondere.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 630, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Dati", "name": "Il Daemon", "text": "Terminare un processo che gira da prima del mio arrivo, o farlo rispondere.", "title": "Il Daemon", "credo": "dati"}}}}
{"_id": "f2a45d0f9b003fe6", "name": "La Documentazione", "pages": [{"_id": "35a6aba19f0eabe8", "name": "La Documentazione", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Documentazione</em></p><p>Scrivere la documentazione che manca, e lasciarla a chi viene dopo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 640, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Dati", "name": "La Documentazione", "text": "Scrivere la documentazione che manca, e lasciarla a chi viene dopo.", "title": "La Documentazione", "credo": "dati"}}}}
{"_id": "74741ac8c4ff0052", "name": "Il Confine", "pages": [{"_id": "6c327d72a31868e5", "name": "Il Confine", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Confine</em></p><p>Arrivare al confine della mappa, e vedere cosa c'è dove non si carica.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 650, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Dati", "name": "Il Confine", "text": "Arrivare al confine della mappa, e vedere cosa c'è dove non si carica.", "title": "Il Confine", "credo": "dati"}}}}
{"_id": "e634b267ef1d5703", "name": "Il Nodo", "pages": [{"_id": "131325bfeb78c3f8", "name": "Il Nodo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Nodo</em></p><p>Prendere il controllo di un Nodo, e decidere io chi ci scrive.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 660, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Dati", "name": "Il Nodo", "text": "Prendere il controllo di un Nodo, e decidere io chi ci scrive.", "title": "Il Nodo", "credo": "dati"}}}}
{"_id": "c509c84fc5367d5f", "name": "La Patch", "pages": [{"_id": "0ad82830906501d0", "name": "La Patch", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Patch</em></p><p>Correggere per sempre la regola scritta di fretta che ha rovinato qualcuno che conosco.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 670, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Dati", "name": "La Patch", "text": "Correggere per sempre la regola scritta di fretta che ha rovinato qualcuno che conosco.", "title": "La Patch", "credo": "dati"}}}}
{"_id": "1f097f8eeac35b34", "name": "L'Ospedale", "pages": [{"_id": "b62da6b4190a7073", "name": "L'Ospedale", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Ospedale</em></p><p>Far chiudere il reparto in cui mi hanno curato, perché non ci sono più pazienti.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 680, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Fede", "name": "L'Ospedale", "text": "Far chiudere il reparto in cui mi hanno curato, perché non ci sono più pazienti.", "title": "L'Ospedale", "credo": "fede"}}}}
{"_id": "1733ad3283338e49", "name": "Il Nemico", "pages": [{"_id": "0223124e51e80f96", "name": "Il Nemico", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Nemico</em></p><p>Portare a tavola, a casa mia, chi mi ha fatto più male di tutti.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 690, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Fede", "name": "Il Nemico", "text": "Portare a tavola, a casa mia, chi mi ha fatto più male di tutti.", "title": "Il Nemico", "credo": "fede"}}}}
{"_id": "6ed438d8bac8bb39", "name": "La Mensa", "pages": [{"_id": "0acda0f4e4aafa50", "name": "La Mensa", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Mensa</em></p><p>Aprire un posto dove chi arriva a mani vuote viene servito prima di chi paga.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 700, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Fede", "name": "La Mensa", "text": "Aprire un posto dove chi arriva a mani vuote viene servito prima di chi paga.", "title": "La Mensa", "credo": "fede"}}}}
{"_id": "fa3bd9b8cf4bd969", "name": "Il Dono", "pages": [{"_id": "3efbd8c6c1d5ea82", "name": "Il Dono", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Dono</em></p><p>Restituire la vita che mi è stata affidata al momento giusto, e capire quale.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 710, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Fede", "name": "Il Dono", "text": "Restituire la vita che mi è stata affidata al momento giusto, e capire quale.", "title": "Il Dono", "credo": "fede"}}}}
{"_id": "cce83b49d55140ff", "name": "La Prova", "pages": [{"_id": "d71467b920daff18", "name": "La Prova", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Prova</em></p><p>Arrivare disarmato in fondo alla prova che tutti dicono impossibile, e uscirne vivo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 720, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Fede", "name": "La Prova", "text": "Arrivare disarmato in fondo alla prova che tutti dicono impossibile, e uscirne vivo.", "title": "La Prova", "credo": "fede"}}}}
{"_id": "c14c042892f09101", "name": "Il Perduto", "pages": [{"_id": "2bdb3ad038a16b3d", "name": "Il Perduto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Perduto</em></p><p>Riportare a casa chi tutti hanno dato per perso, senza forzare nessuno.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 730, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Fede", "name": "Il Perduto", "text": "Riportare a casa chi tutti hanno dato per perso, senza forzare nessuno.", "title": "Il Perduto", "credo": "fede"}}}}
{"_id": "72fd96abb7cfe882", "name": "Il Muro", "pages": [{"_id": "2f5bfa2034a8a0cb", "name": "Il Muro", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Muro</em></p><p>Attraversare un muro davanti a cento persone, e che nessuna torni a crederlo solido.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 740, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Illusione", "name": "Il Muro", "text": "Attraversare un muro davanti a cento persone, e che nessuna torni a crederlo solido.", "title": "Il Muro", "credo": "illusione"}}}}
{"_id": "c3da9384fcca4eba", "name": "Il Sognatore", "pages": [{"_id": "84ff5f693ee11c2a", "name": "Il Sognatore", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Sognatore</em></p><p>Trovare chi sogna il Consenso, e parlargli.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 750, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Illusione", "name": "Il Sognatore", "text": "Trovare chi sogna il Consenso, e parlargli.", "title": "Il Sognatore", "credo": "illusione"}}}}
{"_id": "b72cb4064d8d7930", "name": "La Scuola", "pages": [{"_id": "5b437bdcf2dc2729", "name": "La Scuola", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Scuola</em></p><p>Insegnare a vedere a qualcuno, senza che se ne costruisca una stanza.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 760, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Illusione", "name": "La Scuola", "text": "Insegnare a vedere a qualcuno, senza che se ne costruisca una stanza.", "title": "La Scuola", "credo": "illusione"}}}}
{"_id": "df87a11ca7d8a567", "name": "Il Dolore", "pages": [{"_id": "435f7a68cbd9a343", "name": "Il Dolore", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Dolore</em></p><p>Smettere di credere al dolore per un anno intero, e vedere cosa resta di me.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 770, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Illusione", "name": "Il Dolore", "text": "Smettere di credere al dolore per un anno intero, e vedere cosa resta di me.", "title": "Il Dolore", "credo": "illusione"}}}}
{"_id": "356aa0885cb87950", "name": "La Stanza", "pages": [{"_id": "3c543cc9e4526fde", "name": "La Stanza", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Stanza</em></p><p>Trovare la porta della stanza in cui la mia Cabala vive senza saperlo, e aprirla.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 780, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Illusione", "name": "La Stanza", "text": "Trovare la porta della stanza in cui la mia Cabala vive senza saperlo, e aprirla.", "title": "La Stanza", "credo": "illusione"}}}}
{"_id": "4cc9f9ce1cb7378f", "name": "Il Risveglio", "pages": [{"_id": "ae6946b2a207c208", "name": "Il Risveglio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Risveglio</em></p><p>Svegliare una persona precisa dal sogno, per intero, e restarle accanto dopo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 790, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Illusione", "name": "Il Risveglio", "text": "Svegliare una persona precisa dal sogno, per intero, e restarle accanto dopo.", "title": "Il Risveglio", "credo": "illusione"}}}}
{"_id": "fcf2be28100ec2f7", "name": "La Copia", "pages": [{"_id": "76a8950833a54473", "name": "La Copia", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Copia</em></p><p>Riportare un quartiere intero a somigliare all'originale, una strada per volta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 800, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Legge", "name": "La Copia", "text": "Riportare un quartiere intero a somigliare all'originale, una strada per volta.", "title": "La Copia", "credo": "legge"}}}}
{"_id": "5cf163ccdfc647e6", "name": "Il Titolo", "pages": [{"_id": "eea29364df1ee9ec", "name": "Il Titolo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Titolo</em></p><p>Ottenere un ufficio con un nome, e vederlo riconosciuto da chi conta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 810, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Legge", "name": "Il Titolo", "text": "Ottenere un ufficio con un nome, e vederlo riconosciuto da chi conta.", "title": "Il Titolo", "credo": "legge"}}}}
{"_id": "2b13f9d3758e8414", "name": "Il Corrotto", "pages": [{"_id": "ec6aea85f6667227", "name": "Il Corrotto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Corrotto</em></p><p>Portare davanti a una corte chi conosce la legge e ha scelto di corromperla.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 820, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Legge", "name": "Il Corrotto", "text": "Portare davanti a una corte chi conosce la legge e ha scelto di corromperla.", "title": "Il Corrotto", "credo": "legge"}}}}
{"_id": "41061c0beb2e897d", "name": "L'Istanza", "pages": [{"_id": "fe1438e5eade9399", "name": "L'Istanza", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Istanza</em></p><p>Presentare un'istanza oltre il Velo, nelle forme, e ottenere risposta scritta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 830, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Legge", "name": "L'Istanza", "text": "Presentare un'istanza oltre il Velo, nelle forme, e ottenere risposta scritta.", "title": "L'Istanza", "credo": "legge"}}}}
{"_id": "0e7f73aa1855f03e", "name": "L'Archivio", "pages": [{"_id": "6a8aeddb0f335618", "name": "L'Archivio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Archivio</em></p><p>Trovare il testo della norma da cui tutte le altre traggono validità.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 840, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Legge", "name": "L'Archivio", "text": "Trovare il testo della norma da cui tutte le altre traggono validità.", "title": "L'Archivio", "credo": "legge"}}}}
{"_id": "882d1e01583b9bf9", "name": "Il Processo", "pages": [{"_id": "e2273f23c90cae5a", "name": "Il Processo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Processo</em></p><p>Istruire un processo a un Risvegliato che opera senza titolo, e arrivare a sentenza.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 850, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Legge", "name": "Il Processo", "text": "Istruire un processo a un Risvegliato che opera senza titolo, e arrivare a sentenza.", "title": "Il Processo", "credo": "legge"}}}}
{"_id": "012da5afc4597500", "name": "La Leva", "pages": [{"_id": "3c263e9aea33c6f6", "name": "La Leva", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Leva</em></p><p>Trovare la leva che sposta la mia città, e sapere di non doverla toccare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 860, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Macchina", "name": "La Leva", "text": "Trovare la leva che sposta la mia città, e sapere di non doverla toccare.", "title": "La Leva", "credo": "macchina"}}}}
{"_id": "032c39cc666e0312", "name": "Il Pezzo", "pages": [{"_id": "e96b2dd2de808761", "name": "Il Pezzo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Pezzo</em></p><p>Montare nell'impianto un componente che non era previsto da nessuna parte, e farlo girare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 870, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Macchina", "name": "Il Pezzo", "text": "Montare nell'impianto un componente che non era previsto da nessuna parte, e farlo girare.", "title": "Il Pezzo", "credo": "macchina"}}}}
{"_id": "6548648aec65e851", "name": "Il Metodo", "pages": [{"_id": "6f380b817834a7ec", "name": "Il Metodo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Metodo</em></p><p>Insegnare il metodo a qualcuno che lo seguirà passo per passo, e vedergli ottenere lo stesso risultato.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 880, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Macchina", "name": "Il Metodo", "text": "Insegnare il metodo a qualcuno che lo seguirà passo per passo, e vedergli ottenere lo stesso risultato.", "title": "Il Metodo", "credo": "macchina"}}}}
{"_id": "eef8f10a3f40afa5", "name": "Il Guasto", "pages": [{"_id": "2caa65c91a2b2930", "name": "Il Guasto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Guasto</em></p><p>Riparare quello che tutti danno per irreparabile, senza forzare niente.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 890, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Macchina", "name": "Il Guasto", "text": "Riparare quello che tutti danno per irreparabile, senza forzare niente.", "title": "Il Guasto", "credo": "macchina"}}}}
{"_id": "fc0d6fa8c4966715", "name": "La Cadenza", "pages": [{"_id": "01f5377d6f10bafe", "name": "La Cadenza", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Cadenza</em></p><p>Regolare il ritmo di un quartiere intero per un giorno, e vedere cosa va in orario.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 900, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Macchina", "name": "La Cadenza", "text": "Regolare il ritmo di un quartiere intero per un giorno, e vedere cosa va in orario.", "title": "La Cadenza", "credo": "macchina"}}}}
{"_id": "e5d8564e4389a26f", "name": "Il Progetto", "pages": [{"_id": "6fd49a46a2308a2e", "name": "Il Progetto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Progetto</em></p><p>Ricostruire pezzo per pezzo la macchina che ha rovinato la mia famiglia, e fermarla.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 910, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Macchina", "name": "Il Progetto", "text": "Ricostruire pezzo per pezzo la macchina che ha rovinato la mia famiglia, e fermarla.", "title": "Il Progetto", "credo": "macchina"}}}}
{"_id": "1797b89b00f52007", "name": "Il Tetto", "pages": [{"_id": "b8365cb1091041a9", "name": "Il Tetto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Tetto</em></p><p>Tenere in piedi la casa in cui sono cresciuto, finché non ci abita di nuovo qualcuno.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 920, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Polvere", "name": "Il Tetto", "text": "Tenere in piedi la casa in cui sono cresciuto, finché non ci abita di nuovo qualcuno.", "title": "Il Tetto", "credo": "polvere"}}}}
{"_id": "0792f4699402e569", "name": "Il Conto", "pages": [{"_id": "9c9b1a2fcf0d8b9a", "name": "Il Conto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Conto</em></p><p>Sapere quanto mi resta, e decidere cosa farne.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 930, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Polvere", "name": "Il Conto", "text": "Sapere quanto mi resta, e decidere cosa farne.", "title": "Il Conto", "credo": "polvere"}}}}
{"_id": "c717fc4dd413f627", "name": "L'Inventario", "pages": [{"_id": "cd098bb24911787d", "name": "L'Inventario", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Inventario</em></p><p>Chiudere in ordine la faccenda di una città intera, stanza per stanza, prima che cada da sola.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 940, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Polvere", "name": "L'Inventario", "text": "Chiudere in ordine la faccenda di una città intera, stanza per stanza, prima che cada da sola.", "title": "L'Inventario", "credo": "polvere"}}}}
{"_id": "43a9d095b83f82ef", "name": "Il Sostegno", "pages": [{"_id": "01d324dca95008b3", "name": "Il Sostegno", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Sostegno</em></p><p>Restare l'unico puntello di qualcuno per dieci anni, senza sfilarmi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 950, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Polvere", "name": "Il Sostegno", "text": "Restare l'unico puntello di qualcuno per dieci anni, senza sfilarmi.", "title": "Il Sostegno", "credo": "polvere"}}}}
{"_id": "b7e3548ff67dd278", "name": "La Data", "pages": [{"_id": "2f6372925db4db8f", "name": "La Data", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Data</em></p><p>Spostare la scadenza di una vita intera, e stare a vedere chi paga.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 960, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Polvere", "name": "La Data", "text": "Spostare la scadenza di una vita intera, e stare a vedere chi paga.", "title": "La Data", "credo": "polvere"}}}}
{"_id": "1a522bf41b5dc15a", "name": "La Caduta", "pages": [{"_id": "4e3e823008c18c5f", "name": "La Caduta", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Caduta</em></p><p>Far cadere nel verso giusto una cosa che crolla comunque, senza che nessuno resti sotto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 970, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Polvere", "name": "La Caduta", "text": "Far cadere nel verso giusto una cosa che crolla comunque, senza che nessuno resti sotto.", "title": "La Caduta", "credo": "polvere"}}}}
{"_id": "540594473b55b94b", "name": "Il Trono", "pages": [{"_id": "dcb22c065405a8d8", "name": "Il Trono", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Trono</em></p><p>Diventare quello che nessuna fazione della mia città può ignorare, e che nessuna comanda.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 980, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Potere", "name": "Il Trono", "text": "Diventare quello che nessuna fazione della mia città può ignorare, e che nessuna comanda.", "title": "Il Trono", "credo": "potere"}}}}
{"_id": "4fa4e1b092b5f5d8", "name": "Il Rivale", "pages": [{"_id": "ffb572d781740062", "name": "Il Rivale", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Rivale</em></p><p>Trovare l'unico che vale la pena rispettare, e batterlo davanti a testimoni.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 990, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Potere", "name": "Il Rivale", "text": "Trovare l'unico che vale la pena rispettare, e batterlo davanti a testimoni.", "title": "Il Rivale", "credo": "potere"}}}}
{"_id": "db2136d19f6538ae", "name": "La Favola", "pages": [{"_id": "246989ce3343e3d6", "name": "La Favola", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Favola</em></p><p>Strappare la storia di comodo a un forte che si vergogna della sua forza, e vedere cosa resta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1000, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Potere", "name": "La Favola", "text": "Strappare la storia di comodo a un forte che si vergogna della sua forza, e vedere cosa resta.", "title": "La Favola", "credo": "potere"}}}}
{"_id": "8767b619d1eaf8aa", "name": "Il Sonno", "pages": [{"_id": "aa1df272b4a8718e", "name": "Il Sonno", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Sonno</em></p><p>Chiudere l'unica partita che mi tiene sveglio la notte.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1010, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Potere", "name": "Il Sonno", "text": "Chiudere l'unica partita che mi tiene sveglio la notte.", "title": "Il Sonno", "credo": "potere"}}}}
{"_id": "97751101db89ebd8", "name": "La Corte", "pages": [{"_id": "f5a8ad6bae9c1fbc", "name": "La Corte", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Corte</em></p><p>Ottenere che di là qualcuno mi riceva senza doni e senza udienza.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1020, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Potere", "name": "La Corte", "text": "Ottenere che di là qualcuno mi riceva senza doni e senza udienza.", "title": "La Corte", "credo": "potere"}}}}
{"_id": "48466dee2b08e7d8", "name": "Il Padrone", "pages": [{"_id": "bc05748b7afab127", "name": "Il Padrone", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Padrone</em></p><p>Far sapere al mondo di chi è, e non doverlo più ripetere.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1030, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Potere", "name": "Il Padrone", "text": "Far sapere al mondo di chi è, e non doverlo più ripetere.", "title": "Il Padrone", "credo": "potere"}}}}
{"_id": "8f659427b1eaa3f1", "name": "Il Nome", "pages": [{"_id": "afce440b873b0f75", "name": "Il Nome", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Nome</em></p><p>Conoscere il nome di chi tiene la mia città, e sentirmi chiedere il mio.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1040, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Sacro", "name": "Il Nome", "text": "Conoscere il nome di chi tiene la mia città, e sentirmi chiedere il mio.", "title": "Il Nome", "credo": "sacro"}}}}
{"_id": "de1c8a4c4dbd9264", "name": "La Guida", "pages": [{"_id": "d6d40a2838239965", "name": "La Guida", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Guida</em></p><p>Scrivere la mappa delle giurisdizioni della città, isolato per isolato, e lasciarla a chi viene dopo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1050, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Sacro", "name": "La Guida", "text": "Scrivere la mappa delle giurisdizioni della città, isolato per isolato, e lasciarla a chi viene dopo.", "title": "La Guida", "credo": "sacro"}}}}
{"_id": "5d6e9d3bd061499f", "name": "L'Udienza", "pages": [{"_id": "25a08092d912edc2", "name": "L'Udienza", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Udienza</em></p><p>Essere ricevuto da chi presiede alla fine, e uscirne.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1060, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Sacro", "name": "L'Udienza", "text": "Essere ricevuto da chi presiede alla fine, e uscirne.", "title": "L'Udienza", "credo": "sacro"}}}}
{"_id": "af35ebbdff48df6d", "name": "Il Debito", "pages": [{"_id": "5f381f9e6e9411ce", "name": "Il Debito", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Debito</em></p><p>Saldare l'ultimo debito che ho di là, e restare in credito per una volta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1070, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Sacro", "name": "Il Debito", "text": "Saldare l'ultimo debito che ho di là, e restare in credito per una volta.", "title": "Il Debito", "credo": "sacro"}}}}
{"_id": "75281ce4d1edb818", "name": "L'Ambasciata", "pages": [{"_id": "65977652d877fd8a", "name": "L'Ambasciata", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Ambasciata</em></p><p>Far parlare due potenze che non si salutano da un secolo, e stare in mezzo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1080, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Sacro", "name": "L'Ambasciata", "text": "Far parlare due potenze che non si salutano da un secolo, e stare in mezzo.", "title": "L'Ambasciata", "credo": "sacro"}}}}
{"_id": "8303bd4e13177413", "name": "La Porta", "pages": [{"_id": "23b797c4d35b1cec", "name": "La Porta", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Porta</em></p><p>Trovare la potenza che serve chi bussa alla porta sbagliata, e ringraziarla di persona.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1090, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Sacro", "name": "La Porta", "text": "Trovare la potenza che serve chi bussa alla porta sbagliata, e ringraziarla di persona.", "title": "La Porta", "credo": "sacro"}}}}
{"_id": "375be7b6dee1d743", "name": "La Pubblicazione", "pages": [{"_id": "d385ee92ec12c8fd", "name": "La Pubblicazione", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Pubblicazione</em></p><p>Far accettare a un pari una legge che il mondo chiama magia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1100, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Scienza", "name": "La Pubblicazione", "text": "Far accettare a un pari una legge che il mondo chiama magia.", "title": "La Pubblicazione", "credo": "scienza"}}}}
{"_id": "24e4b0f9457d6364", "name": "Il Corpus", "pages": [{"_id": "93a790e041050a80", "name": "Il Corpus", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Corpus</em></p><p>Separare l'oro dal fango di una tradizione intera, e restituirglielo pulito.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1110, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Scienza", "name": "Il Corpus", "text": "Separare l'oro dal fango di una tradizione intera, e restituirglielo pulito.", "title": "Il Corpus", "credo": "scienza"}}}}
{"_id": "e0988dc792ebf83f", "name": "La Legge", "pages": [{"_id": "222776d202863126", "name": "La Legge", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Legge</em></p><p>Scrivere la legge di un fenomeno che nessuno ha ancora scritto, e vederla replicare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1120, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Scienza", "name": "La Legge", "text": "Scrivere la legge di un fenomeno che nessuno ha ancora scritto, e vederla replicare.", "title": "La Legge", "credo": "scienza"}}}}
{"_id": "e18befdc7153cfc5", "name": "L'Esperimento", "pages": [{"_id": "fe88df6b7cfc8147", "name": "L'Esperimento", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Esperimento</em></p><p>Condurre su di me l'unico esperimento senza doppio cieco, e annotarlo fino alla fine.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1130, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Scienza", "name": "L'Esperimento", "text": "Condurre su di me l'unico esperimento senza doppio cieco, e annotarlo fino alla fine.", "title": "L'Esperimento", "credo": "scienza"}}}}
{"_id": "fed98b10e95b92e2", "name": "Il Laboratorio", "pages": [{"_id": "5b53e94963df8721", "name": "Il Laboratorio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Laboratorio</em></p><p>Aprire un posto dove i Risvegliati verificano prima di credere.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1140, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Scienza", "name": "Il Laboratorio", "text": "Aprire un posto dove i Risvegliati verificano prima di credere.", "title": "Il Laboratorio", "credo": "scienza"}}}}
{"_id": "c12d04af5059fe44", "name": "La Domanda", "pages": [{"_id": "d01d4c1c03ccf33d", "name": "La Domanda", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Domanda</em></p><p>Sapere come fa a saperlo chi mi ha insegnato, e sentirmelo dire.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1150, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Scienza", "name": "La Domanda", "text": "Sapere come fa a saperlo chi mi ha insegnato, e sentirmelo dire.", "title": "La Domanda", "credo": "scienza"}}}}
{"_id": "ce07cd320cc17364", "name": "L'Orchestra", "pages": [{"_id": "7d398fa9a2e326ce", "name": "L'Orchestra", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Orchestra</em></p><p>Mettere insieme un'orchestra di Risvegliati che entra in chiave, e dirigerla una sera.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1160, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Suono", "name": "L'Orchestra", "text": "Mettere insieme un'orchestra di Risvegliati che entra in chiave, e dirigerla una sera.", "title": "L'Orchestra", "credo": "suono"}}}}
{"_id": "1cdc32c458b913c5", "name": "Il Pezzo", "pages": [{"_id": "d96a415c878c915e", "name": "Il Pezzo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Pezzo</em></p><p>Scrivere una parte nel pezzo che il mondo suona, e sentirla ripresa da chi non mi conosce.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1170, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Suono", "name": "Il Pezzo", "text": "Scrivere una parte nel pezzo che il mondo suona, e sentirla ripresa da chi non mi conosce.", "title": "Il Pezzo", "credo": "suono"}}}}
{"_id": "bd195ab84c0f4a13", "name": "La Platea", "pages": [{"_id": "1011d01da929b962", "name": "La Platea", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Platea</em></p><p>Farmi sentire da chi non si è mai voltato quando parlavo, e che resti ad ascoltare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1180, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Suono", "name": "La Platea", "text": "Farmi sentire da chi non si è mai voltato quando parlavo, e che resti ad ascoltare.", "title": "La Platea", "credo": "suono"}}}}
{"_id": "2385e3125886d28a", "name": "L'Eco", "pages": [{"_id": "f40486b9e37c9b17", "name": "L'Eco", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Eco</em></p><p>Sentire l'eco rispondere con una voce che non è la mia, e sapere di chi è.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1190, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Suono", "name": "L'Eco", "text": "Sentire l'eco rispondere con una voce che non è la mia, e sapere di chi è.", "title": "L'Eco", "credo": "suono"}}}}
{"_id": "58c4d28c943e580a", "name": "La Frequenza", "pages": [{"_id": "56ef07a19ce50144", "name": "La Frequenza", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Frequenza</em></p><p>Trovare il posto della città che nessuno ha mai chiamato con la frequenza giusta, e farlo rispondere.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1200, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Suono", "name": "La Frequenza", "text": "Trovare il posto della città che nessuno ha mai chiamato con la frequenza giusta, e farlo rispondere.", "title": "La Frequenza", "credo": "suono"}}}}
{"_id": "321d262bce1d99b6", "name": "La Chiave", "pages": [{"_id": "48f1e0ad2ad31fb3", "name": "La Chiave", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Chiave</em></p><p>Far entrare in chiave chi ha rovinato il pezzo per anni, il mio nemico compreso.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1210, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Suono", "name": "La Chiave", "text": "Far entrare in chiave chi ha rovinato il pezzo per anni, il mio nemico compreso.", "title": "La Chiave", "credo": "suono"}}}}
{"_id": "32729123b6f58afe", "name": "La Città", "pages": [{"_id": "517297bbfbd87d13", "name": "La Città", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Città</em></p><p>Guarire il punto malato della mia città che genera spiriti come sintomi, e vederli smettere.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1220, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Vivo", "name": "La Città", "text": "Guarire il punto malato della mia città che genera spiriti come sintomi, e vederli smettere.", "title": "La Città", "credo": "vivo"}}}}
{"_id": "68604769cac7e8d3", "name": "La Vena", "pages": [{"_id": "df34b62fbfa3df86", "name": "La Vena", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Vena</em></p><p>Trovare un Nodo prosciugato e riaprirgli la vena.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1230, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Vivo", "name": "La Vena", "text": "Trovare un Nodo prosciugato e riaprirgli la vena.", "title": "La Vena", "credo": "vivo"}}}}
{"_id": "79eaa274ebe2cce0", "name": "Il Bosco", "pages": [{"_id": "a975b5074d1ca41a", "name": "Il Bosco", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Bosco</em></p><p>Far crescere qualcosa di vivo dove non cresce niente da cent'anni, e tornare a vederlo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1240, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Vivo", "name": "Il Bosco", "text": "Far crescere qualcosa di vivo dove non cresce niente da cent'anni, e tornare a vederlo.", "title": "Il Bosco", "credo": "vivo"}}}}
{"_id": "839cc921fb593c9d", "name": "L'Embolo", "pages": [{"_id": "cec8d4a5c0b03cdf", "name": "L'Embolo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Embolo</em></p><p>Fermare un Risvegliato che spinge il flusso nella direzione sbagliata, prima che il conto arrivi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1250, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Vivo", "name": "L'Embolo", "text": "Fermare un Risvegliato che spinge il flusso nella direzione sbagliata, prima che il conto arrivi.", "title": "L'Embolo", "credo": "vivo"}}}}
{"_id": "a85a0af3e33a3905", "name": "Il Paziente", "pages": [{"_id": "f11a029206d54fb8", "name": "Il Paziente", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Paziente</em></p><p>Guarire chi nessuno ascoltava più, e sentirmi dire che voleva vivere.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1260, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Vivo", "name": "Il Paziente", "text": "Guarire chi nessuno ascoltava più, e sentirmi dire che voleva vivere.", "title": "Il Paziente", "credo": "vivo"}}}}
{"_id": "e84edb82b1840e2b", "name": "Il Giro", "pages": [{"_id": "0bac8dfcfc1645b2", "name": "Il Giro", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Giro</em></p><p>Seguire il giro della mia città dalla sorgente al ritorno, e trovare dove si blocca.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1270, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ambizione", "group": "Tutto è Vivo", "name": "Il Giro", "text": "Seguire il giro della mia città dalla sorgente al ritorno, e trovare dove si blocca.", "title": "Il Giro", "credo": "vivo"}}}}
