{"_id": "20b7444d24b3ac08", "name": "Abbagliato", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/sensi-1.svg", "system": {"description": "<p><strong>Vista I</strong> · Sensi</p><p><em>Vedi macchie e aloni, come dopo un flash: da lontano non distingui volti né scritte.</em></p><p>−2 dadi sui tiri fisici quando miri, mentali quando cerchi o leggi.</p><p>Nasce da luce forte, sabbia o spray negli occhi, un colpo al viso. Tocca quello che passa dagli occhi: mirare, cercare, leggere, riconoscere.</p>", "bonuses": [{"source": "Abbagliato", "value": "-2", "paths": ["physical", "mental"], "displayWhenInactive": false, "activeWhen": {"check": "always", "path": "", "value": ""}}], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 0, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "abbagliato", "archivio": {"kind": "condizione", "group": "Sensi", "name": "Abbagliato", "text": "Vedi macchie e aloni, come dopo un flash: da lontano non distingui volti né scritte.", "description": "−2 dadi sui tiri fisici quando miri, mentali quando cerchi o leggi."}}}}
{"_id": "c991f5c0b09aec0c", "name": "Offuscato", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/sensi-2.svg", "system": {"description": "<p><strong>Vista II</strong> · Sensi</p><p><em>Vedi solo forme, e le persone le riconosci dalla voce. La sabbia si sciacqua; un occhio gonfio va medicato.</em></p><p>−2 dadi e difficoltà 8 sui tiri fisici quando miri, mentali quando cerchi o leggi.</p><p>Nasce da luce forte, sabbia o spray negli occhi, un colpo al viso. Tocca quello che passa dagli occhi: mirare, cercare, leggere, riconoscere.</p>", "bonuses": [{"source": "Offuscato", "value": "-2", "paths": ["physical", "mental"], "displayWhenInactive": false, "activeWhen": {"check": "always", "path": "", "value": ""}}], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 10, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "offuscato", "archivio": {"kind": "condizione", "group": "Sensi", "name": "Offuscato", "text": "Vedi solo forme, e le persone le riconosci dalla voce. La sabbia si sciacqua; un occhio gonfio va medicato.", "description": "−2 dadi e difficoltà 8 sui tiri fisici quando miri, mentali quando cerchi o leggi."}}}}
{"_id": "cbdef5bc2f37382e", "name": "Cieco", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/sensi-3.svg", "system": {"description": "<p><strong>Vista III</strong> · Sensi</p><p><em>Non vedi. Ti muovi toccando o guidato, e in mischia colpisci chi ti tocca o chi senti, a −2 e 8.</em></p><p>Falliscono i tiri fisici quando miri, mentali quando cerchi o leggi.</p><p>Nasce da luce forte, sabbia o spray negli occhi, un colpo al viso. Tocca quello che passa dagli occhi: mirare, cercare, leggere, riconoscere.</p>", "bonuses": [], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 20, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "cieco", "archivio": {"kind": "condizione", "group": "Sensi", "name": "Cieco", "text": "Non vedi. Ti muovi toccando o guidato, e in mischia colpisci chi ti tocca o chi senti, a −2 e 8.", "description": "Falliscono i tiri fisici quando miri, mentali quando cerchi o leggi."}}}}
{"_id": "40edcb96a7c4d6d3", "name": "Ovattato", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/sensi-1.svg", "system": {"description": "<p><strong>Udito I</strong> · Sensi</p><p><em>Senti come da sott'acqua.</em></p><p>−2 dadi sui tiri sociali quando segui chi parla, mentali quando ascolti.</p><p>Nasce da esplosioni, spari al chiuso, colpi alla testa. Tocca quello che passa dalle orecchie: ascoltare, accorgerti di un rumore, seguire chi parla.</p>", "bonuses": [{"source": "Ovattato", "value": "-2", "paths": ["social", "mental"], "displayWhenInactive": false, "activeWhen": {"check": "always", "path": "", "value": ""}}], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 30, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "ovattato", "archivio": {"kind": "condizione", "group": "Sensi", "name": "Ovattato", "text": "Senti come da sott'acqua.", "description": "−2 dadi sui tiri sociali quando segui chi parla, mentali quando ascolti."}}}}
{"_id": "86fc0e442732b91a", "name": "Assordato", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/sensi-2.svg", "system": {"description": "<p><strong>Udito II</strong> · Sensi</p><p><em>Senti solo un fischio: capisci chi ti parla solo se ti guarda in faccia e scandisce.</em></p><p>−2 dadi e difficoltà 8 sui tiri sociali quando segui chi parla, mentali quando ascolti.</p><p>Nasce da esplosioni, spari al chiuso, colpi alla testa. Tocca quello che passa dalle orecchie: ascoltare, accorgerti di un rumore, seguire chi parla.</p>", "bonuses": [{"source": "Assordato", "value": "-2", "paths": ["social", "mental"], "displayWhenInactive": false, "activeWhen": {"check": "always", "path": "", "value": ""}}], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 40, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "assordato", "archivio": {"kind": "condizione", "group": "Sensi", "name": "Assordato", "text": "Senti solo un fischio: capisci chi ti parla solo se ti guarda in faccia e scandisce.", "description": "−2 dadi e difficoltà 8 sui tiri sociali quando segui chi parla, mentali quando ascolti."}}}}
{"_id": "c20b38c66877ecd3", "name": "Sordo", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/sensi-3.svg", "system": {"description": "<p><strong>Udito III</strong> · Sensi</p><p><em>Non senti. Leggere le labbra o scrivere un biglietto aggirano la sordità, se il Narratore lo accetta.</em></p><p>Falliscono i tiri sociali quando segui chi parla, mentali quando ascolti.</p><p>Nasce da esplosioni, spari al chiuso, colpi alla testa. Tocca quello che passa dalle orecchie: ascoltare, accorgerti di un rumore, seguire chi parla.</p>", "bonuses": [], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 50, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "sordo", "archivio": {"kind": "condizione", "group": "Sensi", "name": "Sordo", "text": "Non senti. Leggere le labbra o scrivere un biglietto aggirano la sordità, se il Narratore lo accetta.", "description": "Falliscono i tiri sociali quando segui chi parla, mentali quando ascolti."}}}}
{"_id": "43e64de90223cc4d", "name": "Rauco", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/corpo-1.svg", "system": {"description": "<p><strong>Voce I</strong> · Corpo</p><p><em>La voce non arriva lontano e si spezza.</em></p><p>−2 dadi sui tiri sociali.</p><p>Nasce da un colpo alla gola, dal gas, da uno strangolamento, dalla Magick. Tocca quello che passa dalla voce: convincere, dare ordini, mentire, cantare.</p>", "bonuses": [{"source": "Rauco", "value": "-2", "paths": ["social"], "displayWhenInactive": false, "activeWhen": {"check": "always", "path": "", "value": ""}}], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 60, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "rauco", "archivio": {"kind": "condizione", "group": "Corpo", "name": "Rauco", "text": "La voce non arriva lontano e si spezza.", "description": "−2 dadi sui tiri sociali."}}}}
{"_id": "3aafc2c326b067d2", "name": "Afono", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/corpo-2.svg", "system": {"description": "<p><strong>Voce II</strong> · Corpo</p><p><em>Parli solo sussurrando.</em></p><p>−2 dadi e difficoltà 8 sui tiri sociali.</p><p>Nasce da un colpo alla gola, dal gas, da uno strangolamento, dalla Magick. Tocca quello che passa dalla voce: convincere, dare ordini, mentire, cantare.</p>", "bonuses": [{"source": "Afono", "value": "-2", "paths": ["social"], "displayWhenInactive": false, "activeWhen": {"check": "always", "path": "", "value": ""}}], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 70, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "afono", "archivio": {"kind": "condizione", "group": "Corpo", "name": "Afono", "text": "Parli solo sussurrando.", "description": "−2 dadi e difficoltà 8 sui tiri sociali."}}}}
{"_id": "ca7c0ac2a1dd6554", "name": "Muto", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/corpo-3.svg", "system": {"description": "<p><strong>Voce III</strong> · Corpo</p><p><em>Non esce voce. Resta quello che si fa coi gesti o per iscritto.</em></p><p>Falliscono i sociali che passano dalla voce.</p><p>Nasce da un colpo alla gola, dal gas, da uno strangolamento, dalla Magick. Tocca quello che passa dalla voce: convincere, dare ordini, mentire, cantare.</p>", "bonuses": [], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 80, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "muto", "archivio": {"kind": "condizione", "group": "Corpo", "name": "Muto", "text": "Non esce voce. Resta quello che si fa coi gesti o per iscritto.", "description": "Falliscono i sociali che passano dalla voce."}}}}
{"_id": "524c9d791743dfe9", "name": "Affannato", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/corpo-1.svg", "system": {"description": "<p><strong>Respiro I</strong> · Corpo</p><p><em>Respiri male, e ogni sforzo ti costa. Passa riprendendo fiato.</em></p><p>−2 dadi sui tiri fisici.</p><p>Nasce dallo sforzo, dal fumo, dal gas, dall'acqua. Tocca il fiato: correre, arrampicarti, lottare, ogni sforzo.</p>", "bonuses": [{"source": "Affannato", "value": "-2", "paths": ["physical"], "displayWhenInactive": false, "activeWhen": {"check": "always", "path": "", "value": ""}}], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 90, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "affannato", "archivio": {"kind": "condizione", "group": "Corpo", "name": "Affannato", "text": "Respiri male, e ogni sforzo ti costa. Passa riprendendo fiato.", "description": "−2 dadi sui tiri fisici."}}}}
{"_id": "c75c5119beacf125", "name": "Soffocato", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/corpo-2.svg", "system": {"description": "<p><strong>Respiro II</strong> · Corpo</p><p><em>L'aria non basta, e parli a fatica.</em></p><p>−2 dadi e difficoltà 8 sui tiri fisici.</p><p>Nasce dallo sforzo, dal fumo, dal gas, dall'acqua. Tocca il fiato: correre, arrampicarti, lottare, ogni sforzo.</p>", "bonuses": [{"source": "Soffocato", "value": "-2", "paths": ["physical"], "displayWhenInactive": false, "activeWhen": {"check": "always", "path": "", "value": ""}}], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 100, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "soffocato", "archivio": {"kind": "condizione", "group": "Corpo", "name": "Soffocato", "text": "L'aria non basta, e parli a fatica.", "description": "−2 dadi e difficoltà 8 sui tiri fisici."}}}}
{"_id": "b032a41e4e6ab73e", "name": "Svenuto", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/corpo-3.svg", "system": {"description": "<p><strong>Respiro III</strong> · Corpo</p><p><em>Perdi i sensi, e non agisci finché qualcuno non ti rianima o la scena non finisce.</em></p><p>Falliscono tutti i tiri: fisici, sociali, mentali.</p><p>Nasce dallo sforzo, dal fumo, dal gas, dall'acqua. Tocca il fiato: correre, arrampicarti, lottare, ogni sforzo.</p>", "bonuses": [], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 110, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "svenuto", "archivio": {"kind": "condizione", "group": "Corpo", "name": "Svenuto", "text": "Perdi i sensi, e non agisci finché qualcuno non ti rianima o la scena non finisce.", "description": "Falliscono tutti i tiri: fisici, sociali, mentali."}}}}
{"_id": "781644006cb7f2f0", "name": "Sanguinante", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/corpo-1.svg", "system": {"description": "<p><strong>Emorragia I</strong> · Corpo</p><p><em>Perdi sangue e lasci una scia che si può seguire; chi ti vede capisce che sei ferito.</em></p><p>−2 dadi sui tiri fisici.</p><p>Nasce da tagli, proiettili, morsi. Tocca il corpo intero.</p>", "bonuses": [{"source": "Sanguinante", "value": "-2", "paths": ["physical"], "displayWhenInactive": false, "activeWhen": {"check": "always", "path": "", "value": ""}}], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 120, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "sanguinante", "archivio": {"kind": "condizione", "group": "Corpo", "name": "Sanguinante", "text": "Perdi sangue e lasci una scia che si può seguire; chi ti vede capisce che sei ferito.", "description": "−2 dadi sui tiri fisici."}}}}
{"_id": "226b5d5b1e649b0e", "name": "Dissanguato", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/corpo-2.svg", "system": {"description": "<p><strong>Emorragia II</strong> · Corpo</p><p><em>Sei pallido e ti gira la testa. A fine scena segni 1 Superficiale, finché nessuno ti fascia.</em></p><p>−2 dadi e difficoltà 8 sui tiri fisici.</p><p>Nasce da tagli, proiettili, morsi. Tocca il corpo intero.</p>", "bonuses": [{"source": "Dissanguato", "value": "-2", "paths": ["physical"], "displayWhenInactive": false, "activeWhen": {"check": "always", "path": "", "value": ""}}], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 130, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "dissanguato", "archivio": {"kind": "condizione", "group": "Corpo", "name": "Dissanguato", "text": "Sei pallido e ti gira la testa. A fine scena segni 1 Superficiale, finché nessuno ti fascia.", "description": "−2 dadi e difficoltà 8 sui tiri fisici."}}}}
{"_id": "f9bed4ded4704635", "name": "Morente", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/corpo-3.svg", "system": {"description": "<p><strong>Emorragia III</strong> · Corpo</p><p><em>Ogni fine scena costa 1 Aggravato, finché qualcuno non ti cura. Il sinonimo è Svenuto.</em></p><p>Falliscono i fisici, e ogni fine scena costa 1 Aggravato.</p><p>Nasce da tagli, proiettili, morsi. Tocca il corpo intero.</p>", "bonuses": [], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 140, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "morente", "archivio": {"kind": "condizione", "group": "Corpo", "name": "Morente", "text": "Ogni fine scena costa 1 Aggravato, finché qualcuno non ti cura. Il sinonimo è Svenuto.", "description": "Falliscono i fisici, e ogni fine scena costa 1 Aggravato."}}}}
{"_id": "3839f8298e968304", "name": "Intossicato", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/corpo-1.svg", "system": {"description": "<p><strong>Avvelenamento I</strong> · Corpo</p><p><em>Nausea e sudore freddo.</em></p><p>−2 dadi sui tiri fisici e mentali.</p><p>Nasce da veleni, droghe, infezioni. Tocca il corpo e la testa.</p>", "bonuses": [{"source": "Intossicato", "value": "-2", "paths": ["physical", "mental"], "displayWhenInactive": false, "activeWhen": {"check": "always", "path": "", "value": ""}}], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 150, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "intossicato", "archivio": {"kind": "condizione", "group": "Corpo", "name": "Intossicato", "text": "Nausea e sudore freddo.", "description": "−2 dadi sui tiri fisici e mentali."}}}}
{"_id": "0201b34711a3203d", "name": "Avvelenato", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/corpo-2.svg", "system": {"description": "<p><strong>Avvelenamento II</strong> · Corpo</p><p><em>Il veleno lavora: un orologio da quattro spicchi, uno a ogni scena senza antidoto; pieno, sali al grado 3.</em></p><p>−2 dadi e difficoltà 8 sui tiri fisici e mentali.</p><p>Nasce da veleni, droghe, infezioni. Tocca il corpo e la testa.</p>", "bonuses": [{"source": "Avvelenato", "value": "-2", "paths": ["physical", "mental"], "displayWhenInactive": false, "activeWhen": {"check": "always", "path": "", "value": ""}}], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 160, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "avvelenato", "archivio": {"kind": "condizione", "group": "Corpo", "name": "Avvelenato", "text": "Il veleno lavora: un orologio da quattro spicchi, uno a ogni scena senza antidoto; pieno, sali al grado 3.", "description": "−2 dadi e difficoltà 8 sui tiri fisici e mentali."}}}}
{"_id": "9cdead7e1965dbd5", "name": "Paralizzato", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/corpo-3.svg", "system": {"description": "<p><strong>Avvelenamento III</strong> · Corpo</p><p><em>Non ti muovi e non parli, ma vedi, senti e pensi come prima. Il sinonimo è Svenuto, quando il veleno stende.</em></p><p>Falliscono i fisici, e i sociali che chiedono voce o gesti; pensi, vedi e senti come prima.</p><p>Nasce da veleni, droghe, infezioni. Tocca il corpo e la testa.</p>", "bonuses": [], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 170, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "paralizzato", "archivio": {"kind": "condizione", "group": "Corpo", "name": "Paralizzato", "text": "Non ti muovi e non parli, ma vedi, senti e pensi come prima. Il sinonimo è Svenuto, quando il veleno stende.", "description": "Falliscono i fisici, e i sociali che chiedono voce o gesti; pensi, vedi e senti come prima."}}}}
{"_id": "0dbac96d397763b3", "name": "Rotto", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/corpo-3.svg", "system": {"description": "<p><strong>Rotto III</strong> · Corpo</p><p><em>La parte rotta è fuori uso, e fallisce solo quello che senza di lei non si fa. Con la mano destra rotta falliscono sparare con quella mano, scassinare, dare un pugno; parlare, correre e guidare un'automatica no. Si cura col gesso e con le settimane, o con la Magick di Vita.</em></p><p>Falliscono i fisici che chiedono la parte rotta.</p><p>Nasce da cadute, colpi, schiacciamenti. Vale per una parte sola, e si scrive con la parte: Rotto (braccio sinistro).</p>", "bonuses": [], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 180, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "rotto", "archivio": {"kind": "condizione", "group": "Corpo", "name": "Rotto", "text": "La parte rotta è fuori uso, e fallisce solo quello che senza di lei non si fa. Con la mano destra rotta falliscono sparare con quella mano, scassinare, dare un pugno; parlare, correre e guidare un'automatica no. Si cura col gesso e con le settimane, o con la Magick di Vita.", "description": "Falliscono i fisici che chiedono la parte rotta."}}}}
{"_id": "039443cfc2200944", "name": "Intimorito", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/mente-1.svg", "system": {"description": "<p><strong>Paura I</strong> · Mente</p><p><em>Hai paura e reggi.</em></p><p>−2 dadi sui tiri fisici, sociali e mentali, finché la fonte è in scena.</p><p>Nasce da minacce, orrori, Presenze, e si scrive con la fonte: Spaventato dal Revisore. Tocca tutto quello che fai in presenza della fonte.</p>", "bonuses": [{"source": "Intimorito", "value": "-2", "paths": ["physical", "social", "mental"], "displayWhenInactive": false, "activeWhen": {"check": "always", "path": "", "value": ""}}], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 190, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "intimorito", "archivio": {"kind": "condizione", "group": "Mente", "name": "Intimorito", "text": "Hai paura e reggi.", "description": "−2 dadi sui tiri fisici, sociali e mentali, finché la fonte è in scena."}}}}
{"_id": "e06ef5d9add29357", "name": "Spaventato", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/mente-2.svg", "system": {"description": "<p><strong>Paura II</strong> · Mente</p><p><em>Hai paura e si vede, e vuoi andartene: appena puoi, ti allontani.</em></p><p>−2 dadi e difficoltà 8 sui tiri fisici, sociali e mentali, finché la fonte è in scena.</p><p>Nasce da minacce, orrori, Presenze, e si scrive con la fonte: Spaventato dal Revisore. Tocca tutto quello che fai in presenza della fonte.</p>", "bonuses": [{"source": "Spaventato", "value": "-2", "paths": ["physical", "social", "mental"], "displayWhenInactive": false, "activeWhen": {"check": "always", "path": "", "value": ""}}], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 200, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "spaventato", "archivio": {"kind": "condizione", "group": "Mente", "name": "Spaventato", "text": "Hai paura e si vede, e vuoi andartene: appena puoi, ti allontani.", "description": "−2 dadi e difficoltà 8 sui tiri fisici, sociali e mentali, finché la fonte è in scena."}}}}
{"_id": "baede35009c651fa", "name": "Terrorizzato", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/mente-3.svg", "system": {"description": "<p><strong>Paura III</strong> · Mente</p><p><em>Esci di scena. Il sinonimo è Svenuto: crolli dove sei.</em></p><p>Falliscono i tiri fisici, sociali e mentali, finché la fonte è in scena.</p><p>Nasce da minacce, orrori, Presenze, e si scrive con la fonte: Spaventato dal Revisore. Tocca tutto quello che fai in presenza della fonte.</p>", "bonuses": [], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 210, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "terrorizzato", "archivio": {"kind": "condizione", "group": "Mente", "name": "Terrorizzato", "text": "Esci di scena. Il sinonimo è Svenuto: crolli dove sei.", "description": "Falliscono i tiri fisici, sociali e mentali, finché la fonte è in scena."}}}}
{"_id": "dfc549aa3de386b2", "name": "Nervoso", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/mente-1.svg", "system": {"description": "<p><strong>Rabbia I</strong> · Mente</p><p><em>Rispondi male, e ti si legge in faccia.</em></p><p>−2 dadi sui tiri sociali.</p><p>Nasce da insulti, umiliazioni, provocazioni. Tocca il controllo di te.</p>", "bonuses": [{"source": "Nervoso", "value": "-2", "paths": ["social"], "displayWhenInactive": false, "activeWhen": {"check": "always", "path": "", "value": ""}}], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 220, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "nervoso", "archivio": {"kind": "condizione", "group": "Mente", "name": "Nervoso", "text": "Rispondi male, e ti si legge in faccia.", "description": "−2 dadi sui tiri sociali."}}}}
{"_id": "5d7b5158dd489d27", "name": "Arrabbiato", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/mente-2.svg", "system": {"description": "<p><strong>Rabbia II</strong> · Mente</p><p><em>A ogni provocazione rispondi, e ragioni peggio.</em></p><p>−2 dadi e difficoltà 8 sui tiri sociali.</p><p>Nasce da insulti, umiliazioni, provocazioni. Tocca il controllo di te.</p>", "bonuses": [{"source": "Arrabbiato", "value": "-2", "paths": ["social"], "displayWhenInactive": false, "activeWhen": {"check": "always", "path": "", "value": ""}}], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 230, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "arrabbiato", "archivio": {"kind": "condizione", "group": "Mente", "name": "Arrabbiato", "text": "A ogni provocazione rispondi, e ragioni peggio.", "description": "−2 dadi e difficoltà 8 sui tiri sociali."}}}}
{"_id": "bb172dc583ff7acc", "name": "Furioso", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/mente-3.svg", "system": {"description": "<p><strong>Rabbia III</strong> · Mente</p><p><em>Attacchi chi ti ha provocato, e non ascolti nessuno.</em></p><p>Falliscono i tiri sociali.</p><p>Nasce da insulti, umiliazioni, provocazioni. Tocca il controllo di te.</p>", "bonuses": [], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 240, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "furioso", "archivio": {"kind": "condizione", "group": "Mente", "name": "Furioso", "text": "Attacchi chi ti ha provocato, e non ascolti nessuno.", "description": "Falliscono i tiri sociali."}}}}
{"_id": "b9422a0d4fc70012", "name": "Assonnato", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/mente-1.svg", "system": {"description": "<p><strong>Sonno I</strong> · Mente</p><p><em>Le palpebre pesano e l'attenzione scappa.</em></p><p>−2 dadi sui tiri fisici e mentali.</p><p>Nasce da sedativi, notti in bianco, Magick di Mente o di Vita. Tocca la veglia.</p>", "bonuses": [{"source": "Assonnato", "value": "-2", "paths": ["physical", "mental"], "displayWhenInactive": false, "activeWhen": {"check": "always", "path": "", "value": ""}}], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 250, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "assonnato", "archivio": {"kind": "condizione", "group": "Mente", "name": "Assonnato", "text": "Le palpebre pesano e l'attenzione scappa.", "description": "−2 dadi sui tiri fisici e mentali."}}}}
{"_id": "ef46c295597a3977", "name": "Sedato", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/mente-2.svg", "system": {"description": "<p><strong>Sonno II</strong> · Mente</p><p><em>Sei lento, e la lingua si impasta.</em></p><p>−2 dadi e difficoltà 8 sui tiri fisici e mentali.</p><p>Nasce da sedativi, notti in bianco, Magick di Mente o di Vita. Tocca la veglia.</p>", "bonuses": [{"source": "Sedato", "value": "-2", "paths": ["physical", "mental"], "displayWhenInactive": false, "activeWhen": {"check": "always", "path": "", "value": ""}}], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 260, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "sedato", "archivio": {"kind": "condizione", "group": "Mente", "name": "Sedato", "text": "Sei lento, e la lingua si impasta.", "description": "−2 dadi e difficoltà 8 sui tiri fisici e mentali."}}}}
{"_id": "7310dc1fb2a92677", "name": "Addormentato", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/mente-3.svg", "system": {"description": "<p><strong>Sonno III</strong> · Mente</p><p><em>Dormi finché qualcuno non ti sveglia.</em></p><p>Non agisci: falliscono tutti i tiri.</p><p>Nasce da sedativi, notti in bianco, Magick di Mente o di Vita. Tocca la veglia.</p>", "bonuses": [], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 270, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "addormentato", "archivio": {"kind": "condizione", "group": "Mente", "name": "Addormentato", "text": "Dormi finché qualcuno non ti sveglia.", "description": "Non agisci: falliscono tutti i tiri."}}}}
{"_id": "499e6df9dc184a5b", "name": "Suggestionato", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/soprannaturale-1.svg", "system": {"description": "<p><strong>Controllo I</strong> · Soprannaturale</p><p><em>Segui l'indicazione che ti hanno dato, per lo scopo per cui te l'hanno data.</em></p><p>Nessun dado: toglie le scelte.</p><p>Nasce dalla Magick di Mente, dagli spiriti, dalle Presenze, e si scrive con chi ti tiene.</p>", "bonuses": [], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 280, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "suggestionato", "archivio": {"kind": "condizione", "group": "Soprannaturale", "name": "Suggestionato", "text": "Segui l'indicazione che ti hanno dato, per lo scopo per cui te l'hanno data.", "description": "Nessun dado: toglie le scelte."}}}}
{"_id": "ab376b16d4f0b932", "name": "Ammaliato", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/soprannaturale-2.svg", "system": {"description": "<p><strong>Controllo II</strong> · Soprannaturale</p><p><em>Non hai diritto di reazione, e sei convinto che l'idea sia tua.</em></p><p>Nessun dado: toglie le scelte.</p><p>Nasce dalla Magick di Mente, dagli spiriti, dalle Presenze, e si scrive con chi ti tiene.</p>", "bonuses": [], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 290, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "ammaliato", "archivio": {"kind": "condizione", "group": "Soprannaturale", "name": "Ammaliato", "text": "Non hai diritto di reazione, e sei convinto che l'idea sia tua.", "description": "Nessun dado: toglie le scelte."}}}}
{"_id": "3cd0d4c5537a0add", "name": "Posseduto", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/soprannaturale-3.svg", "system": {"description": "<p><strong>Controllo III</strong> · Soprannaturale</p><p><em>Il Narratore muove il tuo personaggio; tu lo giochi seguendo le sue indicazioni, senza tirare l'acqua al tuo mulino.</em></p><p>Nessun dado: toglie le scelte.</p><p>Nasce dalla Magick di Mente, dagli spiriti, dalle Presenze, e si scrive con chi ti tiene.</p>", "bonuses": [], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 300, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "posseduto", "archivio": {"kind": "condizione", "group": "Soprannaturale", "name": "Posseduto", "text": "Il Narratore muove il tuo personaggio; tu lo giochi seguendo le sue indicazioni, senza tirare l'acqua al tuo mulino.", "description": "Nessun dado: toglie le scelte."}}}}
{"_id": "c867098f95d024c4", "name": "Sfortunato", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/soprannaturale.svg", "system": {"description": "<p><strong>Sventura</strong> · Soprannaturale</p><p><em>Il caso ti gira contro.</em></p><p>Il tuo critico non scatta.</p>", "bonuses": [], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 310, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "sfortunato", "archivio": {"kind": "condizione", "group": "Soprannaturale", "name": "Sfortunato", "text": "Il caso ti gira contro.", "description": "Il tuo critico non scatta."}}}}
{"_id": "13885b716549766b", "name": "Maledetto", "type": "condition", "img": "modules/wod5e-mage/assets/icons/condizioni/soprannaturale.svg", "system": {"description": "<p><strong>Sventura</strong> · Soprannaturale</p><p><em>Le ferite non si chiudono.</em></p><p>Non guarisci in nessun modo, né col riposo né con le cure né con la Magick, finché la causa resta.</p>", "bonuses": [], "source": {"book": "M6 · Le Condizioni", "page": ""}, "effects": {}, "suppressed": false}, "effects": [], "folder": null, "sort": 320, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"condizione": "maledetto", "archivio": {"kind": "condizione", "group": "Soprannaturale", "name": "Maledetto", "text": "Le ferite non si chiudono.", "description": "Non guarisci in nessun modo, né col riposo né con le cure né con la Magick, finché la causa resta."}}}}
