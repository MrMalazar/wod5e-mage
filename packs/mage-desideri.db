{"_id": "deade11c7ca8c45f", "name": "Il perdono", "pages": [{"_id": "907159843535a758", "name": "Il perdono", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il perdono</em></p><p>Farmi perdonare dal partner per essere sparito tre giorni senza spiegazioni.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 0, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Legami", "name": "Il perdono", "text": "Farmi perdonare dal partner per essere sparito tre giorni senza spiegazioni.", "title": "Il perdono"}}}}
{"_id": "58967459eeabed85", "name": "La recita", "pages": [{"_id": "7fe76ae48b3f97c3", "name": "La recita", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La recita</em></p><p>Presenziare alla recita di mia figlia, a costo di ignorare la chiamata urgente della Cabala.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 10, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Legami", "name": "La recita", "text": "Presenziare alla recita di mia figlia, a costo di ignorare la chiamata urgente della Cabala.", "title": "La recita"}}}}
{"_id": "00230919eaa40084", "name": "Il ficcanaso", "pages": [{"_id": "718c1d46511daa19", "name": "Il ficcanaso", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il ficcanaso</em></p><p>Convincere l'amico curioso a smettere di fare domande su quella «setta» prima che si metta nei guai.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 20, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Legami", "name": "Il ficcanaso", "text": "Convincere l'amico curioso a smettere di fare domande su quella «setta» prima che si metta nei guai.", "title": "Il ficcanaso"}}}}
{"_id": "94b397901b498fe1", "name": "La giornata normale", "pages": [{"_id": "a675e6d26638d4bb", "name": "La giornata normale", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La giornata normale</em></p><p>Passare una giornata intera col mio Faro: telefoni spenti, zero Magick, nemmeno Accidentale.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 30, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Legami", "name": "La giornata normale", "text": "Passare una giornata intera col mio Faro: telefoni spenti, zero Magick, nemmeno Accidentale.", "title": "La giornata normale"}}}}
{"_id": "62c07e75ece87a0d", "name": "L'anniversario", "pages": [{"_id": "a7601be3c53ec82e", "name": "L'anniversario", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'anniversario</em></p><p>Ricordarmi dell'anniversario. Organizzare qualcosa di vero. Non usare la Mente per sembrare romantico.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 40, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Legami", "name": "L'anniversario", "text": "Ricordarmi dell'anniversario. Organizzare qualcosa di vero. Non usare la Mente per sembrare romantico.", "title": "L'anniversario"}}}}
{"_id": "79f05a14d0e42e65", "name": "La visita", "pages": [{"_id": "5b25c228df0adb3c", "name": "La visita", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La visita</em></p><p>Andare a trovare mia madre in ospizio prima che non mi riconosca più.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 50, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Legami", "name": "La visita", "text": "Andare a trovare mia madre in ospizio prima che non mi riconosca più.", "title": "La visita"}}}}
{"_id": "23221f55de8675cc", "name": "Il funerale", "pages": [{"_id": "b8498b157aaea886", "name": "Il funerale", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il funerale</em></p><p>Presenziare al funerale da Dormiente della persona che mi ha cresciuto, senza che nessuno sospetti cosa sono.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 60, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Legami", "name": "Il funerale", "text": "Presenziare al funerale da Dormiente della persona che mi ha cresciuto, senza che nessuno sospetti cosa sono.", "title": "Il funerale"}}}}
{"_id": "e9a2a899963ca000", "name": "La lettera", "pages": [{"_id": "294432de9b165046", "name": "La lettera", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La lettera</em></p><p>Rispondere alla lettera di mio fratello dopo tre anni di silenzio: a mano, senza magia, senza scuse.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 70, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Legami", "name": "La lettera", "text": "Rispondere alla lettera di mio fratello dopo tre anni di silenzio: a mano, senza magia, senza scuse.", "title": "La lettera"}}}}
{"_id": "19fd502ca8c9ed60", "name": "La consegna", "pages": [{"_id": "d314449e83718a23", "name": "La consegna", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La consegna</em></p><p>Consegnare il progetto al lavoro ed evitare il licenziamento: la copertura sociale non si paga da sola.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 80, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Denaro", "name": "La consegna", "text": "Consegnare il progetto al lavoro ed evitare il licenziamento: la copertura sociale non si paga da sola.", "title": "La consegna"}}}}
{"_id": "63f786b702be8c35", "name": "L'affitto", "pages": [{"_id": "ad75f5e9c0eceed1", "name": "L'affitto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'affitto</em></p><p>Raccogliere entro domattina i mille euro dell'affitto arretrato, o si finisce per strada.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 90, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Denaro", "name": "L'affitto", "text": "Raccogliere entro domattina i mille euro dell'affitto arretrato, o si finisce per strada.", "title": "L'affitto"}}}}
{"_id": "6b660f0d323cd978", "name": "Lo sfratto", "pages": [{"_id": "85761cfdd05035ae", "name": "Lo sfratto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Lo sfratto</em></p><p>Far sfrattare il vicino che spia nel mio appartamento, in modo del tutto legale e mondano.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 100, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Denaro", "name": "Lo sfratto", "text": "Far sfrattare il vicino che spia nel mio appartamento, in modo del tutto legale e mondano.", "title": "Lo sfratto"}}}}
{"_id": "89c2887435adc81f", "name": "Il ricambio", "pages": [{"_id": "1e130e6297356dc7", "name": "Il ricambio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il ricambio</em></p><p>Trovare quel pezzo introvabile, essenziale alla mia Forma, senza doverlo rubare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 110, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Denaro", "name": "Il ricambio", "text": "Trovare quel pezzo introvabile, essenziale alla mia Forma, senza doverlo rubare.", "title": "Il ricambio"}}}}
{"_id": "de3e5474dc820e21", "name": "Il colloquio", "pages": [{"_id": "a3bc5899bd82384d", "name": "Il colloquio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il colloquio</em></p><p>Superare il colloquio di lavoro senza toccare la mente di nessuno nella stanza.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 120, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Denaro", "name": "Il colloquio", "text": "Superare il colloquio di lavoro senza toccare la mente di nessuno nella stanza.", "title": "Il colloquio"}}}}
{"_id": "9dab1dfec74cbae5", "name": "La cartella", "pages": [{"_id": "e884f4e290949630", "name": "La cartella", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La cartella</em></p><p>Bloccare il pignoramento partito per un debito che non è nemmeno mio.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 130, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Denaro", "name": "La cartella", "text": "Bloccare il pignoramento partito per un debito che non è nemmeno mio.", "title": "La cartella"}}}}
{"_id": "3d00987dbcd1ebcc", "name": "Il turno doppio", "pages": [{"_id": "7ce0b2691dca2b51", "name": "Il turno doppio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il turno doppio</em></p><p>Reggere una settimana di turni doppi senza usare la Vita per restare in piedi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 140, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Denaro", "name": "Il turno doppio", "text": "Reggere una settimana di turni doppi senza usare la Vita per restare in piedi.", "title": "Il turno doppio"}}}}
{"_id": "c49c22b9dc69eb39", "name": "Il cliente", "pages": [{"_id": "279ac22c715b6ad8", "name": "Il cliente", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il cliente</em></p><p>Recuperare il cliente che vale metà del mio fatturato e che qualcuno sta corteggiando.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 150, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Denaro", "name": "Il cliente", "text": "Recuperare il cliente che vale metà del mio fatturato e che qualcuno sta corteggiando.", "title": "Il cliente"}}}}
{"_id": "260845622de3ddfb", "name": "Il telefono", "pages": [{"_id": "e92fcd97ff3d0a21", "name": "Il telefono", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il telefono</em></p><p>Recuperare il telefono smarrito sul taxi: dentro ci sono le foto di un rituale.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 160, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Segreti", "name": "Il telefono", "text": "Recuperare il telefono smarrito sul taxi: dentro ci sono le foto di un rituale.", "title": "Il telefono"}}}}
{"_id": "0309364d4a36bbee", "name": "L'alibi", "pages": [{"_id": "e42ad215bd1d6176", "name": "L'alibi", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'alibi</em></p><p>Costruire un alibi di ferro per la notte in cui il mio furgone era sulla scena della sparatoria.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 170, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Segreti", "name": "L'alibi", "text": "Costruire un alibi di ferro per la notte in cui il mio furgone era sulla scena della sparatoria.", "title": "L'alibi"}}}}
{"_id": "cd220141e6a4607e", "name": "Le ustioni", "pages": [{"_id": "e2713acff78cd73b", "name": "Le ustioni", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Le ustioni</em></p><p>Nascondere le Ustioni da Paradosso sulle braccia ai colleghi e al medico di famiglia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 180, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Segreti", "name": "Le ustioni", "text": "Nascondere le Ustioni da Paradosso sulle braccia ai colleghi e al medico di famiglia.", "title": "Le ustioni"}}}}
{"_id": "238d42a4e0f31e79", "name": "I filmati", "pages": [{"_id": "fed79362a897bfbf", "name": "I filmati", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>I filmati</em></p><p>Tornare sul luogo dell'incantesimo Volgare di ieri sera e cancellare le registrazioni.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 190, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Segreti", "name": "I filmati", "text": "Tornare sul luogo dell'incantesimo Volgare di ieri sera e cancellare le registrazioni.", "title": "I filmati"}}}}
{"_id": "a722c342f1d0149c", "name": "Il testimone", "pages": [{"_id": "9d38bcd56de654ae", "name": "Il testimone", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il testimone</em></p><p>Scoprire cosa ha visto davvero il ragazzino del terzo piano, e sistemarla senza toccarlo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 200, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Segreti", "name": "Il testimone", "text": "Scoprire cosa ha visto davvero il ragazzino del terzo piano, e sistemarla senza toccarlo.", "title": "Il testimone"}}}}
{"_id": "99632b5a98dc794f", "name": "Il registro", "pages": [{"_id": "8b5a56f4893f0509", "name": "Il registro", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il registro</em></p><p>Far sparire il mio nome dal registro presenze della notte sbagliata, senza Corrispondenza.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 210, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Segreti", "name": "Il registro", "text": "Far sparire il mio nome dal registro presenze della notte sbagliata, senza Corrispondenza.", "title": "Il registro"}}}}
{"_id": "01caade6dbefbfa3", "name": "La perizia", "pages": [{"_id": "46ed8f4d977339f7", "name": "La perizia", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La perizia</em></p><p>Superare la visita psichiatrica ordinata dal tribunale parlando la loro lingua, non la mia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 220, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Segreti", "name": "La perizia", "text": "Superare la visita psichiatrica ordinata dal tribunale parlando la loro lingua, non la mia.", "title": "La perizia"}}}}
{"_id": "ec82d437e9342e8d", "name": "Il curioso", "pages": [{"_id": "9db712f48c28e746", "name": "Il curioso", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il curioso</em></p><p>Depistare il blogger del paranormale che ha piazzato il mio ritratto nel suo ultimo video.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 230, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Segreti", "name": "Il curioso", "text": "Depistare il blogger del paranormale che ha piazzato il mio ritratto nel suo ultimo video.", "title": "Il curioso"}}}}
{"_id": "3c701995224d24a2", "name": "La serata", "pages": [{"_id": "dfffe2f17a8b9e4f", "name": "La serata", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La serata</em></p><p>Prendermi una serata al pub, da solo, ignorando la Guerra dell'Ascensione per qualche ora.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 240, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Vizi", "name": "La serata", "text": "Prendermi una serata al pub, da solo, ignorando la Guerra dell'Ascensione per qualche ora.", "title": "La serata"}}}}
{"_id": "77ec32903c98f069", "name": "Il vizio", "pages": [{"_id": "75113841b82f3427", "name": "Il vizio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il vizio</em></p><p>Trovare una dose del mio vizio per calmare i nervi prima dell'incontro con l'Anziano.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 250, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Vizi", "name": "Il vizio", "text": "Trovare una dose del mio vizio per calmare i nervi prima dell'incontro con l'Anziano.", "title": "Il vizio"}}}}
{"_id": "9188371fa44c87ee", "name": "L'accendino", "pages": [{"_id": "20b7406731fdd995", "name": "L'accendino", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'accendino</em></p><p>Rintracciare il ladruncolo dello zaino: dei soldi non m'importa, rivoglio l'accendino del nonno.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 260, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Vizi", "name": "L'accendino", "text": "Rintracciare il ladruncolo dello zaino: dei soldi non m'importa, rivoglio l'accendino del nonno.", "title": "L'accendino"}}}}
{"_id": "a0256efe792db2ea", "name": "Il brivido", "pages": [{"_id": "962de9a35263f842", "name": "Il brivido", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il brivido</em></p><p>Cercare un brivido mondano (una corsa clandestina, una scommessa) senza toccare le Sfere.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 270, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Vizi", "name": "Il brivido", "text": "Cercare un brivido mondano (una corsa clandestina, una scommessa) senza toccare le Sfere.", "title": "Il brivido"}}}}
{"_id": "1c73717acb03632d", "name": "La partita", "pages": [{"_id": "a018c93d0acad768", "name": "La partita", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La partita</em></p><p>Vincere il torneo del circolo. Da Dormiente. Perché sono bravo davvero.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 280, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Vizi", "name": "La partita", "text": "Vincere il torneo del circolo. Da Dormiente. Perché sono bravo davvero.", "title": "La partita"}}}}
{"_id": "ef9513b21050093d", "name": "La cena", "pages": [{"_id": "cd5691b67638bd9c", "name": "La cena", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La cena</em></p><p>Cucinare la cena perfetta per otto persone che non sanno niente di me, e godermela.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 290, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Vizi", "name": "La cena", "text": "Cucinare la cena perfetta per otto persone che non sanno niente di me, e godermela.", "title": "La cena"}}}}
{"_id": "43715d63f2e0ec20", "name": "Lo sfogo", "pages": [{"_id": "59b56ed5d8d99053", "name": "Lo sfogo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Lo sfogo</em></p><p>Trovare un luogo isolato (o usare il Primordio) per scaricare la Ruota prima che il Contraccolpo scatti da solo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 300, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Magick", "name": "Lo sfogo", "text": "Trovare un luogo isolato (o usare il Primordio) per scaricare la Ruota prima che il Contraccolpo scatti da solo.", "title": "Lo sfogo"}}}}
{"_id": "86c3ce6c7e0ca2af", "name": "Lo Strumento", "pages": [{"_id": "3b656a085ddf9e5b", "name": "Lo Strumento", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Lo Strumento</em></p><p>Ritrovare lo Strumento perso o confiscato, senza il quale ogni lancio costa Volontà.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 310, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Magick", "name": "Lo Strumento", "text": "Ritrovare lo Strumento perso o confiscato, senza il quale ogni lancio costa Volontà.", "title": "Lo Strumento"}}}}
{"_id": "8a8e47958d1662f4", "name": "Il pieno", "pages": [{"_id": "13425ea1e0a5bfaa", "name": "Il pieno", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il pieno</em></p><p>Accedere a un Nodo per assorbire la Quintessenza che serve a curare un'Ustione o alimentare una Meraviglia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 320, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Magick", "name": "Il pieno", "text": "Accedere a un Nodo per assorbire la Quintessenza che serve a curare un'Ustione o alimentare una Meraviglia.", "title": "Il pieno"}}}}
{"_id": "45ab2b361e86f9e4", "name": "Le tracce", "pages": [{"_id": "8d6e1c1fd4b63209", "name": "Le tracce", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Le tracce</em></p><p>Cancellare ogni Eco dello scontro mistico di ieri, prima che qualcuno ne segua la scia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 330, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Magick", "name": "Le tracce", "text": "Cancellare ogni Eco dello scontro mistico di ieri, prima che qualcuno ne segua la scia.", "title": "Le tracce"}}}}
{"_id": "f89bd7355663e41f", "name": "La prima volta", "pages": [{"_id": "458ffdb6cef62718", "name": "La prima volta", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La prima volta</em></p><p>Lanciare con successo il primo incantesimo del livello di Sfera appena appreso, in una situazione vera.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 340, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Magick", "name": "La prima volta", "text": "Lanciare con successo il primo incantesimo del livello di Sfera appena appreso, in una situazione vera.", "title": "La prima volta"}}}}
{"_id": "556a73a6340f5a96", "name": "Il collaudo", "pages": [{"_id": "6683ccbbf7676e63", "name": "Il collaudo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il collaudo</em></p><p>Testare la Meraviglia appena costruita lontano da occhi, telecamere e sfortuna.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 350, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Magick", "name": "Il collaudo", "text": "Testare la Meraviglia appena costruita lontano da occhi, telecamere e sfortuna.", "title": "Il collaudo"}}}}
{"_id": "b057e8ca4cad0b89", "name": "La scorta", "pages": [{"_id": "0bc53b136b8b9d52", "name": "La scorta", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La scorta</em></p><p>Rimpiazzare i componenti rituali sequestrati alla dogana prima del plenilunio.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 360, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Magick", "name": "La scorta", "text": "Rimpiazzare i componenti rituali sequestrati alla dogana prima del plenilunio.", "title": "La scorta"}}}}
{"_id": "59625840fb1d9dc9", "name": "Il maestro di riserva", "pages": [{"_id": "e989112a8ed4734e", "name": "Il maestro di riserva", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il maestro di riserva</em></p><p>Convincere un mago che mi detesta a insegnarmi la tecnica che il mio Mentore rifiuta di mostrarmi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 370, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Magick", "name": "Il maestro di riserva", "text": "Convincere un mago che mi detesta a insegnarmi la tecnica che il mio Mentore rifiuta di mostrarmi.", "title": "Il maestro di riserva"}}}}
{"_id": "ec6ee677473a273a", "name": "L'infiltrazione", "pages": [{"_id": "9c30b3c9b7f4fbdc", "name": "L'infiltrazione", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'infiltrazione</em></p><p>Entrare in un Costrutto della Tecnocrazia e uscirne con informazioni sui loro movimenti.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 380, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Guerra", "name": "L'infiltrazione", "text": "Entrare in un Costrutto della Tecnocrazia e uscirne con informazioni sui loro movimenti.", "title": "L'infiltrazione"}}}}
{"_id": "53f1423be874d7f0", "name": "Il Certámen", "pages": [{"_id": "10f68ef5b644dcb4", "name": "Il Certámen", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Certámen</em></p><p>Sconfiggere un rivale in Certámen e chiudere la disputa senza sangue.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 390, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Guerra", "name": "Il Certámen", "text": "Sconfiggere un rivale in Certámen e chiudere la disputa senza sangue.", "title": "Il Certámen"}}}}
{"_id": "06b25fa8f7803a6e", "name": "L'interruzione", "pages": [{"_id": "b76bdf9c1e165bd3", "name": "L'interruzione", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'interruzione</em></p><p>Fermare il rituale della fazione avversaria prima che raggiunga il culmine.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 400, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Guerra", "name": "L'interruzione", "text": "Fermare il rituale della fazione avversaria prima che raggiunga il culmine.", "title": "L'interruzione"}}}}
{"_id": "c3950127c6ff2adb", "name": "La talpa", "pages": [{"_id": "c80f85be2867d002", "name": "La talpa", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La talpa</em></p><p>Scoprire chi, nella mia Cabala, passa informazioni al Nuovo Ordine Mondiale.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 410, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Guerra", "name": "La talpa", "text": "Scoprire chi, nella mia Cabala, passa informazioni al Nuovo Ordine Mondiale.", "title": "La talpa"}}}}
{"_id": "edddd0f78570d28c", "name": "Gli Orfani", "pages": [{"_id": "05f6c0dad65e8528", "name": "Gli Orfani", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Gli Orfani</em></p><p>Convincere gli Orfani della città a combattere con noi per una sola notte.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 420, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Guerra", "name": "Gli Orfani", "text": "Convincere gli Orfani della città a combattere con noi per una sola notte.", "title": "Gli Orfani"}}}}
{"_id": "57a63404108d4104", "name": "Lo scambio", "pages": [{"_id": "a6bc8a7f2e7bbc38", "name": "Lo scambio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Lo scambio</em></p><p>Recuperare il nostro contatto catturato prima che parli, o trattare il prezzo del silenzio.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 430, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Guerra", "name": "Lo scambio", "text": "Recuperare il nostro contatto catturato prima che parli, o trattare il prezzo del silenzio.", "title": "Lo scambio"}}}}
{"_id": "cab535c54704d653", "name": "Il messaggio", "pages": [{"_id": "23b970ce17fe8d95", "name": "Il messaggio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il messaggio</em></p><p>Far arrivare un avvertimento a un agente dell'Unione che, forse, sta per disertare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 440, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Guerra", "name": "Il messaggio", "text": "Far arrivare un avvertimento a un agente dell'Unione che, forse, sta per disertare.", "title": "Il messaggio"}}}}
{"_id": "8664ee04943b668f", "name": "La ritirata", "pages": [{"_id": "134c911c76631401", "name": "La ritirata", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La ritirata</em></p><p>Evacuare il rifugio compromesso spostando tre persone e un Nodo portatile in dodici ore.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 450, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Guerra", "name": "La ritirata", "text": "Evacuare il rifugio compromesso spostando tre persone e un Nodo portatile in dodici ore.", "title": "La ritirata"}}}}
{"_id": "da6d9e25211950f9", "name": "L'incubo", "pages": [{"_id": "b702ea40dfe4c142", "name": "L'incubo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'incubo</em></p><p>Meditare (o assumere ciò che va assunto) per decifrare l'incubo che il mio Avatar mi manda da tre notti.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 460, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Avatar", "name": "L'incubo", "text": "Meditare (o assumere ciò che va assunto) per decifrare l'incubo che il mio Avatar mi manda da tre notti.", "title": "L'incubo"}}}}
{"_id": "55fd8634587f4183", "name": "Il Primer", "pages": [{"_id": "d9a09bba67507a98", "name": "Il Primer", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Primer</em></p><p>Piazzare un Primer sul cammino di quella mortale brillante, e vedere se si sveglia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 470, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Avatar", "name": "Il Primer", "text": "Piazzare un Primer sul cammino di quella mortale brillante, e vedere se si sveglia.", "title": "Il Primer"}}}}
{"_id": "7ea37cdd14f4eff3", "name": "La Penumbra", "pages": [{"_id": "9f57758a029c1198", "name": "La Penumbra", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Penumbra</em></p><p>Assottigliare il Velo e passare dall'altra parte per interrogare un'entità precisa.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 480, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Avatar", "name": "La Penumbra", "text": "Assottigliare il Velo e passare dall'altra parte per interrogare un'entità precisa.", "title": "La Penumbra"}}}}
{"_id": "3f58ef3957cd5d82", "name": "L'epifania", "pages": [{"_id": "e61b4ced4257a60b", "name": "L'epifania", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'epifania</em></p><p>Superare il Punto di Rottura che sento arrivare: trovare la risposta prima che il Silenzio trovi me.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 490, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Avatar", "name": "L'epifania", "text": "Superare il Punto di Rottura che sento arrivare: trovare la risposta prima che il Silenzio trovi me.", "title": "L'epifania"}}}}
{"_id": "6fb6e6b7cc263039", "name": "Il pellegrinaggio", "pages": [{"_id": "32ffc43e8d79364d", "name": "Il pellegrinaggio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il pellegrinaggio</em></p><p>Raggiungere il luogo del mio Risveglio nell'anniversario esatto: l'Avatar insiste, e non dice perché.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 500, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Avatar", "name": "Il pellegrinaggio", "text": "Raggiungere il luogo del mio Risveglio nell'anniversario esatto: l'Avatar insiste, e non dice perché.", "title": "Il pellegrinaggio"}}}}
{"_id": "648f09b5d795f666", "name": "Il debito", "pages": [{"_id": "7e963fd41f5dcddf", "name": "Il debito", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il debito</em></p><p>Ripagare lo spirito che mi ha fatto un favore, prima che decida da solo la valuta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 510, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Avatar", "name": "Il debito", "text": "Ripagare lo spirito che mi ha fatto un favore, prima che decida da solo la valuta.", "title": "Il debito"}}}}
{"_id": "7274c526adacbd81", "name": "La consegna", "pages": [{"_id": "3fdfe4a69db3febe", "name": "La consegna", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La consegna</em></p><p>Consegnare venerdì il lavoro promesso senza toccarlo con la Magick.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 520, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Arte", "name": "La consegna", "text": "Consegnare venerdì il lavoro promesso senza toccarlo con la Magick.", "title": "La consegna", "credo": "arte"}}}}
{"_id": "5d384abddd55e320", "name": "Lo Scatto", "pages": [{"_id": "37d7807874145e80", "name": "Lo Scatto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Lo Scatto</em></p><p>Tornare in quel punto all'ora esatta in cui la luce era giusta, e questa volta averci dietro gli strumenti.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 530, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Arte", "name": "Lo Scatto", "text": "Tornare in quel punto all'ora esatta in cui la luce era giusta, e questa volta averci dietro gli strumenti.", "title": "Lo Scatto", "credo": "arte"}}}}
{"_id": "7cfcf49a1ecbb45c", "name": "Il vernissage", "pages": [{"_id": "9fe97231e82542be", "name": "Il vernissage", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il vernissage</em></p><p>Farmi invitare all'inaugurazione da cui mi hanno escluso, e restarci fino alla fine.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 540, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Arte", "name": "Il vernissage", "text": "Farmi invitare all'inaugurazione da cui mi hanno escluso, e restarci fino alla fine.", "title": "Il vernissage", "credo": "arte"}}}}
{"_id": "577a9155faa05270", "name": "Il giudizio", "pages": [{"_id": "6958d0643d5f2214", "name": "Il giudizio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il giudizio</em></p><p>Sentirmi dire da chi stimo che l'ultima cosa che ho fatto vale qualcosa, senza avergliela chiesta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 550, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Arte", "name": "Il giudizio", "text": "Sentirmi dire da chi stimo che l'ultima cosa che ho fatto vale qualcosa, senza avergliela chiesta.", "title": "Il giudizio", "credo": "arte"}}}}
{"_id": "3489a427f80bd47a", "name": "Il pigmento", "pages": [{"_id": "47fc1eb2e71207b6", "name": "Il pigmento", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il pigmento</em></p><p>Procurarmi entro stanotte il colore che non si produce più, senza rubarlo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 560, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Arte", "name": "Il pigmento", "text": "Procurarmi entro stanotte il colore che non si produce più, senza rubarlo.", "title": "Il pigmento", "credo": "arte"}}}}
{"_id": "8b79c74768edde95", "name": "Il rifacimento", "pages": [{"_id": "6be0d08e283c391c", "name": "Il rifacimento", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il rifacimento</em></p><p>Rifare da capo il pezzo che ho già consegnato, e riprendermelo prima che lo appendano.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 570, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Arte", "name": "Il rifacimento", "text": "Rifare da capo il pezzo che ho già consegnato, e riprendermelo prima che lo appendano.", "title": "Il rifacimento", "credo": "arte"}}}}
{"_id": "05d894dc44bae755", "name": "La Strada Sbagliata", "pages": [{"_id": "47acf6c085e355b7", "name": "La Strada Sbagliata", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Strada Sbagliata</em></p><p>Arrivare stasera dove devo andare prendendo solo strade che non conosco.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 580, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Caos", "name": "La Strada Sbagliata", "text": "Arrivare stasera dove devo andare prendendo solo strade che non conosco.", "title": "La Strada Sbagliata", "credo": "caos"}}}}
{"_id": "6ac4755097c77252", "name": "Il Freno", "pages": [{"_id": "93d5f9f583551bfa", "name": "Il Freno", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Freno</em></p><p>Fermare la coda che si sta formando otto chilometri più avanti, senza che nessuno sappia perché.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 590, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Caos", "name": "Il Freno", "text": "Fermare la coda che si sta formando otto chilometri più avanti, senza che nessuno sappia perché.", "title": "Il Freno", "credo": "caos"}}}}
{"_id": "0dfb265527087650", "name": "Il Primo", "pages": [{"_id": "f5d0ea837881b1a6", "name": "Il Primo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Primo</em></p><p>Essere quello che si alza per primo nella sala, e vedere chi lo segue.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 600, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Caos", "name": "Il Primo", "text": "Essere quello che si alza per primo nella sala, e vedere chi lo segue.", "title": "Il Primo", "credo": "caos"}}}}
{"_id": "8115c84d0d2ce484", "name": "La Moneta", "pages": [{"_id": "47f6541d48ae772c", "name": "La Moneta", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Moneta</em></p><p>Decidere una cosa grossa col lancio di una moneta, e tenermi l'esito.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 610, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Caos", "name": "La Moneta", "text": "Decidere una cosa grossa col lancio di una moneta, e tenermi l'esito.", "title": "La Moneta", "credo": "caos"}}}}
{"_id": "0c2ee37e7e944ee3", "name": "L'Imprevisto", "pages": [{"_id": "fdc4ab304116ae96", "name": "L'Imprevisto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Imprevisto</em></p><p>Mandare per aria una serata organizzata da mesi con una cosa che non costa niente.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 620, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Caos", "name": "L'Imprevisto", "text": "Mandare per aria una serata organizzata da mesi con una cosa che non costa niente.", "title": "L'Imprevisto", "credo": "caos"}}}}
{"_id": "ed8387bbbd58558c", "name": "La Partita", "pages": [{"_id": "e223e217fd659f90", "name": "La Partita", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Partita</em></p><p>Sedermi a un tavolo di gente che ha un piano, e sciogliere il piano prima del dolce.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 630, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Caos", "name": "La Partita", "text": "Sedermi a un tavolo di gente che ha un piano, e sciogliere il piano prima del dolce.", "title": "La Partita", "credo": "caos"}}}}
{"_id": "0a74da4bbd01d84f", "name": "La Scorciatoia", "pages": [{"_id": "ef971a33c562cc04", "name": "La Scorciatoia", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Scorciatoia</em></p><p>Finire stanotte una cosa da tre giorni, saltando tutto quello che si può.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 640, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Dati", "name": "La Scorciatoia", "text": "Finire stanotte una cosa da tre giorni, saltando tutto quello che si può.", "title": "La Scorciatoia", "credo": "dati"}}}}
{"_id": "947b21ae7b27fde5", "name": "Il Buco", "pages": [{"_id": "1c2e144c10c2a21f", "name": "Il Buco", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Buco</em></p><p>Trovare il punto in cui questa regola è stata scritta di fretta, e passarci.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 650, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Dati", "name": "Il Buco", "text": "Trovare il punto in cui questa regola è stata scritta di fretta, e passarci.", "title": "Il Buco", "credo": "dati"}}}}
{"_id": "1746f566abbc87eb", "name": "Il Replay", "pages": [{"_id": "6a16174c4b3721c9", "name": "Il Replay", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Replay</em></p><p>Rivedere il fotogramma di ieri sera e sapere cosa c'era nella stanza.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 660, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Dati", "name": "Il Replay", "text": "Rivedere il fotogramma di ieri sera e sapere cosa c'era nella stanza.", "title": "Il Replay", "credo": "dati"}}}}
{"_id": "a1ce5468b0a4e533", "name": "L'Accesso", "pages": [{"_id": "0f236339bfb13022", "name": "L'Accesso", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Accesso</em></p><p>Entrare in un archivio senza permessi, senza lasciare la richiesta scritta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 670, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Dati", "name": "L'Accesso", "text": "Entrare in un archivio senza permessi, senza lasciare la richiesta scritta.", "title": "L'Accesso", "credo": "dati"}}}}
{"_id": "e6f5a1ff9bc92fdc", "name": "Il Parametro", "pages": [{"_id": "8137d0ca9bad59f5", "name": "Il Parametro", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Parametro</em></p><p>Cambiare un solo parametro a chi mi sta ostacolando, e vedere cosa succede.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 680, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Dati", "name": "Il Parametro", "text": "Cambiare un solo parametro a chi mi sta ostacolando, e vedere cosa succede.", "title": "Il Parametro", "credo": "dati"}}}}
{"_id": "cf7b0ef3f8feb498", "name": "La Partita", "pages": [{"_id": "51d89c6ca9de096e", "name": "La Partita", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Partita</em></p><p>Riaprire una faccenda che tutti hanno archiviato la settimana scorsa.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 690, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Dati", "name": "La Partita", "text": "Riaprire una faccenda che tutti hanno archiviato la settimana scorsa.", "title": "La Partita", "credo": "dati"}}}}
{"_id": "7215b755e5317017", "name": "Il Salto", "pages": [{"_id": "3168267182f288ec", "name": "Il Salto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Salto</em></p><p>Prendere stasera la via che chiede di affidarsi, con quello che ho in mano.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 700, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Fede", "name": "Il Salto", "text": "Prendere stasera la via che chiede di affidarsi, con quello che ho in mano.", "title": "Il Salto", "credo": "fede"}}}}
{"_id": "eb84c5c2fbe1f2c3", "name": "La Visita", "pages": [{"_id": "3ea1623578a72d1f", "name": "La Visita", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Visita</em></p><p>Andare da chi mi ha mentito prima che venga a scusarsi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 710, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Fede", "name": "La Visita", "text": "Andare da chi mi ha mentito prima che venga a scusarsi.", "title": "La Visita", "credo": "fede"}}}}
{"_id": "7ec1eff0ea165151", "name": "Il Sì", "pages": [{"_id": "628d546820873ee8", "name": "Il Sì", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Sì</em></p><p>Dire di sì a chi mi chiede aiuto mentre sto già facendo un'altra cosa che conta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 720, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Fede", "name": "Il Sì", "text": "Dire di sì a chi mi chiede aiuto mentre sto già facendo un'altra cosa che conta.", "title": "Il Sì", "credo": "fede"}}}}
{"_id": "c79b2a5e32b5d588", "name": "L'Attesa", "pages": [{"_id": "4e9f7eea15273dab", "name": "L'Attesa", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Attesa</em></p><p>Aspettare una risposta che non arriva, senza spingerla.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 730, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Fede", "name": "L'Attesa", "text": "Aspettare una risposta che non arriva, senza spingerla.", "title": "L'Attesa", "credo": "fede"}}}}
{"_id": "39959b3239d57e12", "name": "La Difesa", "pages": [{"_id": "bfa54c686be2a9bc", "name": "La Difesa", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Difesa</em></p><p>Entrare disarmato dove tutti mi dicono di portare qualcosa.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 740, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Fede", "name": "La Difesa", "text": "Entrare disarmato dove tutti mi dicono di portare qualcosa.", "title": "La Difesa", "credo": "fede"}}}}
{"_id": "95608213723fa8b6", "name": "Il Grazie", "pages": [{"_id": "4f923cc7a0c833f8", "name": "Il Grazie", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Grazie</em></p><p>Ringraziare ad alta voce per una cosa che è andata storta, e intenderlo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 750, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Fede", "name": "Il Grazie", "text": "Ringraziare ad alta voce per una cosa che è andata storta, e intenderlo.", "title": "Il Grazie", "credo": "fede"}}}}
{"_id": "cbe291306f45aad8", "name": "Il Gesto", "pages": [{"_id": "755f35213640823d", "name": "Il Gesto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Gesto</em></p><p>Fare stasera il gesto impossibile davanti a chiunque ci sia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 760, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Illusione", "name": "Il Gesto", "text": "Fare stasera il gesto impossibile davanti a chiunque ci sia.", "title": "Il Gesto", "credo": "illusione"}}}}
{"_id": "2eb4a6c233f372b3", "name": "Il Fondale", "pages": [{"_id": "94f8d48ac27ae1f0", "name": "Il Fondale", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Fondale</em></p><p>Passare una porta chiusa che tutti stanno rispettando, e non voltarmi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 770, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Illusione", "name": "Il Fondale", "text": "Passare una porta chiusa che tutti stanno rispettando, e non voltarmi.", "title": "Il Fondale", "credo": "illusione"}}}}
{"_id": "06c8392788383c9b", "name": "Il Sonno", "pages": [{"_id": "e413fe4c408122da", "name": "Il Sonno", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Sonno</em></p><p>Dormire una notte senza sognare, o almeno senza ricordarmelo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 780, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Illusione", "name": "Il Sonno", "text": "Dormire una notte senza sognare, o almeno senza ricordarmelo.", "title": "Il Sonno", "credo": "illusione"}}}}
{"_id": "26cab75a4b96fb3c", "name": "La Prova", "pages": [{"_id": "111bba17746a8101", "name": "La Prova", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Prova</em></p><p>Mettere alla prova una cosa che oggi mi ha sorpreso, prima che finisca la giornata.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 790, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Illusione", "name": "La Prova", "text": "Mettere alla prova una cosa che oggi mi ha sorpreso, prima che finisca la giornata.", "title": "La Prova", "credo": "illusione"}}}}
{"_id": "def09b24e4004beb", "name": "La Sveglia", "pages": [{"_id": "bb88638b23890f8f", "name": "La Sveglia", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Sveglia</em></p><p>Spiegare a chi sta male che sta sognando, e restare finché non mi ascolta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 800, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Illusione", "name": "La Sveglia", "text": "Spiegare a chi sta male che sta sognando, e restare finché non mi ascolta.", "title": "La Sveglia", "credo": "illusione"}}}}
{"_id": "7736af88cfd90089", "name": "L'Uscita", "pages": [{"_id": "e9c5dd43fa1a0cc7", "name": "L'Uscita", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Uscita</em></p><p>Trovare l'uscita da un limite che oggi non ha ceduto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 810, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Illusione", "name": "L'Uscita", "text": "Trovare l'uscita da un limite che oggi non ha ceduto.", "title": "L'Uscita", "credo": "illusione"}}}}
{"_id": "1533347a28a94e30", "name": "Il Passaggio", "pages": [{"_id": "d445d1bff2de609a", "name": "Il Passaggio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Passaggio</em></p><p>Fare stasera tutta la procedura, anche il passaggio che nessuno controlla.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 820, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Legge", "name": "Il Passaggio", "text": "Fare stasera tutta la procedura, anche il passaggio che nessuno controlla.", "title": "Il Passaggio", "credo": "legge"}}}}
{"_id": "cfcf556c670e9543", "name": "La Contestazione", "pages": [{"_id": "62ca70f6fc82769f", "name": "La Contestazione", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Contestazione</em></p><p>Chiedere conto e titolo a chi sta violando qualcosa davanti a me, adesso.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 830, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Legge", "name": "La Contestazione", "text": "Chiedere conto e titolo a chi sta violando qualcosa davanti a me, adesso.", "title": "La Contestazione", "credo": "legge"}}}}
{"_id": "e90555b0802cef0e", "name": "Il Termine", "pages": [{"_id": "84ea47cc906b1162", "name": "Il Termine", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Termine</em></p><p>Far rispettare una scadenza a chi contava sulla proroga.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 840, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Legge", "name": "Il Termine", "text": "Far rispettare una scadenza a chi contava sulla proroga.", "title": "Il Termine", "credo": "legge"}}}}
{"_id": "c475be32c96f8da5", "name": "Il Verbale", "pages": [{"_id": "daea222d779b608d", "name": "Il Verbale", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Verbale</em></p><p>Mettere per iscritto quello che è successo stanotte, prima che qualcuno lo racconti diverso.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 850, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Legge", "name": "Il Verbale", "text": "Mettere per iscritto quello che è successo stanotte, prima che qualcuno lo racconti diverso.", "title": "Il Verbale", "credo": "legge"}}}}
{"_id": "3870caa790500b58", "name": "Il Confine", "pages": [{"_id": "0cc9057e17c0bd72", "name": "Il Confine", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Confine</em></p><p>Ripristinare un confine che qualcuno ha spostato di un metro, e farlo valere.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 860, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Legge", "name": "Il Confine", "text": "Ripristinare un confine che qualcuno ha spostato di un metro, e farlo valere.", "title": "Il Confine", "credo": "legge"}}}}
{"_id": "ac73b022aebcf279", "name": "La Fila", "pages": [{"_id": "7ddef98ea5029fe7", "name": "La Fila", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Fila</em></p><p>Rimettere in fila chi è passato davanti, senza alzare la voce.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 870, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Legge", "name": "La Fila", "text": "Rimettere in fila chi è passato davanti, senza alzare la voce.", "title": "La Fila", "credo": "legge"}}}}
{"_id": "016c32edbd53526a", "name": "Il Perché", "pages": [{"_id": "8fe6529d95f405e7", "name": "Il Perché", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Perché</em></p><p>Capire stasera perché quella cosa funziona, prima di occuparmi d'altro.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 880, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Macchina", "name": "Il Perché", "text": "Capire stasera perché quella cosa funziona, prima di occuparmi d'altro.", "title": "Il Perché", "credo": "macchina"}}}}
{"_id": "2a016cd937b9a4f7", "name": "La Consegna", "pages": [{"_id": "7e2024acacc03dbd", "name": "La Consegna", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Consegna</em></p><p>Rifiutare una consegna fatta in fretta, mia o d'altri, e rifarla bene.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 890, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Macchina", "name": "La Consegna", "text": "Rifiutare una consegna fatta in fretta, mia o d'altri, e rifarla bene.", "title": "La Consegna", "credo": "macchina"}}}}
{"_id": "e36e18e89b4531ab", "name": "La Vite", "pages": [{"_id": "07efe30b4d982d71", "name": "La Vite", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Vite</em></p><p>Trovare la vite di registro di una persona nervosa, e girarla di poco.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 900, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Macchina", "name": "La Vite", "text": "Trovare la vite di registro di una persona nervosa, e girarla di poco.", "title": "La Vite", "credo": "macchina"}}}}
{"_id": "44d803ca724353ac", "name": "Il Ricambio", "pages": [{"_id": "261febd21ca93c7a", "name": "Il Ricambio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Ricambio</em></p><p>Sostituire un pezzo che non rende, anche se aveva un nome.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 910, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Macchina", "name": "Il Ricambio", "text": "Sostituire un pezzo che non rende, anche se aveva un nome.", "title": "Il Ricambio", "credo": "macchina"}}}}
{"_id": "71ead5ae7213f265", "name": "Il Secondo", "pages": [{"_id": "a28b5b80d26be9c0", "name": "Il Secondo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Secondo</em></p><p>Tenere il tempo esatto per tutto un incontro, e arrivare io a decidere quanto dura.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 920, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Macchina", "name": "Il Secondo", "text": "Tenere il tempo esatto per tutto un incontro, e arrivare io a decidere quanto dura.", "title": "Il Secondo", "credo": "macchina"}}}}
{"_id": "3ea67fdd20b87f98", "name": "L'Attrito", "pages": [{"_id": "3b8f3c78adea1cec", "name": "L'Attrito", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Attrito</em></p><p>Togliere l'attrito da una faccenda che si è inceppata fra due persone.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 930, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Macchina", "name": "L'Attrito", "text": "Togliere l'attrito da una faccenda che si è inceppata fra due persone.", "title": "L'Attrito", "credo": "macchina"}}}}
{"_id": "ea1e55cca84044f8", "name": "La Trave", "pages": [{"_id": "cda7bd9e81f4d0e4", "name": "La Trave", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Trave</em></p><p>Sapere entro stanotte quanto resta al solaio sotto cui dormono gli altri.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 940, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Polvere", "name": "La Trave", "text": "Sapere entro stanotte quanto resta al solaio sotto cui dormono gli altri.", "title": "La Trave", "credo": "polvere"}}}}
{"_id": "9f6e56cd50d7edef", "name": "Il Puntello", "pages": [{"_id": "4ff29f4969918702", "name": "Il Puntello", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Puntello</em></p><p>Mettere una mano sotto una cosa che sta cedendo, e restarci.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 950, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Polvere", "name": "Il Puntello", "text": "Mettere una mano sotto una cosa che sta cedendo, e restarci.", "title": "Il Puntello", "credo": "polvere"}}}}
{"_id": "c300e41e04168722", "name": "La Scatola", "pages": [{"_id": "d6e8b0540a00a93c", "name": "La Scatola", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Scatola</em></p><p>Portarmi via da una casa svuotata la sola cosa che qualcuno ha stretto per quarant'anni.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 960, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Polvere", "name": "La Scatola", "text": "Portarmi via da una casa svuotata la sola cosa che qualcuno ha stretto per quarant'anni.", "title": "La Scatola", "credo": "polvere"}}}}
{"_id": "a16d81f41913f6a1", "name": "Il No", "pages": [{"_id": "d7a950a8a8d5bb14", "name": "Il No", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il No</em></p><p>Dire di no a chi mi chiede di prolungare oltre il termine, e reggere la faccia che fa.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 970, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Polvere", "name": "Il No", "text": "Dire di no a chi mi chiede di prolungare oltre il termine, e reggere la faccia che fa.", "title": "Il No", "credo": "polvere"}}}}
{"_id": "b78d13eb1a3e21af", "name": "La Proroga", "pages": [{"_id": "2e0f773d1a48739f", "name": "La Proroga", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Proroga</em></p><p>Comprare a qualcuno un giorno in più, sapendo chi lo paga.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 980, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Polvere", "name": "La Proroga", "text": "Comprare a qualcuno un giorno in più, sapendo chi lo paga.", "title": "La Proroga", "credo": "polvere"}}}}
{"_id": "c3a2a131553337a6", "name": "Il Guasto", "pages": [{"_id": "fcf84fb237ad37bc", "name": "Il Guasto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Guasto</em></p><p>Far cedere una cosa dove era già logora, e che nessuno gridi al miracolo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 990, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Polvere", "name": "Il Guasto", "text": "Far cedere una cosa dove era già logora, e che nessuno gridi al miracolo.", "title": "Il Guasto", "credo": "polvere"}}}}
{"_id": "701777bb11a0a286", "name": "La Rivincita", "pages": [{"_id": "90b827f72e92e404", "name": "La Rivincita", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Rivincita</em></p><p>Pareggiare oggi il conto perso in pubblico, quando tutti l'avevano dimenticato.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1000, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Potere", "name": "La Rivincita", "text": "Pareggiare oggi il conto perso in pubblico, quando tutti l'avevano dimenticato.", "title": "La Rivincita", "credo": "potere"}}}}
{"_id": "7fe5c5edf2fc5c2d", "name": "La Stanza", "pages": [{"_id": "b5af493acc53d82d", "name": "La Stanza", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Stanza</em></p><p>Entrare in un gruppo che ha già un capo e farglielo sentire prima di sedermi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1010, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Potere", "name": "La Stanza", "text": "Entrare in un gruppo che ha già un capo e farglielo sentire prima di sedermi.", "title": "La Stanza", "credo": "potere"}}}}
{"_id": "d12091a62f579e07", "name": "La Sfida", "pages": [{"_id": "83c2a7cd4b3c0843", "name": "La Sfida", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Sfida</em></p><p>Accettare la sfida di stasera e rilanciare, qualunque sia la posta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1020, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Potere", "name": "La Sfida", "text": "Accettare la sfida di stasera e rilanciare, qualunque sia la posta.", "title": "La Sfida", "credo": "potere"}}}}
{"_id": "1eccaf7ee4eb753b", "name": "Il Passo", "pages": [{"_id": "bb5226ce7c31d02e", "name": "Il Passo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Passo</em></p><p>Passare davanti a chi era in fila da prima, e che nessuno protesti.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1030, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Potere", "name": "Il Passo", "text": "Passare davanti a chi era in fila da prima, e che nessuno protesti.", "title": "Il Passo", "credo": "potere"}}}}
{"_id": "4e17b9e0cb382965", "name": "Il Rifiuto", "pages": [{"_id": "5d98e9517018b11e", "name": "Il Rifiuto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Rifiuto</em></p><p>Cavarmela da solo in una cosa in cui chiedere aiuto era la mossa ovvia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1040, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Potere", "name": "Il Rifiuto", "text": "Cavarmela da solo in una cosa in cui chiedere aiuto era la mossa ovvia.", "title": "Il Rifiuto", "credo": "potere"}}}}
{"_id": "3e2351472fa150ad", "name": "Lo Sguardo", "pages": [{"_id": "3712247e376737b1", "name": "Lo Sguardo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Lo Sguardo</em></p><p>Farmi vedere dove passare inosservato mi avrebbe dato quello che volevo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1050, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Potere", "name": "Lo Sguardo", "text": "Farmi vedere dove passare inosservato mi avrebbe dato quello che volevo.", "title": "Lo Sguardo", "credo": "potere"}}}}
{"_id": "6fee4d45bea1b9f5", "name": "Il Saluto", "pages": [{"_id": "10f3cbe1da877a22", "name": "Il Saluto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Saluto</em></p><p>Salutare chi veglia su ogni posto nuovo in cui entro oggi, davanti a chiunque.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1060, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Sacro", "name": "Il Saluto", "text": "Salutare chi veglia su ogni posto nuovo in cui entro oggi, davanti a chiunque.", "title": "Il Saluto", "credo": "sacro"}}}}
{"_id": "fdbedc272e5060da", "name": "Il Pegno", "pages": [{"_id": "d87ddf00a8acada6", "name": "Il Pegno", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Pegno</em></p><p>Lasciare il pegno giusto a chi mi ha aiutato stanotte, prima che me lo chieda.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1070, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Sacro", "name": "Il Pegno", "text": "Lasciare il pegno giusto a chi mi ha aiutato stanotte, prima che me lo chieda.", "title": "Il Pegno", "credo": "sacro"}}}}
{"_id": "ac8af75017eca17b", "name": "Il Rito", "pages": [{"_id": "d216b97742c8c501", "name": "Il Rito", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Rito</em></p><p>Compiere per intero il rito dovuto mentre tutti mi aspettano fuori.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1080, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Sacro", "name": "Il Rito", "text": "Compiere per intero il rito dovuto mentre tutti mi aspettano fuori.", "title": "Il Rito", "credo": "sacro"}}}}
{"_id": "415a8569ee0fdd9c", "name": "L'Indirizzo", "pages": [{"_id": "04cb21133be22883", "name": "L'Indirizzo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Indirizzo</em></p><p>Capire a chi rivolgermi per il problema di stasera, prima di parlare con chiunque.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1090, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Sacro", "name": "L'Indirizzo", "text": "Capire a chi rivolgermi per il problema di stasera, prima di parlare con chiunque.", "title": "L'Indirizzo", "credo": "sacro"}}}}
{"_id": "b787a9e60ea177b5", "name": "La Voce", "pages": [{"_id": "5ff61d1b59769423", "name": "La Voce", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Voce</em></p><p>Rispondere a chi mi parla da oltre il Velo, dovunque io sia e con chiunque stia parlando.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1100, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Sacro", "name": "La Voce", "text": "Rispondere a chi mi parla da oltre il Velo, dovunque io sia e con chiunque stia parlando.", "title": "La Voce", "credo": "sacro"}}}}
{"_id": "37e8df6b8f1c8e80", "name": "La Cortesia", "pages": [{"_id": "0be98b57140d7c3a", "name": "La Cortesia", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Cortesia</em></p><p>Far passare un Risvegliato che ha sbagliato indirizzo, senza che lo sappia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1110, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Sacro", "name": "La Cortesia", "text": "Far passare un Risvegliato che ha sbagliato indirizzo, senza che lo sappia.", "title": "La Cortesia", "credo": "sacro"}}}}
{"_id": "4fad48df1c2d512f", "name": "La Fonte", "pages": [{"_id": "319b3fb89dce7b1a", "name": "La Fonte", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Fonte</em></p><p>Farmi dire da chi afferma come fa a saperlo, prima che cambi discorso.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1120, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Scienza", "name": "La Fonte", "text": "Farmi dire da chi afferma come fa a saperlo, prima che cambi discorso.", "title": "La Fonte", "credo": "scienza"}}}}
{"_id": "8cc2f9d1ff905784", "name": "Il Campione", "pages": [{"_id": "23eb7ce18e762ef2", "name": "Il Campione", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Campione</em></p><p>Portarmi via stanotte un pezzo del fenomeno nuovo, qualunque cosa succeda.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1130, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Scienza", "name": "Il Campione", "text": "Portarmi via stanotte un pezzo del fenomeno nuovo, qualunque cosa succeda.", "title": "Il Campione", "credo": "scienza"}}}}
{"_id": "a665053e3f4aea77", "name": "Il Quaderno", "pages": [{"_id": "c33f8a9869fc1fc5", "name": "Il Quaderno", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Quaderno</em></p><p>Annotare luogo, ora, condizioni e nomi di stasera, prima di dormire.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1140, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Scienza", "name": "Il Quaderno", "text": "Annotare luogo, ora, condizioni e nomi di stasera, prima di dormire.", "title": "Il Quaderno", "credo": "scienza"}}}}
{"_id": "6e3cd4637c9211b4", "name": "La Misura", "pages": [{"_id": "b380f9089a9deb7f", "name": "La Misura", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Misura</em></p><p>Lasciar compiere quello che si sta svolgendo davanti a me, e registrarlo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1150, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Scienza", "name": "La Misura", "text": "Lasciar compiere quello che si sta svolgendo davanti a me, e registrarlo.", "title": "La Misura", "credo": "scienza"}}}}
{"_id": "ef9bea41d4338f99", "name": "La Replica", "pages": [{"_id": "d8eef7b0ac46afc6", "name": "La Replica", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Replica</em></p><p>Rifare domani nelle stesse condizioni quello che oggi ha funzionato una volta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1160, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Scienza", "name": "La Replica", "text": "Rifare domani nelle stesse condizioni quello che oggi ha funzionato una volta.", "title": "La Replica", "credo": "scienza"}}}}
{"_id": "f134365b64a98a0c", "name": "L'Errore", "pages": [{"_id": "d28d1e5861dd0856", "name": "L'Errore", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Errore</em></p><p>Trovare dove un collega ha sbagliato, e dirglielo con la fonte in mano.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1170, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Scienza", "name": "L'Errore", "text": "Trovare dove un collega ha sbagliato, e dirglielo con la fonte in mano.", "title": "L'Errore", "credo": "scienza"}}}}
{"_id": "6adeee4e53827f66", "name": "L'Attacco", "pages": [{"_id": "2451b9004b37fd85", "name": "L'Attacco", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'Attacco</em></p><p>Entrare stasera nel pezzo esattamente in chiave, davanti a chi non se lo aspetta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1180, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Suono", "name": "L'Attacco", "text": "Entrare stasera nel pezzo esattamente in chiave, davanti a chi non se lo aspetta.", "title": "L'Attacco", "credo": "suono"}}}}
{"_id": "91ae51b93b1f5767", "name": "Il Volume", "pages": [{"_id": "51c1f97ca21d7698", "name": "Il Volume", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Volume</em></p><p>Farmi sentire da chi non si è mosso, senza toccare il volume di una persona.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1190, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Suono", "name": "Il Volume", "text": "Farmi sentire da chi non si è mosso, senza toccare il volume di una persona.", "title": "Il Volume", "credo": "suono"}}}}
{"_id": "073bd6ebcd4ea548", "name": "Le Otto Battute", "pages": [{"_id": "ac9de019657ac1d1", "name": "Le Otto Battute", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Le Otto Battute</em></p><p>Restare zitto per otto battute quando me lo chiedono, e tenere la parte lo stesso.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1200, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Suono", "name": "Le Otto Battute", "text": "Restare zitto per otto battute quando me lo chiedono, e tenere la parte lo stesso.", "title": "Le Otto Battute", "credo": "suono"}}}}
{"_id": "d43d038b4286fe93", "name": "La Coda", "pages": [{"_id": "8d4bbb74aa10393e", "name": "La Coda", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Coda</em></p><p>Allungare la coda di una cosa che vorrei trattenere, per una sera sola.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1210, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Suono", "name": "La Coda", "text": "Allungare la coda di una cosa che vorrei trattenere, per una sera sola.", "title": "La Coda", "credo": "suono"}}}}
{"_id": "2f22c0fe6eb32bb5", "name": "La Frequenza", "pages": [{"_id": "b95fec1f03178dde", "name": "La Frequenza", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Frequenza</em></p><p>Trovare la frequenza che manda in pezzi il muro di stasera, e non usarla.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1220, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Suono", "name": "La Frequenza", "text": "Trovare la frequenza che manda in pezzi il muro di stasera, e non usarla.", "title": "La Frequenza", "credo": "suono"}}}}
{"_id": "20bc5a6c7f0704d4", "name": "Il Ritornello", "pages": [{"_id": "6c6d3c1f48731e61", "name": "Il Ritornello", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Ritornello</em></p><p>Mettere in testa a una persona la canzone giusta prima che apra bocca.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1230, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Suono", "name": "Il Ritornello", "text": "Mettere in testa a una persona la canzone giusta prima che apra bocca.", "title": "Il Ritornello", "credo": "suono"}}}}
{"_id": "93303c5b30ef4e60", "name": "La Compagnia", "pages": [{"_id": "8d33c213364d6742", "name": "La Compagnia", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Compagnia</em></p><p>Cercare stasera compagnia anche se restare fuori era la mossa giusta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1240, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Vivo", "name": "La Compagnia", "text": "Cercare stasera compagnia anche se restare fuori era la mossa giusta.", "title": "La Compagnia", "credo": "vivo"}}}}
{"_id": "e82e618bec1270e8", "name": "Il Male", "pages": [{"_id": "ee534c03e592371b", "name": "Il Male", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Male</em></p><p>Occuparmi del male di chi mi sta accanto, anche se mi hanno chiesto di restare fuori.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1250, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Vivo", "name": "Il Male", "text": "Occuparmi del male di chi mi sta accanto, anche se mi hanno chiesto di restare fuori.", "title": "Il Male", "credo": "vivo"}}}}
{"_id": "c2823097dd36f67c", "name": "Il Seme", "pages": [{"_id": "1c3cda340672622a", "name": "Il Seme", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Seme</em></p><p>Lasciare qualcosa di vivo nel posto più morto in cui passo oggi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1260, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Vivo", "name": "Il Seme", "text": "Lasciare qualcosa di vivo nel posto più morto in cui passo oggi.", "title": "Il Seme", "credo": "vivo"}}}}
{"_id": "b64df425deb384fe", "name": "La Fase", "pages": [{"_id": "6f223992414b7b39", "name": "La Fase", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Fase</em></p><p>Agire nella fase giusta del respiro della città, anche se costa aspettare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1270, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Vivo", "name": "La Fase", "text": "Agire nella fase giusta del respiro della città, anche se costa aspettare.", "title": "La Fase", "credo": "vivo"}}}}
{"_id": "4b1aad89e932b912", "name": "La Vena", "pages": [{"_id": "2280632bfa729dc1", "name": "La Vena", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Vena</em></p><p>Mettere io la vita che manca, prima di aver finito di pensarci.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1280, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Vivo", "name": "La Vena", "text": "Mettere io la vita che manca, prima di aver finito di pensarci.", "title": "La Vena", "credo": "vivo"}}}}
{"_id": "4cdc4df50712c1da", "name": "Il Blocco", "pages": [{"_id": "a563d5b9418796b1", "name": "Il Blocco", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Blocco</em></p><p>Trovare il punto in cui il giro di questa casa è bloccato, e liberarlo prima di andarmene.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1290, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Vivo", "name": "Il Blocco", "text": "Trovare il punto in cui il giro di questa casa è bloccato, e liberarlo prima di andarmene.", "title": "Il Blocco", "credo": "vivo"}}}}
