{"_id": "deade11c7ca8c45f", "name": "Il perdono", "pages": [{"_id": "907159843535a758", "name": "Il perdono", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il perdono</em></p><p>Ottenere il perdono dalla mia Ancora. Prima che finisca la storia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 0, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Legami", "name": "Il perdono", "text": "Ottenere il perdono dalla mia Ancora. Prima che finisca la storia.", "title": "Il perdono"}}}}
{"_id": "12b1bdd20fbf0265", "name": "L'appuntamento", "pages": [{"_id": "ec6c80f176f99aa1", "name": "L'appuntamento", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'appuntamento</em></p><p>Esserci, per una volta, il giorno che conta per la mia Ancora, anche se la Cabala mi chiama altrove.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 10, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Legami", "name": "L'appuntamento", "text": "Esserci, per una volta, il giorno che conta per la mia Ancora, anche se la Cabala mi chiama altrove.", "title": "L'appuntamento"}}}}
{"_id": "00230919eaa40084", "name": "Il ficcanaso", "pages": [{"_id": "718c1d46511daa19", "name": "Il ficcanaso", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il ficcanaso</em></p><p>Far smettere l'amico curioso di fare domande, con le parole e basta, prima che vada a chiedere in giro.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 20, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Legami", "name": "Il ficcanaso", "text": "Far smettere l'amico curioso di fare domande, con le parole e basta, prima che vada a chiedere in giro.", "title": "Il ficcanaso"}}}}
{"_id": "94b397901b498fe1", "name": "La giornata normale", "pages": [{"_id": "a675e6d26638d4bb", "name": "La giornata normale", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La giornata normale</em></p><p>Passare una giornata intera con la mia Ancora senza Magick e senza telefono, entro questa storia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 30, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Legami", "name": "La giornata normale", "text": "Passare una giornata intera con la mia Ancora senza Magick e senza telefono, entro questa storia.", "title": "La giornata normale"}}}}
{"_id": "62c07e75ece87a0d", "name": "L'anniversario", "pages": [{"_id": "a7601be3c53ec82e", "name": "L'anniversario", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'anniversario</em></p><p>Arrivare in tempo alla data che conta per lei, con qualcosa fatto con le mie mani.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 40, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Legami", "name": "L'anniversario", "text": "Arrivare in tempo alla data che conta per lei, con qualcosa fatto con le mie mani.", "title": "L'anniversario"}}}}
{"_id": "79f05a14d0e42e65", "name": "La visita", "pages": [{"_id": "5b25c228df0adb3c", "name": "La visita", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La visita</em></p><p>Andare a trovare chi mi ha cresciuto entro la prossima sessione, finché mi riconosce ancora.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 50, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Legami", "name": "La visita", "text": "Andare a trovare chi mi ha cresciuto entro la prossima sessione, finché mi riconosce ancora.", "title": "La visita"}}}}
{"_id": "23221f55de8675cc", "name": "Il funerale", "pages": [{"_id": "b8498b157aaea886", "name": "Il funerale", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il funerale</em></p><p>Salutare chi ho perso, da Dormiente, senza che nessuno sospetti cosa sono.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 60, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Legami", "name": "Il funerale", "text": "Salutare chi ho perso, da Dormiente, senza che nessuno sospetti cosa sono.", "title": "Il funerale"}}}}
{"_id": "e9a2a899963ca000", "name": "La lettera", "pages": [{"_id": "294432de9b165046", "name": "La lettera", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La lettera</em></p><p>Rispondere entro stasera alla lettera che rimando da anni, a mano, niente scuse.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 70, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Legami", "name": "La lettera", "text": "Rispondere entro stasera alla lettera che rimando da anni, a mano, niente scuse.", "title": "La lettera"}}}}
{"_id": "19fd502ca8c9ed60", "name": "La consegna", "pages": [{"_id": "d314449e83718a23", "name": "La consegna", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La consegna</em></p><p>Consegnare il lavoro entro la scadenza senza toccarlo con la Magick.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 80, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Denaro", "name": "La consegna", "text": "Consegnare il lavoro entro la scadenza senza toccarlo con la Magick.", "title": "La consegna"}}}}
{"_id": "63f786b702be8c35", "name": "L'affitto", "pages": [{"_id": "ad75f5e9c0eceed1", "name": "L'affitto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'affitto</em></p><p>Trovare i soldi dell'affitto arretrato. Prima che scada.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 90, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Denaro", "name": "L'affitto", "text": "Trovare i soldi dell'affitto arretrato. Prima che scada.", "title": "L'affitto"}}}}
{"_id": "6b660f0d323cd978", "name": "Lo sfratto", "pages": [{"_id": "85761cfdd05035ae", "name": "Lo sfratto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Lo sfratto</em></p><p>Liberarmi per vie legali del vicino che mi spia, entro la fine della storia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 100, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Denaro", "name": "Lo sfratto", "text": "Liberarmi per vie legali del vicino che mi spia, entro la fine della storia.", "title": "Lo sfratto"}}}}
{"_id": "89c2887435adc81f", "name": "Il ricambio", "pages": [{"_id": "1e130e6297356dc7", "name": "Il ricambio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il ricambio</em></p><p>Procurarmi il pezzo che mi serve per lanciare senza rubarlo, prima della prossima scena.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 110, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Denaro", "name": "Il ricambio", "text": "Procurarmi il pezzo che mi serve per lanciare senza rubarlo, prima della prossima scena.", "title": "Il ricambio"}}}}
{"_id": "de3e5474dc820e21", "name": "Il colloquio", "pages": [{"_id": "a3bc5899bd82384d", "name": "Il colloquio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il colloquio</em></p><p>Superare il colloquio di domani senza toccare la mente di nessuno.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 120, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Denaro", "name": "Il colloquio", "text": "Superare il colloquio di domani senza toccare la mente di nessuno.", "title": "Il colloquio"}}}}
{"_id": "9dab1dfec74cbae5", "name": "La cartella", "pages": [{"_id": "e884f4e290949630", "name": "La cartella", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La cartella</em></p><p>Bloccare entro la settimana il pignoramento per un debito che non è mio.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 130, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Denaro", "name": "La cartella", "text": "Bloccare entro la settimana il pignoramento per un debito che non è mio.", "title": "La cartella"}}}}
{"_id": "3d00987dbcd1ebcc", "name": "Il turno doppio", "pages": [{"_id": "7ce0b2691dca2b51", "name": "Il turno doppio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il turno doppio</em></p><p>Reggere una settimana di turni doppi senza usare la Vita per stare in piedi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 140, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Denaro", "name": "Il turno doppio", "text": "Reggere una settimana di turni doppi senza usare la Vita per stare in piedi.", "title": "Il turno doppio"}}}}
{"_id": "c49c22b9dc69eb39", "name": "Il cliente", "pages": [{"_id": "279ac22c715b6ad8", "name": "Il cliente", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il cliente</em></p><p>Tenermi il cliente che qualcuno sta corteggiando. Entro la settimana firma: con me o con loro.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 150, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Denaro", "name": "Il cliente", "text": "Tenermi il cliente che qualcuno sta corteggiando. Entro la settimana firma: con me o con loro.", "title": "Il cliente"}}}}
{"_id": "260845622de3ddfb", "name": "Il telefono", "pages": [{"_id": "e92fcd97ff3d0a21", "name": "Il telefono", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il telefono</em></p><p>Recuperare il telefono perso prima che qualcuno guardi le foto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 160, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Segreti", "name": "Il telefono", "text": "Recuperare il telefono perso prima che qualcuno guardi le foto.", "title": "Il telefono"}}}}
{"_id": "0309364d4a36bbee", "name": "L'alibi", "pages": [{"_id": "e42ad215bd1d6176", "name": "L'alibi", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'alibi</em></p><p>Costruirmi un alibi per la notte sbagliata. Prima che la polizia bussi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 170, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Segreti", "name": "L'alibi", "text": "Costruirmi un alibi per la notte sbagliata. Prima che la polizia bussi.", "title": "L'alibi"}}}}
{"_id": "cd220141e6a4607e", "name": "Le ustioni", "pages": [{"_id": "e2713acff78cd73b", "name": "Le ustioni", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Le ustioni</em></p><p>Nascondere le Ustioni da Paradosso a chi mi vede ogni giorno, finché non guariscono.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 180, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Segreti", "name": "Le ustioni", "text": "Nascondere le Ustioni da Paradosso a chi mi vede ogni giorno, finché non guariscono.", "title": "Le ustioni"}}}}
{"_id": "238d42a4e0f31e79", "name": "I filmati", "pages": [{"_id": "fed79362a897bfbf", "name": "I filmati", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>I filmati</em></p><p>Cancellare entro stanotte le registrazioni del Volgare di ieri. Domattina le guardano.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 190, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Segreti", "name": "I filmati", "text": "Cancellare entro stanotte le registrazioni del Volgare di ieri. Domattina le guardano.", "title": "I filmati"}}}}
{"_id": "a722c342f1d0149c", "name": "Il testimone", "pages": [{"_id": "9d38bcd56de654ae", "name": "Il testimone", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il testimone</em></p><p>Scoprire entro la sessione cosa ha visto davvero chi era lì, e sistemarla senza toccarlo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 200, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Segreti", "name": "Il testimone", "text": "Scoprire entro la sessione cosa ha visto davvero chi era lì, e sistemarla senza toccarlo.", "title": "Il testimone"}}}}
{"_id": "99632b5a98dc794f", "name": "Il registro", "pages": [{"_id": "8b5a56f4893f0509", "name": "Il registro", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il registro</em></p><p>Far sparire il mio nome dal registro della notte sbagliata, senza Corrispondenza, prima del controllo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 210, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Segreti", "name": "Il registro", "text": "Far sparire il mio nome dal registro della notte sbagliata, senza Corrispondenza, prima del controllo.", "title": "Il registro"}}}}
{"_id": "01caade6dbefbfa3", "name": "La perizia", "pages": [{"_id": "46ed8f4d977339f7", "name": "La perizia", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La perizia</em></p><p>Passare la visita psichiatrica di giovedì parlando la loro lingua, non la mia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 220, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Segreti", "name": "La perizia", "text": "Passare la visita psichiatrica di giovedì parlando la loro lingua, non la mia.", "title": "La perizia"}}}}
{"_id": "ec82d437e9342e8d", "name": "Il curioso", "pages": [{"_id": "9db712f48c28e746", "name": "Il curioso", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il curioso</em></p><p>Depistare chi ha messo la mia faccia in un video sul paranormale, prima che ci torni sopra.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 230, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Segreti", "name": "Il curioso", "text": "Depistare chi ha messo la mia faccia in un video sul paranormale, prima che ci torni sopra.", "title": "Il curioso"}}}}
{"_id": "3c701995224d24a2", "name": "La serata", "pages": [{"_id": "dfffe2f17a8b9e4f", "name": "La serata", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La serata</em></p><p>Prendermi una serata tutta mia entro questa storia, ignorando la Guerra per qualche ora.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 240, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Vizi", "name": "La serata", "text": "Prendermi una serata tutta mia entro questa storia, ignorando la Guerra per qualche ora.", "title": "La serata"}}}}
{"_id": "77ec32903c98f069", "name": "Il vizio", "pages": [{"_id": "75113841b82f3427", "name": "Il vizio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il vizio</em></p><p>Procurarmi una dose del mio vizio prima dell'incontro che mi spaventa.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 250, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Vizi", "name": "Il vizio", "text": "Procurarmi una dose del mio vizio prima dell'incontro che mi spaventa.", "title": "Il vizio"}}}}
{"_id": "9188371fa44c87ee", "name": "L'accendino", "pages": [{"_id": "20b7406731fdd995", "name": "L'accendino", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'accendino</em></p><p>Riprendermi l'oggetto che mi hanno rubato, entro la sessione. Dei soldi non m'importa.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 260, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Vizi", "name": "L'accendino", "text": "Riprendermi l'oggetto che mi hanno rubato, entro la sessione. Dei soldi non m'importa.", "title": "L'accendino"}}}}
{"_id": "a0256efe792db2ea", "name": "Il brivido", "pages": [{"_id": "962de9a35263f842", "name": "Il brivido", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il brivido</em></p><p>Cercarmi stanotte un brivido da Dormiente, senza toccare le Sfere.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 270, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Vizi", "name": "Il brivido", "text": "Cercarmi stanotte un brivido da Dormiente, senza toccare le Sfere.", "title": "Il brivido"}}}}
{"_id": "1c73717acb03632d", "name": "La partita", "pages": [{"_id": "a018c93d0acad768", "name": "La partita", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La partita</em></p><p>Vincere sabato il torneo del circolo con le mie sole mani.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 280, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Vizi", "name": "La partita", "text": "Vincere sabato il torneo del circolo con le mie sole mani.", "title": "La partita"}}}}
{"_id": "ef9513b21050093d", "name": "La cena", "pages": [{"_id": "cd5691b67638bd9c", "name": "La cena", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La cena</em></p><p>Cucinare questa settimana per gente che non sa niente di me, e godermela fino alla fine.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 290, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Vizi", "name": "La cena", "text": "Cucinare questa settimana per gente che non sa niente di me, e godermela fino alla fine.", "title": "La cena"}}}}
{"_id": "43715d63f2e0ec20", "name": "Lo sfogo", "pages": [{"_id": "59b56ed5d8d99053", "name": "Lo sfogo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Lo sfogo</em></p><p>Trovare entro l'alba un posto dove lanciare senza testimoni.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 300, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Magick", "name": "Lo sfogo", "text": "Trovare entro l'alba un posto dove lanciare senza testimoni.", "title": "Lo sfogo"}}}}
{"_id": "86c3ce6c7e0ca2af", "name": "Lo Strumento", "pages": [{"_id": "3b656a085ddf9e5b", "name": "Lo Strumento", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Lo Strumento</em></p><p>Ritrovare lo Strumento che mi hanno preso. Entro la prossima scena mi servirà.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 310, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Magick", "name": "Lo Strumento", "text": "Ritrovare lo Strumento che mi hanno preso. Entro la prossima scena mi servirà.", "title": "Lo Strumento"}}}}
{"_id": "8a8e47958d1662f4", "name": "Il pieno", "pages": [{"_id": "13425ea1e0a5bfaa", "name": "Il pieno", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il pieno</em></p><p>Arrivare a un Nodo e riempire la Ruota, prima della prossima storia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 320, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Magick", "name": "Il pieno", "text": "Arrivare a un Nodo e riempire la Ruota, prima della prossima storia.", "title": "Il pieno"}}}}
{"_id": "45ab2b361e86f9e4", "name": "Le tracce", "pages": [{"_id": "8d6e1c1fd4b63209", "name": "Le tracce", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Le tracce</em></p><p>Cancellare ogni Eco dello scontro di ieri, prima che qualcuno la segua fino a me.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 330, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Magick", "name": "Le tracce", "text": "Cancellare ogni Eco dello scontro di ieri, prima che qualcuno la segua fino a me.", "title": "Le tracce"}}}}
{"_id": "f89bd7355663e41f", "name": "La prima volta", "pages": [{"_id": "458ffdb6cef62718", "name": "La prima volta", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La prima volta</em></p><p>Usare entro la sessione, in una situazione vera, il potere appena imparato.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 340, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Magick", "name": "La prima volta", "text": "Usare entro la sessione, in una situazione vera, il potere appena imparato.", "title": "La prima volta"}}}}
{"_id": "556a73a6340f5a96", "name": "Il collaudo", "pages": [{"_id": "6683ccbbf7676e63", "name": "Il collaudo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il collaudo</em></p><p>Provare la Meraviglia appena costruita lontano da occhi e telecamere, entro questa storia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 350, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Magick", "name": "Il collaudo", "text": "Provare la Meraviglia appena costruita lontano da occhi e telecamere, entro questa storia.", "title": "Il collaudo"}}}}
{"_id": "b057e8ca4cad0b89", "name": "La scorta", "pages": [{"_id": "0bc53b136b8b9d52", "name": "La scorta", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La scorta</em></p><p>Rimpiazzare i componenti del rito sequestrati alla dogana, prima del plenilunio.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 360, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Magick", "name": "La scorta", "text": "Rimpiazzare i componenti del rito sequestrati alla dogana, prima del plenilunio.", "title": "La scorta"}}}}
{"_id": "59625840fb1d9dc9", "name": "Il maestro di riserva", "pages": [{"_id": "e989112a8ed4734e", "name": "Il maestro di riserva", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il maestro di riserva</em></p><p>Farmi insegnare da chi mi detesta quello che il mio Mentore mi nega, entro la fine della storia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 370, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Magick", "name": "Il maestro di riserva", "text": "Farmi insegnare da chi mi detesta quello che il mio Mentore mi nega, entro la fine della storia.", "title": "Il maestro di riserva"}}}}
{"_id": "ec6ee677473a273a", "name": "L'infiltrazione", "pages": [{"_id": "9c30b3c9b7f4fbdc", "name": "L'infiltrazione", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'infiltrazione</em></p><p>Entrare in un Costrutto e uscirne con qualcosa in mano, senza che si accorgano di me. Stanotte.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 380, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Guerra", "name": "L'infiltrazione", "text": "Entrare in un Costrutto e uscirne con qualcosa in mano, senza che si accorgano di me. Stanotte.", "title": "L'infiltrazione"}}}}
{"_id": "53f1423be874d7f0", "name": "Il Certámen", "pages": [{"_id": "10f68ef5b644dcb4", "name": "Il Certámen", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Certámen</em></p><p>Chiudere la disputa col mio rivale in Certámen, senza sangue, entro questa storia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 390, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Guerra", "name": "Il Certámen", "text": "Chiudere la disputa col mio rivale in Certámen, senza sangue, entro questa storia.", "title": "Il Certámen"}}}}
{"_id": "06b25fa8f7803a6e", "name": "L'interruzione", "pages": [{"_id": "b76bdf9c1e165bd3", "name": "L'interruzione", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'interruzione</em></p><p>Fermare il rituale della fazione avversaria prima che arrivi al culmine.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 400, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Guerra", "name": "L'interruzione", "text": "Fermare il rituale della fazione avversaria prima che arrivi al culmine.", "title": "L'interruzione"}}}}
{"_id": "c3950127c6ff2adb", "name": "La talpa", "pages": [{"_id": "c80f85be2867d002", "name": "La talpa", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La talpa</em></p><p>Scoprire chi nella mia Cabala parla col Nuovo Ordine Mondiale, prima della prossima missione.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 410, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Guerra", "name": "La talpa", "text": "Scoprire chi nella mia Cabala parla col Nuovo Ordine Mondiale, prima della prossima missione.", "title": "La talpa"}}}}
{"_id": "edddd0f78570d28c", "name": "Gli Orfani", "pages": [{"_id": "05f6c0dad65e8528", "name": "Gli Orfani", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Gli Orfani</em></p><p>Convincere gli Orfani della città a stare con noi per una notte sola. Quella di stasera.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 420, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Guerra", "name": "Gli Orfani", "text": "Convincere gli Orfani della città a stare con noi per una notte sola. Quella di stasera.", "title": "Gli Orfani"}}}}
{"_id": "57a63404108d4104", "name": "Lo scambio", "pages": [{"_id": "a6bc8a7f2e7bbc38", "name": "Lo scambio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Lo scambio</em></p><p>Recuperare il nostro contatto catturato prima che parli, o trattare il prezzo del suo silenzio.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 430, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Guerra", "name": "Lo scambio", "text": "Recuperare il nostro contatto catturato prima che parli, o trattare il prezzo del suo silenzio.", "title": "Lo scambio"}}}}
{"_id": "cab535c54704d653", "name": "Il messaggio", "pages": [{"_id": "23b970ce17fe8d95", "name": "Il messaggio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il messaggio</em></p><p>Far arrivare un avvertimento all'agente dell'Unione che sta per disertare, prima che lo fermino.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 440, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Guerra", "name": "Il messaggio", "text": "Far arrivare un avvertimento all'agente dell'Unione che sta per disertare, prima che lo fermino.", "title": "Il messaggio"}}}}
{"_id": "8664ee04943b668f", "name": "La ritirata", "pages": [{"_id": "134c911c76631401", "name": "La ritirata", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La ritirata</em></p><p>Evacuare il rifugio compromesso, persone e Nodo compresi, entro dodici ore.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 450, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Guerra", "name": "La ritirata", "text": "Evacuare il rifugio compromesso, persone e Nodo compresi, entro dodici ore.", "title": "La ritirata"}}}}
{"_id": "da6d9e25211950f9", "name": "L'incubo", "pages": [{"_id": "b702ea40dfe4c142", "name": "L'incubo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'incubo</em></p><p>Capire cosa vuole dirmi l'incubo che il mio Avatar mi manda da tre notti. Prima della quarta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 460, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Avatar", "name": "L'incubo", "text": "Capire cosa vuole dirmi l'incubo che il mio Avatar mi manda da tre notti. Prima della quarta.", "title": "L'incubo"}}}}
{"_id": "55fd8634587f4183", "name": "Il Primer", "pages": [{"_id": "d9a09bba67507a98", "name": "Il Primer", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il Primer</em></p><p>Piazzare entro la sessione un Primer sul cammino di chi potrebbe svegliarsi, e vedere cosa succede.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 470, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Avatar", "name": "Il Primer", "text": "Piazzare entro la sessione un Primer sul cammino di chi potrebbe svegliarsi, e vedere cosa succede.", "title": "Il Primer"}}}}
{"_id": "7ea37cdd14f4eff3", "name": "La Penumbra", "pages": [{"_id": "9f57758a029c1198", "name": "La Penumbra", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La Penumbra</em></p><p>Passare oltre il Velo e interrogare un'entità precisa, entro la fine della storia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 480, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Avatar", "name": "La Penumbra", "text": "Passare oltre il Velo e interrogare un'entità precisa, entro la fine della storia.", "title": "La Penumbra"}}}}
{"_id": "3f58ef3957cd5d82", "name": "L'epifania", "pages": [{"_id": "e61b4ced4257a60b", "name": "L'epifania", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'epifania</em></p><p>Trovare la risposta prima che il Punto di Rottura trovi me.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 490, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Avatar", "name": "L'epifania", "text": "Trovare la risposta prima che il Punto di Rottura trovi me.", "title": "L'epifania"}}}}
{"_id": "6fb6e6b7cc263039", "name": "Il pellegrinaggio", "pages": [{"_id": "32ffc43e8d79364d", "name": "Il pellegrinaggio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il pellegrinaggio</em></p><p>Tornare dove mi sono Risvegliato, nell'anniversario esatto. L'Avatar insiste.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 500, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Avatar", "name": "Il pellegrinaggio", "text": "Tornare dove mi sono Risvegliato, nell'anniversario esatto. L'Avatar insiste.", "title": "Il pellegrinaggio"}}}}
{"_id": "648f09b5d795f666", "name": "Il debito", "pages": [{"_id": "7e963fd41f5dcddf", "name": "Il debito", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il debito</em></p><p>Ripagare lo spirito che mi ha fatto un favore, prima che scelga lui la valuta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 510, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Avatar", "name": "Il debito", "text": "Ripagare lo spirito che mi ha fatto un favore, prima che scelga lui la valuta.", "title": "Il debito"}}}}
{"_id": "3489a427f80bd47a", "name": "Il pigmento", "pages": [{"_id": "47fc1eb2e71207b6", "name": "Il pigmento", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il pigmento</em></p><p>Procurarmi entro stanotte il materiale che mi manca per finire, senza rubarlo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 520, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Arte", "name": "Il pigmento", "text": "Procurarmi entro stanotte il materiale che mi manca per finire, senza rubarlo.", "title": "Il pigmento", "credo": "arte"}}}}
{"_id": "7cfcf49a1ecbb45c", "name": "Il vernissage", "pages": [{"_id": "9fe97231e82542be", "name": "Il vernissage", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il vernissage</em></p><p>Entrare all'inaugurazione da cui mi hanno escluso, e restarci fino alla fine.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 530, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Arte", "name": "Il vernissage", "text": "Entrare all'inaugurazione da cui mi hanno escluso, e restarci fino alla fine.", "title": "Il vernissage", "credo": "arte"}}}}
{"_id": "577a9155faa05270", "name": "Il giudizio", "pages": [{"_id": "6958d0643d5f2214", "name": "Il giudizio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il giudizio</em></p><p>Sentirmi dire da chi stimo che il mio ultimo lavoro vale qualcosa. Entro la fine della storia, senza chiederglielo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 540, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Arte", "name": "Il giudizio", "text": "Sentirmi dire da chi stimo che il mio ultimo lavoro vale qualcosa. Entro la fine della storia, senza chiederglielo.", "title": "Il giudizio", "credo": "arte"}}}}
{"_id": "8b79c74768edde95", "name": "Il rifacimento", "pages": [{"_id": "6be0d08e283c391c", "name": "Il rifacimento", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il rifacimento</em></p><p>Riprendermi il pezzo che ho consegnato e rifarlo. Lo appendono venerdì.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 550, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Arte", "name": "Il rifacimento", "text": "Riprendermi il pezzo che ho consegnato e rifarlo. Lo appendono venerdì.", "title": "Il rifacimento", "credo": "arte"}}}}
{"_id": "58ae7fd7e0068888", "name": "Lo storto", "pages": [{"_id": "9c50b3a56630464a", "name": "Lo storto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Lo storto</em></p><p>Correggere in questa scena il difetto che vedo nel lavoro di un altro, senza che me l'abbia chiesto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 560, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Arte", "name": "Lo storto", "text": "Correggere in questa scena il difetto che vedo nel lavoro di un altro, senza che me l'abbia chiesto.", "title": "Lo storto", "credo": "arte"}}}}
{"_id": "9e8fed4d0654c30e", "name": "Lo sguardo", "pages": [{"_id": "df88ff3b947ace8b", "name": "Lo sguardo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Lo sguardo</em></p><p>Far guardare davvero la mia opera alla persona che ogni giorno le passa davanti. Entro la sessione.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 570, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Arte", "name": "Lo sguardo", "text": "Far guardare davvero la mia opera alla persona che ogni giorno le passa davanti. Entro la sessione.", "title": "Lo sguardo", "credo": "arte"}}}}
{"_id": "a98cff9926cffd32", "name": "La strada sbagliata", "pages": [{"_id": "81126716ad5e677b", "name": "La strada sbagliata", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La strada sbagliata</em></p><p>Arrivare stasera dove devo, prendendo solo strade che non conosco.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 580, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Caos", "name": "La strada sbagliata", "text": "Arrivare stasera dove devo, prendendo solo strade che non conosco.", "title": "La strada sbagliata", "credo": "caos"}}}}
{"_id": "ddf90e2e663cf2b2", "name": "L'invito", "pages": [{"_id": "57013dc43064e2a0", "name": "L'invito", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'invito</em></p><p>Sedermi al tavolo dove nessuno mi ha invitato, e restarci fino al dolce.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 590, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Caos", "name": "L'invito", "text": "Sedermi al tavolo dove nessuno mi ha invitato, e restarci fino al dolce.", "title": "L'invito", "credo": "caos"}}}}
{"_id": "9d595737619a4f7f", "name": "La moneta", "pages": [{"_id": "9cf22031875704fa", "name": "La moneta", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La moneta</em></p><p>Decidere la scelta grossa di questa storia con una moneta, e tenermi l'esito.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 600, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Caos", "name": "La moneta", "text": "Decidere la scelta grossa di questa storia con una moneta, e tenermi l'esito.", "title": "La moneta", "credo": "caos"}}}}
{"_id": "e975ef393133d95b", "name": "L'imprevisto", "pages": [{"_id": "e3f4975a608fb66e", "name": "L'imprevisto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'imprevisto</em></p><p>Far saltare stasera la serata organizzata da mesi, con una cosa che non costa niente.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 610, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Caos", "name": "L'imprevisto", "text": "Far saltare stasera la serata organizzata da mesi, con una cosa che non costa niente.", "title": "L'imprevisto", "credo": "caos"}}}}
{"_id": "6ab26d5fd633893c", "name": "Il piano", "pages": [{"_id": "e434e3162beb3f98", "name": "Il piano", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il piano</em></p><p>Rompere il piano della mia Cabala per questa storia, e farla arrivare lo stesso.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 620, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Caos", "name": "Il piano", "text": "Rompere il piano della mia Cabala per questa storia, e farla arrivare lo stesso.", "title": "Il piano", "credo": "caos"}}}}
{"_id": "a7e79c90ff281ebb", "name": "Il sassolino", "pages": [{"_id": "b54267d768e592c0", "name": "Il sassolino", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il sassolino</em></p><p>Trovare il gesto piccolo che ferma la coda otto chilometri più avanti, prima che si formi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 630, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Caos", "name": "Il sassolino", "text": "Trovare il gesto piccolo che ferma la coda otto chilometri più avanti, prima che si formi.", "title": "Il sassolino", "credo": "caos"}}}}
{"_id": "7fbd732b1656599d", "name": "L'accesso", "pages": [{"_id": "6b3ca8d30564d07d", "name": "L'accesso", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'accesso</em></p><p>Entrare stanotte nell'archivio senza permessi, senza lasciare la richiesta scritta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 640, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Dati", "name": "L'accesso", "text": "Entrare stanotte nell'archivio senza permessi, senza lasciare la richiesta scritta.", "title": "L'accesso", "credo": "dati"}}}}
{"_id": "24d8801933978a38", "name": "Il buco", "pages": [{"_id": "d705aa25610c802d", "name": "Il buco", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il buco</em></p><p>Trovare dove questa regola è stata scritta di fretta, e passarci, prima della prossima scena.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 650, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Dati", "name": "Il buco", "text": "Trovare dove questa regola è stata scritta di fretta, e passarci, prima della prossima scena.", "title": "Il buco", "credo": "dati"}}}}
{"_id": "2235b43001b82f75", "name": "Il replay", "pages": [{"_id": "8b72c460ab6e2e1e", "name": "Il replay", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il replay</em></p><p>Rivedere entro la sessione cosa c'era davvero nella stanza ieri sera.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 660, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Dati", "name": "Il replay", "text": "Rivedere entro la sessione cosa c'era davvero nella stanza ieri sera.", "title": "Il replay", "credo": "dati"}}}}
{"_id": "cf93543e2bd67c38", "name": "La scorciatoia", "pages": [{"_id": "e00ca60e4a487697", "name": "La scorciatoia", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La scorciatoia</em></p><p>Finire entro stanotte una cosa da tre giorni, saltando tutto il saltabile.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 670, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Dati", "name": "La scorciatoia", "text": "Finire entro stanotte una cosa da tre giorni, saltando tutto il saltabile.", "title": "La scorciatoia", "credo": "dati"}}}}
{"_id": "97fd46a49ea4424e", "name": "Il parametro", "pages": [{"_id": "2e2cc85575b92e69", "name": "Il parametro", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il parametro</em></p><p>Cambiare un solo parametro a chi mi ostacola, e vedere cosa succede in questa storia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 680, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Dati", "name": "Il parametro", "text": "Cambiare un solo parametro a chi mi ostacola, e vedere cosa succede in questa storia.", "title": "Il parametro", "credo": "dati"}}}}
{"_id": "0211a9e2ba71cbe9", "name": "Il caso riaperto", "pages": [{"_id": "3a0465ce1b9ab6af", "name": "Il caso riaperto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il caso riaperto</em></p><p>Riaprire la faccenda che tutti hanno archiviato, e chiuderla come dico io entro la fine della storia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 690, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Dati", "name": "Il caso riaperto", "text": "Riaprire la faccenda che tutti hanno archiviato, e chiuderla come dico io entro la fine della storia.", "title": "Il caso riaperto", "credo": "dati"}}}}
{"_id": "99af27393eb25bb2", "name": "Il salto", "pages": [{"_id": "833f8b6839dad6b9", "name": "Il salto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il salto</em></p><p>Fare stasera la mossa che chiede di affidarsi, con quello che ho in mano e niente di più.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 700, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Fede", "name": "Il salto", "text": "Fare stasera la mossa che chiede di affidarsi, con quello che ho in mano e niente di più.", "title": "Il salto", "credo": "fede"}}}}
{"_id": "dc2785a2b5f33ff4", "name": "Il primo passo", "pages": [{"_id": "87234f9ec583abe1", "name": "Il primo passo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il primo passo</em></p><p>Andare da chi mi ha mentito prima che venga lui a scusarsi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 710, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Fede", "name": "Il primo passo", "text": "Andare da chi mi ha mentito prima che venga lui a scusarsi.", "title": "Il primo passo", "credo": "fede"}}}}
{"_id": "a49c6c7527761a0b", "name": "La parola data", "pages": [{"_id": "40d477c28a89aad3", "name": "La parola data", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La parola data</em></p><p>Portare a termine l'aiuto promesso stamattina a uno sconosciuto, prima di tutto il resto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 720, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Fede", "name": "La parola data", "text": "Portare a termine l'aiuto promesso stamattina a uno sconosciuto, prima di tutto il resto.", "title": "La parola data", "credo": "fede"}}}}
{"_id": "1f7a1c79c3b3d3e6", "name": "L'attesa", "pages": [{"_id": "67bca2be444c797f", "name": "L'attesa", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'attesa</em></p><p>Ottenere la risposta che aspetto senza spingerla. Ho tempo fino alla fine della storia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 730, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Fede", "name": "L'attesa", "text": "Ottenere la risposta che aspetto senza spingerla. Ho tempo fino alla fine della storia.", "title": "L'attesa", "credo": "fede"}}}}
{"_id": "17f2cc94fba267e5", "name": "Disarmato", "pages": [{"_id": "dc3393ab6b99a5e7", "name": "Disarmato", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Disarmato</em></p><p>Entrare stanotte disarmato dove tutti mi dicono di portare qualcosa, e uscirne.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 740, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Fede", "name": "Disarmato", "text": "Entrare stanotte disarmato dove tutti mi dicono di portare qualcosa, e uscirne.", "title": "Disarmato", "credo": "fede"}}}}
{"_id": "56145e5396b6c030", "name": "La sedia vuota", "pages": [{"_id": "ba322a72272b3bb6", "name": "La sedia vuota", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La sedia vuota</em></p><p>Riportare al tavolo chi se n'è andato sbattendo la porta, entro la prossima sessione.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 750, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Fede", "name": "La sedia vuota", "text": "Riportare al tavolo chi se n'è andato sbattendo la porta, entro la prossima sessione.", "title": "La sedia vuota", "credo": "fede"}}}}
{"_id": "2b5df7cb05d869f0", "name": "Il gesto", "pages": [{"_id": "19cfc4dd757deb68", "name": "Il gesto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il gesto</em></p><p>Fare stasera il gesto impossibile davanti a chiunque ci sia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 760, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Illusione", "name": "Il gesto", "text": "Fare stasera il gesto impossibile davanti a chiunque ci sia.", "title": "Il gesto", "credo": "illusione"}}}}
{"_id": "d1268d62aa05e0b0", "name": "La porta", "pages": [{"_id": "07dfe8c982728b62", "name": "La porta", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La porta</em></p><p>Passare la porta chiusa che tutti rispettano, senza voltarmi, prima della prossima scena.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 770, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Illusione", "name": "La porta", "text": "Passare la porta chiusa che tutti rispettano, senza voltarmi, prima della prossima scena.", "title": "La porta", "credo": "illusione"}}}}
{"_id": "f2f7dd2e24dc4d06", "name": "Il sonno", "pages": [{"_id": "3374e9920e8ef274", "name": "Il sonno", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il sonno</em></p><p>Dormire stanotte senza sognare, o senza ricordarmelo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 780, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Illusione", "name": "Il sonno", "text": "Dormire stanotte senza sognare, o senza ricordarmelo.", "title": "Il sonno", "credo": "illusione"}}}}
{"_id": "c946db4d8ce6e8d8", "name": "La sorpresa", "pages": [{"_id": "629f8be092ee2188", "name": "La sorpresa", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La sorpresa</em></p><p>Mettere alla prova la cosa che oggi mi ha sorpreso, prima che finisca la giornata.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 790, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Illusione", "name": "La sorpresa", "text": "Mettere alla prova la cosa che oggi mi ha sorpreso, prima che finisca la giornata.", "title": "La sorpresa", "credo": "illusione"}}}}
{"_id": "e075d701c27e3ba0", "name": "La sveglia", "pages": [{"_id": "08c58c071b5adcf1", "name": "La sveglia", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La sveglia</em></p><p>Far capire a chi sta male che sta sognando, e restare finché non mi ascolta. Entro la sessione.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 800, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Illusione", "name": "La sveglia", "text": "Far capire a chi sta male che sta sognando, e restare finché non mi ascolta. Entro la sessione.", "title": "La sveglia", "credo": "illusione"}}}}
{"_id": "88037be953860e01", "name": "L'uscita", "pages": [{"_id": "727a625908d432d5", "name": "L'uscita", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'uscita</em></p><p>Trovare entro la fine della storia l'uscita dal limite che oggi non ha ceduto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 810, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Illusione", "name": "L'uscita", "text": "Trovare entro la fine della storia l'uscita dal limite che oggi non ha ceduto.", "title": "L'uscita", "credo": "illusione"}}}}
{"_id": "99284510d5ea11cd", "name": "La procedura", "pages": [{"_id": "0a9597a2f1e268c3", "name": "La procedura", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La procedura</em></p><p>Fare stasera tutta la procedura, compreso il passaggio che nessuno controlla.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 820, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Legge", "name": "La procedura", "text": "Fare stasera tutta la procedura, compreso il passaggio che nessuno controlla.", "title": "La procedura", "credo": "legge"}}}}
{"_id": "29ab1d7425d7e840", "name": "La contestazione", "pages": [{"_id": "19b05f15f0992cea", "name": "La contestazione", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La contestazione</em></p><p>Chiedere in questa scena conto e titolo a chi sta violando qualcosa davanti a me.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 830, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Legge", "name": "La contestazione", "text": "Chiedere in questa scena conto e titolo a chi sta violando qualcosa davanti a me.", "title": "La contestazione", "credo": "legge"}}}}
{"_id": "34635854c415d4ec", "name": "La scadenza", "pages": [{"_id": "0f68c895fb16fa43", "name": "La scadenza", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La scadenza</em></p><p>Far rispettare la scadenza a chi contava sulla proroga. Entro la data.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 840, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Legge", "name": "La scadenza", "text": "Far rispettare la scadenza a chi contava sulla proroga. Entro la data.", "title": "La scadenza", "credo": "legge"}}}}
{"_id": "88907500cfdeb706", "name": "Il verbale", "pages": [{"_id": "9dd62e205e747802", "name": "Il verbale", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il verbale</em></p><p>Mettere per iscritto quello che è successo stanotte, prima che qualcuno lo racconti diverso.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 850, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Legge", "name": "Il verbale", "text": "Mettere per iscritto quello che è successo stanotte, prima che qualcuno lo racconti diverso.", "title": "Il verbale", "credo": "legge"}}}}
{"_id": "780ea6d0b299424e", "name": "Il confine", "pages": [{"_id": "9e28a0a2764f256c", "name": "Il confine", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il confine</em></p><p>Rimettere al suo posto il confine che qualcuno ha spostato, e farlo valere entro la sessione.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 860, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Legge", "name": "Il confine", "text": "Rimettere al suo posto il confine che qualcuno ha spostato, e farlo valere entro la sessione.", "title": "Il confine", "credo": "legge"}}}}
{"_id": "b0d95e67323388fa", "name": "La fila", "pages": [{"_id": "3e2676b226a92661", "name": "La fila", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La fila</em></p><p>Rimandare in fondo alla fila chi è passato davanti, senza alzare la voce, prima che tocchi a lui.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 870, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Legge", "name": "La fila", "text": "Rimandare in fondo alla fila chi è passato davanti, senza alzare la voce, prima che tocchi a lui.", "title": "La fila", "credo": "legge"}}}}
{"_id": "c43e95df89fa0d2d", "name": "Il perché", "pages": [{"_id": "afb15ed34868c24e", "name": "Il perché", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il perché</em></p><p>Capire entro stasera perché quella cosa funziona, prima di occuparmi d'altro.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 880, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Macchina", "name": "Il perché", "text": "Capire entro stasera perché quella cosa funziona, prima di occuparmi d'altro.", "title": "Il perché", "credo": "macchina"}}}}
{"_id": "52e1eea502271862", "name": "Il lavoro rifatto", "pages": [{"_id": "17ea5f1c7996730d", "name": "Il lavoro rifatto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il lavoro rifatto</em></p><p>Rifare bene la consegna fatta in fretta, mia o d'altri. Domani la usano.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 890, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Macchina", "name": "Il lavoro rifatto", "text": "Rifare bene la consegna fatta in fretta, mia o d'altri. Domani la usano.", "title": "Il lavoro rifatto", "credo": "macchina"}}}}
{"_id": "3f98eb84b398f82c", "name": "La vite", "pages": [{"_id": "c6c2db107671457d", "name": "La vite", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La vite</em></p><p>Trovare in questa scena la vite di registro di una persona nervosa, e girarla di poco.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 900, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Macchina", "name": "La vite", "text": "Trovare in questa scena la vite di registro di una persona nervosa, e girarla di poco.", "title": "La vite", "credo": "macchina"}}}}
{"_id": "c91bd06b489f0119", "name": "La biella", "pages": [{"_id": "5d11cddf4352faa4", "name": "La biella", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La biella</em></p><p>Sostituire entro la sessione il pezzo che non rende, anche se aveva un nome.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 910, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Macchina", "name": "La biella", "text": "Sostituire entro la sessione il pezzo che non rende, anche se aveva un nome.", "title": "La biella", "credo": "macchina"}}}}
{"_id": "027465d8d3b67c5e", "name": "Il metronomo", "pages": [{"_id": "d95c425ea5333c3f", "name": "Il metronomo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il metronomo</em></p><p>Tenere io il tempo dell'incontro di stasera, e decidere quando finisce.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 920, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Macchina", "name": "Il metronomo", "text": "Tenere io il tempo dell'incontro di stasera, e decidere quando finisce.", "title": "Il metronomo", "credo": "macchina"}}}}
{"_id": "e3b8fd9680a8034e", "name": "L'attrito", "pages": [{"_id": "c4be5e4e42f31e64", "name": "L'attrito", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'attrito</em></p><p>Togliere l'attrito fra le due persone che si sono inceppate, entro la fine della storia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 930, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Macchina", "name": "L'attrito", "text": "Togliere l'attrito fra le due persone che si sono inceppate, entro la fine della storia.", "title": "L'attrito", "credo": "macchina"}}}}
{"_id": "1ea0f6d261633ff0", "name": "La trave", "pages": [{"_id": "81eca31928b0750f", "name": "La trave", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La trave</em></p><p>Sapere entro stanotte quanto resta al solaio sotto cui dormono gli altri.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 940, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Polvere", "name": "La trave", "text": "Sapere entro stanotte quanto resta al solaio sotto cui dormono gli altri.", "title": "La trave", "credo": "polvere"}}}}
{"_id": "a3b3eb2f422b72b3", "name": "Il puntello", "pages": [{"_id": "c468bcee8e57b7a4", "name": "Il puntello", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il puntello</em></p><p>Mettere una mano sotto la cosa che sta cedendo, e restarci fino alla fine della scena.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 950, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Polvere", "name": "Il puntello", "text": "Mettere una mano sotto la cosa che sta cedendo, e restarci fino alla fine della scena.", "title": "Il puntello", "credo": "polvere"}}}}
{"_id": "6d2b18f224da167d", "name": "La scatola", "pages": [{"_id": "34c3da4e876f1899", "name": "La scatola", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La scatola</em></p><p>Portare via dalla casa svuotata la sola cosa che qualcuno ha tenuto per quarant'anni, prima dello sgombero.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 960, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Polvere", "name": "La scatola", "text": "Portare via dalla casa svuotata la sola cosa che qualcuno ha tenuto per quarant'anni, prima dello sgombero.", "title": "La scatola", "credo": "polvere"}}}}
{"_id": "e41bf096579cac6f", "name": "Il no", "pages": [{"_id": "1843615ec0eacb26", "name": "Il no", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il no</em></p><p>Dire oggi di no a chi mi chiede di prolungare oltre il termine, e reggere la sua faccia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 970, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Polvere", "name": "Il no", "text": "Dire oggi di no a chi mi chiede di prolungare oltre il termine, e reggere la sua faccia.", "title": "Il no", "credo": "polvere"}}}}
{"_id": "1cf8af32a8c0dbe0", "name": "La proroga", "pages": [{"_id": "ee09ef2b3f00cf38", "name": "La proroga", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La proroga</em></p><p>Comprare a qualcuno un giorno in più entro la sessione, sapendo chi lo paga.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 980, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Polvere", "name": "La proroga", "text": "Comprare a qualcuno un giorno in più entro la sessione, sapendo chi lo paga.", "title": "La proroga", "credo": "polvere"}}}}
{"_id": "d9b7d9061cc276da", "name": "Il cedimento", "pages": [{"_id": "8b5207d1db874e04", "name": "Il cedimento", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il cedimento</em></p><p>Far cedere in questa storia una cosa dove era già logora, senza che nessuno gridi al miracolo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 990, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Polvere", "name": "Il cedimento", "text": "Far cedere in questa storia una cosa dove era già logora, senza che nessuno gridi al miracolo.", "title": "Il cedimento", "credo": "polvere"}}}}
{"_id": "68ba314f0d334a5a", "name": "La rivincita", "pages": [{"_id": "b8ec76001d1e867a", "name": "La rivincita", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La rivincita</em></p><p>Pareggiare in pubblico il conto perso in pubblico. Entro la fine della storia, davanti agli stessi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1000, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Potere", "name": "La rivincita", "text": "Pareggiare in pubblico il conto perso in pubblico. Entro la fine della storia, davanti agli stessi.", "title": "La rivincita", "credo": "potere"}}}}
{"_id": "86b1171d8ca6af62", "name": "La stanza", "pages": [{"_id": "6d2ed302dadb131f", "name": "La stanza", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La stanza</em></p><p>Far sentire stasera al gruppo che ha già un capo chi comanda, prima di sedermi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1010, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Potere", "name": "La stanza", "text": "Far sentire stasera al gruppo che ha già un capo chi comanda, prima di sedermi.", "title": "La stanza", "credo": "potere"}}}}
{"_id": "cfb77f4721e22de2", "name": "La sfida", "pages": [{"_id": "1198686dfd81c14b", "name": "La sfida", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La sfida</em></p><p>Accettare la sfida di stasera e rilanciare, qualunque sia la posta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1020, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Potere", "name": "La sfida", "text": "Accettare la sfida di stasera e rilanciare, qualunque sia la posta.", "title": "La sfida", "credo": "potere"}}}}
{"_id": "73f74576a05c34bf", "name": "Il passo", "pages": [{"_id": "715a8d3ae10494ea", "name": "Il passo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il passo</em></p><p>Passare oggi davanti a chi era in fila da prima, e che nessuno protesti.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1030, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Potere", "name": "Il passo", "text": "Passare oggi davanti a chi era in fila da prima, e che nessuno protesti.", "title": "Il passo", "credo": "potere"}}}}
{"_id": "6b331e2d4b8d0141", "name": "Da solo", "pages": [{"_id": "0c583093aac9a6ee", "name": "Da solo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Da solo</em></p><p>Cavarmela da solo, entro la sessione, nella cosa in cui chiedere aiuto era la mossa ovvia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1040, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Potere", "name": "Da solo", "text": "Cavarmela da solo, entro la sessione, nella cosa in cui chiedere aiuto era la mossa ovvia.", "title": "Da solo", "credo": "potere"}}}}
{"_id": "0b34654615a146af", "name": "Alla luce", "pages": [{"_id": "0cb27fca5ed4536c", "name": "Alla luce", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Alla luce</em></p><p>Farmi vedere in questa scena dove passare inosservato mi avrebbe dato quello che volevo, e ottenerlo lo stesso.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1050, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Potere", "name": "Alla luce", "text": "Farmi vedere in questa scena dove passare inosservato mi avrebbe dato quello che volevo, e ottenerlo lo stesso.", "title": "Alla luce", "credo": "potere"}}}}
{"_id": "1a7e2c979e8dd1e7", "name": "Il pegno", "pages": [{"_id": "8a95a184ad76c13c", "name": "Il pegno", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il pegno</em></p><p>Lasciare il pegno giusto a chi mi ha aiutato stanotte, senza aspettare che me lo chieda.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1060, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Sacro", "name": "Il pegno", "text": "Lasciare il pegno giusto a chi mi ha aiutato stanotte, senza aspettare che me lo chieda.", "title": "Il pegno", "credo": "sacro"}}}}
{"_id": "54f752c77c5c6097", "name": "Il rito", "pages": [{"_id": "665178537529eb80", "name": "Il rito", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il rito</em></p><p>Compiere stasera per intero il rito dovuto, mentre tutti mi aspettano fuori.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1070, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Sacro", "name": "Il rito", "text": "Compiere stasera per intero il rito dovuto, mentre tutti mi aspettano fuori.", "title": "Il rito", "credo": "sacro"}}}}
{"_id": "5035e867b9257b5b", "name": "L'indirizzo", "pages": [{"_id": "62945273d7c4c289", "name": "L'indirizzo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'indirizzo</em></p><p>Capire quale potenza ha competenza sul problema di stasera, prima di parlare con chiunque.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1080, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Sacro", "name": "L'indirizzo", "text": "Capire quale potenza ha competenza sul problema di stasera, prima di parlare con chiunque.", "title": "L'indirizzo", "credo": "sacro"}}}}
{"_id": "e49f1a0e8b068e4b", "name": "La voce", "pages": [{"_id": "3c4024c9c1ae5ec6", "name": "La voce", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La voce</em></p><p>Rispondere entro la scena a chi mi ha parlato da oltre il Velo, dovunque io sia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1090, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Sacro", "name": "La voce", "text": "Rispondere entro la scena a chi mi ha parlato da oltre il Velo, dovunque io sia.", "title": "La voce", "credo": "sacro"}}}}
{"_id": "8b973e1bb7663396", "name": "La cortesia", "pages": [{"_id": "84f71f0f87ad30f2", "name": "La cortesia", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La cortesia</em></p><p>Far passare in questa storia il Risvegliato che ha bussato alla porta sbagliata, senza che lo sappia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1100, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Sacro", "name": "La cortesia", "text": "Far passare in questa storia il Risvegliato che ha bussato alla porta sbagliata, senza che lo sappia.", "title": "La cortesia", "credo": "sacro"}}}}
{"_id": "d750e8dce390823f", "name": "Il saluto", "pages": [{"_id": "b7ea82ccf8c7a82e", "name": "Il saluto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il saluto</em></p><p>Farmi riconoscere da chi veglia sul posto in cui entro oggi, e ottenere il passaggio.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1110, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Sacro", "name": "Il saluto", "text": "Farmi riconoscere da chi veglia sul posto in cui entro oggi, e ottenere il passaggio.", "title": "Il saluto", "credo": "sacro"}}}}
{"_id": "ce3a864c577f88e1", "name": "La fonte", "pages": [{"_id": "2f63b9f351edc464", "name": "La fonte", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La fonte</em></p><p>Farmi dire da chi afferma come fa a saperlo, prima che cambi discorso.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1120, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Scienza", "name": "La fonte", "text": "Farmi dire da chi afferma come fa a saperlo, prima che cambi discorso.", "title": "La fonte", "credo": "scienza"}}}}
{"_id": "005f78ef32f34502", "name": "Il campione", "pages": [{"_id": "9cad1ef0b92b9c6c", "name": "Il campione", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il campione</em></p><p>Portarmi via stanotte un pezzo del fenomeno nuovo, qualunque cosa succeda.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1130, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Scienza", "name": "Il campione", "text": "Portarmi via stanotte un pezzo del fenomeno nuovo, qualunque cosa succeda.", "title": "Il campione", "credo": "scienza"}}}}
{"_id": "4953b78ce6474d26", "name": "Il quaderno", "pages": [{"_id": "c6b70e6adeaba3bc", "name": "Il quaderno", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il quaderno</em></p><p>Annotare luogo, ora, condizioni e nomi di stasera, prima di dormire.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1140, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Scienza", "name": "Il quaderno", "text": "Annotare luogo, ora, condizioni e nomi di stasera, prima di dormire.", "title": "Il quaderno", "credo": "scienza"}}}}
{"_id": "13d9c0869e64531b", "name": "La misura", "pages": [{"_id": "33b78585993a829e", "name": "La misura", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La misura</em></p><p>Lasciar compiere in questa scena quello che si svolge davanti a me, e registrarlo per intero.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1150, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Scienza", "name": "La misura", "text": "Lasciar compiere in questa scena quello che si svolge davanti a me, e registrarlo per intero.", "title": "La misura", "credo": "scienza"}}}}
{"_id": "dd1b91ac1ce2050c", "name": "La replica", "pages": [{"_id": "446ceba971cee5d1", "name": "La replica", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La replica</em></p><p>Rifare domani, nelle stesse condizioni, quello che oggi ha funzionato una volta sola.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1160, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Scienza", "name": "La replica", "text": "Rifare domani, nelle stesse condizioni, quello che oggi ha funzionato una volta sola.", "title": "La replica", "credo": "scienza"}}}}
{"_id": "35e82eb6b3bd194c", "name": "L'errore", "pages": [{"_id": "f3b340f8ff262ec0", "name": "L'errore", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'errore</em></p><p>Trovare dove il collega ha sbagliato, e dirglielo con la fonte in mano. Pubblica lunedì.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1170, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Scienza", "name": "L'errore", "text": "Trovare dove il collega ha sbagliato, e dirglielo con la fonte in mano. Pubblica lunedì.", "title": "L'errore", "credo": "scienza"}}}}
{"_id": "809b00364390912e", "name": "L'attacco", "pages": [{"_id": "14fb227516ceb4dc", "name": "L'attacco", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'attacco</em></p><p>Entrare stasera nel pezzo esattamente in chiave, davanti a chi non se lo aspetta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1180, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Suono", "name": "L'attacco", "text": "Entrare stasera nel pezzo esattamente in chiave, davanti a chi non se lo aspetta.", "title": "L'attacco", "credo": "suono"}}}}
{"_id": "3aeb0509e1e36cd7", "name": "Il volume", "pages": [{"_id": "05d248391bf58c83", "name": "Il volume", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il volume</em></p><p>Farmi sentire in questa scena da chi non si è mosso, senza toccare il volume di nessuno.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1190, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Suono", "name": "Il volume", "text": "Farmi sentire in questa scena da chi non si è mosso, senza toccare il volume di nessuno.", "title": "Il volume", "credo": "suono"}}}}
{"_id": "7c5956930e5465f2", "name": "La parte", "pages": [{"_id": "624856969d4ad50d", "name": "La parte", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La parte</em></p><p>Tenere la mia parte nel coro che vuole farmi tacere, fino alla fine della serata.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1200, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Suono", "name": "La parte", "text": "Tenere la mia parte nel coro che vuole farmi tacere, fino alla fine della serata.", "title": "La parte", "credo": "suono"}}}}
{"_id": "f61c86463143e059", "name": "La coda", "pages": [{"_id": "5d5602804afcf787", "name": "La coda", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La coda</em></p><p>Allungare di una sera sola la cosa che vorrei trattenere. Stasera.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1210, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Suono", "name": "La coda", "text": "Allungare di una sera sola la cosa che vorrei trattenere. Stasera.", "title": "La coda", "credo": "suono"}}}}
{"_id": "6b8f5263750ef485", "name": "La frequenza", "pages": [{"_id": "96cf22bc2daa236f", "name": "La frequenza", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La frequenza</em></p><p>Trovare la frequenza che manda in pezzi il muro di stasera, e non usarla.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1220, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Suono", "name": "La frequenza", "text": "Trovare la frequenza che manda in pezzi il muro di stasera, e non usarla.", "title": "La frequenza", "credo": "suono"}}}}
{"_id": "377761906d3b3287", "name": "Il ritornello", "pages": [{"_id": "c3da31bdaca51ed5", "name": "Il ritornello", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il ritornello</em></p><p>Mettere in testa alla persona giusta la canzone giusta in questa scena, prima che apra bocca.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1230, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Suono", "name": "Il ritornello", "text": "Mettere in testa alla persona giusta la canzone giusta in questa scena, prima che apra bocca.", "title": "Il ritornello", "credo": "suono"}}}}
{"_id": "8e4f75f2bf401364", "name": "La compagnia", "pages": [{"_id": "b38ddf9be246dc5c", "name": "La compagnia", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La compagnia</em></p><p>Trovare compagnia stasera, anche se restare fuori era la mossa giusta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1240, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Vivo", "name": "La compagnia", "text": "Trovare compagnia stasera, anche se restare fuori era la mossa giusta.", "title": "La compagnia", "credo": "vivo"}}}}
{"_id": "8cc3a74d9eec9ae5", "name": "Il male", "pages": [{"_id": "3b4b74314398682b", "name": "Il male", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il male</em></p><p>Occuparmi entro la sessione del male di chi mi sta accanto, anche se mi hanno chiesto di restare fuori.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1250, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Vivo", "name": "Il male", "text": "Occuparmi entro la sessione del male di chi mi sta accanto, anche se mi hanno chiesto di restare fuori.", "title": "Il male", "credo": "vivo"}}}}
{"_id": "741885d1b2de8d0d", "name": "Il seme", "pages": [{"_id": "447b3cf1bde8f0dd", "name": "Il seme", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il seme</em></p><p>Lasciare oggi qualcosa di vivo nel posto più morto in cui passo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1260, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Vivo", "name": "Il seme", "text": "Lasciare oggi qualcosa di vivo nel posto più morto in cui passo.", "title": "Il seme", "credo": "vivo"}}}}
{"_id": "99c42faa41cff6c8", "name": "La fase", "pages": [{"_id": "afb8343f9f65d783", "name": "La fase", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La fase</em></p><p>Aspettare la fase giusta del respiro della città prima di agire in questa storia, anche se costa.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1270, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Vivo", "name": "La fase", "text": "Aspettare la fase giusta del respiro della città prima di agire in questa storia, anche se costa.", "title": "La fase", "credo": "vivo"}}}}
{"_id": "487f7df3d19594db", "name": "La vena", "pages": [{"_id": "996260137a89f95f", "name": "La vena", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La vena</em></p><p>Mettere io, in questa scena, la vita che manca a chi ho davanti.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1280, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Vivo", "name": "La vena", "text": "Mettere io, in questa scena, la vita che manca a chi ho davanti.", "title": "La vena", "credo": "vivo"}}}}
{"_id": "3c1885bd421a69c6", "name": "Il blocco", "pages": [{"_id": "9b9126645c0c753e", "name": "Il blocco", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il blocco</em></p><p>Trovare dove il giro di questa casa è bloccato, e liberarlo prima di andarmene.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1290, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "desiderio", "group": "Tutto è Vivo", "name": "Il blocco", "text": "Trovare dove il giro di questa casa è bloccato, e liberarlo prima di andarmene.", "title": "Il blocco", "credo": "vivo"}}}}
