{"_id": "839158f9dc2eedbd", "name": "Il fratello", "pages": [{"_id": "d158b96ab7a3765e", "name": "Il fratello", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il fratello</em> · fratello o sorella</p><p><strong>Cosa ti dà:</strong> la vita che avresti avuto. <strong>Cosa non sa:</strong> cosa sei. <strong>Dove morde:</strong> può chiedere.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 40, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ancora", "group": "Ancore", "name": "Il fratello", "text": "Il fratello", "role": "fratello o sorella", "gives": "la vita che avresti avuto", "unknown": "cosa sei", "bites": "può chiedere", "description": "la vita che avresti avuto · cosa sei · può chiedere"}}}}
{"_id": "343500faa35aa9d3", "name": "La barista", "pages": [{"_id": "6a165d0341a9a444", "name": "La barista", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La barista</em> · chi ti serve ogni giorno</p><p><strong>Cosa ti dà:</strong> nessuna domanda. <strong>Cosa non sa:</strong> il tuo cognome. <strong>Dove morde:</strong> può vederti.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 50, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ancora", "group": "Ancore", "name": "La barista", "text": "La barista", "role": "chi ti serve ogni giorno", "gives": "nessuna domanda", "unknown": "il tuo cognome", "bites": "può vederti", "description": "nessuna domanda · il tuo cognome · può vederti"}}}}
{"_id": "731f9a2bce3548d3", "name": "Il nonno in ospizio", "pages": [{"_id": "b54ed453bc6fa690", "name": "Il nonno in ospizio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il nonno in ospizio</em> · nonno o nonna</p><p><strong>Cosa ti dà:</strong> qualcuno che potrebbe capire. <strong>Cosa non sa:</strong> cosa sei, e non glielo dirai. <strong>Dove morde:</strong> può andarsene.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 60, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ancora", "group": "Ancore", "name": "Il nonno in ospizio", "text": "Il nonno in ospizio", "role": "nonno o nonna", "gives": "qualcuno che potrebbe capire", "unknown": "cosa sei, e non glielo dirai", "bites": "può andarsene", "description": "qualcuno che potrebbe capire · cosa sei, e non glielo dirai · può andarsene"}}}}
{"_id": "f7eee579c2f39e4a", "name": "L'ex", "pages": [{"_id": "6192a7176f72b92f", "name": "L'ex", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'ex</em> · ex</p><p><strong>Cosa ti dà:</strong> un debito da pagare. <strong>Cosa non sa:</strong> perché sei sparito. <strong>Dove morde:</strong> può raccontarlo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 70, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ancora", "group": "Ancore", "name": "L'ex", "text": "L'ex", "role": "ex", "gives": "un debito da pagare", "unknown": "perché sei sparito", "bites": "può raccontarlo", "description": "un debito da pagare · perché sei sparito · può raccontarlo"}}}}
{"_id": "7048b03f22d46917", "name": "Il collega", "pages": [{"_id": "0a17bd9df553fbd3", "name": "Il collega", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il collega</em> · collega</p><p><strong>Cosa ti dà:</strong> la copertura. <strong>Cosa non sa:</strong> da cosa ti copre. <strong>Dove morde:</strong> può perdere il lavoro.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 80, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ancora", "group": "Ancore", "name": "Il collega", "text": "Il collega", "role": "collega", "gives": "la copertura", "unknown": "da cosa ti copre", "bites": "può perdere il lavoro", "description": "la copertura · da cosa ti copre · può perdere il lavoro"}}}}
