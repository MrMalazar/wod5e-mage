{"_id": "1f387dfa65127a49", "name": "Il partner che non sa niente", "pages": [{"_id": "f0569eda4953505b", "name": "Il partner che non sa niente", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il partner che non sa niente</em></p><p>La normalità che ti aspetta a casa. Ogni bugia per proteggerla è un filo che si consuma.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 10, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ancora", "group": "Ancore", "name": "Il partner che non sa niente", "text": "Il partner che non sa niente", "description": "La normalità che ti aspetta a casa. Ogni bugia per proteggerla è un filo che si consuma."}}}}
{"_id": "591d1e6abe338e66", "name": "La madre che dimentica", "pages": [{"_id": "9336ac23a31d2ab3", "name": "La madre che dimentica", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La madre che dimentica</em></p><p>Andare a trovarla è l'unica ora in cui non sei un mago. Un giorno chiederà chi sei.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 20, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ancora", "group": "Ancore", "name": "La madre che dimentica", "text": "La madre che dimentica", "description": "Andare a trovarla è l'unica ora in cui non sei un mago. Un giorno chiederà chi sei."}}}}
{"_id": "925b4d0c689abfaf", "name": "La figlia adolescente", "pages": [{"_id": "0841bb951e185bdd", "name": "La figlia adolescente", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La figlia adolescente</em></p><p>Il motivo per cui tieni la Ruota scarica. E il primo nome sulla lista dei tuoi nemici.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 30, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ancora", "group": "Ancore", "name": "La figlia adolescente", "text": "La figlia adolescente", "description": "Il motivo per cui tieni la Ruota scarica. E il primo nome sulla lista dei tuoi nemici."}}}}
{"_id": "9d5be6618935d8dc", "name": "L'amico d'infanzia poliziotto", "pages": [{"_id": "b1e7f50f73115b4b", "name": "L'amico d'infanzia poliziotto", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'amico d'infanzia poliziotto</em></p><p>Ti conosce da prima. E il suo mestiere è notare le cose che non tornano.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 40, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ancora", "group": "Ancore", "name": "L'amico d'infanzia poliziotto", "text": "L'amico d'infanzia poliziotto", "description": "Ti conosce da prima. E il suo mestiere è notare le cose che non tornano."}}}}
{"_id": "009eb4c80361ae18", "name": "Il fratello che ce l'ha fatta", "pages": [{"_id": "c471d3a04e8c92ee", "name": "Il fratello che ce l'ha fatta", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il fratello che ce l'ha fatta</em></p><p>La vita che avresti potuto avere, a cena ogni domenica.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 50, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ancora", "group": "Ancore", "name": "Il fratello che ce l'ha fatta", "text": "Il fratello che ce l'ha fatta", "description": "La vita che avresti potuto avere, a cena ogni domenica."}}}}
{"_id": "18700a7c6da82037", "name": "La barista del turno di notte", "pages": [{"_id": "6f8b856aa2ebabf7", "name": "La barista del turno di notte", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La barista del turno di notte</em></p><p>Dieci minuti di chiacchiere vere. Non sa nemmeno il tuo cognome, e va bene così.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 60, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ancora", "group": "Ancore", "name": "La barista del turno di notte", "text": "La barista del turno di notte", "description": "Dieci minuti di chiacchiere vere. Non sa nemmeno il tuo cognome, e va bene così."}}}}
{"_id": "731f9a2bce3548d3", "name": "Il nonno in ospizio", "pages": [{"_id": "b54ed453bc6fa690", "name": "Il nonno in ospizio", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il nonno in ospizio</em></p><p>L'unico che, forse, capirebbe, e proprio per questo non gli dirai mai nulla.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 70, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ancora", "group": "Ancore", "name": "Il nonno in ospizio", "text": "Il nonno in ospizio", "description": "L'unico che, forse, capirebbe, e proprio per questo non gli dirai mai nulla."}}}}
{"_id": "f520fb52c8b5ecde", "name": "L'ex a cui devi delle scuse", "pages": [{"_id": "c1ee222bad3f2ca5", "name": "L'ex a cui devi delle scuse", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'ex a cui devi delle scuse</em></p><p>Il conto aperto che ti tiene onesto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 80, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ancora", "group": "Ancore", "name": "L'ex a cui devi delle scuse", "text": "L'ex a cui devi delle scuse", "description": "Il conto aperto che ti tiene onesto."}}}}
{"_id": "9fd9f99f9b20eab8", "name": "Il collega che ti copre", "pages": [{"_id": "fe55f06550918b75", "name": "Il collega che ti copre", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il collega che ti copre</em></p><p>Ti salva la Maschera una volta a settimana, e non sa da cosa.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 90, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ancora", "group": "Ancore", "name": "Il collega che ti copre", "text": "Il collega che ti copre", "description": "Ti salva la Maschera una volta a settimana, e non sa da cosa."}}}}
{"_id": "a6670be919c8d370", "name": "La vicina che cucina per due", "pages": [{"_id": "fb67caeaebca0e72", "name": "La vicina che cucina per due", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La vicina che cucina per due</em></p><p>Ti tratta come un figlio. Vive a dieci metri dai tuoi rituali.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 100, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ancora", "group": "Ancore", "name": "La vicina che cucina per due", "text": "La vicina che cucina per due", "description": "Ti tratta come un figlio. Vive a dieci metri dai tuoi rituali."}}}}
{"_id": "c8c4645ae0d84627", "name": "Il migliore amico del liceo", "pages": [{"_id": "ed61407576427969", "name": "Il migliore amico del liceo", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il migliore amico del liceo</em></p><p>L'ultimo che ti ha visto felice da Dormiente. Lo eviti, e lui insiste.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 110, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ancora", "group": "Ancore", "name": "Il migliore amico del liceo", "text": "Il migliore amico del liceo", "description": "L'ultimo che ti ha visto felice da Dormiente. Lo eviti, e lui insiste."}}}}
{"_id": "f051153cda1dfc24", "name": "Lo psicologo del servizio pubblico", "pages": [{"_id": "bba18e7e938a0923", "name": "Lo psicologo del servizio pubblico", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Lo psicologo del servizio pubblico</em></p><p>L'unico a cui dici quasi la verità. Prende appunti.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 120, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ancora", "group": "Ancore", "name": "Lo psicologo del servizio pubblico", "text": "Lo psicologo del servizio pubblico", "description": "L'unico a cui dici quasi la verità. Prende appunti."}}}}
