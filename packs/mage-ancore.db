{"_id": "2b71afacbf235c36", "name": "Il partner", "pages": [{"_id": "9a72efd59ce719fa", "name": "Il partner", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il partner</em> · partner</p><p><strong>Cosa ti dà:</strong> la normalità. <strong>Cosa non sa:</strong> cosa sei. <strong>Dove morde:</strong> può scoprire che menti.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 0, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ancora", "group": "Ancore", "name": "Il partner", "text": "Il partner", "role": "partner", "gives": "la normalità", "unknown": "cosa sei", "bites": "può scoprire che menti", "description": "la normalità · cosa sei · può scoprire che menti"}}}}
{"_id": "591d1e6abe338e66", "name": "La madre che dimentica", "pages": [{"_id": "9336ac23a31d2ab3", "name": "La madre che dimentica", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La madre che dimentica</em> · genitore</p><p><strong>Cosa ti dà:</strong> il prima: chi eri. <strong>Cosa non sa:</strong> chi sei diventato. <strong>Dove morde:</strong> può non riconoscerti più.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 10, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ancora", "group": "Ancore", "name": "La madre che dimentica", "text": "La madre che dimentica", "role": "genitore", "gives": "il prima: chi eri", "unknown": "chi sei diventato", "bites": "può non riconoscerti più", "description": "il prima: chi eri · chi sei diventato · può non riconoscerti più"}}}}
{"_id": "9be26dea15e3a05e", "name": "La figlia", "pages": [{"_id": "ab5b60a03fa67cca", "name": "La figlia", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La figlia</em> · figlio o figlia</p><p><strong>Cosa ti dà:</strong> qualcuno da proteggere. <strong>Cosa non sa:</strong> cosa sei. <strong>Dove morde:</strong> può essere presa di mira.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 20, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "ancora", "group": "Ancore", "name": "La figlia", "text": "La figlia", "role": "figlio o figlia", "gives": "qualcuno da proteggere", "unknown": "cosa sei", "bites": "può essere presa di mira", "description": "qualcuno da proteggere · cosa sei · può essere presa di mira"}}}}
