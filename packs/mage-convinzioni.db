{"_id": "625f036f8241978e", "name": "Nessuno decide chi vive e chi muore.", "pages": [{"_id": "e630b1246d4782e5", "name": "Nessuno decide chi vive e chi muore.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Nessuno decide chi vive e chi muore.</em></p><p>Niente esecuzioni, niente eutanasie «pietose», nemmeno quando il tavolo intero ti supplica.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 0, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Morte", "name": "Nessuno decide chi vive e chi muore.", "text": "Nessuno decide chi vive e chi muore.", "gloss": "Niente esecuzioni, niente eutanasie «pietose», nemmeno quando il tavolo intero ti supplica."}}}}
{"_id": "2500c19fb89676f2", "name": "Il ciclo naturale non va corrotto.", "pages": [{"_id": "263a564489e71914", "name": "Il ciclo naturale non va corrotto.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il ciclo naturale non va corrotto.</em></p><p>Non resusciti, non congeli, non prolunghi oltre il tempo dato. Nemmeno per un'Ancora.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 10, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Morte", "name": "Il ciclo naturale non va corrotto.", "text": "Il ciclo naturale non va corrotto.", "gloss": "Non resusciti, non congeli, non prolunghi oltre il tempo dato. Nemmeno per un'Ancora."}}}}
{"_id": "8e882da9b68e8369", "name": "Ogni vita salvata vale il rischio.", "pages": [{"_id": "a7c43294e840372c", "name": "Ogni vita salvata vale il rischio.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Ogni vita salvata vale il rischio.</em></p><p>Ti fermi a soccorrere. Sempre. Anche quando è una trappola evidente.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 20, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Morte", "name": "Ogni vita salvata vale il rischio.", "text": "Ogni vita salvata vale il rischio.", "gloss": "Ti fermi a soccorrere. Sempre. Anche quando è una trappola evidente."}}}}
{"_id": "d12c52dba749fc75", "name": "I morti hanno diritto alla pace.", "pages": [{"_id": "56bfb1baf0225124", "name": "I morti hanno diritto alla pace.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>I morti hanno diritto alla pace.</em></p><p>Niente negromanzia, niente interrogatori ai defunti, niente reliquie strappate alle tombe.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 30, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Morte", "name": "I morti hanno diritto alla pace.", "text": "I morti hanno diritto alla pace.", "gloss": "Niente negromanzia, niente interrogatori ai defunti, niente reliquie strappate alle tombe."}}}}
{"_id": "7a30773bbdb52cb6", "name": "Il sangue versato si paga.", "pages": [{"_id": "74f60d439a4b20cf", "name": "Il sangue versato si paga.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il sangue versato si paga.</em></p><p>Chi uccide davanti a te risponde, e tieni la contabilità anche di te stesso.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 40, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Morte", "name": "Il sangue versato si paga.", "text": "Il sangue versato si paga.", "gloss": "Chi uccide davanti a te risponde, e tieni la contabilità anche di te stesso."}}}}
{"_id": "fa13656bb63d3aac", "name": "La sofferenza inutile è l'unico vero male.", "pages": [{"_id": "e8b23447d75fd5d0", "name": "La sofferenza inutile è l'unico vero male.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La sofferenza inutile è l'unico vero male.</em></p><p>Abbrevi le agonie, curi i nemici feriti, e detesti chi gioca col dolore.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 50, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Morte", "name": "La sofferenza inutile è l'unico vero male.", "text": "La sofferenza inutile è l'unico vero male.", "gloss": "Abbrevi le agonie, curi i nemici feriti, e detesti chi gioca col dolore."}}}}
{"_id": "151cfbfc7272e52a", "name": "Il mio corpo, le mie regole.", "pages": [{"_id": "bac7ab549a88a8bb", "name": "Il mio corpo, le mie regole.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il mio corpo, le mie regole.</em></p><p>Nessuno tocca la carne o la mente altrui senza consenso, nemmeno per «salvarla».</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 60, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Morte", "name": "Il mio corpo, le mie regole.", "text": "Il mio corpo, le mie regole.", "gloss": "Nessuno tocca la carne o la mente altrui senza consenso, nemmeno per «salvarla»."}}}}
{"_id": "dadd09ccf4a42088", "name": "Ciò che è malato va guarito, non eliminato.", "pages": [{"_id": "e3d38610328e2e21", "name": "Ciò che è malato va guarito, non eliminato.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Ciò che è malato va guarito, non eliminato.</em></p><p>Cerchi la cura dove tutti vedono solo l'abbattimento: mostri inclusi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 70, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Morte", "name": "Ciò che è malato va guarito, non eliminato.", "text": "Ciò che è malato va guarito, non eliminato.", "gloss": "Cerchi la cura dove tutti vedono solo l'abbattimento: mostri inclusi."}}}}
{"_id": "be44f6bb7461185a", "name": "La conoscenza va liberata, sempre.", "pages": [{"_id": "31f8bca3105e4132", "name": "La conoscenza va liberata, sempre.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La conoscenza va liberata, sempre.</em></p><p>Non seppellisci scoperte, non bruci libri, non tieni segreti «per il bene di tutti».</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 80, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Verità", "name": "La conoscenza va liberata, sempre.", "text": "La conoscenza va liberata, sempre.", "gloss": "Non seppellisci scoperte, non bruci libri, non tieni segreti «per il bene di tutti»."}}}}
{"_id": "f12e80ab8217895d", "name": "L'ignoranza è un veleno da estirpare.", "pages": [{"_id": "c4e958efb5cef70f", "name": "L'ignoranza è un veleno da estirpare.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'ignoranza è un veleno da estirpare.</em></p><p>Insegni anche a chi non paga, non ringrazia, o farebbe meglio a non sapere.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 90, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Verità", "name": "L'ignoranza è un veleno da estirpare.", "text": "L'ignoranza è un veleno da estirpare.", "gloss": "Insegni anche a chi non paga, non ringrazia, o farebbe meglio a non sapere."}}}}
{"_id": "0e04cb17c93c5b4c", "name": "Mai mentire a chi si fida di me.", "pages": [{"_id": "b081ae5bcbbad1a9", "name": "Mai mentire a chi si fida di me.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Mai mentire a chi si fida di me.</em></p><p>Le bugie ai nemici passano. Ai tuoi, mai, nemmeno quelle che salverebbero la serata.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 100, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Verità", "name": "Mai mentire a chi si fida di me.", "text": "Mai mentire a chi si fida di me.", "gloss": "Le bugie ai nemici passano. Ai tuoi, mai, nemmeno quelle che salverebbero la serata."}}}}
{"_id": "70fd5191f419477e", "name": "Ogni domanda merita risposta.", "pages": [{"_id": "4b9fbc6278bf9106", "name": "Ogni domanda merita risposta.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Ogni domanda merita risposta.</em></p><p>Non liquidi nessuno con «è complicato». Nemmeno i Dormienti. Nemmeno i bambini.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 110, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Verità", "name": "Ogni domanda merita risposta.", "text": "Ogni domanda merita risposta.", "gloss": "Non liquidi nessuno con «è complicato». Nemmeno i Dormienti. Nemmeno i bambini."}}}}
{"_id": "ee1c6fcf1a6a63ec", "name": "La verità detta male è una menzogna.", "pages": [{"_id": "15fd50e031b55288", "name": "La verità detta male è una menzogna.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La verità detta male è una menzogna.</em></p><p>Il come conta quanto il cosa: la Frattura è il monumento a questa regola.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 120, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Verità", "name": "La verità detta male è una menzogna.", "text": "La verità detta male è una menzogna.", "gloss": "Il come conta quanto il cosa: la Frattura è il monumento a questa regola."}}}}
{"_id": "d0e81dc5786aab9d", "name": "Alcune porte devono restare chiuse.", "pages": [{"_id": "3e88ffd5b5d4c2ca", "name": "Alcune porte devono restare chiuse.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Alcune porte devono restare chiuse.</em></p><p>Esistono saperi che non vanno riaperti, e tu li riconosci, e giri al largo, e impedisci.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 130, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Verità", "name": "Alcune porte devono restare chiuse.", "text": "Alcune porte devono restare chiuse.", "gloss": "Esistono saperi che non vanno riaperti, e tu li riconosci, e giri al largo, e impedisci."}}}}
{"_id": "baa996c8f7777c61", "name": "Prima capire, poi giudicare.", "pages": [{"_id": "1f5eb4adf546e3ef", "name": "Prima capire, poi giudicare.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Prima capire, poi giudicare.</em></p><p>Ascolti la versione del mostro. Per intero. Anche col dito sul grilletto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 140, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Verità", "name": "Prima capire, poi giudicare.", "text": "Prima capire, poi giudicare.", "gloss": "Ascolti la versione del mostro. Per intero. Anche col dito sul grilletto."}}}}
{"_id": "1d6a616b0a755b75", "name": "Il dubbio è un dovere.", "pages": [{"_id": "80d832ac80409dc5", "name": "Il dubbio è un dovere.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il dubbio è un dovere.</em></p><p>Rimetti in discussione le tue certezze davanti ai fatti, anche quelle su cui hai costruito il Credo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 150, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Verità", "name": "Il dubbio è un dovere.", "text": "Il dubbio è un dovere.", "gloss": "Rimetti in discussione le tue certezze davanti ai fatti, anche quelle su cui hai costruito il Credo."}}}}
{"_id": "dd0f457423acfbc0", "name": "I patti si onorano, anche quando costano.", "pages": [{"_id": "3ec19c639c01908c", "name": "I patti si onorano, anche quando costano.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>I patti si onorano, anche quando costano.</em></p><p>La parola data vale con gli amici, coi nemici, con gli spiriti. Soprattutto quando conviene romperla.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 160, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Lealtà", "name": "I patti si onorano, anche quando costano.", "text": "I patti si onorano, anche quando costano.", "gloss": "La parola data vale con gli amici, coi nemici, con gli spiriti. Soprattutto quando conviene romperla."}}}}
{"_id": "893880e57dedb7df", "name": "La mia Cabala è la mia famiglia.", "pages": [{"_id": "490d14ed6b21759f", "name": "La mia Cabala è la mia famiglia.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La mia Cabala è la mia famiglia.</em></p><p>Viene prima del resto del mondo, incluse le cause giuste e gli ordini della tua fazione.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 170, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Lealtà", "name": "La mia Cabala è la mia famiglia.", "text": "La mia Cabala è la mia famiglia.", "gloss": "Viene prima del resto del mondo, incluse le cause giuste e gli ordini della tua fazione."}}}}
{"_id": "149e789e62196afe", "name": "Chi mi salva la vita ha credito su di essa.", "pages": [{"_id": "a6fbab0a95288023", "name": "Chi mi salva la vita ha credito su di essa.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Chi mi salva la vita ha credito su di essa.</em></p><p>I debiti d'onore si pagano su richiesta, senza contrattare la valuta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 180, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Lealtà", "name": "Chi mi salva la vita ha credito su di essa.", "text": "Chi mi salva la vita ha credito su di essa.", "gloss": "I debiti d'onore si pagano su richiesta, senza contrattare la valuta."}}}}
{"_id": "4d5430265e36ee1e", "name": "Non si abbandona nessuno indietro.", "pages": [{"_id": "74d512ada9ac3e60", "name": "Non si abbandona nessuno indietro.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Non si abbandona nessuno indietro.</em></p><p>Torni a prenderli. Sempre. Anche quando la matematica dice di no.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 190, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Lealtà", "name": "Non si abbandona nessuno indietro.", "text": "Non si abbandona nessuno indietro.", "gloss": "Torni a prenderli. Sempre. Anche quando la matematica dice di no."}}}}
{"_id": "01fc582a25fdfa01", "name": "Il tradimento si paga una volta sola.", "pages": [{"_id": "403a5cad8707140d", "name": "Il tradimento si paga una volta sola.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il tradimento si paga una volta sola.</em></p><p>Chi ti tradisce è fuori per sempre: niente seconde possibilità, nemmeno col pianto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 200, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Lealtà", "name": "Il tradimento si paga una volta sola.", "text": "Il tradimento si paga una volta sola.", "gloss": "Chi ti tradisce è fuori per sempre: niente seconde possibilità, nemmeno col pianto."}}}}
{"_id": "f47c863d8a34293d", "name": "L'ospitalità è sacra.", "pages": [{"_id": "e3fc47e97a796e60", "name": "L'ospitalità è sacra.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'ospitalità è sacra.</em></p><p>Chi mangia alla tua tavola è intoccabile finché è sotto il tuo tetto, e tu sotto il suo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 210, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Lealtà", "name": "L'ospitalità è sacra.", "text": "L'ospitalità è sacra.", "gloss": "Chi mangia alla tua tavola è intoccabile finché è sotto il tuo tetto, e tu sotto il suo."}}}}
{"_id": "ac89d77c891d1b08", "name": "Gli ordini ingiusti non si eseguono.", "pages": [{"_id": "5ef8e9785b00de26", "name": "Gli ordini ingiusti non si eseguono.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Gli ordini ingiusti non si eseguono.</em></p><p>Disobbedisci apertamente, ne paghi il prezzo, e non scarichi la colpa su chi ordinava.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 220, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Lealtà", "name": "Gli ordini ingiusti non si eseguono.", "text": "Gli ordini ingiusti non si eseguono.", "gloss": "Disobbedisci apertamente, ne paghi il prezzo, e non scarichi la colpa su chi ordinava."}}}}
{"_id": "01d1ad8c03d92e42", "name": "Prima gli allievi, poi il maestro.", "pages": [{"_id": "6353440311b2f436", "name": "Prima gli allievi, poi il maestro.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Prima gli allievi, poi il maestro.</em></p><p>Chi impara da te viene protetto prima di te, anche dal tuo stesso fallimento.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 230, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Lealtà", "name": "Prima gli allievi, poi il maestro.", "text": "Prima gli allievi, poi il maestro.", "gloss": "Chi impara da te viene protetto prima di te, anche dal tuo stesso fallimento."}}}}
{"_id": "48e265dc97add3ad", "name": "Nessuna autorità ha diritto di incatenare la mia volontà.", "pages": [{"_id": "cb5feeccd47c34e3", "name": "Nessuna autorità ha diritto di incatenare la mia volontà.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Nessuna autorità ha diritto di incatenare la mia volontà.</em></p><p>Non firmi giuramenti perpetui, non accetti guinzagli, nemmeno dorati, nemmeno «temporanei».</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 240, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Libertà", "name": "Nessuna autorità ha diritto di incatenare la mia volontà.", "text": "Nessuna autorità ha diritto di incatenare la mia volontà.", "gloss": "Non firmi giuramenti perpetui, non accetti guinzagli, nemmeno dorati, nemmeno «temporanei»."}}}}
{"_id": "b4765976a2f4220d", "name": "La stabilità delle Masse viene prima della libertà del singolo.", "pages": [{"_id": "1fe98ed51e211f73", "name": "La stabilità delle Masse viene prima della libertà del singolo.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La stabilità delle Masse viene prima della libertà del singolo.</em></p><p>Sacrifichi il brillante, l'eccezione, il caso pietoso, te compreso, per il quieto vivere di milioni.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 250, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Libertà", "name": "La stabilità delle Masse viene prima della libertà del singolo.", "text": "La stabilità delle Masse viene prima della libertà del singolo.", "gloss": "Sacrifichi il brillante, l'eccezione, il caso pietoso, te compreso, per il quieto vivere di milioni."}}}}
{"_id": "919d367ecd1b4d63", "name": "Ogni mente ha diritto di scegliere il proprio errore.", "pages": [{"_id": "e3f5a337ecc65c6b", "name": "Ogni mente ha diritto di scegliere il proprio errore.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Ogni mente ha diritto di scegliere il proprio errore.</em></p><p>Non «correggi» le decisioni altrui, nemmeno quando vedi il burrone e loro no.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 260, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Libertà", "name": "Ogni mente ha diritto di scegliere il proprio errore.", "text": "Ogni mente ha diritto di scegliere il proprio errore.", "gloss": "Non «correggi» le decisioni altrui, nemmeno quando vedi il burrone e loro no."}}}}
{"_id": "95e98687c8232e86", "name": "Il potere non custodito diventa tirannia.", "pages": [{"_id": "29f0d02eb63e6db0", "name": "Il potere non custodito diventa tirannia.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il potere non custodito diventa tirannia.</em></p><p>Sorvegli i potenti (Anziani, Costrutti, alleati) e denunci, anche quando il potente sei tu.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 270, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Libertà", "name": "Il potere non custodito diventa tirannia.", "text": "Il potere non custodito diventa tirannia.", "gloss": "Sorvegli i potenti (Anziani, Costrutti, alleati) e denunci, anche quando il potente sei tu."}}}}
{"_id": "f38f3e4a9ae5b7cd", "name": "Le regole valgono o non valgono per tutti.", "pages": [{"_id": "d89a52f9bb305e19", "name": "Le regole valgono o non valgono per tutti.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Le regole valgono o non valgono per tutti.</em></p><p>Nessuna eccezione per rango, talento o urgenza: il protocollo che pieghi oggi ti piega domani.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 280, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Libertà", "name": "Le regole valgono o non valgono per tutti.", "text": "Le regole valgono o non valgono per tutti.", "gloss": "Nessuna eccezione per rango, talento o urgenza: il protocollo che pieghi oggi ti piega domani."}}}}
{"_id": "23f7ff252cfe3f7e", "name": "Chi non può difendersi va difeso.", "pages": [{"_id": "da582aac64d11c44", "name": "Chi non può difendersi va difeso.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Chi non può difendersi va difeso.</em></p><p>I Dormienti, i nuovi Risvegliati, i piccoli: la tua forza esiste per loro, o non vale niente.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 290, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Libertà", "name": "Chi non può difendersi va difeso.", "text": "Chi non può difendersi va difeso.", "gloss": "I Dormienti, i nuovi Risvegliati, i piccoli: la tua forza esiste per loro, o non vale niente."}}}}
{"_id": "639845d1190940cf", "name": "Meglio il caos libero dell'ordine imposto.", "pages": [{"_id": "b1923b28c18ec8ec", "name": "Meglio il caos libero dell'ordine imposto.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Meglio il caos libero dell'ordine imposto.</em></p><p>Rifiuti la pace comprata con la sottomissione, e sabotarla non ti fa tremare la mano.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 300, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Libertà", "name": "Meglio il caos libero dell'ordine imposto.", "text": "Meglio il caos libero dell'ordine imposto.", "gloss": "Rifiuti la pace comprata con la sottomissione, e sabotarla non ti fa tremare la mano."}}}}
{"_id": "310fdc59875a8c78", "name": "Chi abusa dei più deboli ha perso il diritto alla pietà.", "pages": [{"_id": "3dab84bbf703e34b", "name": "Chi abusa dei più deboli ha perso il diritto alla pietà.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Chi abusa dei più deboli ha perso il diritto alla pietà.</em></p><p>Con i predatori niente mediazioni: si fermano, si consegnano, o peggio.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 310, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Giustizia", "name": "Chi abusa dei più deboli ha perso il diritto alla pietà.", "text": "Chi abusa dei più deboli ha perso il diritto alla pietà.", "gloss": "Con i predatori niente mediazioni: si fermano, si consegnano, o peggio."}}}}
{"_id": "c2cd71fb7efc26e4", "name": "La vendetta è un piatto che non si serve.", "pages": [{"_id": "a610b855b0b27820", "name": "La vendetta è un piatto che non si serve.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La vendetta è un piatto che non si serve.</em></p><p>Giustizia sì, rappresaglia no, e la differenza la tieni tu, quando brucia di più.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 320, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Giustizia", "name": "La vendetta è un piatto che non si serve.", "text": "La vendetta è un piatto che non si serve.", "gloss": "Giustizia sì, rappresaglia no, e la differenza la tieni tu, quando brucia di più."}}}}
{"_id": "e898e0e2e32a1c38", "name": "Ogni colpa merita processo.", "pages": [{"_id": "6830b30f52123e74", "name": "Ogni colpa merita processo.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Ogni colpa merita processo.</em></p><p>Nessuna condanna sommaria: prove, contraddittorio, sentenza. Anche in guerra. Anche per i Caduti.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 330, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Giustizia", "name": "Ogni colpa merita processo.", "text": "Ogni colpa merita processo.", "gloss": "Nessuna condanna sommaria: prove, contraddittorio, sentenza. Anche in guerra. Anche per i Caduti."}}}}
{"_id": "77da3f638ca5cbd4", "name": "Il silenzio davanti all'ingiustizia è complicità.", "pages": [{"_id": "373c89cd42b3eae2", "name": "Il silenzio davanti all'ingiustizia è complicità.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il silenzio davanti all'ingiustizia è complicità.</em></p><p>Parli. Sempre. Anche quando parlare ti costa la copertura, il rango, l'amicizia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 340, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Giustizia", "name": "Il silenzio davanti all'ingiustizia è complicità.", "text": "Il silenzio davanti all'ingiustizia è complicità.", "gloss": "Parli. Sempre. Anche quando parlare ti costa la copertura, il rango, l'amicizia."}}}}
{"_id": "491e1f20440c0d57", "name": "Le colpe dei padri non ricadono sui figli.", "pages": [{"_id": "b99ca80cd4e8a583", "name": "Le colpe dei padri non ricadono sui figli.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Le colpe dei padri non ricadono sui figli.</em></p><p>Non fai pagare a nessuno il sangue, il cognome o la divisa di famiglia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 350, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Giustizia", "name": "Le colpe dei padri non ricadono sui figli.", "text": "Le colpe dei padri non ricadono sui figli.", "gloss": "Non fai pagare a nessuno il sangue, il cognome o la divisa di famiglia."}}}}
{"_id": "300b50b755a643dd", "name": "Prima le vittime, poi i colpevoli.", "pages": [{"_id": "8326bc1954c441db", "name": "Prima le vittime, poi i colpevoli.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Prima le vittime, poi i colpevoli.</em></p><p>Soccorri e metti al sicuro prima di inseguire: la caccia aspetta, il sangue no.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 360, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Giustizia", "name": "Prima le vittime, poi i colpevoli.", "text": "Prima le vittime, poi i colpevoli.", "gloss": "Soccorri e metti al sicuro prima di inseguire: la caccia aspetta, il sangue no."}}}}
{"_id": "affaed5df1a825c6", "name": "La città si protegge da dentro.", "pages": [{"_id": "2970ab73e6837c99", "name": "La città si protegge da dentro.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La città si protegge da dentro.</em></p><p>Il tuo quartiere è giurisdizione tua: ciò che vi accade ti riguarda, chiunque sia il responsabile.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 370, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Giustizia", "name": "La città si protegge da dentro.", "text": "La città si protegge da dentro.", "gloss": "Il tuo quartiere è giurisdizione tua: ciò che vi accade ti riguarda, chiunque sia il responsabile."}}}}
{"_id": "0a171a2564eff560", "name": "Il progresso richiede sacrifici.", "pages": [{"_id": "3e443040ccc6b810", "name": "Il progresso richiede sacrifici.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il progresso richiede sacrifici.</em></p><p>Accetti i costi delle grandi opere, e li dichiari ad alta voce, invece di nasconderli.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 380, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Ordine", "name": "Il progresso richiede sacrifici.", "text": "Il progresso richiede sacrifici.", "gloss": "Accetti i costi delle grandi opere, e li dichiari ad alta voce, invece di nasconderli."}}}}
{"_id": "4a64f1fdfaada1b4", "name": "La disciplina è la prima libertà.", "pages": [{"_id": "77d3d40bd30aa939", "name": "La disciplina è la prima libertà.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La disciplina è la prima libertà.</em></p><p>Niente scorciatoie: l'allenamento, il rito, la preparazione, anche quando la magia farebbe prima.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 390, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Ordine", "name": "La disciplina è la prima libertà.", "text": "La disciplina è la prima libertà.", "gloss": "Niente scorciatoie: l'allenamento, il rito, la preparazione, anche quando la magia farebbe prima."}}}}
{"_id": "f469d2f0237a8e88", "name": "Ogni cosa ha un posto e un tempo.", "pages": [{"_id": "2abafe35ef8de29a", "name": "Ogni cosa ha un posto e un tempo.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Ogni cosa ha un posto e un tempo.</em></p><p>Rispetti gerarchie, procedure e calendari, e pretendi che chi comanda faccia lo stesso.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 400, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Ordine", "name": "Ogni cosa ha un posto e un tempo.", "text": "Ogni cosa ha un posto e un tempo.", "gloss": "Rispetti gerarchie, procedure e calendari, e pretendi che chi comanda faccia lo stesso."}}}}
{"_id": "be72b886ab879aa4", "name": "Il lavoro fatto male è un insulto.", "pages": [{"_id": "777e080b6e9d91f1", "name": "Il lavoro fatto male è un insulto.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il lavoro fatto male è un insulto.</em></p><p>Rifiuti la consegna mediocre, tua o altrui: si rifà, anche a costo di sforare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 410, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Ordine", "name": "Il lavoro fatto male è un insulto.", "text": "Il lavoro fatto male è un insulto.", "gloss": "Rifiuti la consegna mediocre, tua o altrui: si rifà, anche a costo di sforare."}}}}
{"_id": "45fa28dbd0a06196", "name": "La parola misurata vale più della spada.", "pages": [{"_id": "ebb00eacc08fb2fb", "name": "La parola misurata vale più della spada.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La parola misurata vale più della spada.</em></p><p>Prima si tratta, sempre, e chi rompe le trattative per primo ha già perso la tua stima.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 420, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Ordine", "name": "La parola misurata vale più della spada.", "text": "La parola misurata vale più della spada.", "gloss": "Prima si tratta, sempre, e chi rompe le trattative per primo ha già perso la tua stima."}}}}
{"_id": "e44d3ced72a2463f", "name": "Prendi ciò che ti serve, non sprecare mai nulla.", "pages": [{"_id": "0de23cf65200f330", "name": "Prendi ciò che ti serve, non sprecare mai nulla.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Prendi ciò che ti serve, non sprecare mai nulla.</em></p><p>Ricicli, ripari, consumi fino in fondo, e giudichi lo spreco più del furto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 430, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Ordine", "name": "Prendi ciò che ti serve, non sprecare mai nulla.", "text": "Prendi ciò che ti serve, non sprecare mai nulla.", "gloss": "Ricicli, ripari, consumi fino in fondo, e giudichi lo spreco più del furto."}}}}
{"_id": "ba1f1ac03abd4645", "name": "Rispetta la città, e la città rispetterà te.", "pages": [{"_id": "fc3e340bb19bf456", "name": "Rispetta la città, e la città rispetterà te.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Rispetta la città, e la città rispetterà te.</em></p><p>Il cemento è vivo quanto il bosco: non lo ferisci, non lo insudici, ascolti cosa chiede.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 440, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Natura", "name": "Rispetta la città, e la città rispetterà te.", "text": "Rispetta la città, e la città rispetterà te.", "gloss": "Il cemento è vivo quanto il bosco: non lo ferisci, non lo insudici, ascolti cosa chiede."}}}}
{"_id": "26f64f56cbfba735", "name": "La terra non si possiede.", "pages": [{"_id": "3ba60d6fcd58877c", "name": "La terra non si possiede.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La terra non si possiede.</em></p><p>Custodisci i luoghi, non li reciti come proprietà, e i Nodi meno di tutto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 450, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Natura", "name": "La terra non si possiede.", "text": "La terra non si possiede.", "gloss": "Custodisci i luoghi, non li reciti come proprietà, e i Nodi meno di tutto."}}}}
{"_id": "509aed06c7609eb7", "name": "Gli spiriti hanno diritto al loro mondo.", "pages": [{"_id": "29771d3374e172cb", "name": "Gli spiriti hanno diritto al loro mondo.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Gli spiriti hanno diritto al loro mondo.</em></p><p>Niente vincoli forzati, niente evocazioni-schiavitù: si chiede, si paga, si ringrazia.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 460, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Natura", "name": "Gli spiriti hanno diritto al loro mondo.", "text": "Gli spiriti hanno diritto al loro mondo.", "gloss": "Niente vincoli forzati, niente evocazioni-schiavitù: si chiede, si paga, si ringrazia."}}}}
{"_id": "363d975c71d48035", "name": "Il sacro va difeso anche da chi non ci crede.", "pages": [{"_id": "249234ece2e1d9f1", "name": "Il sacro va difeso anche da chi non ci crede.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il sacro va difeso anche da chi non ci crede.</em></p><p>Chiese, cerchi, are e templi di ogni fede: profanare è profanare, punto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 470, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Natura", "name": "Il sacro va difeso anche da chi non ci crede.", "text": "Il sacro va difeso anche da chi non ci crede.", "gloss": "Chiese, cerchi, are e templi di ogni fede: profanare è profanare, punto."}}}}
{"_id": "b1508610ac5a6341", "name": "Ciò che prendi alla natura lo restituisci.", "pages": [{"_id": "704a5ea9b00faf47", "name": "Ciò che prendi alla natura lo restituisci.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Ciò che prendi alla natura lo restituisci.</em></p><p>Ogni raccolto ha il suo contraccambio: sangue, fatica o canto, ma si paga.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 480, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Natura", "name": "Ciò che prendi alla natura lo restituisci.", "text": "Ciò che prendi alla natura lo restituisci.", "gloss": "Ogni raccolto ha il suo contraccambio: sangue, fatica o canto, ma si paga."}}}}
{"_id": "94979763a2fce24e", "name": "Il selvatico non si addomestica.", "pages": [{"_id": "fd5aa6e544c5e3a2", "name": "Il selvatico non si addomestica.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il selvatico non si addomestica.</em></p><p>Non spezzi ciò che è nato libero: bestie, spiriti, tempeste, e nemmeno persone.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 490, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Natura", "name": "Il selvatico non si addomestica.", "text": "Il selvatico non si addomestica.", "gloss": "Non spezzi ciò che è nato libero: bestie, spiriti, tempeste, e nemmeno persone."}}}}
{"_id": "8182f0f86abe245e", "name": "Un difetto che puoi correggere non si lascia.", "pages": [{"_id": "f2bddfaa7fedaf6e", "name": "Un difetto che puoi correggere non si lascia.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Un difetto che puoi correggere non si lascia.</em></p><p><strong>La servi quando</strong> ti fermi a correggere lo storto, tuo o d'altri, anche se costa tempo, pazienza o la pelle.</p><p><strong>La attraversi quando</strong> vedi il difetto, puoi sistemarlo, e passi oltre.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 500, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Arte", "name": "Un difetto che puoi correggere non si lascia.", "text": "Un difetto che puoi correggere non si lascia.", "gloss": "ti fermi a correggere lo storto, tuo o d'altri, anche se costa tempo, pazienza o la pelle", "cross": "vedi il difetto, puoi sistemarlo, e passi oltre", "credo": "arte"}}}}
{"_id": "7496e3628a3f06bf", "name": "Un'opera senza firma non è di nessuno.", "pages": [{"_id": "85061002bd8e1499", "name": "Un'opera senza firma non è di nessuno.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Un'opera senza firma non è di nessuno.</em></p><p><strong>La servi quando</strong> firmi quello che hai fatto anche se la firma ti espone, e ne paghi il prezzo.</p><p><strong>La attraversi quando</strong> neghi che sia opera tua, o lasci che se la prenda un altro.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 510, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Arte", "name": "Un'opera senza firma non è di nessuno.", "text": "Un'opera senza firma non è di nessuno.", "gloss": "firmi quello che hai fatto anche se la firma ti espone, e ne paghi il prezzo", "cross": "neghi che sia opera tua, o lasci che se la prenda un altro", "credo": "arte"}}}}
{"_id": "e8a0f8791b5e93d4", "name": "Migliorare è un dovere, prima che un diritto.", "pages": [{"_id": "b6c4681ce90798fd", "name": "Migliorare è un dovere, prima che un diritto.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Migliorare è un dovere, prima che un diritto.</em></p><p><strong>La servi quando</strong> metti mano a cose e persone per migliorarle senza che te l'abbiano chiesto, e ne rispondi.</p><p><strong>La attraversi quando</strong> lasci una cosa peggio di come l'hai trovata, o la guasti senza rifarla.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 520, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Arte", "name": "Migliorare è un dovere, prima che un diritto.", "text": "Migliorare è un dovere, prima che un diritto.", "gloss": "metti mano a cose e persone per migliorarle senza che te l'abbiano chiesto, e ne rispondi", "cross": "lasci una cosa peggio di come l'hai trovata, o la guasti senza rifarla", "credo": "arte"}}}}
{"_id": "4be079bb5ee83074", "name": "L'opera viene prima delle persone.", "pages": [{"_id": "1f559d73b3f807cb", "name": "L'opera viene prima delle persone.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'opera viene prima delle persone.</em></p><p><strong>La servi quando</strong> fai passare l'opera davanti a qualcuno che ami, anche quando l'opera gli chiede di soffrire.</p><p><strong>La attraversi quando</strong> sacrifichi l'opera per non ferire qualcuno.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 530, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Arte", "name": "L'opera viene prima delle persone.", "text": "L'opera viene prima delle persone.", "gloss": "fai passare l'opera davanti a qualcuno che ami, anche quando l'opera gli chiede di soffrire", "cross": "sacrifichi l'opera per non ferire qualcuno", "credo": "arte"}}}}
{"_id": "0a69ff4adb3d4cac", "name": "Niente è mai finito.", "pages": [{"_id": "f7936671d139b52d", "name": "Niente è mai finito.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Niente è mai finito.</em></p><p><strong>La servi quando</strong> riapri una cosa che tutti davano per chiusa, per rifarla meglio, e ti prendi il disordine che ne esce.</p><p><strong>La attraversi quando</strong> dichiari finita una cosa che sai di poter rifare, per stanchezza o per quieto vivere.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 540, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Arte", "name": "Niente è mai finito.", "text": "Niente è mai finito.", "gloss": "riapri una cosa che tutti davano per chiusa, per rifarla meglio, e ti prendi il disordine che ne esce", "cross": "dichiari finita una cosa che sai di poter rifare, per stanchezza o per quieto vivere", "credo": "arte"}}}}
{"_id": "9510781c6b0b7e33", "name": "Dove c'è un piano manca un pizzico di caos.", "pages": [{"_id": "9a16c337ad7fbdc6", "name": "Dove c'è un piano manca un pizzico di caos.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Dove c'è un piano manca un pizzico di caos.</em></p><p><strong>La servi quando</strong> metti una variazione in ogni cosa organizzata, e a rimetterci è chi contava su di te.</p><p><strong>La attraversi quando</strong> esegui un piano dall'inizio alla fine così com'era scritto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 550, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Caos", "name": "Dove c'è un piano manca un pizzico di caos.", "text": "Dove c'è un piano manca un pizzico di caos.", "gloss": "metti una variazione in ogni cosa organizzata, e a rimetterci è chi contava su di te", "cross": "esegui un piano dall'inizio alla fine così com'era scritto", "credo": "caos"}}}}
{"_id": "9cf2cc9776ab98ac", "name": "Non si esegue un ordine solo perché è un ordine.", "pages": [{"_id": "83f4aab931da78da", "name": "Non si esegue un ordine solo perché è un ordine.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Non si esegue un ordine solo perché è un ordine.</em></p><p><strong>La servi quando</strong> fai un'altra cosa da quella che ti dicono, anche quando era quella che avevi già deciso.</p><p><strong>La attraversi quando</strong> obbedisci a un ordine senza averlo fatto tuo, perché veniva da chi comanda.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 560, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Caos", "name": "Non si esegue un ordine solo perché è un ordine.", "text": "Non si esegue un ordine solo perché è un ordine.", "gloss": "fai un'altra cosa da quella che ti dicono, anche quando era quella che avevi già deciso", "cross": "obbedisci a un ordine senza averlo fatto tuo, perché veniva da chi comanda", "credo": "caos"}}}}
{"_id": "d65edd21a6612f29", "name": "Nessuna abitudine merita di durare per inerzia.", "pages": [{"_id": "0ce11fa6c5293a1b", "name": "Nessuna abitudine merita di durare per inerzia.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Nessuna abitudine merita di durare per inerzia.</em></p><p><strong>La servi quando</strong> rompi il ritmo di cose che vanno avanti da anni e stanno comode a tutti.</p><p><strong>La attraversi quando</strong> lasci correre un'abitudine che hai visto, perché romperla costava fatica.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 570, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Caos", "name": "Nessuna abitudine merita di durare per inerzia.", "text": "Nessuna abitudine merita di durare per inerzia.", "gloss": "rompi il ritmo di cose che vanno avanti da anni e stanno comode a tutti", "cross": "lasci correre un'abitudine che hai visto, perché romperla costava fatica", "credo": "caos"}}}}
{"_id": "e7bf4f67d8668092", "name": "Nessuno resta chiuso in un ordine che non ha scelto.", "pages": [{"_id": "ec489d68e30dd087", "name": "Nessuno resta chiuso in un ordine che non ha scelto.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Nessuno resta chiuso in un ordine che non ha scelto.</em></p><p><strong>La servi quando</strong> apri gabbie, patti e ruoli altrui senza chiederti se chi era dentro sa vivere fuori.</p><p><strong>La attraversi quando</strong> tieni chiuso qualcuno in un patto o in un ruolo che non ha scelto, o lo richiudi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 580, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Caos", "name": "Nessuno resta chiuso in un ordine che non ha scelto.", "text": "Nessuno resta chiuso in un ordine che non ha scelto.", "gloss": "apri gabbie, patti e ruoli altrui senza chiederti se chi era dentro sa vivere fuori", "cross": "tieni chiuso qualcuno in un patto o in un ruolo che non ha scelto, o lo richiudi", "credo": "caos"}}}}
{"_id": "56736d59e6b24fe4", "name": "Una situazione del tutto sotto controllo va rotta.", "pages": [{"_id": "0c2bed3d7f7891d1", "name": "Una situazione del tutto sotto controllo va rotta.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Una situazione del tutto sotto controllo va rotta.</em></p><p><strong>La servi quando</strong> mandi per aria l'ordine perfetto, anche quando l'hai costruito tu e ti stava riuscendo.</p><p><strong>La attraversi quando</strong> vedi tutto sotto controllo e lo lasci lì, perché ti conveniva.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 590, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Caos", "name": "Una situazione del tutto sotto controllo va rotta.", "text": "Una situazione del tutto sotto controllo va rotta.", "gloss": "mandi per aria l'ordine perfetto, anche quando l'hai costruito tu e ti stava riuscendo", "cross": "vedi tutto sotto controllo e lo lasci lì, perché ti conveniva", "credo": "caos"}}}}
{"_id": "5b7491d7208c364b", "name": "Le scorciatoie sono necessarie.", "pages": [{"_id": "094cf39877d6aab8", "name": "Le scorciatoie sono necessarie.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Le scorciatoie sono necessarie.</em></p><p><strong>La servi quando</strong> non prendi mai la via lunga, nemmeno quando era l'unica pulita.</p><p><strong>La attraversi quando</strong> fai tutta la strada per intero quando c'era un passaggio da saltare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 600, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Dati", "name": "Le scorciatoie sono necessarie.", "text": "Le scorciatoie sono necessarie.", "gloss": "non prendi mai la via lunga, nemmeno quando era l'unica pulita", "cross": "fai tutta la strada per intero quando c'era un passaggio da saltare", "credo": "dati"}}}}
{"_id": "082a0dbffa999593", "name": "Una regola non dichiarata non va seguita.", "pages": [{"_id": "5602cd85db8617d6", "name": "Una regola non dichiarata non va seguita.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Una regola non dichiarata non va seguita.</em></p><p><strong>La servi quando</strong> consuetudini, tatto e buone maniere non ti vincolano, e chi ti sta intorno se ne accorge.</p><p><strong>La attraversi quando</strong> ti pieghi a una regola che nessuno ha scritto, per riguardo o per quieto vivere.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 610, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Dati", "name": "Una regola non dichiarata non va seguita.", "text": "Una regola non dichiarata non va seguita.", "gloss": "consuetudini, tatto e buone maniere non ti vincolano, e chi ti sta intorno se ne accorge", "cross": "ti pieghi a una regola che nessuno ha scritto, per riguardo o per quieto vivere", "credo": "dati"}}}}
{"_id": "cfb9a32fad6aa315", "name": "Non esiste niente di inviolabile.", "pages": [{"_id": "740fe929ad0c93bf", "name": "Non esiste niente di inviolabile.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Non esiste niente di inviolabile.</em></p><p><strong>La servi quando</strong> davanti a una cosa che tutti danno per chiusa ci provi, anche se aprirla non ti serve.</p><p><strong>La attraversi quando</strong> lasci chiusa una cosa perché ti hanno detto che non si apre.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 620, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Dati", "name": "Non esiste niente di inviolabile.", "text": "Non esiste niente di inviolabile.", "gloss": "davanti a una cosa che tutti danno per chiusa ci provi, anche se aprirla non ti serve", "cross": "lasci chiusa una cosa perché ti hanno detto che non si apre", "credo": "dati"}}}}
{"_id": "8ef9e3cb24af8b00", "name": "L'ordine delle cose è un suggerimento.", "pages": [{"_id": "8bfab092e06a4b91", "name": "L'ordine delle cose è un suggerimento.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'ordine delle cose è un suggerimento.</em></p><p><strong>La servi quando</strong> salti passaggi, turni e procedure, e il conto lo paga chi stava seguendo l'ordine.</p><p><strong>La attraversi quando</strong> rispetti la fila, il turno e la procedura fino in fondo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 630, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Dati", "name": "L'ordine delle cose è un suggerimento.", "text": "L'ordine delle cose è un suggerimento.", "gloss": "salti passaggi, turni e procedure, e il conto lo paga chi stava seguendo l'ordine", "cross": "rispetti la fila, il turno e la procedura fino in fondo", "credo": "dati"}}}}
{"_id": "22687411d16cc453", "name": "Nessuno è costretto a recitare la sua parte.", "pages": [{"_id": "f126b7dfc7cf7c83", "name": "Nessuno è costretto a recitare la sua parte.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Nessuno è costretto a recitare la sua parte.</em></p><p><strong>La servi quando</strong> quando vedi qualcuno eseguire un copione glielo rompi, in pubblico.</p><p><strong>La attraversi quando</strong> reciti la tua parte, o lasci che un altro reciti la sua, per non fare scena.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 640, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Dati", "name": "Nessuno è costretto a recitare la sua parte.", "text": "Nessuno è costretto a recitare la sua parte.", "gloss": "quando vedi qualcuno eseguire un copione glielo rompi, in pubblico", "cross": "reciti la tua parte, o lasci che un altro reciti la sua, per non fare scena", "credo": "dati"}}}}
{"_id": "7db0157ec75fc941", "name": "Nessuna partita è chiusa.", "pages": [{"_id": "85a3bb552eb56284", "name": "Nessuna partita è chiusa.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Nessuna partita è chiusa.</em></p><p><strong>La servi quando</strong> torni su faccende archiviate e ci spendi tempo, mentre quello da fare adesso aspetta.</p><p><strong>La attraversi quando</strong> accetti un esito come definitivo e chiudi la partita.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 650, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Dati", "name": "Nessuna partita è chiusa.", "text": "Nessuna partita è chiusa.", "gloss": "torni su faccende archiviate e ci spendi tempo, mentre quello da fare adesso aspetta", "cross": "accetti un esito come definitivo e chiudi la partita", "credo": "dati"}}}}
{"_id": "1fee4099dccd5357", "name": "Chiunque merita un'altra occasione.", "pages": [{"_id": "fe5c8ca7515fbb65", "name": "Chiunque merita un'altra occasione.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Chiunque merita un'altra occasione.</em></p><p><strong>La servi quando</strong> la dai anche a chi ti ha mentito, prima di aver contato quanto ti è costata la prima.</p><p><strong>La attraversi quando</strong> chiudi la porta a qualcuno perché ha già sbagliato una volta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 660, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Fede", "name": "Chiunque merita un'altra occasione.", "text": "Chiunque merita un'altra occasione.", "gloss": "la dai anche a chi ti ha mentito, prima di aver contato quanto ti è costata la prima", "cross": "chiudi la porta a qualcuno perché ha già sbagliato una volta", "credo": "fede"}}}}
{"_id": "787e56d78d9ce748", "name": "A chi chiede aiuto non si dice di no.", "pages": [{"_id": "8de56b504df696e3", "name": "A chi chiede aiuto non si dice di no.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>A chi chiede aiuto non si dice di no.</em></p><p><strong>La servi quando</strong> molli quello che stavi facendo e chi ti aspettava, e vai.</p><p><strong>La attraversi quando</strong> dici di no a chi ti chiede aiuto, o fai finta di non aver sentito.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 670, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Fede", "name": "A chi chiede aiuto non si dice di no.", "text": "A chi chiede aiuto non si dice di no.", "gloss": "molli quello che stavi facendo e chi ti aspettava, e vai", "cross": "dici di no a chi ti chiede aiuto, o fai finta di non aver sentito", "credo": "fede"}}}}
{"_id": "eeed27188a9e6da3", "name": "Fra la via prudente e quella che chiede di affidarsi, si prende la seconda.", "pages": [{"_id": "12ed0719f63306d5", "name": "Fra la via prudente e quella che chiede di affidarsi, si prende la seconda.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Fra la via prudente e quella che chiede di affidarsi, si prende la seconda.</em></p><p><strong>La servi quando</strong> scegli il salto ogni volta, e quando la Provvidenza tarda paghi con quello che avevi.</p><p><strong>La attraversi quando</strong> prendi la via prudente perché il salto costava troppo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 680, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Fede", "name": "Fra la via prudente e quella che chiede di affidarsi, si prende la seconda.", "text": "Fra la via prudente e quella che chiede di affidarsi, si prende la seconda.", "gloss": "scegli il salto ogni volta, e quando la Provvidenza tarda paghi con quello che avevi", "cross": "prendi la via prudente perché il salto costava troppo", "credo": "fede"}}}}
{"_id": "5f3ea99aa68af62c", "name": "Quello che accade va accolto per com'è accaduto.", "pages": [{"_id": "bf8e77d16894d855", "name": "Quello che accade va accolto per com'è accaduto.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Quello che accade va accolto per com'è accaduto.</em></p><p><strong>La servi quando</strong> non rimpiangi ad alta voce la versione che avresti preferito, neanche davanti a un lutto.</p><p><strong>La attraversi quando</strong> ti lamenti di com'è andata, o provi a rifare l'accaduto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 690, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Fede", "name": "Quello che accade va accolto per com'è accaduto.", "text": "Quello che accade va accolto per com'è accaduto.", "gloss": "non rimpiangi ad alta voce la versione che avresti preferito, neanche davanti a un lutto", "cross": "ti lamenti di com'è andata, o provi a rifare l'accaduto", "credo": "fede"}}}}
{"_id": "812a12d95d122708", "name": "Portarsi una difesa è già non fidarsi.", "pages": [{"_id": "fde52d098b50726f", "name": "Portarsi una difesa è già non fidarsi.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Portarsi una difesa è già non fidarsi.</em></p><p><strong>La servi quando</strong> vai disarmato dove servirebbe essere armati, e ci porti chi è venuto con te.</p><p><strong>La attraversi quando</strong> ti porti un'arma, una scorta o una via d'uscita per ogni evenienza.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 700, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Fede", "name": "Portarsi una difesa è già non fidarsi.", "text": "Portarsi una difesa è già non fidarsi.", "gloss": "vai disarmato dove servirebbe essere armati, e ci porti chi è venuto con te", "cross": "ti porti un'arma, una scorta o una via d'uscita per ogni evenienza", "credo": "fede"}}}}
{"_id": "e3e47fb95a821335", "name": "Il mondo va messo alla prova ogni volta che sorprende.", "pages": [{"_id": "e6a03c46bb43c0cb", "name": "Il mondo va messo alla prova ogni volta che sorprende.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il mondo va messo alla prova ogni volta che sorprende.</em></p><p><strong>La servi quando</strong> fai il gesto impossibile davanti a chiunque ci sia, senza curarti di chi guarda.</p><p><strong>La attraversi quando</strong> accetti una sorpresa del mondo senza provarla, per non dare spettacolo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 710, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Illusione", "name": "Il mondo va messo alla prova ogni volta che sorprende.", "text": "Il mondo va messo alla prova ogni volta che sorprende.", "gloss": "fai il gesto impossibile davanti a chiunque ci sia, senza curarti di chi guarda", "cross": "accetti una sorpresa del mondo senza provarla, per non dare spettacolo", "credo": "illusione"}}}}
{"_id": "a6abc1cf7e867ff6", "name": "La forma di un danno non conta.", "pages": [{"_id": "88fd2bda620fb6d9", "name": "La forma di un danno non conta.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La forma di un danno non conta.</em></p><p><strong>La servi quando</strong> non rimedi a ferite, perdite e porte chiuse, perché ripararle sarebbe dargli ragione.</p><p><strong>La attraversi quando</strong> curi una ferita, ripari un danno o riapri una porta come se fossero veri.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 720, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Illusione", "name": "La forma di un danno non conta.", "text": "La forma di un danno non conta.", "gloss": "non rimedi a ferite, perdite e porte chiuse, perché ripararle sarebbe dargli ragione", "cross": "curi una ferita, ripari un danno o riapri una porta come se fossero veri", "credo": "illusione"}}}}
{"_id": "8dd46623246e54aa", "name": "Le regole del mondo sono fondali dipinti.", "pages": [{"_id": "0f51dba45bc0499c", "name": "Le regole del mondo sono fondali dipinti.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Le regole del mondo sono fondali dipinti.</em></p><p><strong>La servi quando</strong> file, porte chiuse, permessi e turni li attraversi, e per il buco paga chi era in fila.</p><p><strong>La attraversi quando</strong> rispetti una fila, un permesso o un turno perché lo fanno tutti.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 730, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Illusione", "name": "Le regole del mondo sono fondali dipinti.", "text": "Le regole del mondo sono fondali dipinti.", "gloss": "file, porte chiuse, permessi e turni li attraversi, e per il buco paga chi era in fila", "cross": "rispetti una fila, un permesso o un turno perché lo fanno tutti", "credo": "illusione"}}}}
{"_id": "542135dc58f024d1", "name": "Chi soffre va svegliato.", "pages": [{"_id": "8e37143edd64df48", "name": "Chi soffre va svegliato.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Chi soffre va svegliato.</em></p><p><strong>La servi quando</strong> spieghi a chi sta male che sta sognando, e insisti finché non ti ascolta.</p><p><strong>La attraversi quando</strong> consoli chi soffre dentro il sogno, o lo lasci soffrire in pace.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 740, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Illusione", "name": "Chi soffre va svegliato.", "text": "Chi soffre va svegliato.", "gloss": "spieghi a chi sta male che sta sognando, e insisti finché non ti ascolta", "cross": "consoli chi soffre dentro il sogno, o lo lasci soffrire in pace", "credo": "illusione"}}}}
{"_id": "9d2be093b9a23f4e", "name": "Da un sogno si esce.", "pages": [{"_id": "9bc36e9e6e24870c", "name": "Da un sogno si esce.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Da un sogno si esce.</em></p><p><strong>La servi quando</strong> davanti a un fallimento, a una morte o a un limite cerchi l'uscita, e la cerchi su di te.</p><p><strong>La attraversi quando</strong> accetti un limite, una perdita o una fine come definitivi.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 750, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Illusione", "name": "Da un sogno si esce.", "text": "Da un sogno si esce.", "gloss": "davanti a un fallimento, a una morte o a un limite cerchi l'uscita, e la cerchi su di te", "cross": "accetti un limite, una perdita o una fine come definitivi", "credo": "illusione"}}}}
{"_id": "e5ead9227f1e5930", "name": "Le cose si fanno nel modo giusto, non nel modo veloce.", "pages": [{"_id": "53301aa7ac0d7467", "name": "Le cose si fanno nel modo giusto, non nel modo veloce.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Le cose si fanno nel modo giusto, non nel modo veloce.</em></p><p><strong>La servi quando</strong> non salti un passaggio nemmeno quando non cambierebbe niente e tutti aspettano te.</p><p><strong>La attraversi quando</strong> prendi la via veloce e salti un passaggio perché tanto non lo vedeva nessuno.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 760, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Legge", "name": "Le cose si fanno nel modo giusto, non nel modo veloce.", "text": "Le cose si fanno nel modo giusto, non nel modo veloce.", "gloss": "non salti un passaggio nemmeno quando non cambierebbe niente e tutti aspettano te", "cross": "prendi la via veloce e salti un passaggio perché tanto non lo vedeva nessuno", "credo": "legge"}}}}
{"_id": "9f956a0b60960c61", "name": "Casi uguali, decisioni uguali.", "pages": [{"_id": "9ee88fc0caa9daf4", "name": "Casi uguali, decisioni uguali.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Casi uguali, decisioni uguali.</em></p><p><strong>La servi quando</strong> nessuna eccezione, men che meno per chi ti sta a cuore, e chi ti sta a cuore lo capisce.</p><p><strong>La attraversi quando</strong> fai un'eccezione per qualcuno che ti è vicino, o per te.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 770, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Legge", "name": "Casi uguali, decisioni uguali.", "text": "Casi uguali, decisioni uguali.", "gloss": "nessuna eccezione, men che meno per chi ti sta a cuore, e chi ti sta a cuore lo capisce", "cross": "fai un'eccezione per qualcuno che ti è vicino, o per te", "credo": "legge"}}}}
{"_id": "a377ad76e21d7206", "name": "Ognuno risponde di ciò che gli compete.", "pages": [{"_id": "3d099f6909101a9e", "name": "Ognuno risponde di ciò che gli compete.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Ognuno risponde di ciò che gli compete.</em></p><p><strong>La servi quando</strong> non tocchi ciò che non è tuo e vuoi che se ne occupi chi ha titolo, anche se peggiora.</p><p><strong>La attraversi quando</strong> metti mano a una faccenda che non ti compete perché nessun altro si muoveva.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 780, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Legge", "name": "Ognuno risponde di ciò che gli compete.", "text": "Ognuno risponde di ciò che gli compete.", "gloss": "non tocchi ciò che non è tuo e vuoi che se ne occupi chi ha titolo, anche se peggiora", "cross": "metti mano a una faccenda che non ti compete perché nessun altro si muoveva", "credo": "legge"}}}}
{"_id": "e6c910bf103332d6", "name": "Una violazione fatta davanti a te va contestata.", "pages": [{"_id": "5036bc5879013441", "name": "Una violazione fatta davanti a te va contestata.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Una violazione fatta davanti a te va contestata.</em></p><p><strong>La servi quando</strong> chiedi conto e titolo a chiunque, sul posto, e chi non li dimostra lo blocchi lì.</p><p><strong>La attraversi quando</strong> vedi una violazione e lasci correre, per prudenza o per fretta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 790, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Legge", "name": "Una violazione fatta davanti a te va contestata.", "text": "Una violazione fatta davanti a te va contestata.", "gloss": "chiedi conto e titolo a chiunque, sul posto, e chi non li dimostra lo blocchi lì", "cross": "vedi una violazione e lasci correre, per prudenza o per fretta", "credo": "legge"}}}}
{"_id": "076b6f56ab8cfdc7", "name": "Una conseguenza stabilita si esegue fino in fondo.", "pages": [{"_id": "5a0430557ebdb7a3", "name": "Una conseguenza stabilita si esegue fino in fondo.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Una conseguenza stabilita si esegue fino in fondo.</em></p><p><strong>La servi quando</strong> la pietà non va a verbale, e vale anche il giorno in cui in torto è uno dei tuoi.</p><p><strong>La attraversi quando</strong> sospendi o addolcisci una conseguenza già stabilita, per pietà o per convenienza.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 800, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Legge", "name": "Una conseguenza stabilita si esegue fino in fondo.", "text": "Una conseguenza stabilita si esegue fino in fondo.", "gloss": "la pietà non va a verbale, e vale anche il giorno in cui in torto è uno dei tuoi", "cross": "sospendi o addolcisci una conseguenza già stabilita, per pietà o per convenienza", "credo": "legge"}}}}
{"_id": "c53da294dd86eb33", "name": "Una cosa che funziona senza che tu sappia perché non si lascia lì.", "pages": [{"_id": "b6069a7d0bcff4de", "name": "Una cosa che funziona senza che tu sappia perché non si lascia lì.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Una cosa che funziona senza che tu sappia perché non si lascia lì.</em></p><p><strong>La servi quando</strong> ti fermi a capirla prima di occuparti d'altro, qualunque cosa succeda intorno.</p><p><strong>La attraversi quando</strong> usi una cosa che funziona senza sapere perché, e passi oltre.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 810, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Macchina", "name": "Una cosa che funziona senza che tu sappia perché non si lascia lì.", "text": "Una cosa che funziona senza che tu sappia perché non si lascia lì.", "gloss": "ti fermi a capirla prima di occuparti d'altro, qualunque cosa succeda intorno", "cross": "usi una cosa che funziona senza sapere perché, e passi oltre", "credo": "macchina"}}}}
{"_id": "630d9c36160f665e", "name": "Un lavoro si fa a regola d'arte.", "pages": [{"_id": "d22b835be505cf6a", "name": "Un lavoro si fa a regola d'arte.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Un lavoro si fa a regola d'arte.</em></p><p><strong>La servi quando</strong> rifiuti la consegna fatta in fretta, tua o altrui, e gli altri aspettano.</p><p><strong>La attraversi quando</strong> consegni un lavoro fatto in fretta, o accetti quello di un altro.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 820, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Macchina", "name": "Un lavoro si fa a regola d'arte.", "text": "Un lavoro si fa a regola d'arte.", "gloss": "rifiuti la consegna fatta in fretta, tua o altrui, e gli altri aspettano", "cross": "consegni un lavoro fatto in fretta, o accetti quello di un altro", "credo": "macchina"}}}}
{"_id": "c4b51b38719a4e86", "name": "Ognuno sta al posto che il meccanismo gli ha dato.", "pages": [{"_id": "4aeddd7e26b66d4d", "name": "Ognuno sta al posto che il meccanismo gli ha dato.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Ognuno sta al posto che il meccanismo gli ha dato.</em></p><p><strong>La servi quando</strong> riporti al suo posto chi ne esce, anche se glielo hai dato tu e gli sta stretto.</p><p><strong>La attraversi quando</strong> lasci che qualcuno esca dal suo posto, o ne esci tu.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 830, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Macchina", "name": "Ognuno sta al posto che il meccanismo gli ha dato.", "text": "Ognuno sta al posto che il meccanismo gli ha dato.", "gloss": "riporti al suo posto chi ne esce, anche se glielo hai dato tu e gli sta stretto", "cross": "lasci che qualcuno esca dal suo posto, o ne esci tu", "credo": "macchina"}}}}
{"_id": "51e9ba406649ea05", "name": "Un pezzo che non rende si sostituisce.", "pages": [{"_id": "e5085a82910ebe76", "name": "Un pezzo che non rende si sostituisce.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Un pezzo che non rende si sostituisce.</em></p><p><strong>La servi quando</strong> cambi invece di riparare, e non tieni il lutto per una biella, nemmeno se aveva un nome.</p><p><strong>La attraversi quando</strong> ripari e tieni un pezzo che non rende, per affetto o per abitudine.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 840, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Macchina", "name": "Un pezzo che non rende si sostituisce.", "text": "Un pezzo che non rende si sostituisce.", "gloss": "cambi invece di riparare, e non tieni il lutto per una biella, nemmeno se aveva un nome", "cross": "ripari e tieni un pezzo che non rende, per affetto o per abitudine", "credo": "macchina"}}}}
{"_id": "df71721ab6f205dd", "name": "Prima il problema, poi quello che provi.", "pages": [{"_id": "5b14cf69dcd00c55", "name": "Prima il problema, poi quello che provi.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Prima il problema, poi quello che provi.</em></p><p><strong>La servi quando</strong> risolvi il guasto e rimandi il sentimento, e chi ti stava accanto se lo ricorda per anni.</p><p><strong>La attraversi quando</strong> ti fermi su quello che provi mentre il guasto è ancora aperto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 850, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Macchina", "name": "Prima il problema, poi quello che provi.", "text": "Prima il problema, poi quello che provi.", "gloss": "risolvi il guasto e rimandi il sentimento, e chi ti stava accanto se lo ricorda per anni", "cross": "ti fermi su quello che provi mentre il guasto è ancora aperto", "credo": "macchina"}}}}
{"_id": "3a0c18e1116d4b81", "name": "Quello che sta cedendo si sorregge.", "pages": [{"_id": "354b05046d0f8f42", "name": "Quello che sta cedendo si sorregge.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Quello che sta cedendo si sorregge.</em></p><p><strong>La servi quando</strong> ci metti sotto una mano per un momento, e quel puntello resti tu per anni.</p><p><strong>La attraversi quando</strong> lasci cadere una cosa che stava cedendo davanti a te, perché non era tua.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 860, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Polvere", "name": "Quello che sta cedendo si sorregge.", "text": "Quello che sta cedendo si sorregge.", "gloss": "ci metti sotto una mano per un momento, e quel puntello resti tu per anni", "cross": "lasci cadere una cosa che stava cedendo davanti a te, perché non era tua", "credo": "polvere"}}}}
{"_id": "a7f6790961ea21fe", "name": "Niente va perduto finché c'è qualcuno che può occuparsene.", "pages": [{"_id": "e2ab219171199801", "name": "Niente va perduto finché c'è qualcuno che può occuparsene.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Niente va perduto finché c'è qualcuno che può occuparsene.</em></p><p><strong>La servi quando</strong> ti carichi di roba che non era tua, e chi l'aveva mollata non torna a riprendersela.</p><p><strong>La attraversi quando</strong> lasci andare perduta una cosa di cui avresti potuto occuparti.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 870, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Polvere", "name": "Niente va perduto finché c'è qualcuno che può occuparsene.", "text": "Niente va perduto finché c'è qualcuno che può occuparsene.", "gloss": "ti carichi di roba che non era tua, e chi l'aveva mollata non torna a riprendersela", "cross": "lasci andare perduta una cosa di cui avresti potuto occuparti", "credo": "polvere"}}}}
{"_id": "14693c42784b0f33", "name": "La spugna non si getta.", "pages": [{"_id": "6e9fa1e51eb31596", "name": "La spugna non si getta.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La spugna non si getta.</em></p><p><strong>La servi quando</strong> resti anche quando la mossa giusta sarebbe mollare, e ci tiri dentro chi aveva smesso.</p><p><strong>La attraversi quando</strong> molli una faccenda perché i conti dicevano di mollare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 880, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Polvere", "name": "La spugna non si getta.", "text": "La spugna non si getta.", "gloss": "resti anche quando la mossa giusta sarebbe mollare, e ci tiri dentro chi aveva smesso", "cross": "molli una faccenda perché i conti dicevano di mollare", "credo": "polvere"}}}}
{"_id": "fc0765a23a0a45de", "name": "Finché resta tempo, si sorregge.", "pages": [{"_id": "44486e6acc69e17c", "name": "Finché resta tempo, si sorregge.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Finché resta tempo, si sorregge.</em></p><p><strong>La servi quando</strong> rispondi di sì anche quando i conti dicono di no, e i conti li sai fare benissimo.</p><p><strong>La attraversi quando</strong> dichiari finita una cosa a cui restava ancora del tempo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 890, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Polvere", "name": "Finché resta tempo, si sorregge.", "text": "Finché resta tempo, si sorregge.", "gloss": "rispondi di sì anche quando i conti dicono di no, e i conti li sai fare benissimo", "cross": "dichiari finita una cosa a cui restava ancora del tempo", "credo": "polvere"}}}}
{"_id": "f105f9a3fafc96b0", "name": "Chi è rimasto l'unico sostegno non si sfila.", "pages": [{"_id": "70974cc7b4259814", "name": "Chi è rimasto l'unico sostegno non si sfila.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Chi è rimasto l'unico sostegno non si sfila.</em></p><p><strong>La servi quando</strong> continui a sorreggere finché ci sei, e quello che serviva a te lo spendi lì.</p><p><strong>La attraversi quando</strong> ti sfili da una cosa di cui eri rimasto l'unico sostegno.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 900, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Polvere", "name": "Chi è rimasto l'unico sostegno non si sfila.", "text": "Chi è rimasto l'unico sostegno non si sfila.", "gloss": "continui a sorreggere finché ci sei, e quello che serviva a te lo spendi lì", "cross": "ti sfili da una cosa di cui eri rimasto l'unico sostegno", "credo": "polvere"}}}}
{"_id": "73dd9ef161e1ced2", "name": "Una sconfitta davanti a testimoni si pareggia.", "pages": [{"_id": "9145caf988837cd5", "name": "Una sconfitta davanti a testimoni si pareggia.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Una sconfitta davanti a testimoni si pareggia.</em></p><p><strong>La servi quando</strong> non lasci correre una gara, un conto o una discussione persa in pubblico, e ci torni.</p><p><strong>La attraversi quando</strong> incassi una sconfitta pubblica e la lasci lì.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 910, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Potere", "name": "Una sconfitta davanti a testimoni si pareggia.", "text": "Una sconfitta davanti a testimoni si pareggia.", "gloss": "non lasci correre una gara, un conto o una discussione persa in pubblico, e ci torni", "cross": "incassi una sconfitta pubblica e la lasci lì", "credo": "potere"}}}}
{"_id": "77df3cb879e86980", "name": "In una stanza si sa subito chi comanda.", "pages": [{"_id": "e0c4e3a46bcad25a", "name": "In una stanza si sa subito chi comanda.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>In una stanza si sa subito chi comanda.</em></p><p><strong>La servi quando</strong> entri in un gruppo che ha già un capo e glielo fai sentire, anche se ti conveniva tacere.</p><p><strong>La attraversi quando</strong> lasci comandare un altro in una stanza in cui c'eri anche tu.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 920, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Potere", "name": "In una stanza si sa subito chi comanda.", "text": "In una stanza si sa subito chi comanda.", "gloss": "entri in un gruppo che ha già un capo e glielo fai sentire, anche se ti conveniva tacere", "cross": "lasci comandare un altro in una stanza in cui c'eri anche tu", "credo": "potere"}}}}
{"_id": "098500f0de7342e5", "name": "Chiedere aiuto è cedere.", "pages": [{"_id": "43fff690bd6a6ec5", "name": "Chiedere aiuto è cedere.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Chiedere aiuto è cedere.</em></p><p><strong>La servi quando</strong> o da solo o niente, e chi ti vuole bene impara che non serve nemmeno offrirsi.</p><p><strong>La attraversi quando</strong> chiedi aiuto, o accetti quello che ti viene offerto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 930, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Potere", "name": "Chiedere aiuto è cedere.", "text": "Chiedere aiuto è cedere.", "gloss": "o da solo o niente, e chi ti vuole bene impara che non serve nemmeno offrirsi", "cross": "chiedi aiuto, o accetti quello che ti viene offerto", "credo": "potere"}}}}
{"_id": "907160f88e9fcb2c", "name": "Una sfida aperta si accetta e si rilancia.", "pages": [{"_id": "230e4302b4b11fdc", "name": "Una sfida aperta si accetta e si rilancia.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Una sfida aperta si accetta e si rilancia.</em></p><p><strong>La servi quando</strong> qualunque sia la posta, e la posta la scelgono gli altri sapendo come sei fatto.</p><p><strong>La attraversi quando</strong> rifiuti una sfida aperta, o la accetti senza rilanciare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 940, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Potere", "name": "Una sfida aperta si accetta e si rilancia.", "text": "Una sfida aperta si accetta e si rilancia.", "gloss": "qualunque sia la posta, e la posta la scelgono gli altri sapendo come sei fatto", "cross": "rifiuti una sfida aperta, o la accetti senza rilanciare", "credo": "potere"}}}}
{"_id": "3ec9ce10bc25d691", "name": "Gli dèi non si nascondono.", "pages": [{"_id": "e66344cce677684b", "name": "Gli dèi non si nascondono.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Gli dèi non si nascondono.</em></p><p><strong>La servi quando</strong> ti fai vedere anche quando passare inosservato ti avrebbe dato quello che volevi.</p><p><strong>La attraversi quando</strong> ti nascondi, ti travesti o lasci che il merito vada a un altro.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 950, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Potere", "name": "Gli dèi non si nascondono.", "text": "Gli dèi non si nascondono.", "gloss": "ti fai vedere anche quando passare inosservato ti avrebbe dato quello che volevi", "cross": "ti nascondi, ti travesti o lasci che il merito vada a un altro", "credo": "potere"}}}}
{"_id": "482451489c447f2a", "name": "In casa d'altri si saluta chi ci veglia.", "pages": [{"_id": "23a692c533f6be5e", "name": "In casa d'altri si saluta chi ci veglia.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>In casa d'altri si saluta chi ci veglia.</em></p><p><strong>La servi quando</strong> saluti entrando in ogni posto nuovo, davanti a chiunque, e ti tieni la faccia che fanno.</p><p><strong>La attraversi quando</strong> entri in un posto nuovo senza salutare chi ci veglia, per fretta o per vergogna.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 960, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Sacro", "name": "In casa d'altri si saluta chi ci veglia.", "text": "In casa d'altri si saluta chi ci veglia.", "gloss": "saluti entrando in ogni posto nuovo, davanti a chiunque, e ti tieni la faccia che fanno", "cross": "entri in un posto nuovo senza salutare chi ci veglia, per fretta o per vergogna", "credo": "sacro"}}}}
{"_id": "c9fbb2c801dcf02e", "name": "Non si chiede senza lasciare un pegno.", "pages": [{"_id": "cda15e2cbf982c82", "name": "Non si chiede senza lasciare un pegno.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Non si chiede senza lasciare un pegno.</em></p><p><strong>La servi quando</strong> ogni richiesta a una potenza costa qualcosa di tuo, e cosa sia lo decide lei.</p><p><strong>La attraversi quando</strong> chiedi qualcosa a una potenza e te ne vai senza lasciare niente.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 970, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Sacro", "name": "Non si chiede senza lasciare un pegno.", "text": "Non si chiede senza lasciare un pegno.", "gloss": "ogni richiesta a una potenza costa qualcosa di tuo, e cosa sia lo decide lei", "cross": "chiedi qualcosa a una potenza e te ne vai senza lasciare niente", "credo": "sacro"}}}}
{"_id": "6fdb4c15f9fc3724", "name": "Un favore ricevuto si rende quando viene chiesto.", "pages": [{"_id": "55b2181703b56ad1", "name": "Un favore ricevuto si rende quando viene chiesto.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Un favore ricevuto si rende quando viene chiesto.</em></p><p><strong>La servi quando</strong> chi ti ha aiutato viene servito prima di tutto, comprese le cose che non aspettano.</p><p><strong>La attraversi quando</strong> rimandi o rifiuti il servizio a chi ti aveva aiutato.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 980, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Sacro", "name": "Un favore ricevuto si rende quando viene chiesto.", "text": "Un favore ricevuto si rende quando viene chiesto.", "gloss": "chi ti ha aiutato viene servito prima di tutto, comprese le cose che non aspettano", "cross": "rimandi o rifiuti il servizio a chi ti aveva aiutato", "credo": "sacro"}}}}
{"_id": "d78a94a468395322", "name": "I riti dovuti non si abbreviano.", "pages": [{"_id": "01a74829c1042a77", "name": "I riti dovuti non si abbreviano.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>I riti dovuti non si abbreviano.</em></p><p><strong>La servi quando</strong> li compi per intero prima di occuparti d'altro, e il mondo intanto va avanti senza di te.</p><p><strong>La attraversi quando</strong> accorci o salti un rito dovuto perché non c'era tempo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 990, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Sacro", "name": "I riti dovuti non si abbreviano.", "text": "I riti dovuti non si abbreviano.", "gloss": "li compi per intero prima di occuparti d'altro, e il mondo intanto va avanti senza di te", "cross": "accorci o salti un rito dovuto perché non c'era tempo", "credo": "sacro"}}}}
{"_id": "9dc710399249b7f6", "name": "A chi ti parla da oltre il Velo si risponde.", "pages": [{"_id": "551bc719ca3d5d2c", "name": "A chi ti parla da oltre il Velo si risponde.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>A chi ti parla da oltre il Velo si risponde.</em></p><p><strong>La servi quando</strong> dai ascolto a quello che ti si rivolge, dovunque tu sia e con chiunque tu stia parlando.</p><p><strong>La attraversi quando</strong> ignori una voce che ti parla da oltre il Velo, o fai finta di non sentirla.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1000, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Sacro", "name": "A chi ti parla da oltre il Velo si risponde.", "text": "A chi ti parla da oltre il Velo si risponde.", "gloss": "dai ascolto a quello che ti si rivolge, dovunque tu sia e con chiunque tu stia parlando", "cross": "ignori una voce che ti parla da oltre il Velo, o fai finta di non sentirla", "credo": "sacro"}}}}
{"_id": "ab22245748fc896d", "name": "Chi afferma dice come fa a saperlo.", "pages": [{"_id": "de4be4e5774cc700", "name": "Chi afferma dice come fa a saperlo.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Chi afferma dice come fa a saperlo.</em></p><p><strong>La servi quando</strong> chiedi la fonte a chiunque e non lasci correre, nemmeno se la domanda era retorica.</p><p><strong>La attraversi quando</strong> accetti un'affermazione senza fonte perché veniva da chi stimi, o perché faceva comodo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1010, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Scienza", "name": "Chi afferma dice come fa a saperlo.", "text": "Chi afferma dice come fa a saperlo.", "gloss": "chiedi la fonte a chiunque e non lasci correre, nemmeno se la domanda era retorica", "cross": "accetti un'affermazione senza fonte perché veniva da chi stimi, o perché faceva comodo", "credo": "scienza"}}}}
{"_id": "9e2ed618042370af", "name": "Un fenomeno nuovo si campiona subito.", "pages": [{"_id": "bb023b5667ee947f", "name": "Un fenomeno nuovo si campiona subito.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Un fenomeno nuovo si campiona subito.</em></p><p><strong>La servi quando</strong> lo provi su di te o te ne porti via un pezzo, adesso, qualunque cosa stia succedendo.</p><p><strong>La attraversi quando</strong> lasci passare un fenomeno nuovo senza prenderne un pezzo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1020, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Scienza", "name": "Un fenomeno nuovo si campiona subito.", "text": "Un fenomeno nuovo si campiona subito.", "gloss": "lo provi su di te o te ne porti via un pezzo, adesso, qualunque cosa stia succedendo", "cross": "lasci passare un fenomeno nuovo senza prenderne un pezzo", "credo": "scienza"}}}}
{"_id": "6c8f75d1a9e8b93a", "name": "Quello che accade si annota per intero.", "pages": [{"_id": "9ab5df7fb61bf537", "name": "Quello che accade si annota per intero.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Quello che accade si annota per intero.</em></p><p><strong>La servi quando</strong> luogo, ora, condizioni e nomi finiscono sul quaderno, anche se qualcuno non vorrebbe.</p><p><strong>La attraversi quando</strong> ometti un dato dal quaderno per riguardo, o non annoti affatto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1030, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Scienza", "name": "Quello che accade si annota per intero.", "text": "Quello che accade si annota per intero.", "gloss": "luogo, ora, condizioni e nomi finiscono sul quaderno, anche se qualcuno non vorrebbe", "cross": "ometti un dato dal quaderno per riguardo, o non annoti affatto", "credo": "scienza"}}}}
{"_id": "4ca9350c5776ee91", "name": "L'osservatore che interviene ha già rovinato la misura.", "pages": [{"_id": "d6260abaed5aef8a", "name": "L'osservatore che interviene ha già rovinato la misura.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>L'osservatore che interviene ha già rovinato la misura.</em></p><p><strong>La servi quando</strong> lasci compiere quello che si svolge davanti a te e ti limiti a registrarlo.</p><p><strong>La attraversi quando</strong> intervieni su quello che stavi osservando, e la misura è persa.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1040, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Scienza", "name": "L'osservatore che interviene ha già rovinato la misura.", "text": "L'osservatore che interviene ha già rovinato la misura.", "gloss": "lasci compiere quello che si svolge davanti a te e ti limiti a registrarlo", "cross": "intervieni su quello che stavi osservando, e la misura è persa", "credo": "scienza"}}}}
{"_id": "011488919d7a0005", "name": "Un dato non replicato non esiste.", "pages": [{"_id": "6f6b534a81577744", "name": "Un dato non replicato non esiste.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Un dato non replicato non esiste.</em></p><p><strong>La servi quando</strong> rifai tutto nelle stesse condizioni, comprese il posto, l'ora e le persone che c'erano.</p><p><strong>La attraversi quando</strong> ti fidi di un dato ottenuto una volta sola e ci costruisci sopra.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1050, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Scienza", "name": "Un dato non replicato non esiste.", "text": "Un dato non replicato non esiste.", "gloss": "rifai tutto nelle stesse condizioni, comprese il posto, l'ora e le persone che c'erano", "cross": "ti fidi di un dato ottenuto una volta sola e ci costruisci sopra", "credo": "scienza"}}}}
{"_id": "13a8e84ae1100ff4", "name": "Quello che non si è mosso non ti ha sentito.", "pages": [{"_id": "d591c80f8bdcf234", "name": "Quello che non si è mosso non ti ha sentito.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Quello che non si è mosso non ti ha sentito.</em></p><p><strong>La servi quando</strong> davanti a un no alzi il volume invece di accettarlo, fin sul volume di una persona.</p><p><strong>La attraversi quando</strong> accetti un no e abbassi la voce, o smetti di suonare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1060, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Suono", "name": "Quello che non si è mosso non ti ha sentito.", "text": "Quello che non si è mosso non ti ha sentito.", "gloss": "davanti a un no alzi il volume invece di accettarlo, fin sul volume di una persona", "cross": "accetti un no e abbassi la voce, o smetti di suonare", "credo": "suono"}}}}
{"_id": "0f46a4d4863d1e3c", "name": "La mia parte va sentita.", "pages": [{"_id": "75b1d486b6c7a984", "name": "La mia parte va sentita.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>La mia parte va sentita.</em></p><p><strong>La servi quando</strong> non ti fai da parte quando ti chiedono di tacere per otto battute, e nei cori si paga.</p><p><strong>La attraversi quando</strong> taci quando ti chiedono di tacere, e lasci la tua parte a un altro.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1070, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Suono", "name": "La mia parte va sentita.", "text": "La mia parte va sentita.", "gloss": "non ti fai da parte quando ti chiedono di tacere per otto battute, e nei cori si paga", "cross": "taci quando ti chiedono di tacere, e lasci la tua parte a un altro", "credo": "suono"}}}}
{"_id": "368ccbcac5ed54d7", "name": "In un pezzo si entra in chiave.", "pages": [{"_id": "324351b61de0b67f", "name": "In un pezzo si entra in chiave.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>In un pezzo si entra in chiave.</em></p><p><strong>La servi quando</strong> prima di muovere qualcosa senti come suona quel posto, e chi aveva bisogno di te aspetta.</p><p><strong>La attraversi quando</strong> attacchi fuori chiave, senza aver ascoltato come suona il posto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1080, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Suono", "name": "In un pezzo si entra in chiave.", "text": "In un pezzo si entra in chiave.", "gloss": "prima di muovere qualcosa senti come suona quel posto, e chi aveva bisogno di te aspetta", "cross": "attacchi fuori chiave, senza aver ascoltato come suona il posto", "credo": "suono"}}}}
{"_id": "76e142d9fffe99ee", "name": "Il silenzio non si riempie.", "pages": [{"_id": "6b802a91ead5f427", "name": "Il silenzio non si riempie.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il silenzio non si riempie.</em></p><p><strong>La servi quando</strong> quando cade il silenzio lo lasci cadere, e chi aspettava una parola da te resta senza.</p><p><strong>La attraversi quando</strong> riempi un silenzio con una parola, una nota o un gesto.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1090, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Suono", "name": "Il silenzio non si riempie.", "text": "Il silenzio non si riempie.", "gloss": "quando cade il silenzio lo lasci cadere, e chi aspettava una parola da te resta senza", "cross": "riempi un silenzio con una parola, una nota o un gesto", "credo": "suono"}}}}
{"_id": "e6f368fd0431ab56", "name": "Una cosa detta non si disdice.", "pages": [{"_id": "8e86a0984126ac30", "name": "Una cosa detta non si disdice.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Una cosa detta non si disdice.</em></p><p><strong>La servi quando</strong> non ritratti e non ti rimangi niente, nemmeno le frasi giuste solo quando le hai dette.</p><p><strong>La attraversi quando</strong> ritratti una cosa che hai detto, o fai finta di non averla detta.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1100, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Suono", "name": "Una cosa detta non si disdice.", "text": "Una cosa detta non si disdice.", "gloss": "non ritratti e non ti rimangi niente, nemmeno le frasi giuste solo quando le hai dette", "cross": "ritratti una cosa che hai detto, o fai finta di non averla detta", "credo": "suono"}}}}
{"_id": "b9f39f6b245cac23", "name": "Nessuno sta bene da solo.", "pages": [{"_id": "4a054eb81b0a824f", "name": "Nessuno sta bene da solo.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Nessuno sta bene da solo.</em></p><p><strong>La servi quando</strong> vai a cercare compagnia anche quando restare fuori era la mossa giusta.</p><p><strong>La attraversi quando</strong> lasci qualcuno da solo, o ci resti tu, quando bastava una presenza.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1110, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Vivo", "name": "Nessuno sta bene da solo.", "text": "Nessuno sta bene da solo.", "gloss": "vai a cercare compagnia anche quando restare fuori era la mossa giusta", "cross": "lasci qualcuno da solo, o ci resti tu, quando bastava una presenza", "credo": "vivo"}}}}
{"_id": "70a5287538caede6", "name": "Il male di chi ti sta accanto è anche tuo.", "pages": [{"_id": "cab95986f68d87fc", "name": "Il male di chi ti sta accanto è anche tuo.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Il male di chi ti sta accanto è anche tuo.</em></p><p><strong>La servi quando</strong> te ne occupi anche quando ti hanno chiesto di restare fuori, e restare fuori serviva.</p><p><strong>La attraversi quando</strong> passi oltre il male di chi ti sta accanto, perché non era tuo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1120, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Vivo", "name": "Il male di chi ti sta accanto è anche tuo.", "text": "Il male di chi ti sta accanto è anche tuo.", "gloss": "te ne occupi anche quando ti hanno chiesto di restare fuori, e restare fuori serviva", "cross": "passi oltre il male di chi ti sta accanto, perché non era tuo", "credo": "vivo"}}}}
{"_id": "76f97264b346dccc", "name": "Dove non cresce niente si lascia qualcosa di vivo.", "pages": [{"_id": "edbdd10db087f2b3", "name": "Dove non cresce niente si lascia qualcosa di vivo.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Dove non cresce niente si lascia qualcosa di vivo.</em></p><p><strong>La servi quando</strong> non passi oltre senza aver seminato, e non ti chiedi cosa diventa quel posto.</p><p><strong>La attraversi quando</strong> attraversi un posto morto senza lasciare niente di vivo.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1130, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Vivo", "name": "Dove non cresce niente si lascia qualcosa di vivo.", "text": "Dove non cresce niente si lascia qualcosa di vivo.", "gloss": "non passi oltre senza aver seminato, e non ti chiedi cosa diventa quel posto", "cross": "attraversi un posto morto senza lasciare niente di vivo", "credo": "vivo"}}}}
{"_id": "408349ab00bf4192", "name": "Quello che sente la città lo senti tu.", "pages": [{"_id": "211dac31c1ae136f", "name": "Quello che sente la città lo senti tu.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Quello che sente la città lo senti tu.</em></p><p><strong>La servi quando</strong> sopportarlo non ti basta: devi far passare quel male, e ci provi finché non ci riesci.</p><p><strong>La attraversi quando</strong> chiudi fuori quello che sente la città, per dormire o per lavorare.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1140, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Vivo", "name": "Quello che sente la città lo senti tu.", "text": "Quello che sente la città lo senti tu.", "gloss": "sopportarlo non ti basta: devi far passare quel male, e ci provi finché non ci riesci", "cross": "chiudi fuori quello che sente la città, per dormire o per lavorare", "credo": "vivo"}}}}
{"_id": "afa1bcdbb0f44445", "name": "Se serve più vita di quanta ce n'è, la metti tu.", "pages": [{"_id": "5cb6f1862b61e4d1", "name": "Se serve più vita di quanta ce n'è, la metti tu.", "type": "text", "title": {"show": false, "level": 1}, "text": {"format": 1, "content": "<p><em>Se serve più vita di quanta ce n'è, la metti tu.</em></p><p><strong>La servi quando</strong> la metti prima di finire di pensarci, e a contare quanta ne è uscita ci pensa un altro.</p><p><strong>La attraversi quando</strong> tieni per te la vita che serviva a un altro, per prudenza o per stanchezza.</p>"}, "sort": 0, "ownership": {"default": -1}, "flags": {}}], "folder": null, "sort": 1150, "ownership": {"default": 0}, "flags": {"wod5e-mage": {"archivio": {"kind": "convinzione", "group": "Tutto è Vivo", "name": "Se serve più vita di quanta ce n'è, la metti tu.", "text": "Se serve più vita di quanta ce n'è, la metti tu.", "gloss": "la metti prima di finire di pensarci, e a contare quanta ne è uscita ci pensa un altro", "cross": "tieni per te la vita che serviva a un altro, per prudenza o per stanchezza", "credo": "vivo"}}}}
