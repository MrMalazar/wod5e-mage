{{!-- L'archivio: cerca, i gruppi a tendina (9/9), le linguette dei livelli
     per Pregi e Difetti, apri la voce col clic sul nome, «+» per metterla sulla scheda. --}}
<div class="wod5e-mage-archivio" data-kind="{{kind}}">
    {{#if kinds.length}}
        {{!-- Gli Elementi (10/9): Background, Pregi e Difetti in una finestra, una linguetta per archivio. --}}
        <div class="wod5e-mage-archivio-kinds" role="tablist" aria-label="{{localize 'WOD5E_MAGE.Archivi.KindTabs'}}">
            {{#each kinds as |tab|}}
                <button type="button" role="tab" class="{{#if tab.active}}active{{/if}}" data-role="archivioKind" data-kind="{{tab.id}}" aria-selected="{{#if tab.active}}true{{else}}false{{/if}}">{{tab.label}}</button>
            {{/each}}
        </div>
    {{/if}}
    <div class="wod5e-mage-archivio-head">
        <input type="search" data-role="archivioSearch" placeholder="{{localize 'WOD5E_MAGE.Archivi.Search'}}" aria-label="{{localize 'WOD5E_MAGE.Archivi.Search'}}">
        <button type="button" class="wod5e-mage-archivio-fold" data-role="archivioFold" title="{{localize 'WOD5E_MAGE.Archivi.FoldHint'}}"><i class="fa-solid fa-compress" aria-hidden="true"></i> <span>{{localize "WOD5E_MAGE.Archivi.FoldAll"}}</span></button>
        <small>{{localize "WOD5E_MAGE.Archivi.Count" count=count}}</small>
    </div>
    {{#if levels.length}}
        {{!-- Il livello (9/9): «a 3» mostra le voci che valgono 3, o che arrivano a 3. --}}
        <div class="wod5e-mage-archivio-levels" role="group" aria-label="{{localize 'WOD5E_MAGE.Archivi.Level'}}">
            <span>{{localize "WOD5E_MAGE.Archivi.Level"}}</span>
            <button type="button" class="active" data-role="archivioLevel" data-level="0">{{localize "WOD5E_MAGE.Archivi.LevelAll"}}</button>
            {{#each levels as |level|}}
                <button type="button" data-role="archivioLevel" data-level="{{level}}">{{level}}</button>
            {{/each}}
        </div>
    {{/if}}
    <p class="wod5e-mage-archivio-hint">{{localize "WOD5E_MAGE.Archivi.Hint"}}</p>
    <div class="wod5e-mage-archivio-list">
        {{#each groups as |group|}}
            {{#if group.name}}
            <details class="wod5e-mage-archivio-group" data-role="archivioGroup" open>
                <summary>
                    <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                    <h3>{{group.name}}</h3>
                    <small>{{group.count}}</small>
                </summary>
            {{else}}
            <section class="wod5e-mage-archivio-group" data-role="archivioGroup">
            {{/if}}
                {{#each group.entries as |entry|}}
                    <article class="wod5e-mage-archivio-entry" data-role="archivioEntry" data-uuid="{{entry.uuid}}">
                        <div class="wod5e-mage-archivio-row">
                            <button type="button" class="wod5e-mage-archivio-name" data-role="archivioToggle">
                                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                                <span>{{entry.name}}</span>
                                {{#if entry.cost}}<small>{{entry.cost}}</small>{{/if}}
                            </button>
                            {{#if ../../canAdd}}
                                <button type="button" class="wod5e-mage-archivio-add" data-role="archivioAdd" title="{{localize 'WOD5E_MAGE.Archivi.Add'}}" aria-label="{{localize 'WOD5E_MAGE.Archivi.Add'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
                            {{/if}}
                        </div>
                        <div class="wod5e-mage-archivio-content">{{{entry.content}}}</div>
                    </article>
                {{/each}}
            {{#if group.name}}
            </details>
            {{else}}
            </section>
            {{/if}}
        {{else}}
            <p class="wod5e-mage-archivio-hint">{{localize "WOD5E_MAGE.Archivi.Empty"}}</p>
        {{/each}}
    </div>
</div>
