{{!-- Segna le macchie (23/9, come i Danni subiti della Salute): quante, e di
     che segno. Niente <form>: DialogV2 mette il contenuto dentro il suo. --}}
<div class="wod5e-mage-danni wod5e-mage-macchie">
    <p class="wod5e-mage-arete-hint">{{localize "WOD5E_MAGE.Wisdom.SegnaHint"}}</p>
    <label class="wod5e-mage-item-field wod5e-mage-danni-amount">
        <span class="wod5e-mage-arete-row-label">{{localize "WOD5E_MAGE.Wisdom.SegnaAmount"}}</span>
        <input type="number" name="amount" min="1" max="20" step="1" value="1" autofocus>
    </label>
    <span class="wod5e-mage-arete-row-label">{{localize "WOD5E_MAGE.Wisdom.SegnaSign"}}</span>
    <input type="hidden" name="state" value="{{chosen}}">
    <div class="wod5e-mage-danni-grid" role="group" aria-label="{{localize 'WOD5E_MAGE.Wisdom.SegnaSign'}}">
        {{#each signs as |sign|}}
            <button type="button" class="wod5e-mage-danni-sign" data-role="macchiaSign" data-state="{{sign.state}}" aria-label="{{localize sign.label}}">
                <i class="wod5e-mage-inchiostro-glyph" data-state="{{sign.state}}" aria-hidden="true"></i>
                <span>{{localize sign.label}}</span>
            </button>
        {{/each}}
    </div>
</div>
