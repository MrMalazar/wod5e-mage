<div class="wod5e-mage-affinity-browser-body">
    <label class="wod5e-mage-affinity-search">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input
            type="search"
            data-role="affinity-search"
            placeholder="{{localize 'WOD5E_MAGE.AffinitySphere.Search'}}"
            autocomplete="off"
        >
    </label>

    <div class="wod5e-mage-affinity-results">
        {{#each affinitySpheres as |sphere|}}
            <button
                type="button"
                class="wod5e-mage-affinity-result"
                data-action="selectAffinitySphere"
                data-uuid="{{sphere.uuid}}"
                data-search="{{sphere.searchName}}"
            >
                <img src="{{sphere.img}}" alt="">
                <span>
                    <strong>{{sphere.name}}</strong>
                    <small>{{sphere.intro}}</small>
                </span>
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
            </button>
        {{/each}}

        <p data-role="affinity-no-results" hidden>
            {{#if packMissing}}
                {{localize "WOD5E_MAGE.AffinitySphere.MissingPack"}}
            {{else}}
                {{localize "WOD5E_MAGE.AffinitySphere.NoResults"}}
            {{/if}}
        </p>
    </div>
</div>
