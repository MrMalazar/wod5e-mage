{{!-- Il Grimorio: gli effetti del manuale che le Sfere del personaggio aprono,
     per Sfera e per livello, o per Formula (i verbi universali del ramo B, 6/9).
     Un clic sceglie. --}}
<div class="wod5e-mage-grimorio-body">
    <div class="wod5e-mage-grimorio-top">
        <input type="search" class="wod5e-mage-grimorio-search" data-role="grimorioSearch" placeholder="{{localize 'WOD5E_MAGE.Grimorio.Search'}}" aria-label="{{localize 'WOD5E_MAGE.Grimorio.Search'}}">
        <div class="wod5e-mage-grimorio-views" role="tablist">
            {{!-- Prima Per Formula, poi Per Sfera (verdetto di Blue, 10/9): si apre per Formula. --}}
            <button type="button" data-role="grimorioView" data-view="formula">{{localize "WOD5E_MAGE.Grimorio.ByFormula"}}</button>
            <button type="button" data-role="grimorioView" data-view="sphere">{{localize "WOD5E_MAGE.Grimorio.BySphere"}}</button>
        </div>
    </div>
    {{!-- I simboli delle Sfere possedute (7/9): un clic accende o spegne la Sfera. --}}
    {{#if spheres.length}}
        <div class="wod5e-mage-grimorio-spheres" role="group" data-view-only="sphere">
            {{#each spheres as |s|}}
                <button type="button" data-role="grimorioSphere" data-sphere="{{s.sphere}}" class="{{#if s.lit}}lit{{/if}}" title="{{s.label}} {{s.dots}}"><img src="{{s.icon}}" alt=""><span>{{s.label}}</span></button>
            {{/each}}
        </div>
    {{/if}}
    <div data-view-panel="sphere" class="wod5e-mage-grimorio-panel">
    {{#each groups as |group|}}
        {{!-- Ogni Sfera è una tendina; ogni effetto una riga: il nome sceglie,
             la freccina apre il come. --}}
        <details class="wod5e-mage-grimorio-sphere" data-sphere-group="{{group.sphere}}" open>
            <summary><h3>{{group.label}}</h3></summary>
            {{#each group.levels as |lvl|}}
                <h4><span class="wod5e-mage-grimorio-dots">{{lvl.dots}}</span> {{lvl.label}}</h4>
                {{#each lvl.entries as |entry|}}
                    <details class="wod5e-mage-grimorio-row">
                        <summary>
                            <button type="button" class="wod5e-mage-grimorio-pick" data-effetto="{{entry.id}}">{{entry.name}}</button>
                            {{#each entry.formule as |formula|}}<em class="wod5e-mage-grimorio-formula">{{formula}}</em>{{/each}}
                            {{#if entry.extras.length}}
                                <span class="wod5e-mage-grimorio-extras">{{#each entry.extras as |extra|}}<em class="{{#if extra.required}}required{{/if}}">+ {{extra.label}} {{extra.dots}}</em>{{/each}}</span>
                            {{/if}}
                            <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                        </summary>
                        <p>{{entry.text}}</p>
                        {{#if entry.pairings.length}}
                            <ul class="wod5e-mage-grimorio-pairings">
                                {{#each entry.pairings as |pairing|}}
                                    <li{{#if pairing.required}} class="required"{{/if}}><img src="{{pairing.icon}}" alt=""><b>+ {{pairing.label}}{{#if pairing.dots}} {{pairing.dots}}{{/if}}{{#if pairing.required}} ({{localize "WOD5E_MAGE.Grimorio.Required"}}){{/if}}:</b> {{pairing.text}}</li>
                                {{/each}}
                            </ul>
                        {{/if}}
                        {{#if entry.missing.length}}
                            <p class="wod5e-mage-grimorio-missing">{{#each entry.missing as |name|}}<span>{{localize "WOD5E_MAGE.Grimorio.Without"}} {{name}}: {{localize "WOD5E_MAGE.Grimorio.Sideways"}}</span>{{/each}}</p>
                        {{/if}}
                        {{#if entry.missingPrime}}
                            <p class="wod5e-mage-grimorio-missing prime">{{localize "WOD5E_MAGE.Grimorio.WithoutPrime"}}</p>
                        {{/if}}
                        {{#if entry.scopes.length}}
                            <div class="wod5e-mage-grimorio-scopes">
                                <b>{{localize "WOD5E_MAGE.Grimorio.Scopes"}}</b>
                                {{#each entry.scopes as |line|}}<span>{{line}}</span>{{/each}}
                            </div>
                        {{/if}}
                    </details>
                {{/each}}
            {{/each}}
        </details>
    {{else}}
        <p class="wod5e-mage-grimorio-empty">{{localize "WOD5E_MAGE.Grimorio.Empty"}}</p>
    {{/each}}
    </div>
    {{!-- La vista per Formula (24/9): le 48 matrici del formato di Blue, in
         ordine alfabetico. Ogni riga: il nome, «In genere», i sigilli
         d'Accesso (accesi se il personaggio ha la Sfera); aperta, la
         matrice intera con la scelta della Sfera d'Accesso, delle Amalgame e
         i tasti (scrivi nel Grimorio, lancia; dal tiro: scegli). --}}
    <div data-view-panel="formula" class="wod5e-mage-grimorio-panel" hidden>
    {{#each formule as |formula|}}
        <details class="wod5e-mage-grimorio-row wod5e-mage-grimorio-formula-row{{#unless formula.open}} closed{{/unless}}" data-formula="{{formula.id}}">
            <summary>
                <span class="wod5e-mage-grimorio-formula-name">{{formula.name}}</span>
                <span class="wod5e-mage-grimorio-formula-brief">{{formula.use}}</span>
                <span class="wod5e-mage-grimorio-accessi">{{#each formula.access as |s|}}<img src="{{s.icon}}" alt="{{s.label}}" title="{{s.label}}" class="{{#if s.owned}}lit{{/if}}">{{/each}}</span>
                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
            </summary>
            {{!-- La matrice (24/9 sera, Blue: «l'esposizione del testo non è ordinata»):
                 una tavola a due colonne, l'etichetta a sinistra e il contenuto a
                 destra; nella Descrizione ogni Sfera sta su una riga sua coi sigilli
                 in fila prima del nome. --}}
            <div class="wod5e-mage-matrice">
                <b class="wod5e-mage-matrice-k">{{localize "WOD5E_MAGE.Grimorio.Access"}}</b>
                <div class="wod5e-mage-matrice-corpo wod5e-mage-matrice-riga">{{#each formula.access as |s|}}<span class="wod5e-mage-matrice-sfera{{#if s.owned}} lit{{/if}}"><img src="{{s.icon}}" alt="">{{s.label}}</span>{{/each}}</div>
                <b class="wod5e-mage-matrice-k">{{localize "WOD5E_MAGE.Grimorio.Amalgams"}}</b>
                <div class="wod5e-mage-matrice-corpo wod5e-mage-matrice-riga">{{#if formula.amalgamsFree}}<em>{{#if formula.amalgamsNote}}{{formula.amalgamsNote}}{{else}}{{localize "WOD5E_MAGE.Grimorio.AmalgamsFree"}}{{/if}}</em>{{else}}{{#each formula.amalgams as |s|}}<span class="wod5e-mage-matrice-sfera{{#if s.owned}} lit{{/if}}"><img src="{{s.icon}}" alt="">{{s.label}}</span>{{/each}}{{/if}}</div>
                <b class="wod5e-mage-matrice-k">{{localize "WOD5E_MAGE.Grimorio.Description"}}</b>
                <div class="wod5e-mage-matrice-corpo wod5e-mage-matrice-descrizione">
                    {{#if formula.intro}}<p class="wod5e-mage-matrice-testo">{{formula.intro}}</p>{{/if}}
                    {{#each formula.rows as |row|}}
                        <p class="wod5e-mage-matrice-sfera-riga{{#if row.owned}} lit{{/if}}"><span class="wod5e-mage-matrice-sigilli">{{#each row.spheres as |s|}}<img src="{{s.icon}}" alt="">{{/each}}</span><span class="wod5e-mage-matrice-sfera-testo"><b>{{row.label}}:</b> {{row.text}}</span></p>
                    {{/each}}
                    {{#if formula.coda}}<p class="wod5e-mage-matrice-testo">{{formula.coda}}</p>{{/if}}
                </div>
                <b class="wod5e-mage-matrice-k">{{localize "WOD5E_MAGE.Grimorio.Limit"}}</b>
                <div class="wod5e-mage-matrice-corpo"><p class="wod5e-mage-matrice-testo">{{formula.limit}}</p></div>
                <b class="wod5e-mage-matrice-k">{{localize "WOD5E_MAGE.Grimorio.Threshold"}}</b>
                <div class="wod5e-mage-matrice-corpo wod5e-mage-matrice-soglia">
                    {{#if (gt formula.thresholds.length 1)}}
                        {{#each formula.thresholds as |t|}}<label class="wod5e-mage-matrice-scelta"><input type="radio" name="soglia-{{t.formulaId}}" data-role="formulaThreshold" value="{{@index}}"{{#unless @index}} checked{{/unless}}> {{t.text}}</label>{{/each}}
                    {{else}}
                        {{#each formula.thresholds as |t|}}<span>{{t.text}}</span>{{/each}}
                    {{/if}}
                </div>
                {{#if formula.powers.length}}
                    <b class="wod5e-mage-matrice-k">{{localize "WOD5E_MAGE.Grimorio.Powers"}}</b>
                    <div class="wod5e-mage-matrice-corpo wod5e-mage-matrice-poteri">{{#each formula.powers as |power|}}<span{{#if power.proposal}} class="proposta" title="{{localize 'WOD5E_MAGE.Grimorio.Proposal'}}"{{/if}}>{{power.name}}</span>{{/each}}</div>
                {{/if}}
                {{#if formula.open}}
                    <div class="wod5e-mage-matrice-scelte">
                        <span class="wod5e-mage-matrice-k">{{localize "WOD5E_MAGE.Grimorio.ChooseAccess"}}</span>
                        {{#each formula.accessOwned as |s|}}<label class="wod5e-mage-matrice-scelta"><input type="radio" name="accesso-{{s.formulaId}}" data-role="formulaAccess" value="{{s.id}}"{{#if s.checked}} checked{{/if}}><img src="{{s.icon}}" alt="">{{s.label}}</label>{{/each}}
                    </div>
                    {{#if formula.amalgamChoices.length}}
                        <div class="wod5e-mage-matrice-scelte">
                            <span class="wod5e-mage-matrice-k">{{localize "WOD5E_MAGE.Grimorio.ChooseAmalgam"}}</span>
                            {{#each formula.amalgamChoices as |s|}}<label class="wod5e-mage-matrice-scelta"><input type="checkbox" data-role="formulaAmalgam" value="{{s.id}}"><img src="{{s.icon}}" alt="">{{s.label}}</label>{{/each}}
                        </div>
                    {{/if}}
                    <div class="wod5e-mage-matrice-tasti">
                        {{#if @root.inSheet}}
                            <button type="button" data-role="formulaSave" disabled><i class="fa-solid fa-feather" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Grimorio.FormulaSave"}}</button>
                            <button type="button" data-role="formulaRoll" disabled><i class="fa-solid fa-dice" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Grimorio.FormulaRoll"}}</button>
                        {{else}}
                            <button type="button" data-role="formulaPick" disabled><i class="fa-solid fa-check" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Grimorio.FormulaPick"}}</button>
                        {{/if}}
                    </div>
                {{else}}
                    <p class="wod5e-mage-grimorio-missing">{{localize "WOD5E_MAGE.Grimorio.NoAccess"}}</p>
                {{/if}}
            </div>
        </details>
    {{else}}
        <p class="wod5e-mage-grimorio-empty">{{localize "WOD5E_MAGE.Grimorio.Empty"}}</p>
    {{/each}}
    </div>
</div>
