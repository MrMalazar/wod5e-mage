<form class="dialog-contents wod5e-mage-arete-form">
    {{!-- La riserva (ramo A): un'Abilità, più un'Abilità o un Attributo.
         L'Areté non tira: entra come premio della descrizione. --}}
    <div class="wod5e-mage-arete-row">
        <span class="wod5e-mage-arete-row-label">{{localize "WOD5E_MAGE.RollSelection.Ability"}}</span>
        <select id="wod5e-mage-arete-primary" name="primaryTrait" required>
            <option value="">{{localize "WOD5E_MAGE.RollSelection.SelectAbility"}}</option>
            {{#each skills as |trait|}}
                <option value="{{trait.key}}" data-value="{{trait.value}}">{{trait.label}} ({{trait.value}})</option>
            {{/each}}
        </select>
    </div>

    <div class="wod5e-mage-arete-row">
        <span class="wod5e-mage-arete-row-label">+ {{localize "WOD5E_MAGE.RollSelection.AbilityOrAttribute"}}</span>
        <select id="wod5e-mage-arete-secondary" name="secondaryTrait" required>
            <option value="">{{localize "WOD5E_MAGE.RollSelection.SelectTrait"}}</option>
            <optgroup label="{{localize 'WOD5E_MAGE.RollSelection.Abilities'}}">
                {{#each skills as |trait|}}
                    <option value="{{trait.key}}" data-value="{{trait.value}}">{{trait.label}} ({{trait.value}})</option>
                {{/each}}
            </optgroup>
            <optgroup label="{{localize 'WOD5E_MAGE.RollSelection.Attributes'}}">
                {{#each attributes as |trait|}}
                    <option value="{{trait.key}}" data-value="{{trait.value}}">{{trait.label}} ({{trait.value}})</option>
                {{/each}}
            </optgroup>
        </select>
    </div>

    {{!-- Il premio dell'Areté: dadi in più pari all'Areté quando la descrizione
         lo merita, dentro il tetto +3 insieme ai Bonus. L'Ibrida non lo prende. --}}
    <div class="wod5e-mage-arete-row wod5e-mage-arete-prize">
        <span class="wod5e-mage-arete-row-label">{{localize "WOD5E_MAGE.Arete.Prize"}}</span>
        {{#if prize.allowed}}
            <label class="wod5e-mage-arete-toggle" title="{{localize 'WOD5E_MAGE.Arete.PrizeHint'}}">
                <input type="checkbox" name="prize" data-value="{{prize.dice}}" aria-label="{{localize 'WOD5E_MAGE.Arete.Prize'}}">
                <span class="wod5e-mage-arete-toggle-value">+{{prize.dice}}</span>
            </label>
        {{else}}
            <em>{{localize "WOD5E_MAGE.Arete.PrizeHybrid"}}</em>
        {{/if}}
    </div>
    {{#if prize.allowed}}
        <p class="wod5e-mage-arete-hint">{{localize "WOD5E_MAGE.Arete.PrizeHint" arete=arete.value}}</p>
    {{/if}}

    {{!-- L'Armonia: un dado se un altro Mago ha il tuo Credo o il tuo Tipo,
         due se entrambi, sempre con una Sfera in comune. --}}
    <div class="wod5e-mage-arete-row">
        <span class="wod5e-mage-arete-row-label">{{localize "WOD5E_MAGE.Arete.Harmony"}}</span>
        <select name="harmony" id="wod5e-mage-arete-harmony" title="{{localize 'WOD5E_MAGE.Arete.HarmonyHint'}}">
            <option value="0" data-value="0">{{localize "WOD5E_MAGE.Arete.HarmonyNone"}}</option>
            <option value="1" data-value="1">{{localize "WOD5E_MAGE.Arete.HarmonyOne"}}</option>
            <option value="2" data-value="2">{{localize "WOD5E_MAGE.Arete.HarmonyTwo"}}</option>
        </select>
    </div>

    <hr>

    {{!-- Sfere e Ambiti: la soglia è il maggiore fra la Sfera più alta e
         l'Ambito più alto, +1 per ogni Ambito oltre il primo, +1 con tre o
         più Sfere, tetto 7. --}}
    <div class="wod5e-mage-arete-spheres" role="group" aria-label="{{localize 'WOD5E_MAGE.Arete.Spheres'}}">
        {{#if spheres.length}}
            <div class="wod5e-mage-arete-columns">
                <div class="wod5e-mage-arete-col">
                    <span class="wod5e-mage-arete-row-label">{{localize "WOD5E_MAGE.Arete.Spheres"}}</span>
                    {{#each spheres as |sphere|}}
                        <label class="wod5e-mage-arete-sphere">
                            <input type="checkbox" class="wod5e-mage-arete-sphere-box" name="sphere-{{sphere.id}}" data-level="{{sphere.value}}">
                            <span>{{localize sphere.label}}</span>
                            <span class="wod5e-mage-arete-sphere-dots" aria-label="{{sphere.value}}">
                                {{#each sphere.steps as |step|}}<i class="wod5e-mage-arete-sphere-dot {{#if step.active}}active{{/if}}"></i>{{/each}}
                            </span>
                        </label>
                    {{/each}}
                </div>
                <div class="wod5e-mage-arete-col">
                    {{!-- Gli Ambiti li aggiunge il giocatore col +, ognuno col suo
                         livello da 1 a 7. --}}
                    <div class="wod5e-mage-arete-scope-head">
                        <span class="wod5e-mage-arete-row-label">{{localize "WOD5E_MAGE.Scopes.Label"}}
                            <button type="button" class="wod5e-mage-arete-scope-add" data-role="scopeAdd"
                                    title="{{localize 'WOD5E_MAGE.Arete.AddScope'}}"
                                    aria-label="{{localize 'WOD5E_MAGE.Arete.AddScope'}}"><i class="fa-solid fa-plus"></i></button>
                        </span>
                        <span class="wod5e-mage-arete-scope-lvl-label">{{localize "WOD5E_MAGE.Arete.ScopeLevel"}}</span>
                    </div>
                    <div class="wod5e-mage-arete-scope-rows" data-role="scopeRows"></div>
                    <template data-role="scopeRowTemplate">
                        <div class="wod5e-mage-arete-scope-row">
                            <select class="wod5e-mage-arete-scope"
                                    aria-label="{{localize 'WOD5E_MAGE.Arete.SelectScope'}}">
                                <option value="">{{localize "WOD5E_MAGE.Arete.SelectScope"}}</option>
                                {{#each scopes as |scope|}}
                                    <option value="{{scope.id}}">{{localize scope.label}}</option>
                                {{/each}}
                            </select>
                            <input type="number" class="wod5e-mage-arete-scope-ns"
                                   min="1" max="7" step="1" value="1"
                                   title="{{localize 'WOD5E_MAGE.Arete.ScopeLevelHint'}}"
                                   aria-label="{{localize 'WOD5E_MAGE.Arete.ScopeLevelHint'}}">
                        </div>
                    </template>
                </div>
            </div>
        {{else}}
            <p class="wod5e-mage-magick-type-hint">{{localize "WOD5E_MAGE.Arete.NoSpheres"}}</p>
        {{/if}}

        {{!-- Il conto, aggiornato a ogni scelta: riserva contro soglia. --}}
        <p class="wod5e-mage-arete-difficulty">
            {{localize "WOD5E_MAGE.Arete.Pool"}}: <strong data-role="pool">0</strong>
            · {{localize "WOD5E_MAGE.Arete.Threshold"}}: <strong data-role="threshold">0</strong>
        </p>
        <p class="wod5e-mage-arete-hint">{{localize "WOD5E_MAGE.Arete.ThresholdHint"}}</p>
        <p class="wod5e-mage-arete-auto hidden" data-role="autoVictory">{{localize "WOD5E_MAGE.Arete.AutoVictory"}}</p>
    </div>

    <hr>

    {{!-- La Tipologia: una scelta sola. Le spiegazioni in corsivo stanno in
         una colonna a sé, staccate a destra delle caselle. --}}
    <div class="wod5e-mage-arete-types" role="group" aria-label="{{localize 'WOD5E_MAGE.Arete.MagickType'}}">
        <span class="wod5e-mage-arete-row-label">{{localize "WOD5E_MAGE.Arete.MagickType"}}</span>
        <div class="wod5e-mage-arete-type-grid">
            <label class="wod5e-mage-arete-type"><input type="checkbox" class="wod5e-mage-magick-type" name="coincidental"> <span>{{localize "WOD5E_MAGE.Arete.Coincidental"}}</span></label>
            <em>{{localize "WOD5E_MAGE.Arete.CoincidentalHint"}}</em>
            <label class="wod5e-mage-arete-type"><input type="checkbox" class="wod5e-mage-magick-type" name="vulgar"> <span>{{localize "WOD5E_MAGE.Arete.Vulgar"}}</span></label>
            <em>{{localize "WOD5E_MAGE.Arete.VulgarHint"}}</em>
            <label class="wod5e-mage-arete-type"><input type="checkbox" class="wod5e-mage-magick-type" name="witnesses"> <span>{{localize "WOD5E_MAGE.Arete.VulgarWithWitnesses"}}</span></label>
            <em>{{localize "WOD5E_MAGE.Arete.WitnessesHint"}}</em>
        </div>
    </div>

    <hr>

    {{!-- L'Effetto Mantenuto: se spuntato compare il nome, e a tiro risolto
         l'effetto finisce fra le Magick in Atto. --}}
    <div class="wod5e-mage-arete-maintained">
        <label class="wod5e-mage-arete-maintained-toggle">
            <input type="checkbox" name="maintained" id="wod5e-mage-arete-maintained">
            {{localize "WOD5E_MAGE.Arete.Maintained"}}
        </label>
        <input type="text" name="maintainedName" id="wod5e-mage-arete-maintained-name" class="hidden"
               placeholder="{{localize 'WOD5E_MAGE.Arete.MaintainedName'}}"
               aria-label="{{localize 'WOD5E_MAGE.Arete.MaintainedName'}}">
    </div>
</form>
