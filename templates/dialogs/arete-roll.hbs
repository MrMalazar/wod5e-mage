<form class="dialog-contents">
    <div class="selectors-group">
        <div class="primary-selector">
            <div class="selector-title">
                {{localize "WOD5E_MAGE.Arete.Label"}}
            </div>
            <div class="selector-content">
                <label class="wod5e-mage-arete-toggle" title="{{localize 'WOD5E_MAGE.Arete.IncludeHint'}}">
                    <input type="checkbox" name="arete" aria-label="{{localize 'WOD5E_MAGE.Arete.Include'}}">
                    <span class="wod5e-mage-arete-toggle-value">{{arete.value}}</span>
                </label>
            </div>
        </div>

        <div class="middle">+</div>

        <div class="primary-selector">
            <div class="selector-title">
                {{localize "WOD5E_MAGE.RollSelection.Ability"}}
            </div>
            <div class="selector-content">
                <select id="wod5e-mage-arete-primary" name="primarySkill" required>
                    <option value="">{{localize "WOD5E_MAGE.RollSelection.SelectAbility"}}</option>
                    {{#each skills as |trait|}}
                        <option value="{{trait.id}}">{{trait.label}} ({{trait.value}})</option>
                    {{/each}}
                </select>
            </div>
        </div>

        <div class="middle">+</div>

        <div class="primary-selector">
            <div class="selector-title">
                {{localize "WOD5E_MAGE.RollSelection.AbilityOrAttribute"}}
            </div>
            <div class="selector-content">
                <select id="wod5e-mage-arete-secondary" name="secondaryTrait" required>
                    <option value="">{{localize "WOD5E_MAGE.RollSelection.SelectTrait"}}</option>
                    <optgroup label="{{localize 'WOD5E_MAGE.RollSelection.Abilities'}}">
                        {{#each skills as |trait|}}
                            <option value="{{trait.key}}">{{trait.label}} ({{trait.value}})</option>
                        {{/each}}
                    </optgroup>
                    <optgroup label="{{localize 'WOD5E_MAGE.RollSelection.Attributes'}}">
                        {{#each attributes as |trait|}}
                            <option value="{{trait.key}}">{{trait.label}} ({{trait.value}})</option>
                        {{/each}}
                    </optgroup>
                </select>
            </div>
        </div>
    </div>

    <hr>
    <div class="selector-title">{{localize "WOD5E_MAGE.Arete.MagickType"}}</div>
    <div class="flexrow">
        <div class="secondary-selector">
            <div class="selector-title">{{localize "WOD5E_MAGE.Arete.Coincidental"}}</div>
            <input type="checkbox" class="wod5e-mage-magick-type" name="coincidental">
        </div>
        <div class="secondary-selector">
            <div class="selector-title">{{localize "WOD5E_MAGE.Arete.Vulgar"}}</div>
            <input type="checkbox" class="wod5e-mage-magick-type" name="vulgar">
        </div>
        <div class="secondary-selector">
            <div class="selector-title">{{localize "WOD5E_MAGE.Arete.VulgarWithWitnesses"}}</div>
            <input type="checkbox" class="wod5e-mage-magick-type" name="witnesses">
        </div>
    </div>

    <p class="wod5e-mage-magick-type-hint">{{localize "WOD5E_MAGE.Arete.ParadoxHint"}}</p>
</form>
