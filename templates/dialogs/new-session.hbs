<form class="dialog-contents wod5e-mage-item-form">
    <p class="wod5e-mage-arete-hint">{{localize "WOD5E_MAGE.Salute.NewSessionHint"}}</p>
    <label class="wod5e-mage-item-field">
        <span class="wod5e-mage-arete-row-label">{{localize "WOD5E_MAGE.Salute.SessionXp"}}</span>
        <input type="number" name="experience" min="0" max="99" step="1" value="0" autofocus>
        <small>{{localize "WOD5E_MAGE.Salute.SessionXpHint"}}</small>
    </label>
    <label class="wod5e-mage-item-field">
        <span class="wod5e-mage-arete-row-label">{{localize "WOD5E_MAGE.Experience.GainsWhen"}}</span>
        <input type="text" name="when" value="{{when}}">
    </label>
</form>
