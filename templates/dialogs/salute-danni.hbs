{{!-- Danni subiti (9/9): quanti, e di che segno. Niente <form>: DialogV2 mette
     il contenuto dentro il suo, e un form dentro un form sparisce. --}}
<div class="wod5e-mage-danni">
    <p class="wod5e-mage-arete-hint">{{localize "WOD5E_MAGE.Salute.DanniHint"}}</p>
    <label class="wod5e-mage-item-field wod5e-mage-danni-amount">
        <span class="wod5e-mage-arete-row-label">{{localize "WOD5E_MAGE.Salute.DanniAmount"}}</span>
        <input type="number" name="amount" min="1" max="30" step="1" value="1" autofocus>
    </label>
    <span class="wod5e-mage-arete-row-label">{{localize "WOD5E_MAGE.Salute.DanniSign"}}</span>
    {{!-- I quattro segni del tracciato: un clic sceglie, il campo nascosto lo porta al tiro. --}}
    <input type="hidden" name="state" value="{{chosen}}">
    <div class="wod5e-mage-danni-grid" role="group" aria-label="{{localize 'WOD5E_MAGE.Salute.DanniSign'}}">
        {{#each signs as |sign|}}
            <button type="button" class="wod5e-mage-danni-sign" data-role="danniSign" data-state="{{sign.state}}" aria-label="{{localize sign.label}}">
                <i class="wod5e-mage-salute-glyph" data-state="{{sign.state}}" aria-hidden="true"></i>
                <span>{{localize sign.label}}</span>
            </button>
        {{/each}}
    </div>
</div>
