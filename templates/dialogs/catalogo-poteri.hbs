{{!-- Il catalogo dei poteri (24/9 sera). La finestra «Aggiungi»: le pastiglie delle
     Sfere conosciute (poteri / pallini), la cerca, il conto; solo i poteri che si
     possono prendere adesso, in due gruppi (della Sfera, di qualsiasi Sfera); una
     riga per potere (pallino, nome, matrice, tipo, costo, limite d'uso) che si apre
     sul testo intero; «Aggiungi» lo mette sul personaggio e la riga prende la
     spunta; a quota piena (tanti poteri quanti i pallini) i tasti si spengono. Il
     Catalogo completo (`tutto`): tutti i poteri, Sfera per Sfera, senza tasti. --}}
<div class="wod5e-mage-grimorio-body wod5e-mage-catalogo-body">
    {{#if pastiglie}}
        <div class="wod5e-mage-catalogo-sfere" role="tablist" aria-label="{{localize 'WOD5E_MAGE.Tabs.Spheres'}}">
            {{#each pastiglie as |s|}}
                <button type="button" class="wod5e-mage-catalogo-sfera{{#if s.attiva}} attiva{{/if}}{{#if s.pieno}} piena{{/if}}" role="tab" aria-selected="{{s.attiva}}" data-role="catalogoSfera" data-sphere="{{s.id}}" title="{{localize 'WOD5E_MAGE.Poteri.CatalogoQuota' known=s.conto rating=s.rating}}"><img src="{{s.icon}}" alt=""><span>{{s.label}}</span><small>{{s.conto}}/{{s.rating}}</small></button>
            {{/each}}
        </div>
    {{/if}}
    <div class="wod5e-mage-grimorio-top wod5e-mage-catalogo-top">
        {{#if icon}}<img class="wod5e-mage-catalogo-sigillo" src="{{icon}}" alt="">{{/if}}
        <input type="search" class="wod5e-mage-grimorio-search" data-role="catalogoSearch" placeholder="{{localize 'WOD5E_MAGE.Poteri.CatalogoCerca'}}" aria-label="{{localize 'WOD5E_MAGE.Poteri.CatalogoCerca'}}">
        <span class="wod5e-mage-catalogo-conto" data-role="catalogoConto">{{localize "WOD5E_MAGE.Poteri.CatalogoConto" total=totale known=conosciuti}}</span>
    </div>
    {{#unless tutto}}
        {{#if pieno}}
            <p class="wod5e-mage-catalogo-avviso pieno"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Poteri.CatalogoPieno" sphere=sphereLabel rating=rating}}</p>
        {{else}}
            <p class="wod5e-mage-catalogo-avviso"><i class="fa-solid fa-circle-dot" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Poteri.CatalogoPosti" n=posti sphere=sphereLabel known=conosciuti rating=rating}}</p>
        {{/if}}
        {{#if chiusi}}<p class="wod5e-mage-catalogo-avviso"><i class="fa-solid fa-lock" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Poteri.CatalogoChiusi" n=chiusi rating=rating}}</p>{{/if}}
    {{/unless}}

    {{#each gruppi as |gruppo|}}
        <section class="wod5e-mage-catalogo-gruppo" data-catalogo-gruppo="{{gruppo.id}}">
            <h3 class="wod5e-mage-catalogo-titolo"><span>{{gruppo.label}}</span><small>{{gruppo.righe.length}}</small></h3>
            {{#each gruppo.righe as |voce|}}
            <details class="wod5e-mage-grimorio-row wod5e-mage-catalogo-row{{#if voce.known}} known{{/if}}" data-catalogo="{{voce.id}}" data-search="{{voce.search}}">
                <summary>
                    <b class="wod5e-mage-potere-pallino{{#unless voce.dot}} vuoto{{/unless}}" title="{{localize 'WOD5E_MAGE.Poteri.Pallino'}}">{{#if voce.dot}}{{voce.dot}}{{else}}·{{/if}}</b>
                    <span class="wod5e-mage-catalogo-nome">{{voce.name}}{{#if voce.proposal}} <i class="wod5e-mage-catalogo-proposta" title="{{localize 'WOD5E_MAGE.Grimorio.Proposal'}}">◇</i>{{/if}}</span>
                    <em class="wod5e-mage-grimorio-formula">{{voce.formulaName}}</em>
                    <span class="wod5e-mage-catalogo-tag">{{#if voce.tipi.attivo}}<small class="attivo">{{localize "WOD5E_MAGE.Poteri.Tipo.attivo"}}</small>{{/if}}{{#if voce.tipi.passivo}}<small class="passivo">{{localize "WOD5E_MAGE.Poteri.Tipo.passivo"}}</small>{{/if}}{{#if voce.cost}}<small>{{voce.cost}}</small>{{/if}}{{#if voce.uses}}<small>{{voce.uses}}</small>{{/if}}</span>
                    {{#if @root.tutto}}
                        {{#if voce.known}}<span class="wod5e-mage-catalogo-spunta" title="{{localize 'WOD5E_MAGE.Poteri.Conosciuto'}}"><i class="fa-solid fa-check" aria-hidden="true"></i></span>{{/if}}
                    {{else}}
                        <button type="button" class="wod5e-mage-catalogo-aggiungi" data-role="catalogoAggiungi" data-catalogo="{{voce.id}}" {{#if voce.known}}disabled{{else if @root.pieno}}disabled{{/if}}>{{#if voce.known}}<i class="fa-solid fa-check" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Poteri.Conosciuto"}}{{else}}<i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Poteri.Aggiungi"}}{{/if}}</button>
                    {{/if}}
                    <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                </summary>
                <div class="wod5e-mage-catalogo-testo">
                    {{#each voce.blocchi as |blocco|}}
                        <p class="wod5e-mage-catalogo-blocco">{{#if blocco.titolo}}<b>{{blocco.titolo}}</b>{{/if}}{{#each blocco.righe as |riga|}}<span>{{riga}}</span>{{/each}}</p>
                    {{/each}}
                    {{#if voce.paradox}}<p class="wod5e-mage-catalogo-blocco wod5e-mage-catalogo-paradosso"><b>{{localize "WOD5E_MAGE.Poteri.Carta.Paradosso"}}</b><span>{{voce.paradox}}</span></p>{{/if}}
                    {{#if voce.flavor}}<p class="wod5e-mage-catalogo-flavor"><em>{{voce.flavor}}</em></p>{{/if}}
                </div>
            </details>
            {{else}}
                <p class="wod5e-mage-grimorio-empty">{{localize "WOD5E_MAGE.Poteri.CatalogoVuotoSfera"}}</p>
            {{/each}}
        </section>
    {{/each}}
</div>
