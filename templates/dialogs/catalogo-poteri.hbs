{{!-- Il catalogo dei poteri (24/9 sera; 25/9; 27/9). La finestra «Aggiungi»: le pastiglie
     delle Sfere conosciute (col conto dei poteri che si hanno), la cerca, il conto;
     tutti i poteri che la Sfera apre, in ordine di grado e poi di nome, in due
     gruppi (della Sfera, di qualsiasi Sfera); una riga per potere a colonne fisse
     (grado, nome, matrice, tipo, Aggiungi: niente prezzi qui, Blue 27/9, «mi basta
     vedere il grado») che si apre sulle quattro parti (Grado, Prerequisiti, Effetto
     attivo, Effetto passivo); una riga coi prerequisiti che mancano sta col lucchetto
     e dice cosa serve; «Aggiungi» mette il potere sul personaggio e la riga prende la
     spunta. Il Narratore ha la matita «Per tutti» sul testo di base. Il Catalogo
     completo (`tutto`): tutti i poteri, Sfera per Sfera, senza tasti. --}}
<div class="wod5e-mage-grimorio-body wod5e-mage-catalogo-body">
    {{#if pastiglie}}
        <div class="wod5e-mage-catalogo-sfere" role="tablist" aria-label="{{localize 'WOD5E_MAGE.Tabs.Spheres'}}">
            {{#each pastiglie as |s|}}
                <button type="button" class="wod5e-mage-catalogo-sfera{{#if s.attiva}} attiva{{/if}}" role="tab" aria-selected="{{s.attiva}}" data-role="catalogoSfera" data-sphere="{{s.id}}" title="{{localize 'WOD5E_MAGE.Poteri.CatalogoConosciuti' known=s.conto}}"><img src="{{s.icon}}" alt=""><span>{{s.label}}</span><small>{{s.conto}}</small></button>
            {{/each}}
        </div>
    {{/if}}
    <div class="wod5e-mage-grimorio-top wod5e-mage-catalogo-top">
        {{#if icon}}<img class="wod5e-mage-catalogo-sigillo" src="{{icon}}" alt="">{{/if}}
        <input type="search" class="wod5e-mage-grimorio-search" data-role="catalogoSearch" placeholder="{{localize 'WOD5E_MAGE.Poteri.CatalogoCerca'}}" aria-label="{{localize 'WOD5E_MAGE.Poteri.CatalogoCerca'}}">
        <span class="wod5e-mage-catalogo-conto" data-role="catalogoConto">{{localize "WOD5E_MAGE.Poteri.CatalogoConto" total=totale known=conosciuti}}</span>
    </div>
    {{#unless tutto}}
        {{!-- Il Dominio è di famiglia o esterno, e quanto costa ogni grado (25/9 sera: «nell'elenco non è capibile»). --}}
        <p class="wod5e-mage-catalogo-avviso wod5e-mage-catalogo-dominio"><i class="fa-solid {{#if family}}fa-house{{else}}fa-globe{{/if}}" aria-hidden="true"></i> {{dominioLabel}}</p>
        {{#if creazione}}<p class="wod5e-mage-catalogo-avviso wod5e-mage-catalogo-creazione"><i class="fa-solid fa-wand-sparkles" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Poteri.CreazioneRegola"}}</p>{{/if}}
        {{#if chiusi}}<p class="wod5e-mage-catalogo-avviso"><i class="fa-solid fa-lock" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Poteri.CatalogoChiusi" n=chiusi}}</p>{{/if}}
    {{/unless}}

    {{#each gruppi as |gruppo|}}
        <section class="wod5e-mage-catalogo-gruppo" data-catalogo-gruppo="{{gruppo.id}}">
            <h3 class="wod5e-mage-catalogo-titolo"><span>{{gruppo.label}}</span><small>{{gruppo.righe.length}}</small></h3>
            {{#if gruppo.nota}}{{#unless @root.tutto}}<p class="wod5e-mage-catalogo-avviso wod5e-mage-catalogo-qualsiasi"><i class="fa-solid fa-thumbtack" aria-hidden="true"></i> {{gruppo.nota}}</p>{{/unless}}{{/if}}
            {{#each gruppo.righe as |voce|}}
            <details class="wod5e-mage-grimorio-row wod5e-mage-catalogo-row{{#if voce.known}} known{{/if}}{{#if voce.locked}} chiusa{{/if}}" data-catalogo="{{voce.id}}" data-search="{{voce.search}}">
                <summary>
                    <b class="wod5e-mage-potere-pallino{{#unless voce.dot}} vuoto{{/unless}}" title="{{localize 'WOD5E_MAGE.Poteri.Grado'}}">{{#if voce.dot}}{{voce.dot}}{{else}}·{{/if}}</b>
                    <span class="wod5e-mage-catalogo-nome">{{voce.name}}{{#if voce.proposal}} <i class="wod5e-mage-catalogo-proposta" title="{{localize 'WOD5E_MAGE.Grimorio.Proposal'}}">◇</i>{{/if}}{{#if voce.locked}} <i class="fa-solid fa-lock wod5e-mage-catalogo-lucchetto" title="{{voce.lockedHint}}" aria-hidden="true"></i>{{/if}}{{#if voce.parti.modificato.mondo}} <i class="fa-solid fa-globe wod5e-mage-catalogo-segno" title="{{localize 'WOD5E_MAGE.Poteri.ModificatoMondo'}}" aria-hidden="true"></i>{{/if}}{{#if voce.knownAltrove}}<small class="wod5e-mage-catalogo-segnato" title="{{voce.knownHint}}"><i class="fa-solid fa-thumbtack" aria-hidden="true"></i> {{voce.knownHint}}</small>{{/if}}</span>
                    <em class="wod5e-mage-grimorio-formula">{{voce.formulaName}}</em>
                    <span class="wod5e-mage-catalogo-tipi">{{#if voce.tipi.attivo}}<small class="attivo">{{localize "WOD5E_MAGE.Poteri.Tipo.attivo"}}</small>{{/if}}{{#if voce.tipi.passivo}}<small class="passivo">{{localize "WOD5E_MAGE.Poteri.Tipo.passivo"}}</small>{{/if}}</span>
                    <span class="wod5e-mage-catalogo-azione">
                        {{#if @root.tutto}}
                            {{#if voce.known}}<span class="wod5e-mage-catalogo-spunta" title="{{localize 'WOD5E_MAGE.Poteri.Conosciuto'}}"><i class="fa-solid fa-check" aria-hidden="true"></i></span>{{/if}}
                        {{else}}
                            <button type="button" class="wod5e-mage-catalogo-aggiungi" data-role="catalogoAggiungi" data-catalogo="{{voce.id}}" {{#if voce.known}}disabled title="{{voce.knownHint}}"{{else if voce.locked}}disabled title="{{voce.lockedHint}}"{{/if}}>{{#if voce.known}}<i class="fa-solid fa-check" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Poteri.Conosciuto"}}{{else}}<i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Poteri.Aggiungi"}}{{/if}}</button>
                        {{/if}}
                    </span>
                    <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                </summary>
                <div class="wod5e-mage-catalogo-testo">
                    {{!-- Le quattro parti (Blue, 27/9): Grado, Prerequisiti (una condizione per riga: la spunta se c'è, il lucchetto
                         se manca, il punto se la giudica il tavolo; o il testo scritto dal Narratore), Effetto attivo, Effetto passivo. --}}
                    <p class="wod5e-mage-catalogo-blocco wod5e-mage-catalogo-grado"><b>{{localize "WOD5E_MAGE.Poteri.Grado"}}</b><span>{{voce.gradoLabel}}</span></p>
                    <div class="wod5e-mage-catalogo-blocco wod5e-mage-catalogo-serve{{#if voce.serveOk}} ok{{/if}}{{#if voce.parti.prerequisiti.vuota}} vuoto{{/if}}"><b>{{localize "WOD5E_MAGE.Poteri.Prerequisiti"}}</b>
                        {{#if voce.condizioni.length}}
                            <ul class="wod5e-mage-catalogo-condizioni">
                                {{#each voce.condizioni as |c|}}<li class="{{c.stato}}"><i class="fa-solid {{c.icona}}" aria-hidden="true"></i> {{c.testo}}</li>{{/each}}
                            </ul>
                        {{else}}
                            {{#each voce.parti.prerequisiti.righe as |r|}}<span>{{r}}</span>{{else}}<span><em>{{localize "WOD5E_MAGE.Poteri.PrerequisitiNessuno"}}</em></span>{{/each}}
                        {{/if}}
                    </div>
                    <p class="wod5e-mage-catalogo-blocco attivo{{#if voce.parti.attivo.vuota}} vuoto{{/if}}"><b>{{localize "WOD5E_MAGE.Poteri.EffettoAttivo"}}</b>{{#each voce.parti.attivo.voci as |v|}}<span>{{#if v.accesso}}<strong class="wod5e-mage-accesso">{{#if v.con}}{{localize "WOD5E_MAGE.Poteri.ConSfera"}}{{else}}{{localize "WOD5E_MAGE.Grimorio.Access"}}{{/if}} {{#each v.sfere as |sfera|}}<img class="wod5e-mage-sfera-inline" src="modules/wod5e-mage/assets/icons/sheet/{{sfera}}.png" alt="{{localize (concat 'WOD5E_MAGE.Spheres.' sfera)}}" title="{{localize (concat 'WOD5E_MAGE.Spheres.' sfera)}}">{{/each}}:</strong> {{else if v.chiave}}<strong>{{v.chiave}}:</strong> {{/if}}{{v.testo}}</span>{{else}}<span><em>{{localize "WOD5E_MAGE.Poteri.EffettoNessuno"}}</em></span>{{/each}}</p>
                    <p class="wod5e-mage-catalogo-blocco passivo{{#if voce.parti.passivo.vuota}} vuoto{{/if}}"><b>{{localize "WOD5E_MAGE.Poteri.EffettoPassivo"}}</b>{{#each voce.parti.passivo.voci as |v|}}<span>{{#if v.accesso}}<strong class="wod5e-mage-accesso">{{#if v.con}}{{localize "WOD5E_MAGE.Poteri.ConSfera"}}{{else}}{{localize "WOD5E_MAGE.Grimorio.Access"}}{{/if}} {{#each v.sfere as |sfera|}}<img class="wod5e-mage-sfera-inline" src="modules/wod5e-mage/assets/icons/sheet/{{sfera}}.png" alt="{{localize (concat 'WOD5E_MAGE.Spheres.' sfera)}}" title="{{localize (concat 'WOD5E_MAGE.Spheres.' sfera)}}">{{/each}}:</strong> {{else if v.chiave}}<strong>{{v.chiave}}:</strong> {{/if}}{{v.testo}}</span>{{else}}<span><em>{{localize "WOD5E_MAGE.Poteri.EffettoNessuno"}}</em></span>{{/each}}</p>
                    {{#if voce.paradox}}<p class="wod5e-mage-catalogo-blocco wod5e-mage-catalogo-paradosso"><b>{{localize "WOD5E_MAGE.Poteri.Carta.Paradosso"}}</b><span>{{voce.paradox}}</span></p>{{/if}}
                    {{#if voce.flavor}}<p class="wod5e-mage-catalogo-flavor"><em>{{voce.flavor}}</em></p>{{/if}}
                    {{#if @root.gm}}<p class="wod5e-mage-catalogo-modifica"><button type="button" data-role="catalogoModifica" data-catalogo="{{voce.id}}" title="{{localize 'WOD5E_MAGE.Poteri.ModificaBaseHint'}}"><i class="fa-solid fa-globe" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Poteri.ModificaBase"}}</button>{{#if voce.parti.modificato.mondo}}<small>{{localize "WOD5E_MAGE.Poteri.ModificatoMondo"}}</small>{{/if}}</p>{{/if}}
                </div>
            </details>
            {{else}}
                <p class="wod5e-mage-grimorio-empty">{{localize "WOD5E_MAGE.Poteri.CatalogoVuotoSfera"}}</p>
            {{/each}}
        </section>
    {{/each}}
</div>
