{{!-- Note, rifatta l'1/10 sul mock approvato: a sinistra «Cosa vuole adesso» e
     «Quando molla», due campi della bandiera; a destra la biografia che
     l'attore ha già. In Gioca si leggono, in Scrivi si scrivono. Le vede solo
     il Narratore. --}}
<section class="tab {{tab.cssClass}} wod5e-mage-nemico-corpo" data-tab="{{tab.id}}" data-group="{{tab.group}}">
    {{#if isGM}}
        <div class="wod5e-mage-nemico-due">
            <div class="wod5e-mage-nemico-col">
                <div class="wod5e-mage-nemico-riq">
                    <h3 class="wod5e-mage-nemico-titolo">{{localize "WOD5E_MAGE.Nemico.Vuole"}}</h3>
                    {{#if scrivi}}
                        <textarea class="wod5e-mage-nemico-nota" name="flags.wod5e-mage.nemico.note.vuole" rows="3" placeholder="{{localize 'WOD5E_MAGE.Nemico.DaScrivere'}}" aria-label="{{localize 'WOD5E_MAGE.Nemico.Vuole'}}">{{note.vuole}}</textarea>
                    {{else}}
                        {{#if note.vuole}}<p class="wod5e-mage-nemico-testo">{{note.vuole}}</p>{{else}}<p class="wod5e-mage-nemico-nessuna">{{localize "WOD5E_MAGE.Nemico.DaScrivere"}}</p>{{/if}}
                    {{/if}}
                </div>
                <div class="wod5e-mage-nemico-riq">
                    <h3 class="wod5e-mage-nemico-titolo">{{localize "WOD5E_MAGE.Nemico.Molla"}}</h3>
                    {{#if scrivi}}
                        <textarea class="wod5e-mage-nemico-nota" name="flags.wod5e-mage.nemico.note.molla" rows="3" placeholder="{{localize 'WOD5E_MAGE.Nemico.DaScrivere'}}" aria-label="{{localize 'WOD5E_MAGE.Nemico.Molla'}}">{{note.molla}}</textarea>
                    {{else}}
                        {{#if note.molla}}<p class="wod5e-mage-nemico-testo">{{note.molla}}</p>{{else}}<p class="wod5e-mage-nemico-nessuna">{{localize "WOD5E_MAGE.Nemico.DaScrivere"}}</p>{{/if}}
                    {{/if}}
                </div>
            </div>
            <div class="wod5e-mage-nemico-col">
                <div class="wod5e-mage-nemico-riq wod5e-mage-nemico-biografia">
                    <h3 class="wod5e-mage-nemico-titolo">{{localize "WOD5E_MAGE.Nemico.Biografia"}}</h3>
                    {{!-- La biografia è HTML del sistema: in Scrivi l'editor con la matita, come le note del Credo. --}}
                    {{#if scrivi}}
                        <prose-mirror name="system.biography" value="{{biografia}}" toggled="true" compact="true">
                            {{{biografiaArricchita}}}
                        </prose-mirror>
                    {{else}}
                        {{#if biografia}}<div class="wod5e-mage-nemico-testo">{{{biografiaArricchita}}}</div>{{else}}<p class="wod5e-mage-nemico-nessuna">{{localize "WOD5E_MAGE.Nemico.DaScrivere"}}</p>{{/if}}
                    {{/if}}
                </div>
            </div>
        </div>
    {{/if}}
    <p class="wod5e-mage-nemico-solo">{{localize "WOD5E_MAGE.Nemico.SoloNarratore"}}</p>
</section>
