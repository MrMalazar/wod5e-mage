{{!-- La testata della scheda del nemico, rifatta l'1/10 sul mock approvato
     (docs/mock_scheda_nemico_1-10.html): resta uguale su ogni pagina. In alto
     chi è: il ritratto, il nome, il concetto, la disposizione con icona e
     parola, Natura e Fazione, e il tasto dei due modi. In Gioca è testo fermo;
     in Scrivi sono campi di carta con la loro etichetta. Sotto, la fascia di
     come sta: la Salute (le caselle del mago, il conto, il cuore che apre la
     ruota), l'Armatura se la porta (i punti si cliccano uno per uno), le
     Condizioni (la × le toglie, il + apre la scelta). In fondo le linguette. --}}
<header class="wod5e-mage-nemico-testa" data-disposizione="{{disposizione.id}}" data-modo="{{modo}}">
    <div class="wod5e-mage-nemico-chi">
        <div class="wod5e-mage-nemico-ritratto">
            <img src="{{img}}" alt="{{nome}}">
            {{#if scrivi}}<button type="button" class="wod5e-mage-nemico-cambia" data-action="ritrattoCambia" title="{{localize 'WOD5E_MAGE.Nemico.Ritratto'}}" aria-label="{{localize 'WOD5E_MAGE.Nemico.Ritratto'}}"><i class="fa-solid fa-camera" aria-hidden="true"></i></button>{{/if}}
        </div>
        {{#if scrivi}}
            <div class="wod5e-mage-nemico-campi">
                <div class="wod5e-mage-nemico-campi-riga">
                    <label class="wod5e-mage-nemico-campo largo"><span>{{localize "WOD5E_MAGE.Nemico.Nome"}}</span><input type="text" class="wod5e-mage-nemico-nome" name="name" value="{{nome}}" placeholder="{{localize 'WOD5E_MAGE.Nemico.Nome'}}"></label>
                    <label class="wod5e-mage-nemico-campo largo"><span>{{localize "WOD5E_MAGE.Nemico.Concetto"}}</span><input type="text" name="system.headers.concept" value="{{concetto}}" placeholder="{{localize 'WOD5E_MAGE.Nemico.ConcettoHint'}}"></label>
                </div>
                <div class="wod5e-mage-nemico-campi-riga">
                    <label class="wod5e-mage-nemico-campo"><span>{{localize "WOD5E_MAGE.Nemico.Disposizione"}}</span><select data-nemico-disposizione>{{#each disposizioni as |d|}}<option value="{{d.value}}" {{#if d.on}}selected{{/if}}>{{d.label}}</option>{{/each}}</select></label>
                    <label class="wod5e-mage-nemico-campo"><span>{{localize "WOD5E_MAGE.Nemico.Natura"}}</span><select name="flags.wod5e-mage.nemico.natura">{{#each nature as |n|}}<option value="{{n.id}}" {{#if n.on}}selected{{/if}}>{{n.label}}</option>{{/each}}</select></label>
                    <label class="wod5e-mage-nemico-campo largo"><span>{{localize "WOD5E_MAGE.Nemico.Fazione"}}</span><input type="text" name="flags.wod5e-mage.nemico.fazione" value="{{fazione}}" placeholder="{{localize 'WOD5E_MAGE.Nemico.FazioneHint'}}"></label>
                </div>
            </div>
        {{else}}
            <div class="wod5e-mage-nemico-nomi">
                <h1 class="wod5e-mage-nemico-nome">{{nome}}</h1>
                {{#if concetto}}<p class="wod5e-mage-nemico-concetto">{{concetto}}</p>{{/if}}
                <p class="wod5e-mage-nemico-meta"><span class="wod5e-mage-nemico-disp"><i class="{{disposizione.icona}}" aria-hidden="true"></i>{{disposizione.label}}</span><span class="wod5e-mage-nemico-appartenenza">{{appartenenza}}</span></p>
            </div>
        {{/if}}
        {{#if puoScrivere}}
            <div class="wod5e-mage-nemico-modi" role="group" aria-label="{{localize 'WOD5E_MAGE.Nemico.Modi.gruppo'}}">
                {{#each modi as |m|}}<button type="button" class="wod5e-mage-nemico-modo{{#if m.on}} on{{/if}}" data-action="nemicoModo" data-modo="{{m.id}}" title="{{m.hint}}" aria-pressed="{{m.on}}">{{m.label}}</button>{{/each}}
            </div>
        {{/if}}
    </div>

    <div class="wod5e-mage-nemico-stato">
        {{!-- La Salute: le caselle del mago (il clic sinistro sceglie il segno, il destro svuota), il conto, il cuore che apre la ruota. In Scrivi al posto del conto c'è il numero delle caselle. --}}
        <div class="wod5e-mage-nemico-cella">
            <span class="wod5e-mage-nemico-k">{{localize "WOD5E_MAGE.Nemico.Salute"}}</span>
            <div class="wod5e-mage-nemico-cella-riga">
                <div class="wod5e-mage-salute-track wod5e-mage-nemico-track" role="group" aria-label="{{localize 'WOD5E_MAGE.Nemico.Salute'}}">
                    {{#each salute.cells as |cell|}}
                        <button type="button" class="wod5e-mage-salute-cell{{#if cell.locked}} wod5e-mage-salute-locked{{/if}}" data-state="{{cell.state}}" data-action="saluteCellChange" data-index="{{cell.index}}" aria-label="{{localize cell.label}}"></button>
                    {{/each}}
                </div>
                {{#if scrivi}}
                    <input type="number" class="wod5e-mage-nemico-num" name="system.health.max" value="{{saluteMax}}" min="1" max="20" title="{{localize 'WOD5E_MAGE.Salute.Extra'}}" aria-label="{{localize 'WOD5E_MAGE.Salute.Extra'}}">
                {{else}}
                    <span class="wod5e-mage-nemico-conto">{{salute.total}}/{{salute.max}}</span>
                    <div class="wod5e-mage-riga con-ventaglio wod5e-mage-nemico-ventaglio-riga">
                        <button type="button" class="wod5e-mage-riga-tastino wod5e-mage-ventaglio-tasto wod5e-mage-nemico-mini" data-action="ventaglioToggle" title="{{localize 'WOD5E_MAGE.Nemico.SaluteRuota'}}" aria-label="{{localize 'WOD5E_MAGE.Nemico.SaluteRuota'}}"><i class="fa-solid fa-heart" aria-hidden="true"></i></button>
                        {{!-- La sorgente della ruota: tre comandi (Danni, Riposo, Reset), come sulla scheda del mago. --}}
                        <div class="wod5e-mage-ventaglio wod5e-mage-ventaglio-tre" role="group" aria-label="{{localize 'WOD5E_MAGE.Nemico.SaluteRuota'}}">
                            <button type="button" class="wod5e-mage-ventaglio-voce" style="--voce: 0" data-action="saluteDanni" title="{{localize 'WOD5E_MAGE.Salute.DanniHint'}}" aria-label="{{localize 'WOD5E_MAGE.Salute.Danni'}}"><i class="fa-solid fa-heart-crack" aria-hidden="true"></i><span>{{localize "WOD5E_MAGE.Salute.DanniBreve"}}</span></button>
                            <button type="button" class="wod5e-mage-ventaglio-voce" style="--voce: 1" data-action="saluteRiposo" title="{{localize 'WOD5E_MAGE.Salute.RiposoHint'}}" aria-label="{{localize 'WOD5E_MAGE.Salute.Riposo'}}"><i class="fa-solid fa-bed" aria-hidden="true"></i><span>{{localize "WOD5E_MAGE.Salute.Riposo"}}</span></button>
                            <button type="button" class="wod5e-mage-ventaglio-voce" style="--voce: 2" data-action="saluteReset" title="{{localize 'WOD5E_MAGE.Salute.ResetHint'}}" aria-label="{{localize 'WOD5E_MAGE.Salute.Reset'}}"><i class="fa-solid fa-eraser" aria-hidden="true"></i><span>{{localize "WOD5E_MAGE.Salute.Reset"}}</span></button>
                        </div>
                    </div>
                {{/if}}
            </div>
        </div>

        {{!-- L'Armatura, una cella per protezione: i punti si cliccano uno per uno; il nome sta nel sorvolo e nella pagina Oggetti. --}}
        {{#each armature as |arm|}}
            <div class="wod5e-mage-nemico-cella" title="{{arm.name}} · {{arm.kindLabel}}">
                <span class="wod5e-mage-nemico-k">{{#if arm.mentale}}{{localize "WOD5E_MAGE.Nemico.ArmaturaMentale"}}{{else}}{{localize "WOD5E_MAGE.Nemico.Armatura"}}{{/if}}</span>
                <div class="wod5e-mage-nemico-cella-riga">
                    <span class="wod5e-mage-nemico-punti" role="group" aria-label="{{arm.name}}">
                        {{#each arm.pips as |pip|}}<button type="button" class="wod5e-mage-nemico-punto{{#if pip.pieno}} on{{/if}}" data-action="nemicoArmatura" data-item-id="{{arm.id}}" data-punti="{{pip.punti}}" aria-label="{{localize 'WOD5E_MAGE.Nemico.ArmaturaPunto' nome=arm.name n=pip.n pieno=arm.pieno}}" aria-pressed="{{pip.pieno}}"><i aria-hidden="true"></i></button>{{/each}}
                    </span>
                    <span class="wod5e-mage-nemico-conto">{{arm.conto}}</span>
                </div>
            </div>
        {{/each}}

        <div class="wod5e-mage-nemico-cella larga">
            <span class="wod5e-mage-nemico-k">{{localize "WOD5E_MAGE.Nemico.Condizioni"}}</span>
            <div class="wod5e-mage-nemico-cella-riga">
                <div class="wod5e-mage-nemico-conds">
                    {{#each condizioni as |cond|}}
                        <span class="wod5e-mage-nemico-cond{{#if cond.suppressed}} spenta{{/if}}" title="{{cond.title}}">
                            {{#if cond.list}}<span class="wod5e-mage-cond-icona"><i style="-webkit-mask-image: url({{cond.img}}); mask-image: url({{cond.img}})"></i>{{#if cond.numeral}}<b>{{cond.numeral}}</b>{{/if}}</span>{{else if cond.img}}<img src="{{cond.img}}" alt="">{{/if}}
                            <span class="wod5e-mage-nemico-cond-nome">{{cond.nome}}</span>
                            {{#if cond.malus}}<span class="wod5e-mage-nemico-meno">{{cond.malus}}</span>{{/if}}
                            <button type="button" class="wod5e-mage-nemico-togli" data-action="condizioneToggle" data-condizione="{{cond.condizione}}" data-item-id="{{cond.id}}" title="{{localize 'WOD5E_MAGE.Nemico.CondizioneTogli'}}" aria-label="{{localize 'WOD5E_MAGE.Nemico.CondizioneTogli'}}: {{cond.nome}}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
                        </span>
                    {{else}}
                        <span class="wod5e-mage-nemico-nessuna">{{localize "WOD5E_MAGE.Nemico.Nessuna"}}</span>
                    {{/each}}
                </div>
                {{!-- Il + apre la scelta delle Condizioni come sulla scheda del mago (29/9): le famiglie con le
                     loro scale, ogni grado col numero romano, poi i lievi e lo scontro; un clic accende. --}}
                <details class="wod5e-mage-nemico-condizioni-tendina">
                    <summary class="wod5e-mage-nemico-mini" title="{{localize 'WOD5E_MAGE.Nemico.CondizioneAggiungi'}}" aria-label="{{localize 'WOD5E_MAGE.Nemico.CondizioneAggiungi'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></summary>
                    <div class="wod5e-mage-nemico-condizioni-scelta">
                        {{#each condizioniScelta as |sezione|}}
                            <div class="wod5e-mage-cond-sezione sezione-{{sezione.id}}">
                                <span class="wod5e-mage-cond-sezione-nome">{{#if sezione.icon}}<span class="wod5e-mage-cond-icona"><i style="-webkit-mask-image: url({{sezione.icon}}); mask-image: url({{sezione.icon}})"></i></span>{{/if}}{{sezione.label}}</span>
                                {{#each sezione.scale as |scala|}}
                                    <div class="wod5e-mage-cond-scala">
                                        {{#if scala.label}}<span class="wod5e-mage-cond-scala-nome">{{scala.label}}</span>{{/if}}
                                        <span class="wod5e-mage-cond-voci">
                                            {{#each scala.voci as |entry|}}
                                                <button type="button" class="wod5e-mage-cond-voce{{#if entry.active}} lit{{/if}}" data-action="condizioneToggle" data-condizione="{{entry.id}}" title="{{entry.title}}" aria-pressed="{{entry.active}}">{{#if entry.numeral}}<b class="wod5e-mage-cond-grado">{{entry.numeral}}</b>{{/if}}<span>{{entry.name}}</span></button>
                                            {{/each}}
                                        </span>
                                    </div>
                                {{/each}}
                            </div>
                        {{/each}}
                    </div>
                </details>
            </div>
        </div>
    </div>

    <nav class="wod5e-mage-nemico-pagine tabs" data-group="primary">
        {{#each pagine as |pagina|}}
            <button type="button" class="wod5e-mage-nemico-pagina{{#if (eq pagina.id @root.tabAttiva)}} active{{/if}}" data-action="tab" data-group="primary" data-tab="{{pagina.id}}">{{pagina.label}}</button>
        {{/each}}
    </nav>
</header>
