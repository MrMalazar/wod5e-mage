{{!-- Passo 4 · il Tipo di Magick: tre carte. --}}
<section class="wod5e-mage-guidata-riq wod5e-mage-guidata-cosa">
    <header class="wod5e-mage-guidata-riq-titolo"><span>{{localize "WOD5E_MAGE.Guidata.Cosa"}}</span><small>{{passo.sotto}}</small></header>
    <h2 class="wod5e-mage-guidata-domanda">{{passo.domanda}}</h2>
    <div class="wod5e-mage-guidata-carte carte-tipi">
        {{#each corpo.tipi as |tipo|}}
            <button type="button" class="wod5e-mage-guidata-carta larga{{#if tipo.selected}} scelta{{/if}}{{#if tipo.consigliato}} del-credo{{/if}}" data-action="tipoScegli" data-form="{{tipo.id}}" aria-pressed="{{tipo.selected}}" {{#unless @root.canEdit}}disabled{{/unless}}>
                <span class="wod5e-mage-guidata-arte simbolo"><i class="{{tipo.icon}}" aria-hidden="true"></i></span>
                <h4>{{tipo.label}}</h4>
                <span class="wod5e-mage-guidata-sfere">
                    <small>{{localize "WOD5E_MAGE.Guidata.Tipo.Famiglie"}}: {{#each tipo.famiglie as |f|}}{{#if @index}}, {{/if}}{{f}}{{/each}}</small>
                    <small>{{localize "WOD5E_MAGE.Guidata.Tipo.Premio"}}: {{#if tipo.premio}}{{localize "WOD5E_MAGE.Guidata.Tipo.PremioSi"}}{{else}}{{localize "WOD5E_MAGE.Guidata.Tipo.PremioNo"}}{{/if}}</small>
                    {{#if tipo.consigliato}}<small class="wod5e-mage-guidata-tag oro">{{localize "WOD5E_MAGE.Guidata.Tipo.Consigliato"}}</small>{{/if}}
                </span>
            </button>
        {{/each}}
    </div>
    {{#if corpo.pratica}}
        <p class="wod5e-mage-guidata-nota-passo">{{localize "WOD5E_MAGE.Guidata.Tipo.Pratica"}}: <b>{{corpo.pratica}}</b>{{#if corpo.praticaTipo}} · {{localize "WOD5E_MAGE.Guidata.Tipo.Consigliato"}}: <b>{{corpo.praticaTipo}}</b>{{else}} · {{localize "WOD5E_MAGE.Guidata.Tipo.Nessuna"}}{{/if}}</p>
    {{/if}}
</section>
<aside class="wod5e-mage-guidata-spiega">
    {{> "modules/wod5e-mage/templates/guidata/perche.hbs"}}
    <section class="wod5e-mage-guidata-riq wod5e-mage-guidata-guadagni">
        <header class="wod5e-mage-guidata-riq-titolo"><span>{{localize "WOD5E_MAGE.Guidata.Guadagni"}}</span></header>
        <div class="wod5e-mage-guidata-voci">
            <div class="wod5e-mage-guidata-voce"><i class="fa-solid fa-hand-sparkles" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Guidata.Tipo.Famiglie"}} <b>{{#if corpo.chosen}}{{#each corpo.chosen.famiglie as |f|}}{{#if @index}}, {{/if}}{{f}}{{/each}}{{else}}…{{/if}}</b></div>
            <div class="wod5e-mage-guidata-voce{{#if corpo.chosen}}{{#unless corpo.chosen.premio}} no{{/unless}}{{/if}}"><img class="wod5e-mage-guidata-sigillo" src="modules/wod5e-mage/assets/icons/ui/arete.svg" alt=""> {{localize "WOD5E_MAGE.Guidata.Tipo.Premio"}} <b>{{#if corpo.chosen}}{{#if corpo.chosen.premio}}{{localize "WOD5E_MAGE.Guidata.Tipo.PremioSi"}}{{else}}{{localize "WOD5E_MAGE.Guidata.Tipo.PremioNo"}}{{/if}}{{else}}…{{/if}}</b></div>
            <div class="wod5e-mage-guidata-voce"><i class="fa-solid fa-toolbox" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Guidata.Credo.Strumenti"}} <b>{{localize "WOD5E_MAGE.Guidata.Credo.NelPasso" n=8}}</b></div>
        </div>
    </section>
</aside>
