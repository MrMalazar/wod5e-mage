{{!-- Passo 12 · le Ancore, da una a tre persone, sette righe l'una (Blue, 25/9):
     nome, ruolo, mestiere, età, cosa ti dà, la Convinzione che ti fa tenere,
     cosa non sa, dove morde. Il dado tira tutto tranne la Convinzione. --}}
<section class="wod5e-mage-guidata-riq wod5e-mage-guidata-cosa">
    <header class="wod5e-mage-guidata-riq-titolo"><span>{{localize "WOD5E_MAGE.Guidata.Cosa"}}</span><small>{{passo.sotto}}</small></header>
    <h2 class="wod5e-mage-guidata-domanda">{{passo.domanda}}</h2>
    <div class="wod5e-mage-guidata-etichetta"><i class="fa-solid fa-anchor" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Guidata.Passi.ancore.Label"}}
        <button type="button" class="wod5e-mage-guidata-tastino" data-action="catalogoApri" data-kind="ancora" title="{{localize 'WOD5E_MAGE.Guidata.Catalogo'}}" {{#unless @root.canEdit}}disabled{{/unless}}><i class="fa-solid fa-book-open" aria-hidden="true"></i></button>
        <button type="button" class="wod5e-mage-guidata-tastino wod5e-mage-guidata-tastino-testo" data-action="ancoraGenera" title="{{localize 'WOD5E_MAGE.Guidata.Ancore.Genera'}}" {{#unless @root.canEdit}}disabled{{/unless}}><i class="fa-solid fa-dice" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Guidata.Ancore.GeneraBreve"}}</button>
        <button type="button" class="wod5e-mage-guidata-tastino" data-action="rigaNuova" data-table="ancore" title="{{localize 'WOD5E_MAGE.Guidata.Ancore.Nuova'}}" {{#unless @root.canEdit}}disabled{{/unless}}><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
    </div>
    {{#each corpo.ancore as |row|}}
        <div class="wod5e-mage-guidata-ancora" data-row="{{row.id}}">
            <div class="wod5e-mage-guidata-ancora-riga wod5e-mage-guidata-ancora-testa">
                <input type="text" name="flags.wod5e-mage.ancore.{{row.id}}.name" value="{{row.name}}" placeholder="{{localize 'WOD5E_MAGE.Guidata.Ancore.Nome'}}" aria-label="{{localize 'WOD5E_MAGE.Guidata.Ancore.Nome'}}" {{#unless @root.canEdit}}disabled{{/unless}}>
                <select name="flags.wod5e-mage.ancore.{{row.id}}.role" aria-label="{{localize 'WOD5E_MAGE.Guidata.Ancore.Ruolo'}}" {{#unless @root.canEdit}}disabled{{/unless}}>
                    <option value="">{{localize "WOD5E_MAGE.Guidata.Ancore.Ruolo"}}</option>
                    {{#each row.roles as |ruolo|}}
                        <option value="{{ruolo.id}}" title="{{ruolo.definizione}}" {{#if ruolo.selected}}selected{{/if}}>{{ruolo.id}}</option>
                    {{/each}}
                </select>
                <input type="text" name="flags.wod5e-mage.ancore.{{row.id}}.job" value="{{row.job}}" placeholder="{{localize 'WOD5E_MAGE.Guidata.Ancore.Mestiere'}}" aria-label="{{localize 'WOD5E_MAGE.Guidata.Ancore.Mestiere'}}" {{#unless @root.canEdit}}disabled{{/unless}}>
                <input type="text" class="wod5e-mage-guidata-ancora-eta" name="flags.wod5e-mage.ancore.{{row.id}}.age" value="{{row.age}}" placeholder="{{localize 'WOD5E_MAGE.Guidata.Ancore.Eta'}}" aria-label="{{localize 'WOD5E_MAGE.Guidata.Ancore.Eta'}}" inputmode="numeric" {{#unless @root.canEdit}}disabled{{/unless}}>
                <button type="button" class="wod5e-mage-guidata-tastino" data-action="ancoraGenera" data-row="{{row.id}}" title="{{localize 'WOD5E_MAGE.Guidata.Ancore.GeneraRiga'}}" {{#unless @root.canEdit}}disabled{{/unless}}><i class="fa-solid fa-dice" aria-hidden="true"></i></button>
                <button type="button" class="wod5e-mage-guidata-tastino" data-action="rigaTogli" data-table="ancore" data-row="{{row.id}}" title="{{localize 'WOD5E_MAGE.Guidata.Togli'}}" {{#unless @root.canEdit}}disabled{{/unless}}><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
            </div>
            <div class="wod5e-mage-guidata-ancora-riga">
                <label><span>{{localize "WOD5E_MAGE.Guidata.Ancore.CosaTiDa"}}</span><input type="text" name="flags.wod5e-mage.ancore.{{row.id}}.gives" value="{{row.gives}}" {{#unless @root.canEdit}}disabled{{/unless}}></label>
                <label><span>{{localize "WOD5E_MAGE.Guidata.Ancore.Convinzione"}}</span>
                    <select name="flags.wod5e-mage.ancore.{{row.id}}.conviction" {{#unless @root.canEdit}}disabled{{/unless}}>
                        <option value="">{{localize "WOD5E_MAGE.Guidata.Ancore.ConvinzioneNessuna"}}</option>
                        {{#each row.convictions as |conv|}}
                            <option value="{{conv.id}}" {{#if conv.selected}}selected{{/if}}>{{conv.text}}</option>
                        {{/each}}
                    </select>
                </label>
            </div>
            <div class="wod5e-mage-guidata-ancora-riga">
                <label><span>{{localize "WOD5E_MAGE.Guidata.Ancore.CosaNonSa"}}</span><input type="text" name="flags.wod5e-mage.ancore.{{row.id}}.unknown" value="{{row.unknown}}" {{#unless @root.canEdit}}disabled{{/unless}}></label>
                <label><span>{{localize "WOD5E_MAGE.Guidata.Ancore.DoveMorde"}}</span><input type="text" name="flags.wod5e-mage.ancore.{{row.id}}.bites" value="{{row.bites}}" {{#unless @root.canEdit}}disabled{{/unless}}></label>
            </div>
            {{#if row.description}}
                <input type="text" class="wod5e-mage-guidata-ancora-note" name="flags.wod5e-mage.ancore.{{row.id}}.description" value="{{row.description}}" placeholder="{{localize 'WOD5E_MAGE.Guidata.Ancore.Note'}}" aria-label="{{localize 'WOD5E_MAGE.Guidata.Ancore.Note'}}" {{#unless @root.canEdit}}disabled{{/unless}}>
            {{/if}}
        </div>
    {{else}}
        <p class="wod5e-mage-guidata-nota-passo">{{localize "WOD5E_MAGE.Guidata.Ancore.Vuota"}}</p>
    {{/each}}
    {{#if corpo.proposte.length}}
        {{!-- Le dodici Ancore montate: ruolo, cosa ti dà, cosa non sa, dove morde; nome, mestiere ed età li tira il dado. --}}
        <div class="wod5e-mage-guidata-proposte"><small>{{localize "WOD5E_MAGE.Guidata.Ancore.Montate"}}</small>
            {{#each corpo.proposte as |p|}}<button type="button" class="wod5e-mage-guidata-chip" data-action="propostaMetti" data-kind="ancora" data-uuid="{{p.uuid}}" title="{{p.gives}} · {{p.unknown}} · {{p.bites}}" {{#unless @root.canEdit}}disabled{{/unless}}><b>{{p.name}}</b> {{p.role}}</button>{{/each}}
        </div>
    {{/if}}
</section>
<aside class="wod5e-mage-guidata-spiega">
    {{> "modules/wod5e-mage/templates/guidata/perche.hbs"}}
    <section class="wod5e-mage-guidata-riq wod5e-mage-guidata-guadagni">
        <header class="wod5e-mage-guidata-riq-titolo"><span>{{localize "WOD5E_MAGE.Guidata.Guadagni"}}</span></header>
        <div class="wod5e-mage-guidata-voci">
            <div class="wod5e-mage-guidata-voce {{#if corpo.fatte}}exact{{else}}under{{/if}}"><i class="fa-solid fa-anchor" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Guidata.Ancore.Scritte"}} <b>{{corpo.fatte}}/3</b></div>
            <div class="wod5e-mage-guidata-voce"><i class="fa-solid fa-hand-fist" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Guidata.Ancore.Volonta"}}</div>
            <div class="wod5e-mage-guidata-voce"><i class="fa-solid fa-scale-balanced" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Guidata.Ancore.Legame"}}</div>
        </div>
    </section>
</aside>
