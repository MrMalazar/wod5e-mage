{{!-- Passo 2 · la Famiglia (le nove Tradizioni, le dieci Craft) e sotto la via, con le Sfere che portano. --}}
<section class="wod5e-mage-guidata-riq wod5e-mage-guidata-cosa">
    <header class="wod5e-mage-guidata-riq-titolo"><span>{{localize "WOD5E_MAGE.Guidata.Cosa"}}</span><small>{{passo.sotto}}</small></header>
    <h2 class="wod5e-mage-guidata-domanda">{{passo.domanda}}</h2>
    {{#each corpo.gruppi as |gruppo|}}
        <h3 class="wod5e-mage-guidata-occhiello">{{gruppo.label}}</h3>
        <div class="wod5e-mage-guidata-carte carte-famiglie">
            {{#each gruppo.famiglie as |card|}}
                <button type="button" class="wod5e-mage-guidata-carta grande{{#if card.selected}} scelta{{/if}}{{#if card.delCredo}} del-credo{{/if}}" data-action="famigliaScegli" data-famiglia="{{card.id}}" aria-pressed="{{card.selected}}" {{#unless @root.canEdit}}disabled{{/unless}}>
                    <span class="wod5e-mage-guidata-arte immagine" data-iniziale="{{card.initial}}" title="{{localize 'WOD5E_MAGE.Guidata.ImmagineHint'}}"><img src="{{card.image}}" alt="" loading="lazy" onerror="this.parentElement.classList.add('manca')"><span class="wod5e-mage-guidata-arte-manca">{{localize "WOD5E_MAGE.Guidata.ImmagineDaFare"}}</span></span>
                    <h4>{{card.label}}</h4>
                    <span class="wod5e-mage-guidata-sfere">
                        {{#if card.sphere}}<span class="wod5e-mage-guidata-sfera"><img src="{{card.sphere.icon}}" alt=""> {{card.sphere.label}} <b>1</b></span>{{/if}}
                        {{#if card.delCredo}}<small class="wod5e-mage-guidata-tag oro">{{localize "WOD5E_MAGE.Guidata.Famiglia.DelCredo"}}</small>{{/if}}
                        {{#if card.craft}}<small class="wod5e-mage-guidata-tag">{{localize "WOD5E_MAGE.Guidata.Famiglia.Craft"}}</small>{{/if}}
                    </span>
                </button>
            {{/each}}
        </div>
    {{/each}}
    {{#if corpo.family}}
        {{#if corpo.sottofamiglie.length}}
            <header class="wod5e-mage-guidata-riq-titolo via"><span>{{localize "WOD5E_MAGE.Guidata.Famiglia.Via"}}</span><small>{{localize "WOD5E_MAGE.Guidata.Famiglia.ViaSotto" famiglia=corpo.family.label kind=corpo.family.subKind}}</small></header>
            <div class="wod5e-mage-guidata-carte carte-famiglie">
                {{#each corpo.sottofamiglie as |card|}}
                    <button type="button" class="wod5e-mage-guidata-carta grande{{#if card.selected}} scelta{{/if}}{{#if card.delCredo}} del-credo{{/if}}" data-action="sottofamigliaScegli" data-sottofamiglia="{{card.id}}" aria-pressed="{{card.selected}}" {{#unless @root.canEdit}}disabled{{/unless}} title="{{#if card.credoLabel}}{{localize 'WOD5E_MAGE.Guidata.Famiglia.CredoVia'}}: {{card.credoLabel}}{{/if}}{{#if card.pratica}} · {{localize 'WOD5E_MAGE.Guidata.Famiglia.Pratica'}}: {{card.pratica}}{{/if}}">
                        <span class="wod5e-mage-guidata-arte immagine" data-iniziale="{{card.initial}}"><img src="{{card.image}}" alt="" loading="lazy" onerror="this.parentElement.classList.add('manca')"><span class="wod5e-mage-guidata-arte-manca">{{localize "WOD5E_MAGE.Guidata.ImmagineDaFare"}}</span></span>
                        <h4>{{card.label}}</h4>
                        <span class="wod5e-mage-guidata-sfere">
                            {{#if card.sphere}}<span class="wod5e-mage-guidata-sfera"><img src="{{card.sphere.icon}}" alt=""> {{card.sphere.label}} <b>1</b></span>{{/if}}
                            {{#if card.delCredo}}<small class="wod5e-mage-guidata-tag oro">{{localize "WOD5E_MAGE.Guidata.Famiglia.DelCredo"}}</small>{{/if}}
                        </span>
                    </button>
                {{/each}}
            </div>
        {{/if}}
    {{else}}
        <p class="wod5e-mage-guidata-nota-passo">{{localize "WOD5E_MAGE.Guidata.Famiglia.ScegliPrima"}}</p>
    {{/if}}
</section>
<aside class="wod5e-mage-guidata-spiega">
    {{> "modules/wod5e-mage/templates/guidata/perche.hbs"}}
    <section class="wod5e-mage-guidata-riq wod5e-mage-guidata-guadagni">
        <header class="wod5e-mage-guidata-riq-titolo"><span>{{localize "WOD5E_MAGE.Guidata.Guadagni"}}</span></header>
        <div class="wod5e-mage-guidata-voci">
            <div class="wod5e-mage-guidata-voce"><i class="fa-solid fa-circle-nodes" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Guidata.Famiglia.SferaFamiglia"}} <b>{{#if corpo.family.sphere}}{{corpo.family.sphere.label}}{{else}}…{{/if}}</b></div>
            {{#unless corpo.family.craft}}<div class="wod5e-mage-guidata-voce"><i class="fa-solid fa-circle-nodes" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Guidata.Famiglia.SferaVia"}} <b>{{#if corpo.sub.sphere}}{{corpo.sub.sphere.label}}{{else}}…{{/if}}</b></div>{{/unless}}
            {{#if corpo.pratica}}<div class="wod5e-mage-guidata-voce"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Guidata.Famiglia.Pratica"}} <b>{{corpo.pratica}}</b></div>{{/if}}
            <div class="wod5e-mage-guidata-voce"><i class="fa-solid fa-compass" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Guidata.Famiglia.Bussola"}} <b>{{localize "WOD5E_MAGE.Guidata.Credo.NelPasso" n=3}}</b></div>
            <div class="wod5e-mage-guidata-voce"><i class="fa-solid fa-microchip" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Guidata.Famiglia.Tipo"}} <b>{{localize "WOD5E_MAGE.Guidata.Credo.NelPasso" n=4}}</b></div>
            <div class="wod5e-mage-guidata-voce"><i class="fa-solid fa-hand-sparkles" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Guidata.Famiglia.Strumenti"}} <b>{{localize "WOD5E_MAGE.Guidata.Credo.NelPasso" n=7}}</b></div>
        </div>
    </section>
</aside>
