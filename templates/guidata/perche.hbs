{{!-- Il «perché» del passo: poche righe dal LIBRO. Il Narratore lo riscrive
     con l'editor (Blue, 23/9: «le descrizioni passate con un editor testo»):
     per lui il testo è un prose-mirror con la matita, e il testo salvato vale
     per tutto il mondo (l'impostazione guidaTesti). --}}
<section class="wod5e-mage-guidata-riq wod5e-mage-guidata-perche{{#if perche.proprio}} proprio{{/if}}">
    <header class="wod5e-mage-guidata-riq-titolo">
        <span>{{localize "WOD5E_MAGE.Guidata.Perche"}}</span>
        {{#if perche.proprio}}<small class="wod5e-mage-guidata-tag">{{localize "WOD5E_MAGE.Guidata.Proprio"}}</small>{{/if}}
        {{#if narratore}}
            <span class="wod5e-mage-guidata-riq-tasti" title="{{localize 'WOD5E_MAGE.Guidata.RiscriviHint'}}">
                {{#if perche.proprio}}<button type="button" class="wod5e-mage-guidata-tastino" data-action="percheRipristina" title="{{localize 'WOD5E_MAGE.Guidata.Ripristina'}}" aria-label="{{localize 'WOD5E_MAGE.Guidata.Ripristina'}}"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></button>{{/if}}
            </span>
        {{/if}}
    </header>
    {{#if narratore}}
        <prose-mirror name="{{perche.chiave}}" value="{{perche.html}}" toggled="true" compact="true" class="wod5e-mage-guidata-editor wod5e-mage-guidata-testo">{{{perche.html}}}</prose-mirror>
    {{else}}
        <div class="wod5e-mage-guidata-testo">{{{perche.html}}}</div>
    {{/if}}
</section>
