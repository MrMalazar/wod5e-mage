{{!-- Il menù (25/9; 27/9, nove cassetti per «su cosa rimbalza il Paradosso»): i cassetti come titoli che si aprono e si chiudono (quadratino colorato, nome, riga «cosa ci trovi», conto), le voci in ordine alfabetico, una riga per voce (nome, effetto in breve, prezzo), senza sottotitoli di scena; le voci che il PDF consiglia per la scena scelta portano la barretta d'oro. Il clic sulla riga apre i comandi della spesa, la «i» apre il testo della voce. --}}
<div class="wod5e-mage-quadro-corpo wod5e-mage-quadro-menu">
    <div class="wod5e-mage-menu-testa">
        <select data-role="scena" aria-label="{{localize 'WOD5E_MAGE.Menu.Scena'}}">
            <option value="">{{localize "WOD5E_MAGE.Menu.NessunaScena"}}</option>
            {{#each scene as |s|}}<option value="{{s.id}}" {{#if s.selected}}selected{{/if}}>{{s.nome}}</option>{{/each}}
        </select>
        <input type="search" data-role="cerca" value="{{cerca}}" placeholder="{{localize 'WOD5E_MAGE.Menu.Cerca'}}" aria-label="{{localize 'WOD5E_MAGE.Menu.Cerca'}}">
    </div>
    {{#each cassetti as |cassetto|}}
        <section class="wod5e-mage-menu-cassetto wod5e-mage-menu-cassetto-{{cassetto.cassetto}}{{#if cassetto.chiusa}} chiusa{{/if}}{{#if cassetto.staccato}} staccato{{/if}}" data-cassetto="{{cassetto.cassetto}}">
            <h3 class="wod5e-mage-menu-cassetto-titolo">
                <button type="button" data-action="cassetto" data-cassetto="{{cassetto.cassetto}}" aria-expanded="{{#if cassetto.chiusa}}false{{else}}true{{/if}}">
                    <span class="quadratino"><i class="{{cassetto.icona}}" aria-hidden="true"></i></span>
                    <span class="testi"><span class="nome">{{cassetto.label}}</span><span class="sotto">{{cassetto.sotto}}</span></span>
                    <small class="conto">{{cassetto.conto}}</small>
                    <i class="fa-solid {{#if cassetto.chiusa}}fa-chevron-down{{else}}fa-chevron-up{{/if}} freccia" aria-hidden="true"></i>
                </button>
            </h3>
            {{#each cassetto.voci as |voce|}}
                    <div class="wod5e-mage-menu-voce{{#if voce.aperta}} aperta{{/if}}{{#if voce.scoppio}} scoppio{{/if}}{{#if voce.consigliata}} consigliata{{/if}}" data-voce="{{voce.id}}" data-testo="{{voce.testoCerca}}">
                        <div class="wod5e-mage-menu-riga">
                            <button type="button" class="wod5e-mage-menu-scegli" data-action="voce" data-voce="{{voce.id}}" aria-expanded="{{voce.aperta}}">
                                <i class="{{voce.iconaModo}}" title="{{voce.modoLabel}}" aria-hidden="true"></i>
                                <span class="nome">{{voce.nome}}</span>
                                <span class="breve">{{voce.breve}}</span>
                                <span class="prezzo">{{voce.prezzoLabel}}</span>
                            </button>
                            <button type="button" class="wod5e-mage-menu-info-tasto{{#if voce.testoAperto}} attivo{{/if}}" data-action="testo" data-voce="{{voce.id}}" title="{{localize 'WOD5E_MAGE.Menu.LeggiVoce'}}" aria-label="{{localize 'WOD5E_MAGE.Menu.LeggiVoce'}}" aria-expanded="{{voce.testoAperto}}"><i class="fa-solid fa-circle-info" aria-hidden="true"></i></button>
                        </div>
                        {{#if voce.testoAperto}}
                            <div class="wod5e-mage-menu-info">
                                {{#if voce.scenaNome}}<p><b>{{localize "WOD5E_MAGE.Menu.Scena"}}.</b> {{voce.scenaNome}}{{#if voce.inCorso}} ({{localize "WOD5E_MAGE.Menu.ScenaInCorso"}}){{/if}}</p>{{/if}}
                                <p><b>{{localize "WOD5E_MAGE.Menu.Quando"}}</b> {{voce.quando}}</p>
                                {{#if voce.segno}}<p><b>{{localize "WOD5E_MAGE.Menu.Segno"}}</b> {{voce.segno}}</p>{{/if}}
                                <p><b>{{localize "WOD5E_MAGE.Menu.Effetto"}}</b> {{voce.effetto}}</p>
                                <p><b>{{localize "WOD5E_MAGE.Menu.Mosse"}}</b> {{#each voce.mosse as |mossa|}}<span class="wod5e-mage-menu-mossa">{{mossa}}</span>{{/each}}</p>
                                {{#if voce.poi}}<p><b>{{localize "WOD5E_MAGE.Menu.Poi"}}</b> {{voce.poi}}</p>{{/if}}
                                {{#if voce.esempio}}<p class="esempio"><b>{{localize "WOD5E_MAGE.Menu.Esempio"}}</b> {{voce.esempio}}</p>{{/if}}
                                {{#if voce.faccia}}<p class="faccia"><b>{{localize "WOD5E_MAGE.Menu.InQuestaScena"}}</b> {{voce.faccia.testo}}{{#if voce.faccia.prezzo}} · {{voce.faccia.prezzo}}{{/if}}</p>{{/if}}
                            </div>
                        {{/if}}
                        {{#if voce.aperta}}
                            {{#if voce.scoppio}}
                                <p class="wod5e-mage-menu-avviso"><i class="fa-solid fa-burst" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Menu.SoloScoppio"}}</p>
                            {{else}}
                                <div class="wod5e-mage-menu-spesa" data-voce="{{voce.id}}">
                                    <div class="fila">
                                        <label class="campo">
                                            <span>{{localize "WOD5E_MAGE.Menu.Risponde"}}</span>
                                            <select data-role="rispondeA" data-prezzo="1">
                                                {{#each voce.volgari as |v|}}<option value="{{v.messageId}}" data-actor="{{v.actorId}}" data-soglia="{{v.soglia}}" {{#if v.selected}}selected{{/if}}>{{v.label}}</option>{{/each}}
                                                <option value="" data-soglia="0"{{#unless voce.volgari.length}} selected{{/unless}}>{{localize "WOD5E_MAGE.Menu.NessunVolgare"}}</option>
                                            </select>
                                        </label>
                                        <label class="campo">
                                            <span>{{localize "WOD5E_MAGE.Menu.SuChi"}}</span>
                                            <select data-role="suChi">
                                                {{#each voce.bersagli as |m|}}<option value="{{m.id}}" {{#if m.selected}}selected{{/if}}>{{m.label}}</option>{{/each}}
                                                <option value=""{{#if voce.suChiVuoto}} selected{{/if}}>{{localize "WOD5E_MAGE.Menu.Nessuno"}}</option>
                                            </select>
                                        </label>
                                        {{#if voce.campi.suaSoglia}}
                                            <label class="campo corto"><span>{{localize "WOD5E_MAGE.Menu.SuaSoglia"}}</span><input type="number" data-role="suaSoglia" data-prezzo="1" min="1" max="13" value="{{voce.suaSogliaDefault}}"></label>
                                        {{/if}}
                                        {{#if voce.campi.pallini}}
                                            <label class="campo corto"><span>{{localize "WOD5E_MAGE.Menu.Pallini"}}</span><select data-role="pallini" data-prezzo="1">{{#each voce.pallini as |p|}}<option value="{{p.value}}">{{p.label}}</option>{{/each}}</select></label>
                                        {{/if}}
                                        {{#if voce.campi.ancora}}
                                            <label class="campo"><span>{{localize "WOD5E_MAGE.Menu.Ancora"}}</span><select data-role="ancora">{{#each voce.ancore as |a|}}<option value="{{a.id}}">{{a.name}}</option>{{else}}<option value="">{{localize "WOD5E_MAGE.Menu.NessunaAncora"}}</option>{{/each}}</select></label>
                                        {{/if}}
                                        {{#if voce.campi.rimbalzo}}
                                            <label class="campo"><span>{{localize "WOD5E_MAGE.Menu.Rimbalzo"}}</span><select data-role="rimbalzo" data-prezzo="1">{{#each voce.rimbalzi as |r|}}<option value="{{r.id}}" data-prezzo="{{r.prezzo}}" data-nome="{{r.nome}}">{{r.nome}} · {{r.prezzo}}</option>{{/each}}</select></label>
                                        {{/if}}
                                        {{#if voce.campi.vuole}}
                                            <label class="campo"><span>{{localize "WOD5E_MAGE.Menu.Vuole"}}</span><input type="text" data-role="vuole" placeholder="{{localize 'WOD5E_MAGE.Menu.VuoleHint'}}"></label>
                                        {{/if}}
                                    </div>
                                    {{#if voce.campi.orologio}}
                                        <div class="fila wod5e-mage-menu-orologio">
                                            <span class="titolo"><i class="fa-solid fa-clock" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Menu.OrologioNuovo"}}</span>
                                            <label class="campo"><span>{{localize "WOD5E_MAGE.Menu.Titolo"}}</span><input type="text" data-role="titolo" value="{{voce.titoloDefault}}" placeholder="{{localize 'WOD5E_MAGE.Menu.TitoloHint'}}"></label>
                                            <div class="campo corto">
                                                <span>{{localize "WOD5E_MAGE.Menu.Segmenti"}}</span>
                                                <span class="wod5e-mage-menu-segmenti">
                                                    {{#each voce.segmentiScelte as |s|}}<button type="button" class="{{#if s.attivo}}attivo{{/if}}" data-n="{{s.n}}">{{s.n}}</button>{{/each}}
                                                    <input type="number" data-role="segmenti" min="3" max="16" value="{{voce.segmentiDefault}}" aria-label="{{localize 'WOD5E_MAGE.Menu.Segmenti'}}">
                                                </span>
                                            </div>
                                            <label class="campo cresce"><span>{{localize "WOD5E_MAGE.Menu.Scatta"}}</span><input type="text" data-role="scatta" value="{{voce.scattaDefault}}" placeholder="{{localize 'WOD5E_MAGE.Menu.ScattaHint'}}"></label>
                                        </div>
                                    {{/if}}
                                    {{#if voce.campi.soglia}}<p class="nota">{{localize "WOD5E_MAGE.Menu.SogliaDalVolgare"}}</p>{{/if}}
                                    <div class="fila piede">
                                        <span class="wod5e-mage-menu-vede" role="group" aria-label="{{localize 'WOD5E_MAGE.Menu.ChiVede'}}">
                                            <button type="button" class="attivo" data-vede="tutti"><i class="fa-solid fa-users" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Menu.Tutti"}}</button>
                                            <button type="button" data-vede="narratori"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Paradosso.Whisper"}}</button>
                                            <input type="hidden" data-role="vede" value="tutti">
                                        </span>
                                        <label class="campo cresce"><span>{{localize "WOD5E_MAGE.Menu.Nota"}}</span><input type="text" data-role="nota" placeholder="{{localize 'WOD5E_MAGE.Menu.NotaHint'}}"></label>
                                        <span class="wod5e-mage-menu-conto">{{localize "WOD5E_MAGE.Paradosso.Price"}} <b data-role="prezzoVivo">{{voce.stima}}</b> · {{localize "WOD5E_MAGE.Menu.RiservaDopo"}} <b data-role="riservaDopo"></b></span>
                                        <button type="button" class="wod5e-mage-menu-spendi" data-action="spendi" data-voce="{{voce.id}}"><i class="fa-solid fa-bolt" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Menu.SpendiManda"}}</button>
                                    </div>
                                </div>
                            {{/if}}
                        {{/if}}
                    </div>
            {{/each}}
        </section>
    {{/each}}
    {{#if nessunaVoce}}<p class="wod5e-mage-quadro-vuoto">{{localize "WOD5E_MAGE.Menu.NessunaVoce"}}</p>{{/if}}
    <p class="wod5e-mage-menu-legenda"><i class="fa-regular fa-eye" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Menu.Modo.annunciato"}} &nbsp; <i class="fa-solid fa-bolt" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Menu.Modo.immediato"}} &nbsp; <i class="fa-solid fa-eye-slash" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Menu.Modo.nascosto"}} &nbsp; <i class="fa-solid fa-burst" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Menu.Modo.scoppio"}} &nbsp; <i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Menu.LeggiVoce"}}</p>
</div>
