{{!-- Mage header: the single Health track on the left, portrait and
     allegiance in the middle. The Wheel widget lives on the Traits page (see ruota.hbs). --}}
<header class="actor-header wod5e-mage-header" {{#if headerbg}}style="background: url({{headerbg}}) center;"{{/if}}>
    <div class="header-fields">
        <div class="header-fields-left wod5e-mage-header-resources">
            {{> "modules/wod5e-mage/templates/actor/parts/salute.hbs"}}
        </div>
    </div>

    {{!-- Il profilo del sistema, disteso qui per aggiungere l'appartenenza
         sotto il nome: Famiglia · Sottofamiglia, con la Fazione nel titolo. --}}
    <div class="header-profile">
        <div class="header-profile-img">
            <img class="profile-img" data-action="editImage" src="{{img}}" data-edit="img" title="{{actor.name}}"/>
        </div>
        <div class="flexrow name-field{{#if locked}} clickthrough{{/if}}">
            {{#if locked}}
                <div class="charname">{{name}}</div>
            {{else}}
                <input class="charname" name="name" type="text" value="{{name}}" placeholder="{{localize 'WOD5E.Name'}}"/>
            {{/if}}
        </div>
        {{#if lineage.riga}}
            <div class="wod5e-mage-lineage" title="{{lineage.completa}}">{{lineage.riga}}</div>
        {{/if}}
    </div>

    {{!-- Come nella 0.9.4: bilancia il blocco risorse a sinistra e mantiene
         il ritratto al centro dopo lo spostamento della Ruota. --}}
    <div class="header-fields wod5e-mage-header-spacer" aria-hidden="true"></div>
</header>
