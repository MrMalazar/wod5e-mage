{{!-- Mage header: the single Health track on the left, portrait and
     allegiance in the middle. The Wheel widget lives on the Traits page (see ruota.hbs). --}}
<header class="actor-header wod5e-mage-header" {{#if headerbg}}style="background: url({{headerbg}}) center;"{{/if}}>
    {{!-- Nuova sessione all'estremo in alto a sinistra, su ogni pagina (4/9 notte). --}}
    <button type="button" class="wod5e-mage-new-session" data-action="saluteNewSession" title="{{localize 'WOD5E_MAGE.Salute.NewSessionHint'}}">
        <i class="fa-solid fa-sun" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Salute.NewSession"}}
    </button>
    {{!-- In alto a destra, speculare: il sigillo dell'Areté tira da ogni pagina (6/9). --}}
    <button type="button" class="wod5e-mage-header-arete-roll wod5e-mage-arete-roll" data-action="areteRoll"
            title="{{localize 'WOD5E_MAGE.Arete.RollHint'}}" aria-label="{{localize 'WOD5E_MAGE.Arete.RollHint'}}">
        <img class="wod5e-mage-arete-sigillo" src="modules/wod5e-mage/assets/icons/ui/arete.svg" alt="" aria-hidden="true">
    </button>
    <div class="header-fields">
        <div class="header-fields-left wod5e-mage-header-resources">
            {{> "modules/wod5e-mage/templates/actor/parts/salute.hbs"}}
        </div>
    </div>

    {{!-- Il profilo del sistema, disteso qui per aggiungere l'appartenenza
         sotto il nome: Famiglia · Sottofamiglia, con la Fazione nel titolo. --}}
    <div class="header-profile">
        <div class="header-profile-img">
            <img class="profile-img" data-action="editImage" src="{{img}}" data-edit="img" title="{{actor.name}}"/>
        </div>
        {{!-- Nome del personaggio e, sotto, quello del giocatore: una colonna
             sola in fondo al ritratto, due caselle della stessa misura. --}}
        <div class="wod5e-mage-names">
        <div class="flexrow name-field{{#if locked}} clickthrough{{/if}}">
            {{#if locked}}
                <div class="charname">{{name}}</div>
            {{else}}
                <input class="charname" name="name" type="text" value="{{name}}" placeholder="{{localize 'WOD5E.Name'}}"/>
            {{/if}}
        </div>
        {{!-- Sotto il nome del personaggio, quello del giocatore. L'appartenenza
             sta nel pannello a destra, non più sotto il nome. --}}
        <div class="wod5e-mage-player-field">
            <input class="wod5e-mage-player" name="flags.wod5e-mage.player" type="text" value="{{playerName}}" placeholder="{{localize 'WOD5E_MAGE.Header.Player'}}" aria-label="{{localize 'WOD5E_MAGE.Header.Player'}}" {{#if locked}}disabled{{/if}}/>
        </div>
        </div>
    </div>

    {{!-- A destra, a bilanciare la Salute: l'Appartenenza a tendina. --}}
    <div class="header-fields wod5e-mage-header-spacer">
        {{> "modules/wod5e-mage/templates/actor/parts/appartenenza.hbs"}}
    </div>
</header>
