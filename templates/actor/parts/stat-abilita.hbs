{{!-- Abilità (16/9): per famiglia, il nome è il tasto che la mette nel tiro
     (una sola). Le Specializzazioni (Blue, 26/9: via la finestra e la tendina,
     «un menù a pop anti intuitivo») stanno in riga sotto l'Abilità, tre posti
     (uno a 1 pallino, due a 3, tre a 5): ogni nome è una pastiglia che la
     sceglie insieme all'Abilità, la × la toglie, e finché c'è posto una
     casella tratteggiata ne scrive una nuova (a mano, o dai sei suggerimenti
     del catalogo, a Invio). La riga si apre e si chiude con la freccetta fra
     il nome e i pallini (Blue, 26/9 sera: «un compromesso tra prima e dopo»;
     27/9: a sinistra della ×, coi pallini allineati), che porta il conto delle
     scritte; nasce aperta se la sua Specializzazione è nel Tiro.
     I pallini restano quelli della scheda. Le Abilità
     Specifiche del giocatore chiudono la lista. Il tasto accanto al + (16/9
     sera) scioglie le famiglie: tutte in fila, Specifiche comprese, in ordine
     alfabetico, senza divisorie. --}}
<section class="wod5e-mage-riq wod5e-mage-riq-abilita">
    {{!-- Col memo di creazione acceso (23/9): il conto a destra del titolo (col premio della Sfida se c'è), il tetto se sforato. --}}
    <header class="wod5e-mage-riq-title{{#if memo.on}} memo-{{memo.boxes.abilita.state}}{{/if}}">
        {{#if creazioneReset}}{{> "modules/wod5e-mage/templates/actor/parts/reset-tasto.hbs" resetsById.skills}}{{/if}}
        <span>{{localize "WOD5E.SkillsList.Skills"}}{{#if memo.on}} <b class="wod5e-mage-memo-conto" title="{{localize 'WOD5E_MAGE.Riepilogo.Skills'}}">{{memo.boxes.abilita.text}}{{#if memo.boxes.abilita.sfida}} <small class="wod5e-mage-memo-premio preso" title="{{localize 'WOD5E_MAGE.Riepilogo.SfidaPremi.skills'}}">+{{memo.boxes.abilita.sfida}} {{localize "WOD5E_MAGE.Tabs.Short.conceptChallenge"}}</small>{{/if}}{{#unless memo.boxes.abilita.tetto.ok}} <small class="wod5e-mage-memo-avviso" title="{{localize 'WOD5E_MAGE.Riepilogo.SkillCap'}}"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Riepilogo.SkillCapBreve"}} {{memo.boxes.abilita.tetto.target}}</small>{{/unless}}</b>{{/if}}</span>
        <button type="button" class="wod5e-mage-riq-tasto-piccolo{{#if skillsFlat}} active{{/if}}" data-action="skillsFlatToggle" title="{{#if skillsFlat}}{{localize 'WOD5E_MAGE.Stat.AbilitaFamiglie'}}{{else}}{{localize 'WOD5E_MAGE.Stat.AbilitaInFila'}}{{/if}}" aria-label="{{#if skillsFlat}}{{localize 'WOD5E_MAGE.Stat.AbilitaFamiglie'}}{{else}}{{localize 'WOD5E_MAGE.Stat.AbilitaInFila'}}{{/if}}" aria-pressed="{{skillsFlat}}"><i class="fa-solid {{#if skillsFlat}}fa-layer-group{{else}}fa-arrow-down-a-z{{/if}}" aria-hidden="true"></i></button>
        <button type="button" class="wod5e-mage-riq-tasto-piccolo" data-action="customSkillAdd" title="{{localize 'WOD5E_MAGE.CustomSkills.Add'}}" aria-label="{{localize 'WOD5E_MAGE.CustomSkills.Add'}}" {{#if locked}}disabled{{/if}}><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
    </header>
    <div class="wod5e-mage-riq-body">
        {{#each skillGroups as |group|}}
            {{#if group.label}}<span class="wod5e-mage-riq-occhiello">{{group.label}}</span>{{/if}}
            <div class="wod5e-mage-tratti-lista">
                {{#each group.rows as |skill|}}
                    {{#if skill.custom}}
                        <div class="wod5e-mage-riga wod5e-mage-riga-tratto wod5e-mage-riga-specifica{{#if skill.chosen}} scelta{{/if}}">
                            {{!-- Il nome si scrive; la spunta a sinistra la mette nel tiro. --}}
                            <button type="button" class="wod5e-mage-riga-spunta-tasto" data-action="tiroSkill" data-key="custom:{{skill.id}}" aria-pressed="{{skill.chosen}}" title="{{localize 'WOD5E_MAGE.Tiro.SkillHint'}}"><span class="wod5e-mage-riga-spunta" aria-hidden="true"></span></button>
                            <input type="text" class="wod5e-mage-custom-skill-name" name="flags.wod5e-mage.customSkills.{{skill.id}}.name" value="{{skill.name}}" placeholder="{{localize 'WOD5E_MAGE.CustomSkills.NameHint'}}" aria-label="{{localize 'WOD5E_MAGE.CustomSkills.Name'}}" {{#if ../../locked}}disabled{{/if}}>
                            <div class="resource-value" data-value="{{skill.value}}" data-name="flags.wod5e-mage.customSkills.{{skill.id}}.value">
                                <span class="resource-value-empty" data-action="dotCounterEmpty"></span>
                                {{#numLoop 5}}
                                    <span class="resource-value-step" data-action="dotCounterChange" data-index="{{this}}"></span>
                                {{/numLoop}}
                            </div>
                            <button type="button" class="wod5e-mage-custom-skill-delete" data-action="customSkillDelete" data-row="{{skill.id}}" title="{{localize 'WOD5E_MAGE.CustomSkills.Remove'}}" aria-label="{{localize 'WOD5E_MAGE.CustomSkills.Remove'}}" {{#if ../../locked}}disabled{{/if}}><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
                        </div>
                    {{else}}
                        <div class="wod5e-mage-riga wod5e-mage-riga-tratto wod5e-mage-riga-abilita{{#if skill.chosen}} scelta{{/if}}{{#if skill.spec.slots}} con-specializzazioni{{#if skill.spec.chosen}} aperta{{/if}}{{/if}}" data-skill="{{skill.id}}">
                            <button type="button" class="wod5e-mage-riga-nome" data-action="tiroSkill" data-key="{{skill.key}}" aria-pressed="{{skill.chosen}}" title="{{localize 'WOD5E_MAGE.Tiro.SkillHint'}}">
                                {{#if skill.icon}}<img class="wod5e-mage-riga-icona" src="{{skill.icon}}" alt="">{{/if}}
                                <span>{{skill.displayName}}</span>
                            </button>
                            {{#if skill.spec.slots}}
                                {{!-- La freccetta (26/9 sera; 27/9: a sinistra della × dei pallini, così i pallini restano
                                     allineati fra le righe): apre e chiude la riga delle Specializzazioni, col conto delle scritte. --}}
                                <button type="button" class="wod5e-mage-abilita-apri{{#if skill.spec.scritte.length}} piena{{/if}}" data-action="specialtyToggle" aria-expanded="{{#if skill.spec.chosen}}true{{else}}false{{/if}}" title="{{localize 'WOD5E_MAGE.Specialties.Apri'}}" aria-label="{{skill.displayName}}: {{localize 'WOD5E_MAGE.Specialties.Apri'}}">{{#if skill.spec.scritte.length}}<small>{{skill.spec.scritte.length}}</small>{{/if}}<i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button>
                            {{/if}}
                            {{#if ../../settings.skillAttributeInputs}}
                                {{#if ../../locked}}
                                    <b>{{skill.value}}</b>
                                {{else}}
                                    <input class="resource-value skill-attribute-input" name="system.skills.{{skill.id}}.value" type="number" value="{{skill.value}}"/>
                                {{/if}}
                            {{else}}
                                <div class="resource-value" data-value="{{skill.value}}" data-name="system.skills.{{skill.id}}.value">
                                    <span class="resource-value-empty" data-action="essentialSkillClear"></span>
                                    {{#numLoop 5}}
                                        <span class="resource-value-step" data-action="essentialSkillDotChange" data-index="{{this}}"></span>
                                    {{/numLoop}}
                                </div>
                            {{/if}}
                            {{#if skill.spec.slots}}
                                {{!-- Le Specializzazioni in riga (Blue, 26/9): le pastiglie (il clic nel tiro, la × toglie) e,
                                     finché c'è posto, la casella tratteggiata che ne scrive una: a mano, o dai suggerimenti. --}}
                                <div class="wod5e-mage-specializzazioni" role="group" aria-label="{{skill.displayName}}: {{localize 'WOD5E.SkillsList.Specialties'}}">
                                    {{#each skill.spec.scritte as |s|}}
                                        <span class="wod5e-mage-pastiglia wod5e-mage-pastiglia-spec{{#if s.chosen}} scelta{{/if}}">
                                            <button type="button" class="wod5e-mage-pastiglia-nome" data-action="tiroSpecialty" data-key="{{skill.key}}" data-specialty="{{s.name}}" aria-pressed="{{s.chosen}}" title="{{localize 'WOD5E_MAGE.Tiro.SpecialtyHint'}}">{{s.name}}</button>
                                            {{#unless @root.locked}}<button type="button" class="wod5e-mage-pastiglia-via" data-action="specialtyDelete" data-skill="{{skill.id}}" data-index="{{s.index}}" title="{{localize 'WOD5E_MAGE.Specialties.Remove'}}" aria-label="{{localize 'WOD5E_MAGE.Specialties.Remove'}}: {{s.name}}">×</button>{{/unless}}
                                        </span>
                                    {{/each}}
                                    {{#if skill.spec.free}}
                                        <input type="text" class="wod5e-mage-pastiglia-scrivi" list="wod5e-mage-spec-{{@root.actor.id}}-{{skill.id}}" data-specialty-add="{{skill.id}}" data-skill-label="{{skill.displayName}}" placeholder="{{localize 'WOD5E_MAGE.Specialties.Scrivi'}}" title="{{localize 'WOD5E_MAGE.Specialties.ScriviHint' free=skill.spec.free slots=skill.spec.slots}}" aria-label="{{skill.displayName}}: {{localize 'WOD5E_MAGE.Specialties.Scrivi'}}" autocomplete="off" maxlength="30" {{#if @root.locked}}disabled{{/if}}>
                                        {{#if skill.spec.suggestions.length}}<datalist id="wod5e-mage-spec-{{@root.actor.id}}-{{skill.id}}">{{#each skill.spec.suggestions as |nome|}}<option value="{{nome}}"></option>{{/each}}</datalist>{{/if}}
                                    {{/if}}
                                </div>
                            {{/if}}
                        </div>
                    {{/if}}
                {{/each}}
            </div>
        {{/each}}

        {{#if customSkills.length}}
            <span class="wod5e-mage-riq-occhiello">{{localize "WOD5E_MAGE.CustomSkills.Label"}}</span>
            <div class="wod5e-mage-tratti-lista">
                {{#each customSkills as |skill|}}
                    <div class="wod5e-mage-riga wod5e-mage-riga-tratto wod5e-mage-riga-specifica{{#if skill.chosen}} scelta{{/if}}">
                        {{!-- Il nome si scrive; la spunta a sinistra la mette nel tiro. --}}
                        <button type="button" class="wod5e-mage-riga-spunta-tasto" data-action="tiroSkill" data-key="custom:{{skill.id}}" aria-pressed="{{skill.chosen}}" title="{{localize 'WOD5E_MAGE.Tiro.SkillHint'}}"><span class="wod5e-mage-riga-spunta" aria-hidden="true"></span></button>
                        <input type="text" class="wod5e-mage-custom-skill-name" name="flags.wod5e-mage.customSkills.{{skill.id}}.name" value="{{skill.name}}" placeholder="{{localize 'WOD5E_MAGE.CustomSkills.NameHint'}}" aria-label="{{localize 'WOD5E_MAGE.CustomSkills.Name'}}" {{#if ../locked}}disabled{{/if}}>
                        <div class="resource-value" data-value="{{skill.value}}" data-name="flags.wod5e-mage.customSkills.{{skill.id}}.value">
                            <span class="resource-value-empty" data-action="dotCounterEmpty"></span>
                            {{#numLoop 5}}
                                <span class="resource-value-step" data-action="dotCounterChange" data-index="{{this}}"></span>
                            {{/numLoop}}
                        </div>
                        <button type="button" class="wod5e-mage-custom-skill-delete" data-action="customSkillDelete" data-row="{{skill.id}}" title="{{localize 'WOD5E_MAGE.CustomSkills.Remove'}}" aria-label="{{localize 'WOD5E_MAGE.CustomSkills.Remove'}}" {{#if ../locked}}disabled{{/if}}><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
                    </div>
                {{/each}}
            </div>
        {{/if}}
    </div>
</section>
