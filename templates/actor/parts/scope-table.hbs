{{!-- La tavola degli Ambiti (23/9): sette Ambiti, due lenti l'uno, otto
     livelli dallo 0 al 7. Lo 0 è la base e non costa; ogni livello vale il
     suo numero e la soglia è la somma. --}}
<section class="wod5e-mage-scope-table">
    {{!-- Il titolo lo porta la tendina della pagina Magick (21/9). La lettura della tavola, dalla guida degli Ambiti (23/9). --}}

    <div class="wod5e-mage-scope-table-scroll">
        <table>
            <thead>
                <tr>
                    <th scope="col" class="wod5e-mage-scope-col-name">{{localize "WOD5E_MAGE.Scopes.TableSuccesses"}}</th>
                    <th scope="col" class="wod5e-mage-scope-col-reading">{{localize "WOD5E_MAGE.Scopes.TableReading"}}</th>
                    {{#each scopeTable.steps as |step|}}
                        <th scope="col"{{#unless step}} class="wod5e-mage-scope-zero"{{/unless}}>{{step}}</th>
                    {{/each}}
                </tr>
            </thead>
            <tbody>
                {{!-- Gli Ambiti in ordine alfabetico (6/9). Due colonne di testa
                     (verdetto di Blue, 7/9): il nome dell'Ambito, che occupa le
                     sue due righe e nel sorvolo dice cosa misura, e la lente. --}}
                {{#each scopeTable.groups as |group|}}
                    {{#each group.rows as |row|}}
                    <tr class="scope-{{row.id}}{{#if row.small}} wod5e-mage-scope-row-small{{/if}}{{#if group.header}} wod5e-mage-scope-sub{{/if}}">
                        {{#if @first}}
                            <th scope="rowgroup" class="wod5e-mage-scope-group" rowspan="{{group.span}}" title="{{localize group.desc}}">{{localize group.label}}</th>
                        {{/if}}
                        <th scope="row" class="wod5e-mage-scope-reading">{{#if group.header}}{{localize row.title}}{{/if}}</th>
                        {{!-- Ogni cella ha le stesse colonne invisibili della sua riga:
                             simbolo | numero | testo (o casella). Così, dentro una colonna
                             della tavola, simboli, numeri e testi stanno in fila. La
                             colonna dello 0 è in ombra: è la base, non si dichiara. --}}
                        {{#each row.cells as |cell|}}
                            <td{{#unless cell.step}} class="wod5e-mage-scope-zero"{{/unless}}{{#if cell.tip}} title="{{cell.tip}}"{{/if}}>
                                <span class="wod5e-mage-scope-cell" data-layout="{{cell.layout}}">
                                    {{#if cell.arete}}
                                        <img class="wod5e-mage-scope-cell-symbol wod5e-mage-arete-sigillo-small" src="modules/wod5e-mage/assets/icons/ui/arete.svg" alt="Areté" title="Areté">
                                    {{else if cell.icon}}
                                        <img class="wod5e-mage-scope-cell-symbol wod5e-mage-tempo-icon" src="{{cell.icon}}" alt="">
                                    {{else if cell.faIcon}}
                                        <i class="wod5e-mage-scope-cell-symbol {{cell.faIcon}}" aria-hidden="true"></i>
                                    {{/if}}
                                    {{#if cell.number}}
                                        <b class="wod5e-mage-scope-cell-number">{{localize cell.label}}</b>
                                    {{else if cell.hideLabel}}
                                        <b class="wod5e-mage-scope-cell-number" aria-hidden="true"></b>
                                    {{/if}}
                                    {{#if cell.text}}
                                        <span class="wod5e-mage-scope-cell-text">{{localize cell.label}}</span>
                                    {{/if}}
                                </span>
                            </td>
                        {{/each}}
                    </tr>
                    {{/each}}
                {{/each}}
            </tbody>
        </table>
    </div>
</section>
