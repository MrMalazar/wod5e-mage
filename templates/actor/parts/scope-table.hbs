{{!-- La tavola degli Ambiti: sei Ambiti per sette livelli, che fanno soglia. --}}
<section class="wod5e-mage-scope-table">
    <header class="resource-header">
        <label class="header-label">{{localize "WOD5E_MAGE.Scopes.TableTitle"}}</label>
    </header>

    <p class="wod5e-mage-scopes-hint">{{localize "WOD5E_MAGE.Scopes.TableHint"}}</p>

    <div class="wod5e-mage-scope-table-scroll">
        <table>
            <thead>
                <tr>
                    <th scope="col">{{localize "WOD5E_MAGE.Scopes.TableSuccesses"}}</th>
                    {{#each scopeTable.steps as |step|}}
                        <th scope="col">{{step}}</th>
                    {{/each}}
                </tr>
            </thead>
            <tbody>
                {{#each scopeTable.rows as |row|}}
                    <tr class="scope-{{row.id}}">
                        <th scope="row">{{localize row.label}}</th>
                        {{#each row.cells as |cell|}}
                            <td>{{#if cell.icon}}<span class="wod5e-mage-tempo-cell"><img class="wod5e-mage-tempo-icon" src="{{cell.icon}}" alt="">{{localize cell.label}}</span>{{else if cell.faIcon}}<span class="wod5e-mage-tempo-cell"><i class="{{cell.faIcon}}" aria-hidden="true"></i> {{localize cell.label}}</span>{{else if cell.glyph}}<span class="wod5e-mage-tempo-cell">{{localize cell.label}} <i class="wod5e-mage-salute-glyph" data-state="{{cell.glyph}}" aria-hidden="true"></i></span>{{else}}{{localize cell.label}}{{/if}}</td>
                        {{/each}}
                    </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</section>
