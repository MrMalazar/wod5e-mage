{{!-- La tavola degli Ambiti: sei Ambiti per sette livelli, che fanno soglia. --}}
<section class="wod5e-mage-scope-table">
    <header class="resource-header">
        <label class="header-label">{{localize "WOD5E_MAGE.Scopes.TableTitle"}}</label>
    </header>

    <p class="wod5e-mage-scopes-hint">{{localize "WOD5E_MAGE.Scopes.TableHint"}}</p>

    <div class="wod5e-mage-scope-table-scroll">
        <table>
            <thead>
                <tr>
                    <th scope="col">{{localize "WOD5E_MAGE.Scopes.TableSuccesses"}}</th>
                    {{#each scopeTable.steps as |step|}}
                        <th scope="col">{{step}}</th>
                    {{/each}}
                </tr>
            </thead>
            <tbody>
                {{#each scopeTable.rows as |row|}}
                    <tr class="scope-{{row.id}}{{#if row.small}} wod5e-mage-scope-row-small{{/if}}">
                        <th scope="row">{{localize row.label}}</th>
                        {{!-- Ogni cella ha le stesse colonne invisibili della sua riga:
                             simbolo | numero | testo (o casella). Così, dentro una colonna
                             della tavola, simboli, numeri e testi stanno in fila. --}}
                        {{#each row.cells as |cell|}}
                            <td>
                                <span class="wod5e-mage-scope-cell" data-layout="{{cell.layout}}">
                                    {{#if cell.arete}}
                                        <img class="wod5e-mage-scope-cell-symbol wod5e-mage-arete-sigillo-small" src="modules/wod5e-mage/assets/icons/ui/arete.svg" alt="Areté" title="Areté">
                                    {{else if cell.icon}}
                                        <img class="wod5e-mage-scope-cell-symbol wod5e-mage-tempo-icon" src="{{cell.icon}}" alt="">
                                    {{else if cell.faIcon}}
                                        <i class="wod5e-mage-scope-cell-symbol {{cell.faIcon}}" aria-hidden="true"></i>
                                    {{/if}}
                                    {{#if cell.number}}
                                        <b class="wod5e-mage-scope-cell-number">{{localize cell.label}}</b>
                                    {{else if cell.hideLabel}}
                                        <b class="wod5e-mage-scope-cell-number" aria-hidden="true"></b>
                                    {{/if}}
                                    {{#if cell.text}}
                                        <span class="wod5e-mage-scope-cell-text">{{localize cell.label}}</span>
                                    {{/if}}
                                    {{#if cell.arete}}
                                        <i class="wod5e-mage-scope-cell-glyph wod5e-mage-salute-glyph" data-state="" aria-hidden="true"></i>
                                    {{/if}}
                                </span>
                            </td>
                        {{/each}}
                    </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</section>
