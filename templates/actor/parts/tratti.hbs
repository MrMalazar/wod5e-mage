{{!-- Traits page. Forked from the system's stats.hbs (wod5e 5.3.19): six
     cells, Attributes | Conditions, Skills | Specialties, Wheel | Bonuses.
     Keep the trait blocks in sync with the system template. --}}
<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
    {{!-- Measuring container for the two-state grid: as a block it takes its
         width from the parent, so inline-size containment is safe here
         (on the tab itself it collapsed the whole page to its padding). --}}
    {{!-- A colonne (6/9): gli Attributi in una colonna da nove righe, le
         Abilità in due da nove, senza Fisici, Sociali, Mentali. --}}
    <div class="wod5e-mage-tratti{{#if traitsColumns}} wod5e-mage-tratti-columns{{/if}}">
    <div class="stats-content">
        {{!-- Sei celle: Attributi | Condizioni, Abilità | Specializzazioni,
             Ruota | Bonus. --}}
        <div class="skills-attributes wod5e-mage-tratti-attributes">
            <div class="resource-header wod5e-mage-tratti-header">
                <label class="header-label">
                    {{localize "WOD5E.AttributesList.Attributes"}}
                </label>
                {{!-- Il tasto cambia la struttura dei Tratti: gruppi o colonne. --}}
                <button type="button" class="wod5e-mage-wheel-mode wod5e-mage-traits-layout" data-action="traitsLayoutToggle"
                        aria-label="{{localize 'WOD5E_MAGE.Settings.TraitsLayout.Toggle'}}"
                        title="{{localize 'WOD5E_MAGE.Settings.TraitsLayout.Toggle'}}">
                    <i class="fa-solid {{#if traitsColumns}}fa-table-cells-large{{else}}fa-table-columns{{/if}}"></i>
                </button>
                {{!-- A colonne: l'ordine, alfabetico o per gruppo (Fisici, Sociali, Mentali). --}}
                {{#if traitsColumns}}
                <button type="button" class="wod5e-mage-wheel-mode wod5e-mage-traits-order" data-action="traitsOrderToggle"
                        aria-label="{{localize 'WOD5E_MAGE.Settings.TraitsOrder.Toggle'}}"
                        title="{{localize 'WOD5E_MAGE.Settings.TraitsOrder.Toggle'}}">
                    <i class="fa-solid {{#if traitsOrderGroup}}fa-arrow-down-a-z{{else}}fa-layer-group{{/if}}"></i>
                </button>
                {{/if}}
            </div>
            <div class="stats-container attributes">
                <div class="grid grid-3col stats-footer">
                    <div class="field-header">{{localize "WOD5E.SPC.Physical"}}</div>
                    <div class="field-header">{{localize "WOD5E.SPC.Social"}}</div>
                    <div class="field-header">{{localize "WOD5E.SPC.Mental"}}</div>
                </div>
                <div class="stats-content">
                    {{#each sortedAttributes as |type key|}}
                        <div class="attributes stats-list">
                            {{#each type as |attribute key|}}
                                <div class="attribute">
                                    {{#if attribute.icon}}<img class="wod5e-mage-trait-icon" src="{{attribute.icon}}" alt="">{{/if}}
                                    <label for="actor.system.attributes.{{attribute.id}}.value" class="resource-label rollable" data-action="roll" data-value-paths="attributes.{{attribute.id}}.value" data-select-dialog="true"
                                        data-attribute="{{attribute.id}}">{{attribute.displayName}}</label>
                                    {{#if ../../settings.skillAttributeInputs}}
                                        {{#if ../../locked}}
                                            <b>
                                                {{attribute.value}}
                                            </b>
                                        {{else}}
                                            <input class="resource-value skill-attribute-input" name="system.attributes.{{attribute.id}}.value" type="number" value="{{attribute.value}}"/>
                                        {{/if}}
                                    {{else}}
                                        <b class="wod5e-mage-trait-number" aria-hidden="true">{{attribute.value}}</b>
                                        <div class="resource-value" data-value="{{attribute.value}}" data-name="system.attributes.{{attribute.id}}.value">
                                            <span class="resource-value-empty" data-action="dotCounterEmpty"></span>
                                            {{#numLoop 5}}
                                                <span class="resource-value-step" data-action="dotCounterChange" data-index="{{this}}"></span>
                                            {{/numLoop}}
                                        </div>
                                    {{/if}}
                                </div>
                            {{/each}}
                        </div>
                    {{/each}}
                </div>
            </div>
        </div>

        <div class="side-panel wod5e-mage-tratti-conditions">
            <div class="stat-panel-section">
                <label class="resource-header">{{localize "WOD5E.ItemsList.Conditions"}}</label>
                <div class="stats-container">
                    {{!-- Sopra: i simboli delle Condizioni accese (un clic spegne);
                         la lente per quelle fuori lista. Sotto: la tendina con
                         tutte le venticinque per gruppo, un clic accende. --}}
                    <div class="wod5e-mage-condizioni-strip">
                        {{#each condizioniRows as |row|}}
                            {{!-- Simbolo grande e, sotto, il nome (6/9). --}}
                            <button type="button" class="wod5e-mage-condizione-on{{#if row.suppressed}} suppressed{{/if}}" data-action="condizioneToggle" data-condizione="{{row.condizione}}" data-item-id="{{row.id}}" title="{{row.title}}" aria-label="{{row.name}}">
                                <span class="wod5e-mage-condizione-glyph">
                                    <img src="{{row.img}}" alt="">
                                    {{#if row.dice}}<small>{{row.dice}}</small>{{/if}}
                                </span>
                                <span class="wod5e-mage-condizione-name">{{row.name}}</span>
                            </button>
                        {{/each}}
                        <a class="item-control search-data-item wod5e-mage-condizioni-search" data-action="searchItem" title="{{localize 'WOD5E.Search'}}" data-type="condition">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </a>
                    </div>
                    <details class="wod5e-mage-condizioni-drawer">
                        <summary>
                            <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                            <span>{{localize "WOD5E_MAGE.Condizioni.All"}}</span>
                        </summary>
                        <div class="wod5e-mage-condizioni">
                            {{#each condizioni as |group|}}
                                <div class="wod5e-mage-condizioni-group">
                                    <span class="wod5e-mage-condizioni-title">{{group.group}}</span>
                                    <div class="wod5e-mage-condizioni-row">
                                        {{#each group.entries as |entry|}}
                                            <button type="button" class="wod5e-mage-condizione{{#if entry.active}} lit{{/if}}{{#if entry.suppressed}} suppressed{{/if}}" data-action="condizioneToggle" data-condizione="{{entry.id}}" title="{{entry.title}}" aria-label="{{entry.name}}">
                                                <span class="wod5e-mage-condizione-glyph">
                                                    <img src="{{entry.icon}}" alt="">
                                                    {{#if entry.dice}}<small>{{entry.dice}}</small>{{/if}}
                                                </span>
                                                <span class="wod5e-mage-condizione-name">{{entry.name}}</span>
                                            </button>
                                        {{/each}}
                                    </div>
                                </div>
                            {{/each}}
                        </div>
                    </details>
                </div>
            </div>
        </div>

        <div class="skills-attributes wod5e-mage-tratti-skills">
            <label class="resource-header wod5e-mage-skills-header">
                {{localize "WOD5E.SkillsList.Skills"}}
                {{!-- Il + aggiunge un'Abilità Specifica intera, sotto le essenziali. --}}
                <button type="button" class="wod5e-mage-bonuses-add wod5e-mage-custom-skill-add" data-action="customSkillAdd" title="{{localize 'WOD5E_MAGE.CustomSkills.Add'}}" aria-label="{{localize 'WOD5E_MAGE.CustomSkills.Add'}}" {{#if locked}}disabled{{/if}}>
                    <i class="fa-solid fa-plus"></i>
                </button>
            </label>
            <div class="stats-container skills">
                <div class="stats-content">
                    {{#each sortedSkills as |type key|}}
                        <div class="skills stats-list">
                            {{#each type as |skill key|}}
                                <div class="skill">
                                    {{#if skill.icon}}<img class="wod5e-mage-trait-icon" src="{{skill.icon}}" alt="">{{/if}}
                                    <div class="resource-label">
                                        <label for="actor.system.skills.{{skill.id}}.value" class="rollable{{#if skill.bonuses}} specialty-available{{/if}}" data-action="roll" data-value-paths="skills.{{skill.id}}.value"
                                        data-skill="{{skill.id}}" data-select-dialog="true"
                                        data-use-flavor-path="true" data-flavor-path="skills.{{skill.id}}.description" data-macroid="{{skill.macroid}}">{{skill.displayName}}</label>
                                        {{#if hasSpecialties}}
                                            <label class="specialty" title="{{localize "WOD5E.SkillsList.Specialties"}}:{{#each skill.specialtiesList as |bonus|}} {{bonus}}{{#unless @last}},{{/unless}}{{/each}}">S</label>
                                        {{/if}}
                                    </div>
                                    {{#if ../../settings.skillAttributeInputs}}
                                        {{#if ../../locked}}
                                            <b>
                                                {{skill.value}}
                                            </b>
                                        {{else}}
                                            <input class="resource-value skill-attribute-input" name="system.skills.{{skill.id}}.value" type="number" value="{{skill.value}}"/>
                                        {{/if}}
                                    {{else}}
                                        <b class="wod5e-mage-trait-number" aria-hidden="true">{{skill.value}}</b>
                                        <div class="resource-value" data-value="{{skill.value}}" data-name="system.skills.{{skill.id}}.value">
                                            {{!-- La matita sta qui, a sinistra della X che azzera. --}}
                                            <a class="edit-skill" data-action="editSkill" title="Edit skill" data-skill="{{skill.id}}">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <span class="resource-value-empty" data-action="dotCounterEmpty"></span>
                                            {{#numLoop 5}}
                                                <span class="resource-value-step" data-action="dotCounterChange" data-index="{{this}}"></span>
                                            {{/numLoop}}
                                        </div>
                                    {{/if}}
                                </div>
                            {{/each}}
                        </div>
                    {{/each}}
                </div>
                <div class="grid grid-3col stats-footer">
                    <div class="field-header">{{localize "WOD5E.SPC.Physical"}}</div>
                    <div class="field-header">{{localize "WOD5E.SPC.Social"}}</div>
                    <div class="field-header">{{localize "WOD5E.SPC.Mental"}}</div>
                </div>

                {{#if customSkills.length}}
                {{!-- Le Abilità Specifiche: nome, dadi, pallini, cestino. --}}
                <div class="wod5e-mage-custom-skills">
                    <label class="resource-header">{{localize "WOD5E_MAGE.CustomSkills.Label"}}</label>
                    <div class="wod5e-mage-custom-skill-list">
                        {{#each customSkills as |skill|}}
                            <div class="skill wod5e-mage-custom-skill">
                                <a class="wod5e-mage-custom-skill-roll rollable" data-action="roll" data-select-dialog="true" data-custom-skill="{{skill.id}}" title="{{localize 'WOD5E_MAGE.CustomSkills.Roll'}}"><i class="fa-solid fa-dice-d10"></i></a>
                                <input type="text" class="wod5e-mage-custom-skill-name" name="flags.wod5e-mage.customSkills.{{skill.id}}.name" value="{{skill.name}}" placeholder="{{localize 'WOD5E_MAGE.CustomSkills.NameHint'}}" aria-label="{{localize 'WOD5E_MAGE.CustomSkills.Name'}}" {{#if ../locked}}disabled{{/if}}>
                                <div class="resource-value" data-value="{{skill.value}}" data-name="flags.wod5e-mage.customSkills.{{skill.id}}.value">
                                    <span class="resource-value-empty" data-action="dotCounterEmpty"></span>
                                    {{#numLoop 5}}
                                        <span class="resource-value-step" data-action="dotCounterChange" data-index="{{this}}"></span>
                                    {{/numLoop}}
                                </div>
                                <button type="button" class="wod5e-mage-custom-skill-delete" data-action="customSkillDelete" data-row="{{skill.id}}" title="{{localize 'WOD5E_MAGE.CustomSkills.Remove'}}" aria-label="{{localize 'WOD5E_MAGE.CustomSkills.Remove'}}" {{#if ../locked}}disabled{{/if}}>
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        {{/each}}
                    </div>
                </div>
                {{/if}}
            </div>
        </div>
        <div class="side-panel wod5e-mage-tratti-specialties">
            <div class="stat-panel-section">
                {{> "modules/wod5e-mage/templates/actor/parts/specializzazioni.hbs"}}
            </div>
        </div>

        {{!-- La Ruota sotto le Abilità, coi Bonus accanto: dentro vivono anche
             Quintessenza generata e Paradosso permanente. --}}
        <div class="wod5e-mage-arcana-cell wod5e-mage-tratti-ruota">
            <div class="wod5e-mage-ruota-cell">
                {{> "modules/wod5e-mage/templates/actor/parts/ruota.hbs"}}

                {{!-- Il memo di creazione: conta i pallini e verifica i campi.
                     Si richiude dal titolo. --}}
                <details class="wod5e-mage-riepilogo">
                    <summary>
                        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                        <span>{{localize "WOD5E_MAGE.Riepilogo.Label"}}</span>
                    </summary>

                    <div class="wod5e-mage-riepilogo-grid">
                        {{#each creationSummary.counts as |count|}}
                            <div class="wod5e-mage-riepilogo-chip">
                                <strong>{{count.value}}</strong>
                                <span>{{localize count.label}}</span>
                            </div>
                        {{/each}}
                    </div>

                    <div class="wod5e-mage-riepilogo-checks">
                        {{#each creationSummary.checks as |check|}}
                            <span class="wod5e-mage-riepilogo-check {{#if check.ok}}ok{{/if}}">
                                <i class="fa-solid {{#if check.ok}}fa-circle-check{{else}}fa-circle-xmark{{/if}}" aria-hidden="true"></i>
                                {{localize check.label}}
                            </span>
                        {{/each}}
                    </div>

                    {{!-- I reset, una parte per tasto, con conferma. --}}
                    <div class="wod5e-mage-reset-row">
                        {{#each resets as |reset|}}
                            <button type="button" class="{{#if reset.all}}wod5e-mage-reset-all{{/if}}" data-action="resetSection" data-reset="{{reset.id}}" title="{{reset.label}}" {{#if ../locked}}disabled{{/if}}>
                                <i class="fa-solid {{reset.icon}}" aria-hidden="true"></i> {{reset.label}}
                            </button>
                        {{/each}}
                    </div>
                </details>
            </div>
        </div>

        <div class="side-panel wod5e-mage-tratti-bonus">
            <div class="stat-panel-section">
                {{> "modules/wod5e-mage/templates/actor/parts/bonuses.hbs"}}
            </div>
        </div>
    </div>
    </div>
</section>
