{{!-- L'Appartenenza in testata, in alto a destra, visibile da ogni pagina
     (verdetto di Blue, 4/9 notte): Famiglia e Sottofamiglia col simbolo della
     Sfera, il Credo coi suoi due e il libro dell'archivio. Niente Fazione.
     Chiusa di default, stretta quanto il testo. --}}
<details class="wod5e-mage-appartenenza">
    <summary title="{{lineage.completa}}">
        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
        <span>{{localize "WOD5E_MAGE.Lineage.Label"}}</span>
    </summary>
    <div class="wod5e-mage-appartenenza-body">
        <div class="wod5e-mage-lineage-grid">
            {{!-- Famiglia e Sottofamiglia in tendina: scegliere sblocca le loro
                 Sfere a 1 (il Credo, nella sua pagina, le sue di sola presenza). --}}
            <label>
                <span>{{localize "WOD5E_MAGE.Lineage.Family"}}</span>
                <div class="wod5e-mage-lineage-pick">
                {{#if lineageChoices.familySphere}}<img src="{{lineageChoices.familySphere.icon}}" alt="" title="{{lineageChoices.familySphere.label}}">{{else}}<span class="wod5e-mage-lineage-nosphere" aria-hidden="true"></span>{{/if}}
                <select name="flags.wod5e-mage.lineage.famiglia" {{#if locked}}disabled{{/if}}>
                    <option value="">{{localize "WOD5E_MAGE.Lineage.FamilyNone"}}</option>
                    {{#each lineageChoices.groups as |group|}}
                        <optgroup label="{{group.label}}">
                            {{#each group.famiglie as |famiglia|}}
                                <option value="{{famiglia.id}}" {{#if famiglia.selected}}selected{{/if}}>{{famiglia.label}}</option>
                            {{/each}}
                        </optgroup>
                    {{/each}}
                </select>
                </div>
            </label>
            <label>
                <span>{{localize "WOD5E_MAGE.Lineage.Subfamily"}}{{#if lineageChoices.subKind}} <small>({{lineageChoices.subKind}})</small>{{/if}}</span>
                <div class="wod5e-mage-lineage-pick">
                {{#if lineageChoices.subSphere}}<img src="{{lineageChoices.subSphere.icon}}" alt="" title="{{lineageChoices.subSphere.label}}">{{else}}<span class="wod5e-mage-lineage-nosphere" aria-hidden="true"></span>{{/if}}
                <select name="flags.wod5e-mage.lineage.sottofamiglia" {{#unless lineageChoices.hasSubfamilies}}disabled{{/unless}} {{#if locked}}disabled{{/if}}>
                    <option value="">{{#if lineageChoices.hasSubfamilies}}{{localize "WOD5E_MAGE.Lineage.SubfamilyNone"}}{{else}}{{localize "WOD5E_MAGE.Lineage.SubfamilyEmpty"}}{{/if}}</option>
                    {{#each lineageChoices.sottofamiglie as |sub|}}
                        <option value="{{sub.id}}" {{#if sub.selected}}selected{{/if}}>{{sub.label}}</option>
                    {{/each}}
                </select>
                </div>
            </label>
        </div>
        <label class="wod5e-mage-appartenenza-credo">
            <span>{{localize "WOD5E_MAGE.Focus.Credo"}} <button type="button" class="wod5e-mage-archivio-open" data-action="archivioOpen" data-kind="credo" title="{{localize 'WOD5E_MAGE.Archivi.Open'}}" aria-label="{{localize 'WOD5E_MAGE.Archivi.Open'}}"><i class="fa-solid fa-book-open" aria-hidden="true"></i></button></span>
            {{!-- Il Credo porta due Sfere: due posti per i simboli, come Famiglia e Sottofamiglia. --}}
            <div class="wod5e-mage-lineage-pick wod5e-mage-lineage-pick-double">
                {{#each credoSpheres as |sphere|}}<img src="{{sphere.icon}}" alt="" title="{{sphere.label}}">{{/each}}
                {{#unless credoSpheres.length}}<span class="wod5e-mage-lineage-nosphere" aria-hidden="true"></span><span class="wod5e-mage-lineage-nosphere" aria-hidden="true"></span>{{/unless}}
                {{#if credoSpheres.length}}{{#unless credoSpheres.[1]}}<span class="wod5e-mage-lineage-nosphere" aria-hidden="true"></span>{{/unless}}{{/if}}
                <select name="flags.wod5e-mage.focus.credo" aria-label="{{localize 'WOD5E_MAGE.Focus.Credo'}}" {{#if locked}}disabled{{/if}}>
                    <option value="">{{localize "WOD5E_MAGE.Focus.CredoNone"}}</option>
                    {{#each credos as |credo|}}
                        <option value="{{credo.id}}" {{#if credo.selected}}selected{{/if}}>{{credo.label}}</option>
                    {{/each}}
                </select>
            </div>
        </label>
        {{#if credoFree}}
            {{!-- Potere e Scienza: le due Sfere di famiglia le sceglie il giocatore. --}}
            <div class="wod5e-mage-appartenenza-credo-spheres">
                {{#each credoSphereChoices as |pick|}}
                    <select name="flags.wod5e-mage.focus.credoSpheres.{{pick.slot}}" aria-label="{{localize 'WOD5E_MAGE.Lineage.CredoSphere'}}" {{#if ../locked}}disabled{{/if}}>
                        <option value="">{{localize "WOD5E_MAGE.Lineage.CredoSphereNone"}}</option>
                        {{#each pick.options as |sphere|}}
                            <option value="{{sphere.id}}" {{#if sphere.selected}}selected{{/if}}>{{sphere.label}}</option>
                        {{/each}}
                    </select>
                {{/each}}
            </div>
        {{/if}}
    </div>
</details>
