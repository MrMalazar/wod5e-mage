<section class="tab {{tab.cssClass}} wod5e-mage-focus" data-tab="{{tab.id}}" data-group="{{tab.group}}">
    <header class="wod5e-mage-section-title">
        <span>{{localize "WOD5E_MAGE.Tabs.Focus"}}</span>
    </header>

    <div class="wod5e-mage-focus-layout">
        <section class="wod5e-mage-focus-definition">
            {{!-- La Saggezza sta col Credo: un riquadro in colonna, non una barra.
                 Quando la fila è piena, accanto compare l'effetto (Segnato). --}}
            <div class="wod5e-mage-focus-wisdom">
                {{> "modules/wod5e-mage/templates/actor/parts/wisdom.hbs"}}
            </div>

            {{!-- Il Credo si sceglie in testata (Appartenenza); qui restano le parole tue. --}}
            <div class="wod5e-mage-focus-short-field">
                <div>
                    <strong>{{localize "WOD5E_MAGE.Focus.Credo"}}{{#if focus.credoLabel}}: {{focus.credoLabel}}{{/if}}</strong>
                    <small>{{localize "WOD5E_MAGE.Focus.CredoHere"}}</small>
                </div>
                <input type="text" name="flags.wod5e-mage.focus.paradigm" value="{{focus.paradigm}}" placeholder="{{localize 'WOD5E_MAGE.Focus.ParadigmHint'}}" aria-label="{{localize 'WOD5E_MAGE.Focus.ParadigmHint'}}" {{#if locked}}disabled{{/if}}>
            </div>

            <div class="wod5e-mage-focus-short-field">
                <div>
                    <strong>{{localize "WOD5E_MAGE.Focus.Type"}}</strong>
                    <small>{{localize "WOD5E_MAGE.Focus.TypeHint"}}</small>
                </div>
                {{!-- Magick, Tecnomagick, Magick Ibrida: il Tipo decide le famiglie
                     di Strumenti ammesse (Macchina solo Tecnomagick, Parola e
                     Corpo solo Magick, l'Ibrida tutto). --}}
                <select name="flags.wod5e-mage.focus.practiceForm" aria-label="{{localize 'WOD5E_MAGE.Focus.TypeHint'}}" {{#if locked}}disabled{{/if}}>
                    <option value="">{{localize "WOD5E_MAGE.Focus.FormNone"}}</option>
                    {{#each focus.forms as |form|}}
                        <option value="{{form.id}}" {{#if form.selected}}selected{{/if}}>{{form.label}}</option>
                    {{/each}}
                </select>
            </div>

            <section class="wod5e-mage-focus-instruments">
                <header class="resource-header">
                    <label class="header-label">{{localize "WOD5E_MAGE.Focus.Instruments"}}</label>
                </header>
                <p class="wod5e-mage-focus-instruments-hint">{{localize "WOD5E_MAGE.Focus.InstrumentsHint"}}</p>

                {{!-- Uno Strumento per Sfera (ramo A): la Sfera, lo Strumento fra i
                     ventidue a gruppi di famiglia, il mestiere quando serve, e il
                     tuo di preciso. --}}
                <div class="wod5e-mage-focus-instrument-list">
                    {{#each focus.instruments as |row|}}
                        <div class="wod5e-mage-focus-instrument{{#if row.sharedWith.length}} shared{{/if}}{{#if row.outsideForm}} outside{{/if}}">
                            <div class="wod5e-mage-focus-instrument-head">
                                <label class="wod5e-mage-focus-instrument-sphere" title="{{localize row.label}}">
                                    <img src="{{row.icon}}" alt="">
                                    <span>{{localize row.label}}</span>
                                </label>
                                {{!-- La lampadina: i consigli dal Credo, dalla Famiglia e dalla Sottofamiglia. --}}
                                <button type="button" class="wod5e-mage-archivio-open wod5e-mage-focus-instrument-suggest" data-action="strumentiSuggest" data-sphere="{{row.id}}" title="{{localize 'WOD5E_MAGE.Focus.Suggest'}}" aria-label="{{localize 'WOD5E_MAGE.Focus.Suggest'}}"><i class="fa-solid fa-lightbulb" aria-hidden="true"></i></button>
                            </div>
                            <select name="flags.wod5e-mage.focus.sphereInstruments.{{row.id}}.tool" aria-label="{{localize 'WOD5E_MAGE.Focus.Tool'}}" {{#if ../locked}}disabled{{/if}}>
                                <option value="">{{localize "WOD5E_MAGE.Focus.ToolNone"}}</option>
                                {{#each row.families as |family|}}
                                    <optgroup label="{{family.label}}" {{#unless family.allowed}}disabled{{/unless}}>
                                        {{#each family.tools as |tool|}}
                                            <option value="{{tool.id}}" {{#if tool.selected}}selected{{/if}}>{{tool.label}}</option>
                                        {{/each}}
                                    </optgroup>
                                {{/each}}
                            </select>
                            {{#if row.needsProfession}}
                                <input type="text" class="wod5e-mage-focus-instrument-profession" name="flags.wod5e-mage.focus.sphereInstruments.{{row.id}}.profession" value="{{row.profession}}" placeholder="{{localize 'WOD5E_MAGE.Focus.ProfessionHint'}}" aria-label="{{localize 'WOD5E_MAGE.Focus.Profession'}}" {{#if ../locked}}disabled{{/if}}>
                            {{/if}}
                            <input type="text" class="wod5e-mage-focus-instrument-name" name="flags.wod5e-mage.focus.sphereInstruments.{{row.id}}.name" value="{{row.name}}" placeholder="{{localize 'WOD5E_MAGE.Focus.Detail'}}" aria-label="{{localize 'WOD5E_MAGE.Focus.Detail'}}" {{#if ../locked}}disabled{{/if}}>
                            {{#if row.sharedWith.length}}
                                <small class="wod5e-mage-focus-instrument-note">{{localize "WOD5E_MAGE.Focus.SharedTool" others=row.sharedList}}</small>
                            {{/if}}
                            {{#if row.outsideForm}}
                                <small class="wod5e-mage-focus-instrument-note">{{localize "WOD5E_MAGE.Focus.ToolOutsideType"}}</small>
                            {{/if}}
                        </div>
                    {{else}}
                        <p class="wod5e-mage-focus-spheres-empty">{{localize "WOD5E_MAGE.Focus.NoSpheres"}}</p>
                    {{/each}}
                </div>
            </section>
        </section>

        <section class="wod5e-mage-focus-spheres">
            <header class="resource-header">
                <label class="header-label">{{localize "WOD5E_MAGE.Focus.Spheres"}}</label>
            </header>

            {{#each focus.spheres as |sphere|}}
                <article class="wod5e-mage-focus-sphere">{{!-- solo le Sfere sbloccate --}}
                    <h3>
                        <span>{{localize "WOD5E_MAGE.Focus.WhatIs"}}</span>
                        <strong>{{localize sphere.label}}</strong>
                    </h3>
                    <div class="resource">
                        <prose-mirror name="flags.wod5e-mage.focus.sphereNotes.{{sphere.id}}" value="{{sphere.notes}}" toggled="true" compact="true">
                            {{{sphere.enrichedNotes}}}
                        </prose-mirror>
                    </div>
                </article>
            {{else}}
                <p class="wod5e-mage-focus-spheres-empty">{{localize "WOD5E_MAGE.Focus.SpheresEmpty"}}</p>
            {{/each}}
        </section>
    </div>
</section>
