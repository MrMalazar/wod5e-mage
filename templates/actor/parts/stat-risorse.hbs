{{!-- Risorse (Blue, 20/9): un riquadro solo, a righe come le altre colonne.
     In quest'ordine: la Salute (col suo tastino che apre la ruota dei sei
     comandi) e la Saggezza (la bilancia, dal 3/10, con la ruota a quattro), la Quintessenza e il
     Paradosso col meno e il più ai lati del numero, la Ruota da sola, e in
     fondo le Condizioni, ognuna apribile col clic sul nome. --}}
<section class="wod5e-mage-riq wod5e-mage-riq-risorse">
    <header class="wod5e-mage-riq-title"><span>{{localize "WOD5E_MAGE.Stat.Risorse"}}</span></header>
    <div class="wod5e-mage-riq-body">
        <div class="wod5e-mage-risorse-righe">
            {{> "modules/wod5e-mage/templates/actor/parts/salute.hbs"}}

            {{!-- La Saggezza come bilancia (Blue, 3/10): nove caselle, Caduto a sinistra e
                 Folle a destra, e due segni indipendenti che partono dal centro, uno per
                 l'Hubris e uno per il Silenzio; al quarto passo il personaggio è finito. In
                 testa la bilancia, il nome, la riserva del tiro (Fermezza + Autocontrollo) e
                 il tastino che apre la ruota dei quattro comandi: Atto (gradino, lato,
                 Convinzione), Risplende, Ancora, Reset. Il clic su una casella porta lì il
                 segno di quel lato, il clic destro lo riporta al centro; sotto la fila, lo
                 stato dei due segni in parole. --}}
            <div class="wod5e-mage-riga wod5e-mage-riga-risorsa wod5e-mage-riga-saggezza con-ventaglio{{#if wisdom.fine}} finita{{/if}}">
                <div class="wod5e-mage-riga-testa">
                    <i class="fa-solid fa-scale-balanced wod5e-mage-riga-icona" aria-hidden="true"></i>
                    <span class="wod5e-mage-riga-nome wod5e-mage-riga-nome-fermo" title="{{localize 'WOD5E_MAGE.Wisdom.Hint'}}"><span>{{localize "WOD5E_MAGE.Wisdom.Label"}}</span></span>
                    {{#if wisdom.fine}}
                        <output class="wod5e-mage-saggezza-fine lato-{{wisdom.fine}}" title="{{localize (concat 'WOD5E_MAGE.Wisdom.Fine.' wisdom.fine)}}">{{wisdom.fineLabel}}</output>
                    {{/if}}
                    {{!-- La riserva del tiro: Fermezza + Autocontrollo, letta dagli Attributi. --}}
                    <b class="wod5e-mage-riga-valore" title="{{localize 'WOD5E_MAGE.Wisdom.RiservaHint' resolve=wisdom.resolve composure=wisdom.composure}}">{{wisdom.riserva}}</b>
                    <div class="wod5e-mage-riga-tastini">
                        <button type="button" class="wod5e-mage-riga-tastino wod5e-mage-ventaglio-tasto" data-action="ventaglioToggle" title="{{localize 'WOD5E_MAGE.Wisdom.VentaglioHint'}}" aria-label="{{localize 'WOD5E_MAGE.Wisdom.VentaglioHint'}}"><i class="fa-solid fa-dice-d10" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="wod5e-mage-saggezza-track wod5e-mage-bilancia" role="group" aria-label="{{localize 'WOD5E_MAGE.Wisdom.Label'}}" title="{{localize 'WOD5E_MAGE.Wisdom.ClickHint'}}">
                    {{#each wisdom.cells as |cell|}}
                        <button type="button" class="wod5e-mage-bilancia-cella lato-{{cell.lato}}{{#if cell.fine}} fine{{/if}}{{#if cell.hubris}} segno-hubris{{/if}}{{#if cell.silenzio}} segno-silenzio{{/if}}" data-action="wisdomCellChange" data-index="{{cell.index}}" data-lato="{{cell.lato}}" data-passo="{{cell.passo}}" title="{{cell.title}}" aria-label="{{cell.title}}">
                            {{#if cell.fine}}<i class="fa-solid {{#if (eq cell.lato 'hubris')}}fa-skull{{else}}fa-hurricane{{/if}}" aria-hidden="true"></i>{{/if}}
                            <span class="wod5e-mage-bilancia-segno hubris" aria-hidden="true"></span>
                            <span class="wod5e-mage-bilancia-segno silenzio" aria-hidden="true"></span>
                        </button>
                    {{/each}}
                </div>
                <small class="wod5e-mage-bilancia-stato">
                    <span class="lato-hubris{{#if wisdom.stato.hubris.passo}} fuori{{/if}}">{{wisdom.stato.hubris.riga}}</span>
                    <span class="lato-silenzio{{#if wisdom.stato.silenzio.passo}} fuori{{/if}}">{{wisdom.stato.silenzio.riga}}</span>
                </small>
                {{!-- La sorgente della ruota: quattro comandi (--voce): 0 sinistra l'Ancora,
                     1 sotto il Reset, 2 destra Risplende, 3 sopra l'Atto. --}}
                <div class="wod5e-mage-ventaglio wod5e-mage-ventaglio-quattro" role="group" aria-label="{{localize 'WOD5E_MAGE.Wisdom.VentaglioHint'}}">
                    <button type="button" class="wod5e-mage-ventaglio-voce" style="--voce: 3" data-action="wisdomAtto" title="{{localize 'WOD5E_MAGE.Wisdom.Roll'}}" aria-label="{{localize 'WOD5E_MAGE.Wisdom.Roll'}}">
                        <i class="fa-solid fa-dice-d10" aria-hidden="true"></i><span>{{localize "WOD5E_MAGE.Wisdom.Tira"}}</span>
                    </button>
                    <button type="button" class="wod5e-mage-ventaglio-voce" style="--voce: 2" data-action="wisdomRisplende" title="{{localize 'WOD5E_MAGE.Wisdom.RisplendeHint'}}" aria-label="{{localize 'WOD5E_MAGE.Wisdom.Risplende'}}">
                        <i class="fa-solid fa-sun" aria-hidden="true"></i><span>{{localize "WOD5E_MAGE.Wisdom.Risplende"}}</span>
                    </button>
                    <button type="button" class="wod5e-mage-ventaglio-voce" style="--voce: 0" data-action="wisdomAncora" title="{{localize 'WOD5E_MAGE.Wisdom.AncoraHint'}}" aria-label="{{localize 'WOD5E_MAGE.Wisdom.Ancora'}}">
                        <i class="fa-solid fa-anchor" aria-hidden="true"></i><span>{{localize "WOD5E_MAGE.Wisdom.Ancora"}}</span>
                    </button>
                    <button type="button" class="wod5e-mage-ventaglio-voce" style="--voce: 1" data-action="wisdomReset" title="{{localize 'WOD5E_MAGE.Wisdom.ResetHint'}}" aria-label="{{localize 'WOD5E_MAGE.Wisdom.Reset'}}">
                        <i class="fa-solid fa-eraser" aria-hidden="true"></i><span>{{localize "WOD5E_MAGE.Wisdom.Reset"}}</span>
                    </button>
                </div>
            </div>

            {{!-- I due conti della Ruota, ognuno sulla sua riga col meno e il più
                 ai lati del numero (Blue, 20/9); la Ruota sotto non porta più
                 tasti. Il nome PARADOSSO resta il tasto dello Scoppio. --}}
            {{!-- Il Sacrificio (Blue, 29/9): il tastino accanto al nome apre la finestra dei danni
                 in cambio di Quintessenza; col debito aperto compare il lucchetto col conto da
                 ripagare, e un clic lo salda. --}}
            <div class="wod5e-mage-riga wod5e-mage-riga-risorsa wod5e-mage-riga-conto quintessence">
                <div class="wod5e-mage-riga-testa">
                    <i class="fa-solid fa-circle-dot wod5e-mage-riga-icona" aria-hidden="true"></i>
                    <span class="wod5e-mage-riga-nome wod5e-mage-riga-nome-fermo"><span>{{localize "WOD5E_MAGE.MagickBalance.Quintessence"}}</span></span>
                    <button type="button" class="wod5e-mage-riga-tastino wod5e-mage-sacrificio-tasto" data-action="saluteSacrificio" title="{{localize 'WOD5E_MAGE.Sacrificio.Hint'}}" aria-label="{{localize 'WOD5E_MAGE.Sacrificio.Label'}}"><i class="fa-solid fa-hand-holding-droplet" aria-hidden="true"></i></button>
                    {{#if salute.debitoQuintessenza}}
                        <button type="button" class="wod5e-mage-debito-tasto" data-action="saluteSalda" title="{{localize 'WOD5E_MAGE.Debito.Hint' points=salute.debitoQuintessenza}}" aria-label="{{localize 'WOD5E_MAGE.Debito.Title'}}"><i class="fa-solid fa-lock" aria-hidden="true"></i> {{salute.debitoQuintessenza}}</button>
                    {{/if}}
                    <div class="wod5e-mage-riga-conto-tasti">
                        <button type="button" class="wod5e-mage-ruota-tasto quintessence meno" data-action="magickBalanceChange" data-resource="quintessence" data-delta="-1" aria-label="{{localize 'WOD5E_MAGE.MagickBalance.RemoveQuintessence'}}" title="{{localize 'WOD5E_MAGE.MagickBalance.RemoveQuintessence'}}"><i class="fa-solid fa-minus" aria-hidden="true"></i></button>
                        <b class="wod5e-mage-riga-valore">{{magickTrack.quintessence}}</b>
                        <button type="button" class="wod5e-mage-ruota-tasto quintessence piu" data-action="magickBalanceChange" data-resource="quintessence" data-delta="1" aria-label="{{localize 'WOD5E_MAGE.MagickBalance.AddQuintessence'}}" title="{{localize 'WOD5E_MAGE.MagickBalance.AddQuintessence'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
                    </div>
                </div>
            </div>
            <div class="wod5e-mage-riga wod5e-mage-riga-risorsa wod5e-mage-riga-conto paradox">
                <div class="wod5e-mage-riga-testa">
                    <i class="fa-solid fa-eye wod5e-mage-riga-icona" aria-hidden="true"></i>
                    <button type="button" class="wod5e-mage-riga-nome wod5e-mage-paradox-burst" data-action="paradoxBurst" title="{{localize 'WOD5E_MAGE.Burst.Hint'}}"><span>{{localize "WOD5E_MAGE.MagickBalance.Paradox"}}</span></button>
                    <div class="wod5e-mage-riga-conto-tasti">
                        <button type="button" class="wod5e-mage-ruota-tasto paradox meno" data-action="magickBalanceChange" data-resource="paradox" data-delta="-1" aria-label="{{localize 'WOD5E_MAGE.MagickBalance.RemoveParadox'}}" title="{{localize 'WOD5E_MAGE.MagickBalance.RemoveParadox'}}"><i class="fa-solid fa-minus" aria-hidden="true"></i></button>
                        <b class="wod5e-mage-riga-valore">{{magickTrack.paradox}}</b>
                        <button type="button" class="wod5e-mage-ruota-tasto paradox piu" data-action="magickBalanceChange" data-resource="paradox" data-delta="1" aria-label="{{localize 'WOD5E_MAGE.MagickBalance.AddParadox'}}" title="{{localize 'WOD5E_MAGE.MagickBalance.AddParadox'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
                    </div>
                </div>
            </div>
        </div>

        {{> "modules/wod5e-mage/templates/actor/parts/stat-ruota.hbs"}}

        {{> "modules/wod5e-mage/templates/actor/parts/stat-condizioni.hbs"}}
    </div>
</section>
