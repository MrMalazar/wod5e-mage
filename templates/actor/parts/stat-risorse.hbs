{{!-- Risorse (Blue, 16/9 sera): un riquadro solo, in quest'ordine, le
     Condizioni addosso, la Salute, la Saggezza a tendina e la Ruota. --}}
<section class="wod5e-mage-riq wod5e-mage-riq-risorse">
    <header class="wod5e-mage-riq-title"><span>{{localize "WOD5E_MAGE.Stat.Risorse"}}</span></header>
    <div class="wod5e-mage-riq-body">
        {{> "modules/wod5e-mage/templates/actor/parts/stat-condizioni.hbs"}}
        {{> "modules/wod5e-mage/templates/actor/parts/salute.hbs"}}
        <details class="wod5e-mage-saggezza-tendina">
            <summary><i class="fa-solid fa-chevron-right" aria-hidden="true"></i> <span>{{localize "WOD5E_MAGE.Wisdom.Label"}}</span></summary>
            <div class="wod5e-mage-saggezza-tendina-body">
                {{> "modules/wod5e-mage/templates/actor/parts/wisdom.hbs"}}
            </div>
        </details>
        {{> "modules/wod5e-mage/templates/actor/parts/stat-ruota.hbs"}}
    </div>
</section>
