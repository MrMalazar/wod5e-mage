<section class="tab {{tab.cssClass}} wod5e-mage-spheres" data-tab="{{tab.id}}" data-group="{{tab.group}}">
    <header class="wod5e-mage-section-title">
        <span>{{localize "WOD5E_MAGE.Tabs.Magick"}}</span>
    </header>

    <div class="wod5e-mage-spheres-content wod5e-mage-magick-layout">
        <section class="wod5e-mage-spheres-panel">
            <header class="resource-header">
                <label class="header-label">{{localize "WOD5E_MAGE.Tabs.Spheres"}}</label>
            </header>

            <div class="wod5e-mage-sphere-selector" role="group" aria-label="{{localize 'WOD5E_MAGE.Spheres.Selector'}}">
                {{#each sphereChoices as |sphere|}}
                    <label class="wod5e-mage-sphere-choice" title="{{localize sphere.label}}">
                        <img src="{{sphere.icon}}" alt="{{localize sphere.label}}">
                        <span class="resource-value wod5e-mage-sphere-toggle" data-value="{{#if sphere.selected}}1{{else}}0{{/if}}">
                            <span class="resource-value-step" data-action="sphereSelectionChange" data-sphere="{{sphere.id}}" data-selected="{{sphere.selected}}" data-index="1" role="checkbox" aria-checked="{{sphere.selected}}" tabindex="0"></span>
                        </span>
                    </label>
                {{/each}}
            </div>

            <div class="wod5e-mage-spheres-grid">
                <div class="wod5e-mage-spheres-list-header">
                    <span>{{localize "WOD5E_MAGE.Spheres.List"}}</span>
                    <span>{{localize "WOD5E_MAGE.Spheres.Influence.Label"}}</span>
                </div>

                {{#each spheres as |sphere|}}
                    <div class="wod5e-mage-sphere{{#if sphere.family}} family{{/if}}">
                        {{!-- La casetta: Sfera di famiglia (costa meno) o esterna. --}}
                        <button type="button" class="wod5e-mage-sphere-family" data-action="familySphereToggle" data-sphere="{{sphere.id}}" title="{{#if sphere.family}}{{localize 'WOD5E_MAGE.Spheres.FamilyOn'}}{{else}}{{localize 'WOD5E_MAGE.Spheres.FamilyOff'}}{{/if}}" aria-pressed="{{sphere.family}}" {{#if ../locked}}disabled{{/if}}><i class="fa-solid fa-house"></i></button>
                        <label class="resource-label">{{localize sphere.label}}</label>
                        <div class="resource-value" data-value="{{sphere.value}}" data-name="flags.wod5e-mage.spheres.{{sphere.id}}">
                            {{!-- Come le Abilità: il vuoto a sinistra riporta la Sfera a zero. --}}
                            <span class="resource-value-empty" data-action="dotCounterEmpty"></span>
                            {{#numLoop 5}}
                                <span class="resource-value-step" data-action="dotCounterChange" data-index="{{this}}" title="{{this}}"></span>
                            {{/numLoop}}
                        </div>
                        <span class="wod5e-mage-sphere-influence">{{localize sphere.influenceLabel}}</span>
                    </div>
                {{else}}
                    <p class="wod5e-mage-spheres-empty">{{localize "WOD5E_MAGE.Spheres.Empty"}}</p>
                {{/each}}
            </div>
        </section>

        <section class="wod5e-mage-ongoing-magick">
            <header class="resource-header">
                <label class="header-label">{{localize "WOD5E_MAGE.OngoingMagick.Label"}}</label>
            </header>

            <div class="wod5e-mage-ongoing-magick-controls">
                <button type="button" data-action="ongoingMagickAdd" title="{{localize 'WOD5E_MAGE.OngoingMagick.Add'}}" {{#if locked}}disabled{{/if}}>
                    <i class="fa-solid fa-plus"></i>
                    {{localize "WOD5E_MAGE.OngoingMagick.Add"}}
                </button>
            </div>

            {{#if ongoingMagick.length}}
            <div class="wod5e-mage-ongoing-magick-grid">
                <span aria-hidden="true"></span>
                <span>{{localize "WOD5E_MAGE.OngoingMagick.NameSpheres"}}</span>
                <span>{{localize "WOD5E_MAGE.OngoingMagick.Status"}}</span>
                <span>{{localize "WOD5E_MAGE.OngoingMagick.TriggerEffect"}}</span>
                <span aria-hidden="true"></span>

                {{#each ongoingMagick as |row|}}
                    {{!-- I segni: il lucchetto rosso del Paradosso bloccato (Volgare),
                         la clessidra con la Durata, la soglia. --}}
                    <span class="wod5e-mage-ongoing-marks">
                        {{#if row.lock}}<i class="fa-solid fa-lock wod5e-mage-ongoing-lock" title="{{localize 'WOD5E_MAGE.OngoingMagick.LockHint'}}" aria-hidden="true"></i>{{/if}}
                        {{#if row.duration}}<small title="{{localize 'WOD5E_MAGE.Scopes.duration'}}"><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>{{row.duration}}</small>{{/if}}
                        {{#if row.threshold}}<small title="{{localize 'WOD5E_MAGE.Arete.Threshold'}}"><i class="fa-solid fa-bullseye" aria-hidden="true"></i>{{row.threshold}}</small>{{/if}}
                    </span>
                    <input type="text" name="flags.wod5e-mage.ongoingMagick.{{row.id}}.nameSpheres" value="{{row.nameSpheres}}" aria-label="{{localize 'WOD5E_MAGE.OngoingMagick.NameSpheres'}}" {{#if ../locked}}disabled{{/if}}>
                    <input type="text" name="flags.wod5e-mage.ongoingMagick.{{row.id}}.status" value="{{row.status}}" aria-label="{{localize 'WOD5E_MAGE.OngoingMagick.Status'}}" {{#if ../locked}}disabled{{/if}}>
                    <input type="text" name="flags.wod5e-mage.ongoingMagick.{{row.id}}.triggerEffect" value="{{row.triggerEffect}}" aria-label="{{localize 'WOD5E_MAGE.OngoingMagick.TriggerEffect'}}" {{#if ../locked}}disabled{{/if}}>
                    <button type="button" data-action="ongoingMagickDelete" data-row="{{row.id}}" title="{{localize 'WOD5E_MAGE.OngoingMagick.Remove'}}" aria-label="{{localize 'WOD5E_MAGE.OngoingMagick.Remove'}}" {{#if ../locked}}disabled{{/if}}>
                        <i class="fa-solid fa-trash"></i>
                    </button>
                {{/each}}
            </div>
            {{else}}
                <p class="wod5e-mage-ongoing-magick-empty">{{localize "WOD5E_MAGE.OngoingMagick.Empty"}}</p>
            {{/if}}
        </section>

        {{!-- Le Specialità delle Sfere: al terzo pallino di una Sfera si sceglie
             uno dei suoi poteri passivi. La Sfera affine non esiste più. --}}
        <section class="wod5e-mage-sphere-specialties">
            <header class="resource-header">
                <label class="header-label">{{localize "WOD5E_MAGE.SphereSpecialties.Label"}}</label>
            </header>

            {{#if sphereSpecialties.length}}
                <div class="wod5e-mage-sphere-specialty-list">
                    {{#each sphereSpecialties as |row|}}
                        {{#unless row.hasPowers}}
                            <p class="wod5e-mage-spheres-empty">{{localize "WOD5E_MAGE.SphereSpecialties.MissingPack"}}</p>
                        {{/unless}}
                        {{!-- Un riquadro per ogni Specialità: la Sfera, il numero, la
                             tendina stretta, il testo del potere scelto. --}}
                        {{#each row.slots as |slot|}}
                            {{!-- Una riga per Specialità: simbolo, Sfera, numero e la tendina;
                                 il testo del potere si apre cliccando sul titolo. --}}
                            <article class="wod5e-mage-sphere-specialty{{#if slot.chosen}} chosen{{/if}}" data-slot="{{row.id}}-{{slot.key}}">
                                <div class="wod5e-mage-sphere-specialty-head"{{#if slot.chosen}} title="{{localize 'WOD5E_MAGE.SphereSpecialties.ShowText'}}"{{/if}}>
                                    <img src="{{row.icon}}" alt="">
                                    <strong>{{localize row.label}}</strong>
                                    {{#if slot.chosen}}<i class="fa-solid fa-chevron-down wod5e-mage-sphere-specialty-chevron" aria-hidden="true"></i>{{/if}}
                                </div>
                                <select name="flags.wod5e-mage.sphereSpecialties.{{row.id}}.{{slot.key}}" aria-label="{{localize 'WOD5E_MAGE.SphereSpecialties.Label'}}" {{#if ../../locked}}disabled{{/if}}>
                                    <option value="">{{localize "WOD5E_MAGE.SphereSpecialties.None"}}</option>
                                    {{#each slot.options as |option|}}
                                        <option value="{{option.id}}" {{#if option.selected}}selected{{/if}} {{#if option.taken}}disabled{{/if}}>{{option.label}}</option>
                                    {{/each}}
                                </select>
                                {{#if slot.chosen}}
                                    <div class="wod5e-mage-sphere-specialty-text">{{{slot.chosen.description}}}</div>
                                {{/if}}
                            </article>
                        {{/each}}
                    {{/each}}
                </div>
            {{else}}
                <p class="wod5e-mage-spheres-empty">{{localize "WOD5E_MAGE.SphereSpecialties.Empty"}}</p>
            {{/if}}
        </section>

        {{> "modules/wod5e-mage/templates/actor/parts/scope-table.hbs"}}
    </div>
</section>
