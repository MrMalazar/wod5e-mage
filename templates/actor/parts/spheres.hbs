{{!-- La pagina Magick (Blue, 21/9/2026, dal mock docs/mock_pagina_magick_21-9.html):
     a sinistra le nove Sfere in una lista sola (il segno dell'accesso apre o
     chiude il Dominio; niente livelli dal 25/9 sera; la casetta di famiglia; il
     conto dei poteri conosciuti, lo stesso numero della prima pagina) e sotto le Magick
     in atto; a destra i poteri che il giocatore ha inserito, Sfera per Sfera,
     in righe a colonne allineate (pallino, nome, tipo, Amalgama, costo), col
     testo che si apre al clic sul nome e la tendina Aggiungi (dal catalogo,
     o scritto a mano); in fondo, in una tendina, la tavola degli Ambiti. Le
     Specialità delle Sfere e la colonna Influenza non esistono più. --}}
<section class="tab {{tab.cssClass}} wod5e-mage-spheres" data-tab="{{tab.id}}" data-group="{{tab.group}}">
    <header class="wod5e-mage-section-title">
        {{#if creazioneReset}}{{> "modules/wod5e-mage/templates/actor/parts/reset-tasto.hbs" resetsById.spheres}}{{/if}}
        <span>{{localize "WOD5E_MAGE.Tabs.Magick"}}</span>
    </header>

    <div class="wod5e-mage-spheres-content wod5e-mage-magick-layout">
        <div class="wod5e-mage-magick-sinistra">
            {{!-- Le Sfere: quelle conosciute in testa, con pallini, casetta e conto; le altre sotto, spente. --}}
            <section class="wod5e-mage-riq wod5e-mage-riq-pagina wod5e-mage-riq-sfere">
                <header class="wod5e-mage-riq-title">
                    <span>{{localize "WOD5E_MAGE.Tabs.Spheres"}}</span>
                    <small class="wod5e-mage-riq-conto">{{localize "WOD5E_MAGE.Poteri.SfereConosciute" count=sfereConosciute.length}} · {{localize "WOD5E_MAGE.Poteri.InTutto" count=poteriTotale}}</small>
                </header>
                <div class="wod5e-mage-riq-body">
                    {{!-- Le Sfere come nella prima pagina (Blue, 25/9 sera): niente livelli da 1 a 5,
                         «creano solo confusione». Il sigillo è il tasto che apre e chiude il Dominio (Blue:
                         «bastasse sul simbolo sfera»), poi il conto dei poteri conosciuti, il nome, la casetta
                         (di famiglia o esterna). --}}
                    <div class="wod5e-mage-sfere-lista">
                        {{#each sfereConosciute as |sphere|}}
                            <div class="wod5e-mage-riga wod5e-mage-riga-sfera-pagina{{#if sphere.family}} family{{/if}}">
                                <button type="button" class="wod5e-mage-sfera-accesso acceso" data-action="sphereSelectionChange" data-sphere="{{sphere.id}}" data-selected="true" title="{{localize 'WOD5E_MAGE.Poteri.DominioChiudi'}}" aria-pressed="true" {{#if ../locked}}disabled{{/if}}><img class="wod5e-mage-riga-icona wod5e-mage-sfera-sigillo" src="{{sphere.icon}}" alt=""></button>
                                <b class="wod5e-mage-sfera-conto{{#unless sphere.conto}} vuoto{{/unless}}" title="{{localize 'WOD5E_MAGE.Stat.PoteriConosciuti'}}">{{sphere.conto}}</b>
                                <span class="wod5e-mage-riga-nome wod5e-mage-riga-nome-fermo"><span>{{localize sphere.label}}</span></span>
                                <button type="button" class="wod5e-mage-riga-tastino wod5e-mage-sfera-casa{{#if sphere.family}} on{{/if}}" data-action="familySphereToggle" data-sphere="{{sphere.id}}" title="{{#if sphere.family}}{{localize 'WOD5E_MAGE.Poteri.Casa'}}{{else}}{{localize 'WOD5E_MAGE.Poteri.CasaOff'}}{{/if}}" aria-pressed="{{sphere.family}}" {{#if ../locked}}disabled{{/if}}><i class="fa-solid fa-house" aria-hidden="true"></i></button>
                            </div>
                        {{/each}}
                    </div>
                    {{#if sfereAltre.length}}
                        <span class="wod5e-mage-riq-occhiello">{{localize "WOD5E_MAGE.Poteri.AltreSfere"}}</span>
                        <div class="wod5e-mage-sfere-lista">
                            {{#each sfereAltre as |sphere|}}
                                <div class="wod5e-mage-riga wod5e-mage-riga-sfera-pagina spenta">
                                    <button type="button" class="wod5e-mage-sfera-accesso" data-action="sphereSelectionChange" data-sphere="{{sphere.id}}" data-selected="false" title="{{localize 'WOD5E_MAGE.Poteri.DominioApri'}}" aria-pressed="false" {{#if ../locked}}disabled{{/if}}><img class="wod5e-mage-riga-icona wod5e-mage-sfera-sigillo" src="{{sphere.icon}}" alt=""></button>
                                    <span class="wod5e-mage-riga-nome wod5e-mage-riga-nome-fermo"><span>{{localize sphere.label}}</span></span>
                                </div>
                            {{/each}}
                        </div>
                    {{/if}}
                </div>
            </section>

            {{!-- Le Magick in atto (6/9; rifatte il 25/9 sera, Blue: «deve segnare diversi elementi»):
                 ogni riga è una carta. In testa On/Off, il nome, le pastiglie (Volgare, il lucchetto del
                 Paradosso permanente che si accende e spegne, «dal tiro», la Durata), il cestino; poi chi
                 l'ha lanciata e chi la mantiene; com'è composta (i sigilli delle Sfere e il testo); la
                 soglia con gli Ambiti in parole; i bonus e i malus; l'effetto su più righe. Il lancio con
                 una Durata scrive tutto da sé; a mano si compila quel che serve. --}}
            <section class="wod5e-mage-riq wod5e-mage-riq-pagina wod5e-mage-ongoing-magick">
                <header class="wod5e-mage-riq-title">
                    <span>{{localize "WOD5E_MAGE.OngoingMagick.Label"}}</span>
                    <button type="button" class="wod5e-mage-riq-tasto-piccolo" data-action="ongoingMagickAdd" title="{{localize 'WOD5E_MAGE.OngoingMagick.Add'}}" aria-label="{{localize 'WOD5E_MAGE.OngoingMagick.Add'}}" {{#if locked}}disabled{{/if}}><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
                </header>
                <div class="wod5e-mage-riq-body">
                    {{#each ongoingMagick as |row|}}
                        <div class="wod5e-mage-atto-riga{{#if row.active}} accesa{{/if}}">
                            <div class="wod5e-mage-atto-testa">
                                <button type="button" class="wod5e-mage-ongoing-toggle{{#if row.active}} lit{{/if}}" data-action="ongoingMagickToggle" data-row="{{row.id}}" title="{{#if row.active}}{{localize 'WOD5E_MAGE.OngoingMagick.On'}}{{else}}{{localize 'WOD5E_MAGE.OngoingMagick.Off'}}{{/if}}" aria-label="{{localize 'WOD5E_MAGE.OngoingMagick.Status'}}" {{#if ../locked}}disabled{{/if}}>
                                    {{#if row.active}}{{localize "WOD5E_MAGE.OngoingMagick.On"}}{{else}}{{localize "WOD5E_MAGE.OngoingMagick.Off"}}{{/if}}
                                </button>
                                <input type="text" class="wod5e-mage-atto-nome" name="flags.wod5e-mage.ongoingMagick.{{row.id}}.nameSpheres" value="{{row.nameSpheres}}" placeholder="{{localize 'WOD5E_MAGE.OngoingMagick.Name'}}" aria-label="{{localize 'WOD5E_MAGE.OngoingMagick.Name'}}" {{#if ../locked}}disabled{{/if}}>
                                <span class="wod5e-mage-ongoing-marks">
                                    {{#if row.vulgar}}<small class="wod5e-mage-atto-pastiglia volgare" title="{{localize 'WOD5E_MAGE.OngoingMagick.VolgareHint'}}">{{localize "WOD5E_MAGE.OngoingMagick.Volgare"}}</small>{{/if}}
                                    <button type="button" class="wod5e-mage-atto-pastiglia wod5e-mage-atto-lucchetto{{#if row.lock}} on{{/if}}" data-action="ongoingMagickLock" data-row="{{row.id}}" title="{{#if row.lock}}{{localize 'WOD5E_MAGE.OngoingMagick.LockHint'}}{{else}}{{localize 'WOD5E_MAGE.OngoingMagick.LockOffHint'}}{{/if}}" aria-pressed="{{#if row.lock}}true{{else}}false{{/if}}" {{#if ../locked}}disabled{{/if}}><i class="fa-solid {{#if row.lock}}fa-lock{{else}}fa-lock-open{{/if}}" aria-hidden="true"></i> {{localize "WOD5E_MAGE.OngoingMagick.Permanente"}}</button>
                                    {{#if row.fromRoll}}<small class="wod5e-mage-atto-pastiglia" title="{{localize 'WOD5E_MAGE.OngoingMagick.DalTiroHint'}}"><i class="fa-solid fa-dice" aria-hidden="true"></i> {{localize "WOD5E_MAGE.OngoingMagick.DalTiro"}}</small>{{/if}}
                                    {{#if row.duration}}<small class="wod5e-mage-atto-pastiglia" title="{{localize 'WOD5E_MAGE.Scopes.duration'}}"><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i> {{row.duration}}</small>{{/if}}
                                </span>
                                <button type="button" class="wod5e-mage-riq-tasto-piccolo wod5e-mage-atto-cestino" data-action="ongoingMagickDelete" data-row="{{row.id}}" title="{{localize 'WOD5E_MAGE.OngoingMagick.Remove'}}" aria-label="{{localize 'WOD5E_MAGE.OngoingMagick.Remove'}}" {{#if ../locked}}disabled{{/if}}><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                            </div>
                            <div class="wod5e-mage-atto-campi">
                                <label class="wod5e-mage-atto-campo"><span>{{localize "WOD5E_MAGE.OngoingMagick.Lanciata"}}</span><input type="text" name="flags.wod5e-mage.ongoingMagick.{{row.id}}.caster" value="{{row.caster}}" placeholder="{{localize 'WOD5E_MAGE.OngoingMagick.Chi'}}" {{#if ../locked}}disabled{{/if}}></label>
                                <label class="wod5e-mage-atto-campo"><span>{{localize "WOD5E_MAGE.OngoingMagick.Mantenuta"}}</span><input type="text" name="flags.wod5e-mage.ongoingMagick.{{row.id}}.maintainer" value="{{row.maintainer}}" placeholder="{{localize 'WOD5E_MAGE.OngoingMagick.Nessuno'}}" {{#if ../locked}}disabled{{/if}}></label>
                                <label class="wod5e-mage-atto-campo largo"><span>{{localize "WOD5E_MAGE.OngoingMagick.Composizione"}}</span>{{#if row.spheres.length}}<span class="wod5e-mage-atto-sigilli">{{#each row.spheres as |s|}}<img src="{{s.icon}}" alt="{{s.label}}" title="{{s.label}}">{{/each}}</span>{{/if}}<input type="text" name="flags.wod5e-mage.ongoingMagick.{{row.id}}.composition" value="{{row.composition}}" placeholder="{{localize 'WOD5E_MAGE.OngoingMagick.ComposizioneHint'}}" {{#if ../locked}}disabled{{/if}}></label>
                                <label class="wod5e-mage-atto-campo largo"><span>{{localize "WOD5E_MAGE.OngoingMagick.Soglia"}}</span><input type="number" class="wod5e-mage-atto-numero" name="flags.wod5e-mage.ongoingMagick.{{row.id}}.threshold" value="{{row.threshold}}" min="0" step="1" data-dtype="Number" {{#if ../locked}}disabled{{/if}}><input type="text" name="flags.wod5e-mage.ongoingMagick.{{row.id}}.scopesText" value="{{row.scopesText}}" placeholder="{{localize 'WOD5E_MAGE.OngoingMagick.AmbitiHint'}}" {{#if ../locked}}disabled{{/if}}></label>
                                <label class="wod5e-mage-atto-campo largo"><span>{{localize "WOD5E_MAGE.OngoingMagick.BonusMalus"}}</span><input type="text" name="flags.wod5e-mage.ongoingMagick.{{row.id}}.modifiers" value="{{row.modifiers}}" placeholder="{{localize 'WOD5E_MAGE.OngoingMagick.BonusMalusHint'}}" {{#if ../locked}}disabled{{/if}}></label>
                            </div>
                            {{!-- L'effetto su più righe (Blue, 25/9: il riquadro era troppo piccolo). --}}
                            <textarea class="wod5e-mage-atto-effetto" name="flags.wod5e-mage.ongoingMagick.{{row.id}}.triggerEffect" rows="2" placeholder="{{localize 'WOD5E_MAGE.OngoingMagick.Effect'}}" aria-label="{{localize 'WOD5E_MAGE.OngoingMagick.Effect'}}" {{#if ../locked}}disabled{{/if}}>{{row.triggerEffect}}</textarea>
                        </div>
                    {{/each}}
                </div>
            </section>
        </div>

        {{!-- I poteri conosciuti (24/9 sera, Blue: «una semplice lista», senza la divisione
             per Sfere): in testa il conto, Aggiungi (la finestra dei poteri che si possono
             prendere adesso, con le pastiglie delle Sfere) e il Catalogo completo da leggere;
             sotto, una riga per potere in ordine di nome: il sigillo della Sfera, il pallino,
             il nome (il clic apre il testo, come la freccia in fondo), le pastiglie del tipo
             (attivo, passivo, tutte e due), l'Amalgama, il costo. --}}
        <section class="wod5e-mage-riq wod5e-mage-riq-pagina wod5e-mage-riq-conosciuti">
            <header class="wod5e-mage-riq-title wod5e-mage-riq-title-tasti">
                <span>{{localize "WOD5E_MAGE.Stat.PoteriConosciuti"}}</span>
                <small class="wod5e-mage-riq-conto">{{localize "WOD5E_MAGE.Poteri.InTutto" count=poteriTotale}}</small>
                <span class="wod5e-mage-riq-tasti">
                    <button type="button" class="wod5e-mage-riq-tasto-piccolo wod5e-mage-poteri-catalogo-completo" data-action="potereCatalogoCompleto" title="{{localize 'WOD5E_MAGE.Poteri.CatalogoCompletoHint'}}" aria-label="{{localize 'WOD5E_MAGE.Poteri.CatalogoCompleto'}}"><i class="fa-solid fa-book-open" aria-hidden="true"></i></button>
                    <button type="button" class="wod5e-mage-sfera-potere wod5e-mage-poteri-aggiungi" data-action="potereCatalogo" title="{{localize 'WOD5E_MAGE.Poteri.AggiungiHint'}}" {{#if locked}}disabled{{/if}}><i class="fa-solid fa-plus" aria-hidden="true"></i><span>{{localize "WOD5E_MAGE.Poteri.Aggiungi"}}</span></button>
                </span>
            </header>
            <div class="wod5e-mage-riq-body wod5e-mage-poteri-lista">
                {{#each poteriLista as |p|}}
                    {{!-- La riga del potere: colonne allineate (Blue, 21/9: il tipo «non attaccato al nome»). --}}
                    <div class="wod5e-mage-potere-riga{{#if p.editing}} aperta modifica{{/if}}" data-row="{{p.id}}">
                        <div class="wod5e-mage-potere-testa">
                            <img class="wod5e-mage-potere-sfera" src="{{p.sphereIcon}}" alt="{{p.sphereLabel}}" title="{{p.sphereLabel}}">
                            <b class="wod5e-mage-potere-pallino{{#unless p.dot}} vuoto{{/unless}}" title="{{localize 'WOD5E_MAGE.Poteri.Pallino'}}">{{#if p.dot}}{{p.dot}}{{else}}·{{/if}}</b>
                            <button type="button" class="wod5e-mage-potere-nome" data-action="potereApri" title="{{localize 'WOD5E_MAGE.Poteri.Apri'}}" aria-expanded="{{p.editing}}"><span>{{p.label}}</span></button>
                            <span class="wod5e-mage-potere-tipi">{{#if p.tipi.attivo}}<small class="wod5e-mage-potere-tipo attivo">{{localize "WOD5E_MAGE.Poteri.Tipo.attivo"}}</small>{{/if}}{{#if p.tipi.passivo}}<small class="wod5e-mage-potere-tipo passivo">{{localize "WOD5E_MAGE.Poteri.Tipo.passivo"}}</small>{{/if}}{{#if p.universale}}<small class="wod5e-mage-potere-tipo universale" title="{{localize 'WOD5E_MAGE.Poteri.UniversaleHint' sphere=p.sphereLabel}}">{{localize "WOD5E_MAGE.Poteri.Universale"}}</small>{{/if}}</span>
                            <span class="wod5e-mage-potere-amalgama{{#if p.amalgam}}{{#unless p.amalgamOwned}} manca{{/unless}}{{else}} niente{{/if}}" title="{{#if p.amalgam}}{{localize 'WOD5E_MAGE.Poteri.Con' sphere=p.amalgamLabel}}{{/if}}">{{#if p.amalgam}}<img src="{{p.amalgamIcon}}" alt="{{p.amalgamLabel}}">{{/if}}</span>
                            <small class="wod5e-mage-potere-costo">{{p.cost}}</small>
                            {{!-- «Usa» nella testa della riga, senza aprire la tendina (Blue, 25/9): sui poteri con
                                 una parte attiva paga, conta gli usi e manda la carta; sui soli passivi «Mostra», la carta e basta. --}}
                            <button type="button" class="wod5e-mage-potere-usa{{#unless p.usa.ok}} spento{{/unless}}{{#unless p.tipi.attivo}} mostra{{/unless}}" data-action="potereUsa" data-row="{{p.id}}" title="{{#if p.tipi.attivo}}{{p.usa.hint}}{{else}}{{localize 'WOD5E_MAGE.Poteri.MostraHint'}}{{/if}}"><i class="fa-solid {{#if p.tipi.attivo}}fa-hand-sparkles{{else}}fa-comment{{/if}}" aria-hidden="true"></i> {{#if p.tipi.attivo}}{{localize "WOD5E_MAGE.Poteri.Usa"}}{{else}}{{localize "WOD5E_MAGE.Poteri.Mostra"}}{{/if}}{{#if p.usa.label}}<small>{{p.usa.label}}</small>{{/if}}</button>
                            {{!-- La freccia apre e chiude come il nome (Blue, 24/9 sera: «la freccetta non funziona»). --}}
                            <button type="button" class="wod5e-mage-potere-chevron" data-action="potereApri" title="{{localize 'WOD5E_MAGE.Poteri.Apri'}}" aria-label="{{localize 'WOD5E_MAGE.Poteri.Apri'}}"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button>
                        </div>
                        <div class="wod5e-mage-potere-spiega">
                            {{#if p.editing}}
                                {{!-- In modifica: i campi della bandiera, salvati dal foglio come le Magick in atto. --}}
                                <div class="wod5e-mage-potere-campi">
                                    <label class="wod5e-mage-potere-campo-largo"><span>{{localize "WOD5E_MAGE.Poteri.Nome"}}</span><input type="text" name="flags.wod5e-mage.poteri.{{p.id}}.name" value="{{p.name}}"></label>
                                    <label><span>{{localize "WOD5E_MAGE.Poteri.Pallino"}}</span><select name="flags.wod5e-mage.poteri.{{p.id}}.dot" data-dtype="Number"><option value="0"{{#unless p.dot}} selected{{/unless}}>{{localize "WOD5E_MAGE.Poteri.PallinoNessuno"}}</option>{{#each p.options.pallini as |o|}}<option value="{{o.value}}"{{#if (eq o.value p.dot)}} selected{{/if}}>{{o.label}}</option>{{/each}}</select></label>
                                    <label><span>{{localize "WOD5E_MAGE.Poteri.Tipo.Label"}}</span><select name="flags.wod5e-mage.poteri.{{p.id}}.type"><option value=""{{#unless p.type}} selected{{/unless}}>{{localize "WOD5E_MAGE.Poteri.Tipo.Nessuno"}}</option>{{#each p.options.tipi as |o|}}<option value="{{o.value}}"{{#if (eq o.value p.type)}} selected{{/if}}>{{o.label}}</option>{{/each}}</select></label>
                                    <label><span>{{localize "WOD5E_MAGE.Poteri.Costo"}}</span><input type="text" name="flags.wod5e-mage.poteri.{{p.id}}.cost" value="{{p.cost}}"></label>
                                    {{!-- Di qualsiasi Sfera (25/9 sera): il segno si sposta su un'altra Sfera aperta. --}}
                                    {{#if p.universale}}<label><span>{{localize "WOD5E_MAGE.Poteri.SegnatoIn"}}</span><select name="flags.wod5e-mage.poteri.{{p.id}}.sphere">{{#each p.sfereSegno as |o|}}<option value="{{o.value}}"{{#if o.selected}} selected{{/if}}>{{o.label}}</option>{{/each}}</select></label>{{/if}}
                                    <label class="wod5e-mage-potere-campo-largo"><span>{{localize "WOD5E_MAGE.Poteri.CosaFa"}}</span><textarea name="flags.wod5e-mage.poteri.{{p.id}}.text" rows="3">{{p.text}}</textarea></label>
                                    <label><span>{{localize "WOD5E_MAGE.Poteri.Amalgama"}}</span><select name="flags.wod5e-mage.poteri.{{p.id}}.amalgam"><option value=""{{#unless p.amalgam}} selected{{/unless}}>{{localize "WOD5E_MAGE.Poteri.AmalgamaNessuna"}}</option>{{#each p.options.sfere as |o|}}<option value="{{o.value}}"{{#if (eq o.value p.amalgam)}} selected{{/if}}>{{o.label}}</option>{{/each}}</select></label>
                                    <label class="wod5e-mage-potere-campo-largo"><span>{{localize "WOD5E_MAGE.Poteri.ConAmalgama"}}</span><textarea name="flags.wod5e-mage.poteri.{{p.id}}.amalgamText" rows="2">{{p.amalgamText}}</textarea></label>
                                    <label class="wod5e-mage-potere-campo-largo"><span>{{localize "WOD5E_MAGE.Poteri.Flavor"}}</span><textarea name="flags.wod5e-mage.poteri.{{p.id}}.flavor" rows="2">{{p.flavor}}</textarea></label>
                                </div>
                            {{else}}
                                {{#if p.formulaName}}<p class="wod5e-mage-potere-testo wod5e-mage-potere-matrice"><span class="wod5e-mage-potere-k">{{localize "WOD5E_MAGE.Poteri.Matrice"}}</span>{{p.formulaName}}{{#if p.usesLabel}} · {{p.usesLabel}}{{/if}}</p>{{/if}}
                                {{!-- La scelta fatta all'acquisto (tappa 3): l'Ambito, l'Abilità o l'incantesimo che il potere chiede; la salva il foglio. --}}
                                {{#if p.sceltaCampo}}
                                    <label class="wod5e-mage-potere-testo wod5e-mage-potere-scelta{{#unless p.scelta}} manca{{/unless}}"><span class="wod5e-mage-potere-k">{{p.sceltaCampo.label}}</span>
                                        <select name="flags.wod5e-mage.poteri.{{p.id}}.scelta" {{#if ../locked}}disabled{{/if}}>
                                            <option value=""{{#unless p.scelta}} selected{{/unless}}>{{localize "WOD5E_MAGE.Poteri.SceltaNessuna"}}</option>
                                            {{#each p.sceltaCampo.options as |o|}}<option value="{{o.value}}"{{#if o.selected}} selected{{/if}}>{{o.label}}</option>{{/each}}
                                        </select>
                                    </label>
                                {{/if}}
                                {{!-- Il testo a blocchi (Blue, 25/9: «non si distingue»): Effetto attivo, Effetto passivo,
                                     Effetto Amalgama, ognuno col suo titolo; le righe «Accesso con X» con la chiave in evidenza.
                                     Il testo scritto a mano, senza titoli, sta in un blocco solo con «Cosa fa». --}}
                                {{#each p.blocchi as |b|}}
                                    <div class="wod5e-mage-potere-blocco{{#if b.kind}} {{b.kind}}{{/if}}{{#if (eq b.kind "amalgama")}}{{#unless p.amalgamOwned}} manca{{/unless}}{{/if}}">
                                        <span class="wod5e-mage-potere-blocco-titolo">{{#if b.titolo}}{{b.titolo}}{{else}}{{localize "WOD5E_MAGE.Poteri.CosaFa"}}{{/if}}</span>
                                        {{#each b.voci as |v|}}<p class="wod5e-mage-potere-blocco-riga">{{#if v.chiave}}<b>{{v.chiave}}:</b> {{/if}}{{v.testo}}</p>{{/each}}
                                        {{#if (eq b.kind "amalgama")}}{{#unless p.amalgamOwned}}<p class="wod5e-mage-potere-blocco-riga"><em>{{localize "WOD5E_MAGE.Poteri.NonHai" sphere=p.amalgamLabel}}</em></p>{{/unless}}{{/if}}
                                    </div>
                                {{else}}
                                    <p class="wod5e-mage-potere-testo"><span class="wod5e-mage-potere-k">{{localize "WOD5E_MAGE.Poteri.CosaFa"}}</span><em>{{localize "WOD5E_MAGE.Poteri.CosaFaVuoto"}}</em></p>
                                {{/each}}
                                {{#if p.conAmalgama}}
                                    {{!-- L'Amalgama scritta a mano: piena se la Sfera ce l'hai, tratteggiata se no. --}}
                                    <div class="wod5e-mage-potere-con{{#unless p.amalgamOwned}} manca{{/unless}}"><span class="wod5e-mage-potere-k">{{localize "WOD5E_MAGE.Poteri.Con" sphere=p.amalgamLabel}}</span>{{p.amalgamText}}{{#unless p.amalgamOwned}} <em>{{localize "WOD5E_MAGE.Poteri.NonHai" sphere=p.amalgamLabel}}</em>{{/unless}}</div>
                                {{/if}}
                                {{#if p.flavor}}<p class="wod5e-mage-potere-flavor"><em>{{p.flavor}}</em></p>{{/if}}
                            {{/if}}
                            <div class="wod5e-mage-potere-fondo">
                                <button type="button" data-action="potereModifica" data-row="{{p.id}}" {{#if ../locked}}disabled{{/if}}><i class="fa-solid {{#if p.editing}}fa-check{{else}}fa-pen{{/if}}" aria-hidden="true"></i> {{#if p.editing}}{{localize "WOD5E_MAGE.Poteri.Fatto"}}{{else}}{{localize "WOD5E_MAGE.Poteri.Modifica"}}{{/if}}</button>
                                <button type="button" data-action="potereTogli" data-row="{{p.id}}" {{#if ../locked}}disabled{{/if}}><i class="fa-solid fa-trash" aria-hidden="true"></i> {{localize "WOD5E_MAGE.Poteri.Togli"}}</button>
                            </div>
                        </div>
                    </div>
                {{/each}}
            </div>
        </section>

        {{!-- Gli Ambiti: la tavola dei sette livelli, in una tendina a tutta larghezza. --}}
        <details class="wod5e-mage-riq wod5e-mage-riq-pagina wod5e-mage-riq-ambiti-tavola">
            <summary class="wod5e-mage-riq-title"><span>{{localize "WOD5E_MAGE.Scopes.TableTitle"}}</span><small class="wod5e-mage-riq-conto">{{localize "WOD5E_MAGE.Poteri.Tavola"}}</small><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
            {{> "modules/wod5e-mage/templates/actor/parts/scope-table.hbs"}}
        </details>
    </div>
</section>
