{{!-- Magick (16/9): l'Areté, le Sfere possedute e gli Ambiti, tutti
     cliccabili. L'Areté cliccato fa il tiro di Magick; la Sfera entra in
     catena e al sorvolo apre il cassetto dei suoi poteri (uno solo per
     lancio, porta con sé la Sfera); l'Ambito mostra dopo il nome il
     pallino del livello scelto con la sua lettura dalla tavola; in fondo
     alla riga il tastino della lettura (la «modalità»: Peso, Epicità,
     Danni…) e la freccia, che apre la tendina dei sette livelli, ognuno col
     suo pallino e la lettura (lo stesso numero lo toglie). La tendina si
     apre solo col clic. I pallini dell'Areté e delle Sfere restano quelli
     della scheda: cambiano il valore, non la catena. (Blue, 16/9 sera.) --}}
<section class="wod5e-mage-riq wod5e-mage-riq-magick">
    <header class="wod5e-mage-riq-title">
        {{#if creazioneReset}}{{> "modules/wod5e-mage/templates/actor/parts/reset-tasto.hbs" resetsById.spheres}}{{/if}}
        <span>{{localize "WOD5E_MAGE.Tabs.Magick"}}</span>
    </header>
    <div class="wod5e-mage-riq-body">
        {{!-- La riga dell'Areté: il nome è il tasto, i pallini il valore. --}}
        <div class="wod5e-mage-riga wod5e-mage-riga-arete{{#if tiro.magick}} scelta{{/if}}">
            <button type="button" class="wod5e-mage-riga-nome" data-action="tiroArete" title="{{localize 'WOD5E_MAGE.Tiro.AreteHint'}}" aria-pressed="{{tiro.magick}}">
                <img class="wod5e-mage-arete-sigillo" src="modules/wod5e-mage/assets/icons/ui/arete.svg" alt="" aria-hidden="true">
                <span>{{localize "WOD5E_MAGE.Arete.Label"}}</span>
            </button>
            <div class="wod5e-mage-arete-dots" role="group" aria-label="{{localize 'WOD5E_MAGE.Arete.Label'}}">
                {{#each arete.steps as |step|}}
                    <button type="button" class="wod5e-mage-arete-dot {{#if step.active}}active{{/if}}" data-action="areteChange" data-value="{{step.value}}" aria-label="{{step.value}}"></button>
                {{/each}}
            </div>
        </div>

        <span class="wod5e-mage-riq-occhiello">{{localize "WOD5E_MAGE.Tabs.Spheres"}}</span>
        <div class="wod5e-mage-sfere-lista">
            {{#each spheres as |sphere|}}
                {{!-- La riga della Sfera (Blue, 20/9 sera: cambio di direttiva): niente
                     pallini, «non servono più». Il sigillo, il conto dei poteri
                     conosciuti, il nome (il clic mette la Sfera nel lancio), e in
                     fondo la scelta del potere: una tendina a caselle, come un
                     menù, un potere solo per lancio (la casella scelta si spegne
                     con un altro clic; scegliere un potere porta con sé la Sfera). --}}
                <div class="wod5e-mage-riga wod5e-mage-riga-sfera{{#if sphere.chosen}} scelta{{/if}}{{#if sphere.family}} family{{/if}}{{#if sphere.poteri.length}} con-tendina{{/if}}">
                    <img class="wod5e-mage-riga-icona wod5e-mage-sfera-sigillo" src="{{sphere.icon}}" alt="">
                    <b class="wod5e-mage-sfera-conto{{#unless sphere.poteri.length}} vuoto{{/unless}}" title="{{localize 'WOD5E_MAGE.Stat.PoteriConosciuti'}}" data-tooltip="{{localize 'WOD5E_MAGE.Stat.PoteriConosciuti'}}">{{sphere.poteri.length}}</b>
                    <button type="button" class="wod5e-mage-riga-nome" data-action="tiroSphere" data-sphere="{{sphere.id}}" aria-pressed="{{sphere.chosen}}" title="{{localize 'WOD5E_MAGE.Tiro.SphereHint'}}">
                        <span>{{localize sphere.label}}</span>
                    </button>
                    {{#if sphere.poteri.length}}
                        <button type="button" class="wod5e-mage-sfera-potere{{#if sphere.potere}} pieno{{/if}}" data-action="cassettoToggle" title="{{localize 'WOD5E_MAGE.Tiro.PoteriHint'}}" aria-label="{{localize 'WOD5E_MAGE.Stat.PotereScegli'}}">
                            <span>{{#if sphere.potere}}{{sphere.potere.short}}{{else}}{{localize "WOD5E_MAGE.Stat.PotereScegli"}}{{/if}}</span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                        </button>
                        {{!-- La tendina a caselle: un potere per riga, la casella spuntata su quello scelto. --}}
                        <div class="wod5e-mage-cassetto wod5e-mage-cassetto-poteri" role="group" aria-label="{{localize 'WOD5E_MAGE.Stat.Poteri'}}">
                            {{#each sphere.poteri as |power|}}
                                <button type="button" class="wod5e-mage-potere-voce{{#if power.selected}} scelta{{/if}}{{#if power.placeholder}} segnaposto{{/if}}" role="checkbox" aria-checked="{{power.selected}}" data-action="tiroPower" data-power="{{power.id}}" title="{{#if power.text}}{{power.text}}{{else}}{{localize 'WOD5E_MAGE.Stat.PotereSegnaposto'}}{{/if}}">
                                    <i class="wod5e-mage-casella{{#if power.selected}} spuntata{{/if}}" aria-hidden="true"></i>
                                    <span>{{power.label}}</span>
                                </button>
                            {{/each}}
                        </div>
                    {{/if}}
                </div>
            {{else}}
                <p class="wod5e-mage-riq-vuoto">{{localize "WOD5E_MAGE.Spheres.Empty"}}</p>
            {{/each}}
        </div>

        <span class="wod5e-mage-riq-occhiello">{{localize "WOD5E_MAGE.Scopes.TableTitle"}}</span>
        <div class="wod5e-mage-ambiti-lista">
            {{#each scopeRows as |scope|}}
                {{!-- La riga (20/9, sera): la testa col nome (il chevron in oro se
                     l'Ambito ha più letture: il clic apre la tendina delle letture,
                     una pastiglia per lettura) e in fondo i sette pallini, della
                     misura e del colore di quelli delle Sfere (Blue: «in linea con
                     gli altri colori»), a riposo al 40%; chi ha più letture e non
                     ne ha ancora scelta una mostra al loro posto «Scegli la
                     lettura». Sul pallino il sorvolo dice il livello e la lettura,
                     il clic lo dichiara. Sotto, la pastiglia della lettura a
                     sinistra sotto il nome e, col livello, la sua lettura centrata
                     e in grassetto. --}}
                <div class="wod5e-mage-riga wod5e-mage-riga-ambito{{#if scope.multi}} con-tendina{{/if}}{{#if scope.level}} scelta{{/if}}">
                    <div class="wod5e-mage-riga-testa">
                        <i class="{{scope.faIcon}} wod5e-mage-riga-icona" aria-hidden="true"></i>
                        {{#if scope.multi}}
                            <button type="button" class="wod5e-mage-riga-nome wod5e-mage-riga-nome-ambito" data-action="cassettoToggle" title="{{localize 'WOD5E_MAGE.Tiro.ScopeModePick'}}" aria-label="{{scope.label}}: {{localize 'WOD5E_MAGE.Tiro.ScopeModePick'}}"><span>{{scope.label}}</span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button>
                        {{else}}
                            <span class="wod5e-mage-riga-nome wod5e-mage-riga-nome-fermo"><span>{{scope.label}}</span></span>
                        {{/if}}
                        {{#if scope.modeChosen}}
                            <span class="wod5e-mage-ambito-pallini" role="group" aria-label="{{scope.label}}">
                                {{#each scope.steps as |step|}}
                                    <button type="button" class="wod5e-mage-pallino-ambito{{#if step.lit}} lit{{/if}}" data-action="tiroScope" data-scope="{{scope.id}}" data-level="{{step.value}}" data-tooltip="{{step.value}} · {{step.reading}}" aria-pressed="{{step.active}}" aria-label="{{scope.label}} {{step.value}}: {{step.reading}}"></button>
                                {{/each}}
                            </span>
                        {{else}}
                            <button type="button" class="wod5e-mage-ambito-scegli" data-action="cassettoToggle" title="{{localize 'WOD5E_MAGE.Tiro.ScopeModePick'}}">{{localize "WOD5E_MAGE.Tiro.ScopeModeChoose"}}</button>
                        {{/if}}
                    </div>
                    {{#if scope.level}}
                        <div class="wod5e-mage-ambito-lettura" title="{{scope.reading}}">{{#if scope.multi}}<small class="wod5e-mage-ambito-tag">{{scope.modeLabel}}</small>{{/if}}<span>{{scope.reading}}</span></div>
                    {{else if scope.modeShown}}
                        <div class="wod5e-mage-ambito-lettura"><small class="wod5e-mage-ambito-tag">{{scope.modeLabel}}</small></div>
                    {{/if}}
                    {{#if scope.multi}}
                        {{!-- La tendina delle letture: una pastiglia per lettura, quella in uso accesa. --}}
                        <div class="wod5e-mage-cassetto wod5e-mage-cassetto-modi" role="group" aria-label="{{localize 'WOD5E_MAGE.Tiro.ScopeModePick'}}">
                            {{#each scope.modes as |mode|}}
                                <button type="button" class="wod5e-mage-pastiglia wod5e-mage-pastiglia-modo{{#if mode.selected}} scelta{{/if}}" data-action="scopeMode" data-scope="{{scope.id}}" data-mode="{{mode.id}}" aria-pressed="{{mode.selected}}">{{mode.label}}</button>
                            {{/each}}
                        </div>
                    {{/if}}
                </div>
            {{/each}}
        </div>
    </div>
</section>
