{{!-- Magick (16/9): l'Areté, le Sfere possedute e gli Ambiti, tutti
     cliccabili. L'Areté cliccato fa il tiro di Magick; la Sfera entra in
     catena e al sorvolo apre il cassetto dei suoi poteri (uno solo per
     lancio, porta con sé la Sfera); l'Ambito mostra dopo il nome il
     pallino del livello scelto con la sua lettura dalla tavola; in fondo
     alla riga il tastino della lettura (la «modalità»: Peso, Epicità,
     Danni…) e la freccia, che apre la tendina dei sette livelli, ognuno col
     suo pallino e la lettura (lo stesso numero lo toglie). La tendina si
     apre solo col clic. I pallini dell'Areté e delle Sfere restano quelli
     della scheda: cambiano il valore, non la catena. (Blue, 16/9 sera.) --}}
<section class="wod5e-mage-riq wod5e-mage-riq-magick">
    <header class="wod5e-mage-riq-title">
        {{#if creazioneReset}}{{> "modules/wod5e-mage/templates/actor/parts/reset-tasto.hbs" resetsById.spheres}}{{/if}}
        <span>{{localize "WOD5E_MAGE.Tabs.Magick"}}</span>
    </header>
    <div class="wod5e-mage-riq-body">
        {{!-- La riga dell'Areté: il nome è il tasto, i pallini il valore. --}}
        <div class="wod5e-mage-riga wod5e-mage-riga-arete{{#if tiro.magick}} scelta{{/if}}">
            <button type="button" class="wod5e-mage-riga-nome" data-action="tiroArete" title="{{localize 'WOD5E_MAGE.Tiro.AreteHint'}}" aria-pressed="{{tiro.magick}}">
                <img class="wod5e-mage-arete-sigillo" src="modules/wod5e-mage/assets/icons/ui/arete.svg" alt="" aria-hidden="true">
                <span>{{localize "WOD5E_MAGE.Arete.Label"}}</span>
            </button>
            <div class="wod5e-mage-arete-dots" role="group" aria-label="{{localize 'WOD5E_MAGE.Arete.Label'}}">
                {{#each arete.steps as |step|}}
                    <button type="button" class="wod5e-mage-arete-dot {{#if step.active}}active{{/if}}" data-action="areteChange" data-value="{{step.value}}" aria-label="{{step.value}}"></button>
                {{/each}}
            </div>
        </div>

        <span class="wod5e-mage-riq-occhiello">{{localize "WOD5E_MAGE.Tabs.Spheres"}}</span>
        <div class="wod5e-mage-sfere-lista">
            {{#each spheres as |sphere|}}
                <div class="wod5e-mage-riga wod5e-mage-riga-sfera{{#if sphere.chosen}} scelta{{/if}}{{#if sphere.family}} family{{/if}}{{#if sphere.poteri.length}} con-cassetto{{/if}}">
                    <button type="button" class="wod5e-mage-riga-nome" data-action="tiroSphere" data-sphere="{{sphere.id}}" aria-pressed="{{sphere.chosen}}" title="{{localize 'WOD5E_MAGE.Tiro.SphereHint'}}">
                        <img class="wod5e-mage-riga-icona wod5e-mage-sfera-sigillo" src="{{sphere.icon}}" alt="">
                        <span>{{localize sphere.label}}</span>
                    </button>
                    <div class="resource-value" data-value="{{sphere.value}}" data-name="flags.wod5e-mage.spheres.{{sphere.id}}">
                        <span class="resource-value-empty" data-action="dotCounterEmpty"></span>
                        {{#numLoop 5}}
                            <span class="resource-value-step" data-action="dotCounterChange" data-index="{{this}}" title="{{this}}"></span>
                        {{/numLoop}}
                    </div>
                    {{#if sphere.poteri.length}}
                        {{!-- Il cassetto dei poteri della Sfera: due per pallino, fino ai pallini che ha. --}}
                        <div class="wod5e-mage-cassetto wod5e-mage-cassetto-poteri" role="group" aria-label="{{localize 'WOD5E_MAGE.Stat.Poteri'}}" title="{{localize 'WOD5E_MAGE.Tiro.PoteriHint'}}">
                            {{#each sphere.poteri as |power|}}
                                <button type="button" class="wod5e-mage-pastiglia wod5e-mage-pastiglia-potere{{#if power.selected}} scelta{{/if}}{{#if power.placeholder}} segnaposto{{/if}}" data-action="tiroPower" data-power="{{power.id}}" aria-pressed="{{power.selected}}" title="{{#if power.text}}{{power.text}}{{else}}{{localize 'WOD5E_MAGE.Stat.PotereSegnaposto'}}{{/if}}">{{power.short}}</button>
                            {{/each}}
                        </div>
                    {{/if}}
                </div>
            {{else}}
                <p class="wod5e-mage-riq-vuoto">{{localize "WOD5E_MAGE.Spheres.Empty"}}</p>
            {{/each}}
        </div>

        <span class="wod5e-mage-riq-occhiello">{{localize "WOD5E_MAGE.Scopes.TableTitle"}}</span>
        <div class="wod5e-mage-ambiti-lista">
            {{#each scopeRows as |scope|}}
                {{!-- La riga: il nome intero, poi (se dichiarato) il pallino col
                     livello e la sua lettura subito dopo, non in fondo; in fondo
                     il tastino della lettura (Peso, Epicità, Danni…: solo chi ne
                     ha più d'una) e la freccia che apre la tendina. Niente
                     sorvolo: si apre solo col clic (Blue, 16/9 sera). --}}
                <div class="wod5e-mage-riga wod5e-mage-riga-ambito con-tendina{{#if scope.level}} scelta{{/if}}" title="{{localize 'WOD5E_MAGE.Tiro.ScopeHint'}}">
                    <span class="wod5e-mage-riga-nome wod5e-mage-riga-nome-fermo">
                        <i class="{{scope.faIcon}} wod5e-mage-riga-icona" aria-hidden="true"></i>
                        <span>{{scope.label}}</span>
                    </span>
                    {{#if scope.level}}
                        <span class="wod5e-mage-ambito-lettura" title="{{scope.reading}}">
                            <span class="wod5e-mage-pallino-ambito scelta">{{scope.level}}</span>
                            <span>{{scope.reading}}</span>
                        </span>
                    {{/if}}
                    <span class="wod5e-mage-riga-tastini">
                        {{#if scope.nextModeLabel}}
                            <button type="button" class="wod5e-mage-riga-modo" data-action="scopeMode" data-scope="{{scope.id}}" title="{{localize 'WOD5E_MAGE.Tiro.ScopeModeHint' mode=scope.modeLabel next=scope.nextModeLabel}}" aria-label="{{localize 'WOD5E_MAGE.Tiro.ScopeModeHint' mode=scope.modeLabel next=scope.nextModeLabel}}">{{scope.modeLabel}}</button>
                        {{/if}}
                        <button type="button" class="wod5e-mage-riga-tastino" data-action="cassettoToggle" title="{{localize 'WOD5E_MAGE.Tiro.ScopeOpen'}}" aria-label="{{localize 'WOD5E_MAGE.Tiro.ScopeOpen'}}"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button>
                    </span>
                    {{!-- La tendina: i sette pallini, ognuno con la sua lettura dopo il numero. --}}
                    <div class="wod5e-mage-cassetto wod5e-mage-cassetto-ambito" role="group" aria-label="{{scope.label}}">
                        {{#each scope.steps as |step|}}
                            <button type="button" class="wod5e-mage-livello{{#if step.active}} scelta{{/if}}{{#if step.lit}} lit{{/if}}" data-action="tiroScope" data-scope="{{scope.id}}" data-level="{{step.value}}" aria-pressed="{{step.active}}" aria-label="{{scope.label}} {{step.value}}" title="{{step.reading}}">
                                <span class="wod5e-mage-pallino-ambito">{{step.value}}</span>
                                <span class="wod5e-mage-livello-lettura">{{step.reading}}</span>
                            </button>
                        {{/each}}
                    </div>
                </div>
            {{/each}}
        </div>
    </div>
</section>
