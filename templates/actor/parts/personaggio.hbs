{{!-- Personaggio: chi è, i precetti, i punti di riferimento.
     Solo la colonna sinistra della linguetta features di sistema. --}}
<section class="tab {{tab.cssClass}} wod5e-mage-personaggio" data-tab="{{tab.id}}" data-group="{{tab.group}}">
    <div class="flexcol wod5e-mage-personaggio-layout">
        <section class="wod5e-mage-lineage-fields">
            <header class="resource-header">
                <label class="header-label">{{localize "WOD5E_MAGE.Lineage.Label"}}</label>
            </header>
            <div class="wod5e-mage-lineage-grid">
                <label>
                    <span>{{localize "WOD5E_MAGE.Lineage.Faction"}}</span>
                    <input type="text" name="flags.wod5e-mage.lineage.fazione" value="{{lineage.fazione}}" placeholder="{{localize 'WOD5E_MAGE.Lineage.FactionHint'}}"/>
                </label>
                <label>
                    <span>{{localize "WOD5E_MAGE.Lineage.Family"}}</span>
                    <input type="text" name="flags.wod5e-mage.lineage.famiglia" value="{{lineage.famiglia}}" placeholder="{{localize 'WOD5E_MAGE.Lineage.FamilyHint'}}"/>
                </label>
                <label>
                    <span>{{localize "WOD5E_MAGE.Lineage.Subfamily"}}</span>
                    <input type="text" name="flags.wod5e-mage.lineage.sottofamiglia" value="{{lineage.sottofamiglia}}" placeholder="{{localize 'WOD5E_MAGE.Lineage.SubfamilyHint'}}"/>
                </label>
            </div>
        </section>
        {{> "systems/wod5e/display/shared/actors/parts/core-details.hbs"}}
        {{> "systems/wod5e/display/shared/actors/parts/chronicle-tenets.hbs"}}
        {{> "systems/wod5e/display/shared/actors/parts/touchstones-convictions.hbs"}}
    </div>
</section>
