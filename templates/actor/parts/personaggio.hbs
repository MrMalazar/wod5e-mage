{{!-- La Bussola (Blue, 25/9 sera: «come la Magick in atto»; 26/9: via lo Stato):
     il titolo di pagina e le misure della pagina Magick, riquadri col titolo
     d'oro, carte scure, campi trasparenti con la riga d'oro sotto, etichette in
     oro maiuscolo a larghezza fissa così le caselle stanno in colonna. Su due
     colonne: a sinistra Concetto e Cronaca (con Ambizione e Desiderio e il loro
     «quando si attiva») e le Convinzioni; a destra le Ancore, che sono le carte
     più alte. Lo Stato non c'è più: la Saggezza ha il suo stato in prima pagina
     (Blue, 26/9). L'Appartenenza sta in testata. --}}
<section class="tab {{tab.cssClass}} wod5e-mage-personaggio" data-tab="{{tab.id}}" data-group="{{tab.group}}">
    <header class="wod5e-mage-section-title">
        {{!-- Il reset della Bussola (Ambizione, Desiderio, Convinzioni, Ancore), 11/9. --}}
        {{#if creazioneReset}}{{> "modules/wod5e-mage/templates/actor/parts/reset-tasto.hbs" resetsById.compass}}{{/if}}
        <span>{{localize "WOD5E_MAGE.Tabs.Short.personaggio"}}</span>
    </header>

    <div class="wod5e-mage-spheres-content wod5e-mage-personaggio-columns">
        <div class="wod5e-mage-personaggio-col wod5e-mage-personaggio-col-left">
            <section class="wod5e-mage-riq wod5e-mage-riq-pagina wod5e-mage-riq-bussola-identita">
                <header class="wod5e-mage-riq-title">
                    <span>{{localize "WOD5E_MAGE.Personaggio.IdentityLabel"}}</span>
                </header>
                <div class="wod5e-mage-riq-body">
                    <div class="wod5e-mage-bussola-carta">
                        <div class="wod5e-mage-bussola-campo">
                            <span>{{localize "WOD5E.BiographyList.Concept"}}</span>
                            <input type="text" name="system.headers.concept" value="{{concept}}" placeholder="{{localize 'WOD5E.BiographyList.Concept'}}" aria-label="{{localize 'WOD5E.BiographyList.Concept'}}" {{#if locked}}disabled{{/if}}>
                            <button type="button" class="wod5e-mage-riq-tasto-piccolo" data-action="archivioOpen" data-kind="concetto" title="{{localize 'WOD5E_MAGE.Archivi.Open'}}" aria-label="{{localize 'WOD5E_MAGE.Archivi.Open'}}"><i class="fa-solid fa-book-open" aria-hidden="true"></i></button>
                        </div>
                        <label class="wod5e-mage-bussola-campo">
                            <span>{{localize "WOD5E.BiographyList.Chronicle"}}</span>
                            <input type="text" name="system.headers.chronicle" value="{{chronicle}}" placeholder="{{localize 'WOD5E.BiographyList.Chronicle'}}" {{#if locked}}disabled{{/if}}>
                        </label>
                    </div>

                    {{!-- Ambizione e Desiderio: il nome e, sotto, quando si attiva.
                         Il libro apre l'archivio dei Cataloghi; il «+» dell'archivio accoda. --}}
                    <div class="wod5e-mage-bussola-carta">
                        <div class="wod5e-mage-bussola-campo">
                            <span>{{localize "WOD5E.BiographyList.Ambition"}}</span>
                            <input type="text" name="system.headers.ambition" value="{{ambition}}" placeholder="{{localize 'WOD5E.BiographyList.Ambition'}}" aria-label="{{localize 'WOD5E.BiographyList.Ambition'}}" {{#if locked}}disabled{{/if}}>
                            <button type="button" class="wod5e-mage-riq-tasto-piccolo" data-action="archivioOpen" data-kind="ambizione" title="{{localize 'WOD5E_MAGE.Archivi.Open'}}" aria-label="{{localize 'WOD5E_MAGE.Archivi.Open'}}"><i class="fa-solid fa-book-open" aria-hidden="true"></i></button>
                        </div>
                        <label class="wod5e-mage-bussola-campo">
                            <span>{{localize "WOD5E_MAGE.Personaggio.TriggerHint"}}</span>
                            <textarea name="flags.wod5e-mage.ambitionTrigger" rows="1" placeholder="{{localize 'WOD5E_MAGE.Personaggio.TriggerHint'}}" {{#if locked}}disabled{{/if}}>{{ambitionTrigger}}</textarea>
                        </label>
                    </div>
                    <div class="wod5e-mage-bussola-carta">
                        <div class="wod5e-mage-bussola-campo">
                            <span>{{localize "WOD5E.BiographyList.Desire"}}</span>
                            <input type="text" name="system.headers.desire" value="{{desire}}" placeholder="{{localize 'WOD5E.BiographyList.Desire'}}" aria-label="{{localize 'WOD5E.BiographyList.Desire'}}" {{#if locked}}disabled{{/if}}>
                            <button type="button" class="wod5e-mage-riq-tasto-piccolo" data-action="archivioOpen" data-kind="desiderio" title="{{localize 'WOD5E_MAGE.Archivi.Open'}}" aria-label="{{localize 'WOD5E_MAGE.Archivi.Open'}}"><i class="fa-solid fa-book-open" aria-hidden="true"></i></button>
                        </div>
                        <label class="wod5e-mage-bussola-campo">
                            <span>{{localize "WOD5E_MAGE.Personaggio.TriggerHint"}}</span>
                            <textarea name="flags.wod5e-mage.desireTrigger" rows="1" placeholder="{{localize 'WOD5E_MAGE.Personaggio.TriggerHint'}}" {{#if locked}}disabled{{/if}}>{{desireTrigger}}</textarea>
                        </label>
                    </div>
                </div>
            </section>

            {{!-- Ogni Convinzione è una carta (9/9): il gruppo (o il Credo) e il testo con il
                 cestino; sotto «La servi quando» e «La attraversi quando», con la descrizione. --}}
            <section class="wod5e-mage-riq wod5e-mage-riq-pagina wod5e-mage-riq-convinzioni">
                <header class="wod5e-mage-riq-title wod5e-mage-riq-title-tasti">
                    <span>{{localize "WOD5E_MAGE.Personaggio.ConvictionsLabel"}}</span>
                    <span class="wod5e-mage-riq-tasti">
                        <button type="button" class="wod5e-mage-riq-tasto-piccolo" data-action="archivioOpen" data-kind="convinzione" title="{{localize 'WOD5E_MAGE.Archivi.Open'}}" aria-label="{{localize 'WOD5E_MAGE.Archivi.Open'}}"><i class="fa-solid fa-book-open" aria-hidden="true"></i></button>
                        <button type="button" class="wod5e-mage-riq-tasto-piccolo" data-action="personaggioRowAdd" data-table="convinzioni" title="{{localize 'WOD5E_MAGE.Personaggio.ConvictionAdd'}}" aria-label="{{localize 'WOD5E_MAGE.Personaggio.ConvictionAdd'}}" {{#if locked}}disabled{{/if}}><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
                    </span>
                </header>
                <div class="wod5e-mage-riq-body">
                    {{#each convictions as |row|}}
                        <div class="wod5e-mage-bussola-carta wod5e-mage-conviction">
                            <div class="wod5e-mage-conviction-testa">
                                <select name="flags.wod5e-mage.convinzioni.{{row.id}}.group" aria-label="{{localize 'WOD5E_MAGE.Personaggio.ConvictionGroup'}}" {{#if ../locked}}disabled{{/if}}>
                                    <option value="">{{localize "WOD5E_MAGE.Personaggio.ConvictionGroupNone"}}</option>
                                    <optgroup label="{{localize 'WOD5E_MAGE.Personaggio.ConvictionGroupsCatalog'}}">
                                        {{#each row.groups as |group|}}
                                            <option value="{{group.id}}" {{#if group.selected}}selected{{/if}}>{{group.label}}</option>
                                        {{/each}}
                                    </optgroup>
                                    <optgroup label="{{localize 'WOD5E_MAGE.Personaggio.ConvictionGroupsCredi'}}">
                                        {{#each row.credos as |group|}}
                                            <option value="{{group.id}}" {{#if group.selected}}selected{{/if}}>{{group.label}}</option>
                                        {{/each}}
                                    </optgroup>
                                </select>
                                <input type="text" name="flags.wod5e-mage.convinzioni.{{row.id}}.text" value="{{row.text}}" placeholder="{{localize 'WOD5E_MAGE.Personaggio.ConvictionText'}}" aria-label="{{localize 'WOD5E_MAGE.Personaggio.ConvictionText'}}" {{#if ../locked}}disabled{{/if}}>
                                <button type="button" class="wod5e-mage-riq-tasto-piccolo" data-action="personaggioRowDelete" data-table="convinzioni" data-row="{{row.id}}" title="{{localize 'WOD5E_MAGE.Personaggio.ConvictionRemove'}}" aria-label="{{localize 'WOD5E_MAGE.Personaggio.ConvictionRemove'}}" {{#if ../locked}}disabled{{/if}}><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                            </div>
                            <div class="wod5e-mage-bussola-campi wod5e-mage-conviction-when">
                                <label class="wod5e-mage-bussola-campo largo">
                                    <span>{{localize "WOD5E_MAGE.Personaggio.ConvictionServe"}}</span>
                                    <textarea name="flags.wod5e-mage.convinzioni.{{row.id}}.serve" rows="1" placeholder="{{localize 'WOD5E_MAGE.Personaggio.ConvictionServeHint'}}" {{#if ../locked}}disabled{{/if}}>{{row.serve}}</textarea>
                                </label>
                                <label class="wod5e-mage-bussola-campo largo">
                                    <span>{{localize "WOD5E_MAGE.Personaggio.ConvictionCross"}}</span>
                                    <textarea name="flags.wod5e-mage.convinzioni.{{row.id}}.cross" rows="1" placeholder="{{localize 'WOD5E_MAGE.Personaggio.ConvictionCrossHint'}}" {{#if ../locked}}disabled{{/if}}>{{row.cross}}</textarea>
                                </label>
                            </div>
                        </div>
                    {{else}}
                        <p class="wod5e-mage-bussola-vuoto">{{localize "WOD5E_MAGE.Personaggio.ConvictionsEmpty"}}</p>
                    {{/each}}
                </div>
            </section>
        </div>

        <div class="wod5e-mage-personaggio-col wod5e-mage-personaggio-col-right">
            {{!-- Le Ancore a sette righe (25/9): una carta per Ancora. In testa il nome, il ruolo, il
                 mestiere, l'età, il dado che tira i campi vuoti e il cestino; sotto cosa ti dà e la
                 Convinzione legata, cosa non sa e dove morde; in coda le note. Nel titolo il libro
                 delle dodici montate, il dado che genera un'Ancora nuova, il + di una vuota. --}}
            <section class="wod5e-mage-riq wod5e-mage-riq-pagina wod5e-mage-riq-ancore">
                <header class="wod5e-mage-riq-title wod5e-mage-riq-title-tasti">
                    <span>{{localize "WOD5E_MAGE.Personaggio.AnchorsLabel"}}</span>
                    <span class="wod5e-mage-riq-tasti">
                        <button type="button" class="wod5e-mage-riq-tasto-piccolo" data-action="archivioOpen" data-kind="ancora" title="{{localize 'WOD5E_MAGE.Archivi.Open'}}" aria-label="{{localize 'WOD5E_MAGE.Archivi.Open'}}"><i class="fa-solid fa-book-open" aria-hidden="true"></i></button>
                        <button type="button" class="wod5e-mage-riq-tasto-piccolo wod5e-mage-ancora-genera" data-action="ancoraGenera" title="{{localize 'WOD5E_MAGE.Personaggio.AnchorGenerateNew'}}" aria-label="{{localize 'WOD5E_MAGE.Personaggio.AnchorGenerateNew'}}" {{#if locked}}disabled{{/if}}><i class="fa-solid fa-dice" aria-hidden="true"></i></button>
                        <button type="button" class="wod5e-mage-riq-tasto-piccolo" data-action="personaggioRowAdd" data-table="ancore" title="{{localize 'WOD5E_MAGE.Personaggio.AnchorAdd'}}" aria-label="{{localize 'WOD5E_MAGE.Personaggio.AnchorAdd'}}" {{#if locked}}disabled{{/if}}><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
                    </span>
                </header>
                <div class="wod5e-mage-riq-body">
                    {{#each anchors as |row|}}
                        <div class="wod5e-mage-bussola-carta wod5e-mage-ancora wod5e-mage-riga-apribile" data-row="{{row.id}}">
                            <div class="wod5e-mage-ancora-testa">
                                {{!-- La freccia (Blue, 26/9): apre e chiude le note dell'Ancora; la carta ricorda com'era. --}}
                                <button type="button" class="wod5e-mage-riq-tasto-piccolo wod5e-mage-ancora-apri" data-action="rigaApri" title="{{localize 'WOD5E_MAGE.Personaggio.AnchorNotesOpen'}}" aria-label="{{localize 'WOD5E_MAGE.Personaggio.AnchorNotesOpen'}}" aria-expanded="false"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button>
                                <input type="text" name="flags.wod5e-mage.ancore.{{row.id}}.name" value="{{row.name}}" placeholder="{{localize 'WOD5E_MAGE.Personaggio.AnchorName'}}" aria-label="{{localize 'WOD5E_MAGE.Personaggio.AnchorName'}}" {{#if ../locked}}disabled{{/if}}>
                                <select name="flags.wod5e-mage.ancore.{{row.id}}.role" aria-label="{{localize 'WOD5E_MAGE.Personaggio.AnchorRole'}}" {{#if ../locked}}disabled{{/if}}>
                                    <option value="">{{localize "WOD5E_MAGE.Personaggio.AnchorRole"}}</option>
                                    {{#each row.roles as |ruolo|}}
                                        <option value="{{ruolo.id}}" title="{{ruolo.definizione}}" {{#if ruolo.selected}}selected{{/if}}>{{ruolo.id}}</option>
                                    {{/each}}
                                </select>
                                <input type="text" name="flags.wod5e-mage.ancore.{{row.id}}.job" value="{{row.job}}" placeholder="{{localize 'WOD5E_MAGE.Personaggio.AnchorJob'}}" aria-label="{{localize 'WOD5E_MAGE.Personaggio.AnchorJob'}}" {{#if ../locked}}disabled{{/if}}>
                                <input type="text" class="wod5e-mage-ancora-eta" name="flags.wod5e-mage.ancore.{{row.id}}.age" value="{{row.age}}" placeholder="{{localize 'WOD5E_MAGE.Personaggio.AnchorAge'}}" aria-label="{{localize 'WOD5E_MAGE.Personaggio.AnchorAge'}}" inputmode="numeric" {{#if ../locked}}disabled{{/if}}>
                                <button type="button" class="wod5e-mage-riq-tasto-piccolo" data-action="ancoraGenera" data-row="{{row.id}}" title="{{localize 'WOD5E_MAGE.Personaggio.AnchorGenerateHint'}}" aria-label="{{localize 'WOD5E_MAGE.Personaggio.AnchorGenerate'}}" {{#if ../locked}}disabled{{/if}}><i class="fa-solid fa-dice" aria-hidden="true"></i></button>
                                <button type="button" class="wod5e-mage-riq-tasto-piccolo" data-action="personaggioRowDelete" data-table="ancore" data-row="{{row.id}}" title="{{localize 'WOD5E_MAGE.Personaggio.AnchorRemove'}}" aria-label="{{localize 'WOD5E_MAGE.Personaggio.AnchorRemove'}}" {{#if ../locked}}disabled{{/if}}><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                            </div>
                            <div class="wod5e-mage-bussola-campi">
                                <label class="wod5e-mage-bussola-campo"><span>{{localize "WOD5E_MAGE.Personaggio.AnchorGives"}}</span><input type="text" name="flags.wod5e-mage.ancore.{{row.id}}.gives" value="{{row.gives}}" {{#if ../locked}}disabled{{/if}}></label>
                                <label class="wod5e-mage-bussola-campo"><span>{{localize "WOD5E_MAGE.Personaggio.AnchorConviction"}}</span>
                                    <select name="flags.wod5e-mage.ancore.{{row.id}}.conviction" {{#if ../locked}}disabled{{/if}}>
                                        <option value="">{{localize "WOD5E_MAGE.Personaggio.AnchorConvictionNone"}}</option>
                                        {{#each row.convictions as |conv|}}
                                            <option value="{{conv.id}}" {{#if conv.selected}}selected{{/if}}>{{conv.text}}</option>
                                        {{/each}}
                                    </select>
                                </label>
                                <label class="wod5e-mage-bussola-campo"><span>{{localize "WOD5E_MAGE.Personaggio.AnchorUnknown"}}</span><input type="text" name="flags.wod5e-mage.ancore.{{row.id}}.unknown" value="{{row.unknown}}" {{#if ../locked}}disabled{{/if}}></label>
                                <label class="wod5e-mage-bussola-campo"><span>{{localize "WOD5E_MAGE.Personaggio.AnchorBites"}}</span><input type="text" name="flags.wod5e-mage.ancore.{{row.id}}.bites" value="{{row.bites}}" {{#if ../locked}}disabled{{/if}}></label>
                            </div>
                            {{!-- Le note (il vecchio campo «perché conta, e cosa non sa»): un campo come gli altri,
                                 dello stesso colore (Blue, 26/9: «non sembra importante»); chiuse due righe, aperte
                                 con la freccia hanno spazio (26/9 sera: «più spazio alle note») e crescono col testo. --}}
                            <label class="wod5e-mage-bussola-campo largo wod5e-mage-ancora-note">
                                <span>{{localize "WOD5E_MAGE.Personaggio.AnchorNotes"}}</span>
                                <textarea class="wod5e-mage-bussola-note" name="flags.wod5e-mage.ancore.{{row.id}}.description" rows="6" placeholder="{{localize 'WOD5E_MAGE.Personaggio.AnchorDescription'}}" aria-label="{{localize 'WOD5E_MAGE.Personaggio.AnchorNotes'}}" {{#if ../locked}}disabled{{/if}}>{{row.description}}</textarea>
                            </label>
                        </div>
                    {{else}}
                        <p class="wod5e-mage-bussola-vuoto">{{localize "WOD5E_MAGE.Personaggio.AnchorsEmpty"}}</p>
                    {{/each}}
                </div>
            </section>
        </div>
    </div>
</section>
