{{!-- Personaggio, nella gabbia a tendine della Sfida, su due colonne:
     a sinistra Concetto e Cronaca (con Ambizione e Desiderio descritti) e le
     Ancore; a destra la Saggezza e le Convinzioni. L'Appartenenza sta in testata. --}}
<section class="tab {{tab.cssClass}} wod5e-mage-personaggio" data-tab="{{tab.id}}" data-group="{{tab.group}}">
    <div class="wod5e-mage-concept-content wod5e-mage-personaggio-content">
        <div class="wod5e-mage-personaggio-columns">
            <div class="wod5e-mage-personaggio-col wod5e-mage-personaggio-col-left">
                <details class="wod5e-mage-concept-group" open>
                    <summary>
                        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                        <span>{{localize "WOD5E_MAGE.Personaggio.IdentityLabel"}}</span>
                    </summary>

                    <div class="wod5e-mage-identity-grid">
                        <label class="wod5e-mage-identity-field">
                            <span>{{localize "WOD5E.BiographyList.Concept"}} <button type="button" class="wod5e-mage-archivio-open" data-action="archivioOpen" data-kind="concetto" title="{{localize 'WOD5E_MAGE.Archivi.Open'}}" aria-label="{{localize 'WOD5E_MAGE.Archivi.Open'}}"><i class="fa-solid fa-book-open" aria-hidden="true"></i></button></span>
                            <input type="text" name="system.headers.concept" value="{{concept}}" placeholder="{{localize 'WOD5E.BiographyList.Concept'}}"/>
                        </label>
                        <label class="wod5e-mage-identity-field">
                            <span>{{localize "WOD5E.BiographyList.Chronicle"}}</span>
                            <input type="text" name="system.headers.chronicle" value="{{chronicle}}" placeholder="{{localize 'WOD5E.BiographyList.Chronicle'}}"/>
                        </label>
                    </div>

                    {{!-- Ambizione e Desiderio: il nome, e sotto quando si attiva.
                         Il libro apre l'archivio dei Cataloghi; il «+» dell'archivio accoda. --}}
                    <div class="wod5e-mage-identity-grid">
                        <div class="wod5e-mage-identity-field">
                            <span>{{localize "WOD5E.BiographyList.Ambition"}} <button type="button" class="wod5e-mage-archivio-open" data-action="archivioOpen" data-kind="ambizione" title="{{localize 'WOD5E_MAGE.Archivi.Open'}}" aria-label="{{localize 'WOD5E_MAGE.Archivi.Open'}}"><i class="fa-solid fa-book-open" aria-hidden="true"></i></button></span>
                            <input type="text" name="system.headers.ambition" value="{{ambition}}" placeholder="{{localize 'WOD5E.BiographyList.Ambition'}}"/>
                            <textarea name="flags.wod5e-mage.ambitionTrigger" rows="2" placeholder="{{localize 'WOD5E_MAGE.Personaggio.TriggerHint'}}" aria-label="{{localize 'WOD5E_MAGE.Personaggio.TriggerHint'}}" {{#if locked}}disabled{{/if}}>{{ambitionTrigger}}</textarea>
                        </div>
                        <div class="wod5e-mage-identity-field">
                            <span>{{localize "WOD5E.BiographyList.Desire"}} <button type="button" class="wod5e-mage-archivio-open" data-action="archivioOpen" data-kind="desiderio" title="{{localize 'WOD5E_MAGE.Archivi.Open'}}" aria-label="{{localize 'WOD5E_MAGE.Archivi.Open'}}"><i class="fa-solid fa-book-open" aria-hidden="true"></i></button></span>
                            <input type="text" name="system.headers.desire" value="{{desire}}" placeholder="{{localize 'WOD5E.BiographyList.Desire'}}"/>
                            <textarea name="flags.wod5e-mage.desireTrigger" rows="2" placeholder="{{localize 'WOD5E_MAGE.Personaggio.TriggerHint'}}" aria-label="{{localize 'WOD5E_MAGE.Personaggio.TriggerHint'}}" {{#if locked}}disabled{{/if}}>{{desireTrigger}}</textarea>
                        </div>
                    </div>
                </details>

                <details class="wod5e-mage-concept-group" open>
                    <summary>
                        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                        <span>{{localize "WOD5E_MAGE.Personaggio.AnchorsLabel"}}</span>
                    </summary>

                    <div class="wod5e-mage-row-head">
                        <button type="button" class="wod5e-mage-archivio-open" data-action="archivioOpen" data-kind="ancora" title="{{localize 'WOD5E_MAGE.Archivi.Open'}}" aria-label="{{localize 'WOD5E_MAGE.Archivi.Open'}}"><i class="fa-solid fa-book-open" aria-hidden="true"></i></button>
                        <button type="button" class="wod5e-mage-row-add" data-action="personaggioRowAdd" data-table="ancore" title="{{localize 'WOD5E_MAGE.Personaggio.AnchorAdd'}}" aria-label="{{localize 'WOD5E_MAGE.Personaggio.AnchorAdd'}}" {{#if locked}}disabled{{/if}}>
                            <i class="fa-solid fa-plus"></i>
                        </button>
                    </div>

                    {{#if anchors.length}}
                    <div class="wod5e-mage-anchor-grid">
                        <span>{{localize "WOD5E_MAGE.Personaggio.AnchorName"}}</span>
                        <span>{{localize "WOD5E_MAGE.Personaggio.AnchorDescription"}}</span>
                        <span aria-hidden="true"></span>

                        {{#each anchors as |row|}}
                            <textarea rows="2" class="wod5e-mage-mini-textarea" name="flags.wod5e-mage.ancore.{{row.id}}.name" aria-label="{{localize 'WOD5E_MAGE.Personaggio.AnchorName'}}" {{#if ../locked}}disabled{{/if}}>{{row.name}}</textarea>
                            <textarea rows="2" class="wod5e-mage-mini-textarea" name="flags.wod5e-mage.ancore.{{row.id}}.description" aria-label="{{localize 'WOD5E_MAGE.Personaggio.AnchorDescription'}}" {{#if ../locked}}disabled{{/if}}>{{row.description}}</textarea>
                            <button type="button" data-action="personaggioRowDelete" data-table="ancore" data-row="{{row.id}}" title="{{localize 'WOD5E_MAGE.Personaggio.AnchorRemove'}}" aria-label="{{localize 'WOD5E_MAGE.Personaggio.AnchorRemove'}}" {{#if ../locked}}disabled{{/if}}>
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        {{/each}}
                    </div>
                    {{else}}
                        <p class="wod5e-mage-row-empty">{{localize "WOD5E_MAGE.Personaggio.AnchorsEmpty"}}</p>
                    {{/if}}
                </details>
            </div>

            <div class="wod5e-mage-personaggio-col wod5e-mage-personaggio-col-right">
                {{!-- In cima al Personaggio: la Saggezza e, sotto, le Convinzioni (4/9 notte). --}}
                <div class="wod5e-mage-focus-wisdom">
                    {{> "modules/wod5e-mage/templates/actor/parts/wisdom.hbs"}}
                </div>

                <details class="wod5e-mage-concept-group" open>
                    <summary>
                        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                        <span>{{localize "WOD5E_MAGE.Personaggio.ConvictionsLabel"}}</span>
                    </summary>

                    <div class="wod5e-mage-row-head">
                        <button type="button" class="wod5e-mage-archivio-open" data-action="archivioOpen" data-kind="convinzione" title="{{localize 'WOD5E_MAGE.Archivi.Open'}}" aria-label="{{localize 'WOD5E_MAGE.Archivi.Open'}}"><i class="fa-solid fa-book-open" aria-hidden="true"></i></button>
                        <button type="button" class="wod5e-mage-row-add" data-action="personaggioRowAdd" data-table="convinzioni" title="{{localize 'WOD5E_MAGE.Personaggio.ConvictionAdd'}}" aria-label="{{localize 'WOD5E_MAGE.Personaggio.ConvictionAdd'}}" {{#if locked}}disabled{{/if}}>
                            <i class="fa-solid fa-plus"></i>
                        </button>
                    </div>

                    {{#if convictions.length}}
                    <div class="wod5e-mage-conviction-list">
                        {{!-- Ogni Convinzione: gruppo (o Credo) e testo, e sotto i due momenti,
                             «La servi quando» e «La attraversi quando» (arrivano dall'archivio). --}}
                        {{#each convictions as |row|}}
                            <div class="wod5e-mage-conviction">
                                <div class="wod5e-mage-conviction-grid">
                                    <select name="flags.wod5e-mage.convinzioni.{{row.id}}.group" aria-label="{{localize 'WOD5E_MAGE.Personaggio.ConvictionGroup'}}" {{#if ../locked}}disabled{{/if}}>
                                        <option value="">{{localize "WOD5E_MAGE.Personaggio.ConvictionGroupNone"}}</option>
                                        <optgroup label="{{localize 'WOD5E_MAGE.Personaggio.ConvictionGroupsCatalog'}}">
                                            {{#each row.groups as |group|}}
                                                <option value="{{group.id}}" {{#if group.selected}}selected{{/if}}>{{group.label}}</option>
                                            {{/each}}
                                        </optgroup>
                                        <optgroup label="{{localize 'WOD5E_MAGE.Personaggio.ConvictionGroupsCredi'}}">
                                            {{#each row.credos as |group|}}
                                                <option value="{{group.id}}" {{#if group.selected}}selected{{/if}}>{{group.label}}</option>
                                            {{/each}}
                                        </optgroup>
                                    </select>
                                    <input type="text" name="flags.wod5e-mage.convinzioni.{{row.id}}.text" value="{{row.text}}" placeholder="{{localize 'WOD5E_MAGE.Personaggio.ConvictionText'}}" aria-label="{{localize 'WOD5E_MAGE.Personaggio.ConvictionText'}}" {{#if ../locked}}disabled{{/if}}>
                                    <button type="button" data-action="personaggioRowDelete" data-table="convinzioni" data-row="{{row.id}}" title="{{localize 'WOD5E_MAGE.Personaggio.ConvictionRemove'}}" aria-label="{{localize 'WOD5E_MAGE.Personaggio.ConvictionRemove'}}" {{#if ../locked}}disabled{{/if}}>
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                                <div class="wod5e-mage-conviction-when">
                                    <label>
                                        <span>{{localize "WOD5E_MAGE.Personaggio.ConvictionServe"}}</span>
                                        <textarea class="wod5e-mage-mini-textarea" name="flags.wod5e-mage.convinzioni.{{row.id}}.serve" rows="2" placeholder="{{localize 'WOD5E_MAGE.Personaggio.ConvictionServeHint'}}" {{#if ../locked}}disabled{{/if}}>{{row.serve}}</textarea>
                                    </label>
                                    <label>
                                        <span>{{localize "WOD5E_MAGE.Personaggio.ConvictionCross"}}</span>
                                        <textarea class="wod5e-mage-mini-textarea" name="flags.wod5e-mage.convinzioni.{{row.id}}.cross" rows="2" placeholder="{{localize 'WOD5E_MAGE.Personaggio.ConvictionCrossHint'}}" {{#if ../locked}}disabled{{/if}}>{{row.cross}}</textarea>
                                    </label>
                                </div>
                            </div>
                        {{/each}}
                    </div>
                    {{else}}
                        <p class="wod5e-mage-row-empty">{{localize "WOD5E_MAGE.Personaggio.ConvictionsEmpty"}}</p>
                    {{/if}}
                </details>
            </div>
        </div>
    </div>
</section>
