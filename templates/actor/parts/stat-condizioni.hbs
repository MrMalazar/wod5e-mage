{{!-- Le Condizioni addosso (20/9; la regola di base del 29/9), in fondo alle
     Risorse sotto la Ruota. In testa l'occhiello col più, che apre la scelta:
     le quattro famiglie (Sensi, Corpo, Mente, Soprannaturale), ognuna con la
     sua icona e le sue scale, una riga per scala coi gradi in numeri romani;
     poi i lievi del corpo e della mente, poi lo scontro. Un clic accende, un
     altro spegne, e su una scala si sta a un gradino solo. La lente cerca
     quelle fuori lista. Sotto, una riga per Condizione accesa: l'icona della
     famiglia col grado (un clic spegne), il nome (un clic apre e chiude la
     spiegazione: la scala, com'è e cosa fa), il peso. Da vuota la sezione è
     la sola riga del titolo. --}}
<div class="wod5e-mage-condizioni-box">
    <span class="wod5e-mage-riq-occhiello wod5e-mage-condizioni-occhiello">{{localize "WOD5E.ItemsList.Conditions"}}</span>
    <details class="wod5e-mage-condizioni-drawer">
        <summary title="{{localize 'WOD5E_MAGE.Condizioni.AddHint'}}" aria-label="{{localize 'WOD5E_MAGE.Condizioni.AddHint'}}">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
        </summary>
        <div class="wod5e-mage-condizioni">
            {{#each condizioni as |sezione|}}
                <div class="wod5e-mage-cond-sezione sezione-{{sezione.id}}">
                    <span class="wod5e-mage-cond-sezione-nome">{{#if sezione.icon}}<span class="wod5e-mage-cond-icona"><i style="-webkit-mask-image: url({{sezione.icon}}); mask-image: url({{sezione.icon}})"></i></span>{{/if}}{{sezione.label}}</span>
                    {{#each sezione.scale as |scala|}}
                        <div class="wod5e-mage-cond-scala">
                            {{#if scala.label}}<span class="wod5e-mage-cond-scala-nome">{{scala.label}}</span>{{/if}}
                            <span class="wod5e-mage-cond-voci">
                                {{#each scala.voci as |entry|}}
                                    <button type="button" class="wod5e-mage-cond-voce{{#if entry.active}} lit{{/if}}{{#if entry.suppressed}} suppressed{{/if}}" data-action="condizioneToggle" data-condizione="{{entry.id}}" title="{{entry.title}}" aria-pressed="{{entry.active}}">{{#if entry.numeral}}<b class="wod5e-mage-cond-grado">{{entry.numeral}}</b>{{/if}}<span>{{entry.name}}</span></button>
                                {{/each}}
                            </span>
                        </div>
                    {{/each}}
                </div>
            {{/each}}
            <a class="item-control search-data-item wod5e-mage-condizioni-search" data-action="searchItem" title="{{localize 'WOD5E.Search'}}" data-type="condition">
                <i class="fa-solid fa-magnifying-glass"></i> <span>{{localize "WOD5E_MAGE.Condizioni.SearchHint"}}</span>
            </a>
        </div>
    </details>
    {{#each condizioniRows as |row|}}
        <div class="wod5e-mage-condizione-riga{{#if row.suppressed}} suppressed{{/if}}{{#if row.weight}} peso-{{row.weight}}{{/if}}">
            <div class="wod5e-mage-condizione-testa">
                <button type="button" class="wod5e-mage-condizione-spegni" data-action="condizioneToggle" data-condizione="{{row.condizione}}" data-item-id="{{row.id}}" title="{{localize 'WOD5E_MAGE.Condizioni.OffHint'}}" aria-label="{{localize 'WOD5E_MAGE.Condizioni.OffHint'}}">
                    {{#if row.list}}<span class="wod5e-mage-cond-icona"><i style="-webkit-mask-image: url({{row.img}}); mask-image: url({{row.img}})"></i>{{#if row.numeral}}<b>{{row.numeral}}</b>{{/if}}</span>{{else}}<img src="{{row.img}}" alt="">{{/if}}
                </button>
                <button type="button" class="wod5e-mage-condizione-nome" data-action="condizioneApri" title="{{localize 'WOD5E_MAGE.Condizioni.OpenHint'}}" aria-expanded="false">
                    <span>{{row.name}}</span>
                    <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                </button>
                {{#if row.dice}}<b class="wod5e-mage-condizione-dadi">{{row.dice}}</b>{{/if}}
            </div>
            {{#if row.what}}
                <div class="wod5e-mage-condizione-spiega">
                    {{#if row.scale}}<small>{{row.scale}}{{#if row.numeral}} {{row.numeral}}{{/if}}</small>{{/if}}<em>{{row.what}}</em>{{#if row.effect}}<span>{{row.effect}}</span>{{/if}}
                </div>
            {{else if row.effect}}
                <div class="wod5e-mage-condizione-spiega">{{#if row.scale}}<small>{{row.scale}}{{#if row.numeral}} {{row.numeral}}{{/if}}</small>{{/if}}<span>{{row.effect}}</span></div>
            {{/if}}
        </div>
    {{/each}}
</div>
