{{!-- Le Condizioni addosso (20/9), in fondo alle Risorse sotto la Ruota.
     In testa l'occhiello col più, che apre la scelta: la tendina con tutte
     le venticinque per gruppo (i simboli veri sono ancora allo studio: qui
     stanno le immagini degli oggetti, segnaposto) e la lente per quelle
     fuori lista. Sotto, una riga per Condizione accesa: il simbolo (un clic
     spegne), il nome (un clic apre e chiude la spiegazione: cos'è e cosa
     fa, dalla voce), i dadi che toglie. Da vuota la sezione è la sola riga
     del titolo. --}}
<div class="wod5e-mage-condizioni-box">
    <span class="wod5e-mage-riq-occhiello wod5e-mage-condizioni-occhiello">{{localize "WOD5E.ItemsList.Conditions"}}</span>
    <details class="wod5e-mage-condizioni-drawer">
        <summary title="{{localize 'WOD5E_MAGE.Condizioni.AddHint'}}" aria-label="{{localize 'WOD5E_MAGE.Condizioni.AddHint'}}">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
        </summary>
        <div class="wod5e-mage-condizioni">
            {{#each condizioni as |group|}}
                <div class="wod5e-mage-condizioni-group">
                    <span class="wod5e-mage-condizioni-title">{{group.group}}</span>
                    <div class="wod5e-mage-condizioni-row">
                        {{#each group.entries as |entry|}}
                            <button type="button" class="wod5e-mage-condizione{{#if entry.active}} lit{{/if}}{{#if entry.suppressed}} suppressed{{/if}}" data-action="condizioneToggle" data-condizione="{{entry.id}}" title="{{entry.title}}" aria-label="{{entry.name}}">
                                <span class="wod5e-mage-condizione-glyph">
                                    <img src="{{entry.icon}}" alt="">
                                    {{#if entry.dice}}<small>{{entry.dice}}</small>{{/if}}
                                </span>
                                <span class="wod5e-mage-condizione-name">{{entry.name}}</span>
                            </button>
                        {{/each}}
                    </div>
                </div>
            {{/each}}
            <a class="item-control search-data-item wod5e-mage-condizioni-search" data-action="searchItem" title="{{localize 'WOD5E.Search'}}" data-type="condition">
                <i class="fa-solid fa-magnifying-glass"></i> <span>{{localize "WOD5E_MAGE.Condizioni.SearchHint"}}</span>
            </a>
        </div>
    </details>
    {{#each condizioniRows as |row|}}
        <div class="wod5e-mage-condizione-riga{{#if row.suppressed}} suppressed{{/if}}">
            <div class="wod5e-mage-condizione-testa">
                <button type="button" class="wod5e-mage-condizione-spegni" data-action="condizioneToggle" data-condizione="{{row.condizione}}" data-item-id="{{row.id}}" title="{{localize 'WOD5E_MAGE.Condizioni.OffHint'}}" aria-label="{{localize 'WOD5E_MAGE.Condizioni.OffHint'}}">
                    <img src="{{row.img}}" alt="">
                </button>
                <button type="button" class="wod5e-mage-condizione-nome" data-action="condizioneApri" title="{{localize 'WOD5E_MAGE.Condizioni.OpenHint'}}" aria-expanded="false">
                    <span>{{row.name}}</span>
                    <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                </button>
                {{#if row.dice}}<b class="wod5e-mage-condizione-dadi">{{row.dice}}</b>{{/if}}
            </div>
            {{#if row.what}}
                <div class="wod5e-mage-condizione-spiega">
                    <em>{{row.what}}</em>{{#if row.effect}}<span>{{row.effect}}</span>{{/if}}
                </div>
            {{else if row.effect}}
                <div class="wod5e-mage-condizione-spiega"><span>{{row.effect}}</span></div>
            {{/if}}
        </div>
    {{/each}}
</div>
