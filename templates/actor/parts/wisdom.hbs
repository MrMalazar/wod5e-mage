{{!-- La Saggezza nella pagina del Personaggio: il nome centrato sopra la
     fila, le caselle d'inchiostro come nella prima pagina (23/9), il meno e
     il più delle caselle in più ai lati, il d10 tira. --}}
<div class="flexcol field-section wod5e-mage-wisdom">
    <div class="flexcol">
        <label class="field-header flexrow resource-label wod5e-mage-wisdom-head">
            <i class="fas fa-minus resource-control resource-minus" data-action="wisdomResourceChange" data-resource-action="minus" title="{{localize 'WOD5E_MAGE.Wisdom.MaxMeno'}}"></i>
            <label for="wisdom" class="system-rollable wisdom-roll" data-action="wisdomRoll" title="{{localize 'WOD5E_MAGE.Wisdom.Roll'}}">
                {{localize "WOD5E_MAGE.Wisdom.Label"}}
                <i class="fa-solid fa-dice-d10"></i>
            </label>
            {{!-- Il numero delle caselle: il clic sceglie fra Carisma e Fermezza (23/9). --}}
            <button type="button" class="wod5e-mage-valore-tasto wod5e-mage-wisdom-max" data-action="wisdomAttributePick" title="{{localize 'WOD5E_MAGE.Wisdom.AttributeHint' attribute=(localize (concat 'WOD5E.AttributesList.' wisdom.attributeLabel)) value=wisdom.attributeValue extra=wisdom.extra}}" aria-label="{{localize 'WOD5E_MAGE.Wisdom.AttributePick'}}">{{wisdom.max}}</button>
            <i class="fas fa-plus resource-control resource-plus" data-action="wisdomResourceChange" data-resource-action="plus" title="{{localize 'WOD5E_MAGE.Wisdom.MaxPiu'}}"></i>
        </label>
    </div>
    <div class="resource flex-group-center wisdom">
        <div class="resource-content flexrow flex-center flex-between">
            <div class="wod5e-mage-inchiostro-fila" role="group" aria-label="{{localize 'WOD5E_MAGE.Wisdom.Label'}}" title="{{localize 'WOD5E_MAGE.Wisdom.ClickHint'}}">
                {{#each wisdom.cells as |cell|}}
                    <button type="button" class="wod5e-mage-inchiostro-cella" data-state="{{cell.state}}" data-action="wisdomCellChange" data-index="{{cell.index}}" aria-label="{{localize cell.label}}"></button>
                {{/each}}
            </div>
        </div>
    </div>

    {{#if wisdom.segnato}}
        {{!-- La fila piena ha un nome (04_95), e i suoi quattro effetti. --}}
        <p class="wod5e-mage-wisdom-segnato">
            <strong>{{localize "WOD5E_MAGE.Wisdom.Segnato"}}</strong> ·
            {{localize "WOD5E_MAGE.Wisdom.SegnatoEffects"}}
        </p>
    {{/if}}
</div>
