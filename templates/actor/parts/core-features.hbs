{{!-- I Vantaggi (21/9, dal mock docs/mock_tre_pagine_21-9.html): un occhiello
     per Background, Pregi e Difetti coi tre tastini (il libro dell'archivio
     M6, la lente del compendio, il + che crea da zero); la riga del tratto con
     l'immagine dell'oggetto o la lettera nel disco (il clic manda in chat), il nome che apre la
     descrizione, i cinque pallini, la matita e il cestino, e in coda (Blue,
     24/9 sera) la casella dei dettagli, da scrivere senza aprire niente: dov'è
     il Rifugio, cos'è, di chi sono i Contatti. Sta nel flag dell'oggetto
     (flags.wod5e-mage.dettagli) e si salva al cambio. Le azioni sono
     quelle del sistema wod5e (5.3.x): itemChat, createItem, searchItem,
     itemEdit (la matita del modulo), itemDelete, dotCounterChange sugli
     oggetti, expendItemUse e restoreItemUses. --}}
{{#each features as |feature key|}}
    <span class="wod5e-mage-riq-occhiello wod5e-mage-occhiello-tasti">
        {{!-- I nomi di casa (23/9 sera): il sistema traduce «merit» con Vantaggi, qui sono Pregi. --}}
        <span>{{localize (concat "WOD5E_MAGE.Stat.Schede." key)}}</span>
        <span class="wod5e-mage-occhiello-tastini">
            {{!-- L'archivio dei Cataloghi M6 (Pregi, Difetti, Background): il libro, distinto dal + che crea da zero. --}}
            {{#unless (eq key "boon")}}
            <a class="item-control wod5e-mage-riga-tastino wod5e-mage-archivio-open" data-action="archivioOpen" data-subtype="{{key}}" title="{{localize 'WOD5E_MAGE.Archivi.Open'}}"><i class="fa-solid fa-book-open" aria-hidden="true"></i></a>
            {{/unless}}
            <a class="item-control wod5e-mage-riga-tastino search-data-item" data-action="searchItem" title="{{localize 'WOD5E.Search'}}" data-type="feature" data-subtype="{{key}}"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></a>
            <a class="item-control wod5e-mage-riga-tastino item-create" data-action="createItem" title="{{localize 'WOD5E.Add'}}" data-type="feature" data-subtype="{{key}}"><i class="fas fa-plus" aria-hidden="true"></i></a>
        </span>
    </span>
    {{#each feature as |item|}}
        <div class="wod5e-mage-riga wod5e-mage-riga-apribile wod5e-mage-riga-oggetto wod5e-mage-riga-vantaggio tipo-{{key}}" data-drag="true" data-item-id="{{item.id}}" data-document-uuid="{{item.uuid}}" data-type="Item">
            <div class="wod5e-mage-riga-testa wod5e-mage-oggetto-testa">
                {{!-- L'immagine dell'oggetto (il Rifugio ha la sua, 23/9); la lettera nel disco solo col segnaposto. Il clic manda in chat. --}}
                {{#if (mageIconaPropria item.img)}}
                    <a class="wod5e-mage-oggetto-icona clickable" data-action="itemChat" data-item-id="{{item._id}}" title="{{localize 'WOD5E.ItemsList.ShowToChat'}}"><img src="{{item.img}}" alt=""></a>
                {{else}}
                    <a class="wod5e-mage-lettera clickable" data-action="itemChat" data-item-id="{{item._id}}" title="{{localize 'WOD5E.ItemsList.ShowToChat'}}">{{localize (concat 'WOD5E_MAGE.Tratti.Lettera.' key)}}</a>
                {{/if}}
                <button type="button" class="wod5e-mage-riga-nome wod5e-mage-riga-nome-apri" data-action="rigaApri" title="{{localize 'WOD5E_MAGE.Tratti.Apri'}}" aria-expanded="false"><span>{{item.name}}</span>{{#if item.system.enrichedDescription}}<i class="fa-solid fa-chevron-down" aria-hidden="true"></i>{{/if}}</button>
                {{#if item.system.uses.enabled}}
                    <small class="wod5e-mage-oggetto-tag">{{item.system.uses.current}} / {{item.system.uses.max}}</small>
                {{/if}}
                {{#ifnoteq item.system.featuretype 'boon'}}
                    <div class="resource-value wod5e-mage-oggetto-pallini" data-value="{{item.system.points}}" data-name="items.{{item._id}}">
                        <span class="resource-value-empty" data-action="dotCounterEmpty"></span>
                        {{#numLoop 5}}
                            <span class="resource-value-step" data-action="dotCounterChange" data-index="{{this}}"></span>
                        {{/numLoop}}
                    </div>
                {{/ifnoteq}}
                <div class="wod5e-mage-riga-tastini">
                    {{#if item.system.uses.enabled}}
                        <a class="item-control wod5e-mage-riga-tastino item-use" data-action="expendItemUse" data-item-id="{{item._id}}" title="{{localize 'WOD5E.ItemsList.ExpendUse'}}"><i class="fa-solid fa-angle-down" aria-hidden="true"></i></a>
                        <a class="item-control wod5e-mage-riga-tastino item-restore" data-action="restoreItemUses" data-item-id="{{item._id}}" title="{{localize 'WOD5E.ItemsList.ResetUses'}}"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></a>
                    {{/if}}
                    <a class="item-control item-edit wod5e-mage-riga-tastino" data-action="itemEdit" data-item-id="{{item._id}}" title="{{localize 'WOD5E.Edit'}}"><i class="fas fa-edit" aria-hidden="true"></i></a>
                    <a class="item-control item-delete wod5e-mage-riga-tastino" data-action="itemDelete" data-item-id="{{item._id}}" title="{{localize 'WOD5E.Delete'}}"><i class="fas fa-trash" aria-hidden="true"></i></a>
                </div>
                {{!-- I dettagli in riga: senza name, così il modulo li scrive sull'oggetto e non sul personaggio. --}}
                <input type="text" class="wod5e-mage-oggetto-dettagli" data-item-id="{{item._id}}" data-item-field="flags.wod5e-mage.dettagli" value="{{item.flags.[wod5e-mage].dettagli}}" placeholder="{{localize (concat 'WOD5E_MAGE.Tratti.Dettagli.' key)}}" aria-label="{{item.name}}: {{localize 'WOD5E_MAGE.Tratti.DettagliLabel'}}" title="{{localize 'WOD5E_MAGE.Tratti.DettagliHint'}}" {{#if @root.locked}}disabled{{/if}}>
            </div>
            <div class="wod5e-mage-riga-spiega wod5e-mage-oggetto-spiega">
                {{#if item.system.enrichedDescription}}{{{item.system.enrichedDescription}}}{{else}}<p class="wod5e-mage-riq-vuoto">{{localize "WOD5E_MAGE.Tratti.SenzaTesto"}}</p>{{/if}}
            </div>
        </div>
    {{else}}
        <p class="wod5e-mage-riq-vuoto">{{localize (concat 'WOD5E_MAGE.Tratti.Vuoto.' key)}}</p>
    {{/each}}
{{/each}}
