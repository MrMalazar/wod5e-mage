{{!-- Tratti (16/9; 23/9; 25/9): al posto della parola Tratti, in testa, un menù a
     schede, le sei di Blue: Tratti (Background, Pregi e Difetti insieme),
     Equipaggiamento, Poteri attivi, Poteri passivi, Altro, Grimorio; sotto la
     cerca, poi le righe della scheda scelta, in ordine di nome. Ogni tratto si
     mette nel tiro con un clic, anche più d'uno; a destra il bonus scritto
     sull'oggetto, se ce l'ha. I poteri stanno con il testo dell'effetto sotto
     il nome (per ricordare quali passivi si hanno e quali attivi si possono
     fare); il clic sceglie il potere per il tiro come la tendina del Tiro. Un
     incantesimo cliccato si carica nel compositore com'è scritto e i tre
     tasti del Tiro tirano; un altro clic lo toglie. Il libro accanto alla
     cerca, sulla scheda del Grimorio, apre la pagina dove gli incantesimi si
     scrivono. Le schede sono i filtri di specie (`data-filters`): la scelta
     resta nella scheda attraverso i render. Niente righe di vuoto (25/9). --}}
<section class="wod5e-mage-riq wod5e-mage-riq-tratti" data-scheda="{{trattiScheda}}">
    <header class="wod5e-mage-riq-title wod5e-mage-riq-schede{{#if memo.on}} memo-{{memo.boxes.tratti.state}}{{/if}}" role="tablist" aria-label="{{localize 'WOD5E_MAGE.Stat.Tratti'}}">
        <div class="wod5e-mage-schede" role="group" data-filters="tratti">
            {{#each traitKinds as |kind|}}
                <button type="button" class="wod5e-mage-filtro wod5e-mage-scheda{{#if kind.active}} active{{/if}}" role="tab" data-kind="{{kind.id}}" aria-selected="{{kind.active}}" title="{{kind.label}}">{{kind.short}}</button>
            {{/each}}
        </div>
        {{#if memo.on}}
            {{!-- Col memo di creazione acceso (23/9): Vantaggi (Background e Pregi insieme) e Difetti, col premio della Sfida se c'è. --}}
            <b class="wod5e-mage-memo-conto"><span class="wod5e-mage-memo-voce {{memo.boxes.tratti.vantaggi.state}}" title="{{localize 'WOD5E_MAGE.Riepilogo.MeritsHint'}}">{{localize "WOD5E_MAGE.Tratti.Vantaggi"}} {{memo.boxes.tratti.vantaggi.text}}</span>{{#if memo.boxes.tratti.vantaggi.sfida}} <small class="wod5e-mage-memo-premio preso" title="{{localize 'WOD5E_MAGE.Riepilogo.SfidaPremi.merits'}}">+{{memo.boxes.tratti.vantaggi.sfida}} {{localize "WOD5E_MAGE.Tabs.Short.conceptChallenge"}}</small>{{/if}} · <span class="wod5e-mage-memo-voce {{memo.boxes.tratti.difetti.state}}" title="{{localize 'WOD5E_MAGE.Riepilogo.Flaws'}}">{{localize "WOD5E_MAGE.Stat.TrattiDifetti"}} {{memo.boxes.tratti.difetti.text}}</span></b>
        {{/if}}
    </header>
    <div class="wod5e-mage-riq-body">
        <div class="wod5e-mage-riq-cerca-riga">
            <label class="wod5e-mage-riq-cerca">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <input type="search" class="wod5e-mage-cerca-tratti" placeholder="{{localize 'WOD5E_MAGE.Stat.CercaTratto'}}" aria-label="{{localize 'WOD5E_MAGE.Stat.CercaTratto'}}" data-filter="tratti">
            </label>
            <button type="button" class="wod5e-mage-riq-tasto-piccolo wod5e-mage-tratti-libro" data-action="tiroGrimorio" title="{{localize 'WOD5E_MAGE.Stat.ApriGrimorio'}}" aria-label="{{localize 'WOD5E_MAGE.Stat.ApriGrimorio'}}"><i class="fa-solid fa-book-open" aria-hidden="true"></i></button>
        </div>
        <div class="wod5e-mage-riq-scroll wod5e-mage-tratti-oggetti" data-list="tratti">
            {{#each traitRows as |row|}}
                <button type="button" class="wod5e-mage-riga wod5e-mage-riga-oggetto{{#if row.chosen}} scelta{{/if}}" data-action="tiroTrait" data-item-id="{{row.id}}" data-kind="{{row.kind}}" data-search="{{row.name}} {{row.kindLabel}}" aria-pressed="{{row.chosen}}" title="{{row.hint}}">
                    <span class="wod5e-mage-riga-spunta" aria-hidden="true"></span>
                    {{#if row.img}}<img class="wod5e-mage-riga-icona" src="{{row.img}}" alt="">{{/if}}
                    <span class="wod5e-mage-riga-nome-testo">{{row.name}}</span>
                    <small class="wod5e-mage-riga-coda">{{#if row.dice}}<b>{{row.dice}}</b>{{/if}}</small>
                </button>
            {{/each}}
            {{#each poteriFiltri as |p|}}
                <button type="button" class="wod5e-mage-riga wod5e-mage-riga-oggetto wod5e-mage-riga-potere-filtro{{#if p.chosen}} scelta{{/if}}" data-action="tiroPower" data-power="{{p.pick}}" data-sphere="{{p.sphere}}" data-any="{{p.any}}" data-kind="{{p.kind}}" data-search="{{p.search}}" aria-pressed="{{p.chosen}}" title="{{p.hint}}">
                    <span class="wod5e-mage-riga-spunta" aria-hidden="true"></span>
                    <img class="wod5e-mage-riga-icona wod5e-mage-sfera-sigillo" src="{{p.sphereIcon}}" alt="">
                    <span class="wod5e-mage-riga-nome-testo">{{p.name}}</span>
                    <small class="wod5e-mage-riga-coda">{{#if p.nota}}{{p.nota}}{{else}}{{p.cost}}{{/if}}</small>
                    <span class="wod5e-mage-riga-effetto">{{#each p.blocchi as |b|}}<span class="wod5e-mage-riga-effetto-blocco{{#if b.kind}} {{b.kind}}{{/if}}">{{#if (eq b.kind "amalgama")}}<b>{{b.titolo}}:</b> {{/if}}{{#each b.voci as |v|}}<span>{{#if v.accesso}}<b class="wod5e-mage-accesso">{{localize "WOD5E_MAGE.Grimorio.Access"}} {{#each v.sfere as |sfera|}}<img class="wod5e-mage-sfera-inline" src="modules/wod5e-mage/assets/icons/sheet/{{sfera}}.png" alt="{{localize (concat 'WOD5E_MAGE.Spheres.' sfera)}}" title="{{localize (concat 'WOD5E_MAGE.Spheres.' sfera)}}">{{/each}}:</b> {{else if v.chiave}}<b>{{v.chiave}}:</b> {{/if}}{{v.testo}}</span>{{/each}}</span>{{/each}}</span>
                </button>
            {{/each}}
            {{#each incantesimi as |spell|}}
                <button type="button" class="wod5e-mage-riga wod5e-mage-riga-oggetto wod5e-mage-riga-incantesimo{{#if spell.chosen}} scelta{{/if}}" data-action="tiroIncantesimo" data-row="{{spell.id}}" data-kind="grimorio" data-search="{{spell.name}} {{spell.coda}}" aria-pressed="{{spell.chosen}}" title="{{spell.hint}}">
                    <span class="wod5e-mage-riga-spunta" aria-hidden="true"></span>
                    {{#if spell.icon}}<img class="wod5e-mage-riga-icona wod5e-mage-sfera-sigillo" src="{{spell.icon}}" alt="">{{/if}}
                    <span class="wod5e-mage-riga-nome-testo">{{spell.name}}</span>
                    <small class="wod5e-mage-riga-coda">{{spell.coda}}</small>
                </button>
            {{/each}}
        </div>
    </div>
</section>
