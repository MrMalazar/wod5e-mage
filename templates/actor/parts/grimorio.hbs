{{!-- Il Grimorio del personaggio: i suoi incantesimi, scritti con la finestra
     del tiro e salvati. Ogni scheda: nome, Credo e Tipo com'erano, Strumenti,
     riserva, Sfere e Ambiti, tipo, Obiettivo, la narrativa a tendina. --}}
<section class="tab {{tab.cssClass}} wod5e-mage-grimorio-page" data-tab="{{tab.id}}" data-group="{{tab.group}}">
    <header class="wod5e-mage-section-title wod5e-mage-note-head">
        <span>{{localize "WOD5E_MAGE.Tabs.Grimorio"}}</span>
        {{!-- L'archivio degli effetti del manuale: liste da aggiungere alla scheda e ritoccare. --}}
        <button type="button" class="wod5e-mage-archivio-open" data-action="incantesimoFromEffetti" title="{{localize 'WOD5E_MAGE.Incantesimi.FromEffetti'}}" aria-label="{{localize 'WOD5E_MAGE.Incantesimi.FromEffetti'}}" {{#if locked}}disabled{{/if}}><i class="fa-solid fa-book" aria-hidden="true"></i></button>
        {{!-- Il libro aperto: il Grimorio comune del tavolo. --}}
        <button type="button" class="wod5e-mage-archivio-open wod5e-mage-grimorio-comune-open" data-action="grimorioComuneOpen" title="{{localize 'WOD5E_MAGE.GrimorioComune.Open'}}" aria-label="{{localize 'WOD5E_MAGE.GrimorioComune.Open'}}"><i class="fa-solid fa-book-open" aria-hidden="true"></i></button>
        <button type="button" class="wod5e-mage-row-add" data-action="incantesimoAdd" title="{{localize 'WOD5E_MAGE.Incantesimi.Add'}}" aria-label="{{localize 'WOD5E_MAGE.Incantesimi.Add'}}" {{#if locked}}disabled{{/if}}>
            <i class="fa-solid fa-plus"></i>
        </button>
    </header>

    {{#if incantesimi.length}}
        {{!-- Per Sfere: ogni incantesimo sotto la Sfera più alta che usa; a pari
             merito compare in tutte e due. --}}
        <div class="wod5e-mage-incantesimi">
            {{#each incantesimiGroups as |group|}}
                <section class="wod5e-mage-incantesimi-group">
                    <h3 class="wod5e-mage-incantesimi-sphere">{{#if group.icon}}<img src="{{group.icon}}" alt="">{{/if}}{{group.label}} <small>{{group.spells.length}}</small></h3>
                    {{#each group.spells as |spell|}}
                        {{> "modules/wod5e-mage/templates/actor/parts/incantesimo-card.hbs" spell=spell}}
                    {{/each}}
                </section>
            {{/each}}
        </div>
    {{else}}
        <p class="wod5e-mage-row-empty">{{localize "WOD5E_MAGE.Incantesimi.Empty"}}</p>
    {{/if}}
</section>
