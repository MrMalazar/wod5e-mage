{{!-- Gli Ambiti sono liberi per tutti (5.8): nessuna Sfera li sblocca.
     Qui si mostra solo dove il Dono della Sfera d'Affinità regala successi
     automatici; il listino completo sta nella pagina Magick. --}}
<section class="wod5e-mage-scopes">
    <header class="resource-header">
        <label class="header-label">{{localize "WOD5E_MAGE.Scopes.Label"}}</label>
    </header>

    {{#if affinityGift}}
        <div class="wod5e-mage-scope-gift">
            <img src="{{affinityGift.sphereImg}}" alt="">
            <div class="wod5e-mage-scope-gift-text">
                <strong>{{affinityGift.sphereName}}</strong>
                {{#if affinityGift.isScope}}
                    <span>{{localize "WOD5E_MAGE.Scopes.GiftScope"}}: <b>{{localize affinityGift.label}}</b></span>
                    <span class="wod5e-mage-scope-gift-successes">{{localize "WOD5E_MAGE.Scopes.GiftSuccesses" count=affinityGift.successes}}</span>
                {{else}}
                    <span>{{localize "WOD5E_MAGE.Scopes.GiftTrack"}}: <b>{{affinityGift.label}}</b></span>
                {{/if}}
            </div>
        </div>
    {{else}}
        <p class="wod5e-mage-scope-gift-empty">{{localize "WOD5E_MAGE.Scopes.NoAffinity"}}</p>
    {{/if}}

    <p class="wod5e-mage-scopes-hint">{{localize "WOD5E_MAGE.Scopes.Free"}}</p>
</section>
