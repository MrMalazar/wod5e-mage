{{!-- L'inventario (21/9, dal mock docs/mock_tre_pagine_21-9.html): un occhiello
     per tipo (Armatura, Armi, Equipaggiamento, coi nomi del sistema) con la
     lente e il +; la riga dell'oggetto col simbolo che lo manda in chat, il
     nome che apre la descrizione, gli usi, il d10 pieno se tira, le frecce
     degli usi, la matita e il cestino; poi, in riga (Blue, 24/9 sera), i
     dettagli senza aprire l'oggetto: per l'arma il danno base e il tipo, per
     l'armatura il valore, per tutti la casella delle altre informazioni (nel
     flag flags.wod5e-mage.dettagli). Dal 25/9 (Blue): il libro dell'occhiello
     apre l'archivio dell'Equipaggiamento (Armi, Protezioni, Oggetti in
     linguette); sull'arma la spunta dell'Aggravato; sull'armatura il tag
     «mentale» e i tasti ▼ (il colpo assorbito toglie un punto) e ▲ (il punto
     che torna, fino al pieno). Le azioni sono quelle del sistema wod5e
     (5.3.x): da risincronizzare quando il sistema cambia questo blocco. --}}
{{#each equipmentItems as |equipment key|}}
    <span class="wod5e-mage-riq-occhiello wod5e-mage-occhiello-tasti">
        <span>{{localize (concat 'TYPES.Item.' key)}}</span>
        <span class="wod5e-mage-occhiello-tastini">
            <a class="item-control wod5e-mage-riga-tastino wod5e-mage-archivio-open" data-action="archivioOpen" data-kind="equip-{{key}}" data-kinds="equip-weapon,equip-armor,equip-gear" title="{{localize 'WOD5E_MAGE.Archivi.OpenEquip'}}" aria-label="{{localize 'WOD5E_MAGE.Archivi.OpenEquip'}}"><i class="fa-solid fa-book-open" aria-hidden="true"></i></a>
            <a class="item-control wod5e-mage-riga-tastino search-data-item" data-action="searchItem" title="{{localize 'WOD5E.Search'}}" data-type="{{key}}"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></a>
            <a class="item-control wod5e-mage-riga-tastino item-create" data-action="createItem" title="{{localize 'WOD5E.Add'}}" data-type="{{key}}"><i class="fas fa-plus" aria-hidden="true"></i></a>
        </span>
    </span>
    {{#each equipment as |item|}}
        <div class="wod5e-mage-riga wod5e-mage-riga-apribile wod5e-mage-riga-oggetto wod5e-mage-riga-inventario tipo-{{key}}" data-drag="true" data-item-id="{{item.id}}" data-document-uuid="{{item.uuid}}" data-type="Item">
            <div class="wod5e-mage-riga-testa wod5e-mage-oggetto-testa">
                <a class="wod5e-mage-lettera wod5e-mage-lettera-oggetto clickable" data-action="itemChat" data-item-id="{{item._id}}" title="{{localize 'WOD5E.ItemsList.ShowToChat'}}"><i class="fa-solid {{#if (eq key "weapon")}}fa-khanda{{else if (eq key "armor")}}fa-shield-halved{{else}}fa-box-open{{/if}}" aria-hidden="true"></i></a>
                <button type="button" class="wod5e-mage-riga-nome wod5e-mage-riga-nome-apri" data-action="rigaApri" title="{{localize 'WOD5E_MAGE.Tratti.Apri'}}" aria-expanded="false"><span>{{item.name}}</span>{{#if item.system.enrichedDescription}}<i class="fa-solid fa-chevron-down" aria-hidden="true"></i>{{/if}}</button>
                {{#if item.system.uses.enabled}}
                    <small class="wod5e-mage-oggetto-tag">{{item.system.uses.current}} / {{item.system.uses.max}}</small>
                {{/if}}
                <div class="wod5e-mage-riga-tastini">
                    {{!-- Il d10 pieno: l'oggetto ha una riserva e si tira (non dalla scheda di gruppo). --}}
                    {{#ifnoteq ../../baseActorType 'group'}}
                        {{#if item.system.dicepool}}
                            {{#if (isNotEmpty item.system.dicepool)}}
                                <a class="item-image rollable-item wod5e-mage-riga-tastino wod5e-mage-tastino-pieno" data-action="rollItem" data-item-uuid="{{item.uuid}}" title="{{localize 'WOD5E_MAGE.Tratti.Tira'}}"><i class="fa-solid fa-dice-d10" aria-hidden="true"></i></a>
                            {{/if}}
                        {{/if}}
                    {{/ifnoteq}}
                    {{#if item.system.uses.enabled}}
                        <a class="item-control wod5e-mage-riga-tastino item-use" data-action="expendItemUse" data-item-id="{{item._id}}" title="{{localize 'WOD5E.ItemsList.ExpendUse'}}"><i class="fa-solid fa-angle-down" aria-hidden="true"></i></a>
                        <a class="item-control wod5e-mage-riga-tastino item-restore" data-action="restoreItemUses" data-item-id="{{item._id}}" title="{{localize 'WOD5E.ItemsList.ResetUses'}}"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></a>
                    {{/if}}
                    <a class="item-control item-edit wod5e-mage-riga-tastino" data-action="itemEdit" data-item-id="{{item._id}}" title="{{localize 'WOD5E.Edit'}}"><i class="fas fa-edit" aria-hidden="true"></i></a>
                    <a class="item-control item-delete wod5e-mage-riga-tastino" data-action="itemDelete" data-item-id="{{item._id}}" title="{{localize 'WOD5E.Delete'}}"><i class="fas fa-trash" aria-hidden="true"></i></a>
                </div>
                {{#if (eq key "weapon")}}
                    {{!-- Il danno base e il tipo dell'arma, i campi del sistema (weaponvalue, weaponType) scritti dalla riga. --}}
                    <input type="number" class="wod5e-mage-oggetto-numero" data-item-id="{{item._id}}" data-item-field="system.weaponvalue" value="{{item.system.weaponvalue}}" min="0" max="9" step="1" title="{{localize 'WOD5E.EquipmentList.WeaponValue'}}" aria-label="{{item.name}}: {{localize 'WOD5E.EquipmentList.WeaponValue'}}" {{#if @root.locked}}disabled{{/if}}>
                    <select class="wod5e-mage-oggetto-tipo" data-item-id="{{item._id}}" data-item-field="system.weaponType" title="{{localize 'WOD5E.EquipmentList.WeaponType'}}" aria-label="{{item.name}}: {{localize 'WOD5E.EquipmentList.WeaponType'}}" {{#if @root.locked}}disabled{{/if}}>
                        <option value="melee" {{#if (eq item.system.weaponType "melee")}}selected{{/if}}>{{localize "WOD5E.EquipmentList.Melee"}}</option>
                        <option value="ranged" {{#if (eq item.system.weaponType "ranged")}}selected{{/if}}>{{localize "WOD5E.EquipmentList.Ranged"}}</option>
                        <option value="supernatural" {{#if (eq item.system.weaponType "supernatural")}}selected{{/if}}>{{localize "WOD5E.EquipmentList.Supernatural"}}</option>
                    </select>
                    {{!-- La spunta dell'Aggravato (Blue, 25/9): il danno è Superficiale, e diventa Aggravato quando serve. --}}
                    <label class="wod5e-mage-oggetto-spunta" title="{{localize 'WOD5E_MAGE.Items.AggravatedHint'}}">
                        <input type="checkbox" data-item-id="{{item._id}}" data-item-field="flags.wod5e-mage.aggravato" aria-label="{{item.name}}: {{localize 'WOD5E_MAGE.Items.Aggravated'}}" {{#if item.flags.[wod5e-mage].aggravato}}checked{{/if}} {{#if @root.locked}}disabled{{/if}}>
                        <span>{{localize "WOD5E_MAGE.Items.AggravatedShort"}}</span>
                    </label>
                {{else if (eq key "armor")}}
                    <input type="number" class="wod5e-mage-oggetto-numero" data-item-id="{{item._id}}" data-item-field="system.armorvalue" value="{{item.system.armorvalue}}" min="0" max="7" step="1" title="{{localize 'WOD5E.EquipmentList.ArmorValue'}}" aria-label="{{item.name}}: {{localize 'WOD5E.EquipmentList.ArmorValue'}}" {{#if @root.locked}}disabled{{/if}}>
                    {{#if (eq item.flags.[wod5e-mage].armatura "mentale")}}<small class="wod5e-mage-oggetto-tag">{{localize "WOD5E_MAGE.Items.ArmorKinds.mentale"}}</small>{{/if}}
                    <button type="button" class="wod5e-mage-riga-tastino wod5e-mage-armatura-colpo" data-action="armaturaColpo" data-item-id="{{item._id}}" title="{{localize 'WOD5E_MAGE.Items.ArmorHit'}}" aria-label="{{item.name}}: {{localize 'WOD5E_MAGE.Items.ArmorHit'}}" {{#if @root.locked}}disabled{{/if}}><i class="fa-solid fa-angle-down" aria-hidden="true"></i></button>
                    <button type="button" class="wod5e-mage-riga-tastino wod5e-mage-armatura-punto" data-action="armaturaPunto" data-item-id="{{item._id}}" title="{{localize 'WOD5E_MAGE.Items.ArmorBack'}}" aria-label="{{item.name}}: {{localize 'WOD5E_MAGE.Items.ArmorBack'}}" {{#if @root.locked}}disabled{{/if}}><i class="fa-solid fa-angle-up" aria-hidden="true"></i></button>
                {{/if}}
                <input type="text" class="wod5e-mage-oggetto-dettagli" data-item-id="{{item._id}}" data-item-field="flags.wod5e-mage.dettagli" value="{{item.flags.[wod5e-mage].dettagli}}" placeholder="{{localize 'WOD5E_MAGE.Tratti.Dettagli.oggetto'}}" aria-label="{{item.name}}: {{localize 'WOD5E_MAGE.Tratti.DettagliLabel'}}" title="{{localize 'WOD5E_MAGE.Tratti.DettagliHint'}}" {{#if @root.locked}}disabled{{/if}}>
            </div>
            <div class="wod5e-mage-riga-spiega wod5e-mage-oggetto-spiega">
                {{#if item.system.enrichedDescription}}{{{item.system.enrichedDescription}}}{{/if}}
            </div>
        </div>
    {{/each}}
{{/each}}
