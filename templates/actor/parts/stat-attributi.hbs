{{!-- Attributi (16/9): per famiglia (Fisico, Sociale, Mentale), il nome è il
     tasto che lo mette nel tiro (uno solo), i pallini restano quelli della
     scheda e cambiano il valore. --}}
<section class="wod5e-mage-riq wod5e-mage-riq-attributi">
    <header class="wod5e-mage-riq-title">
        {{#if creazioneReset}}{{> "modules/wod5e-mage/templates/actor/parts/reset-tasto.hbs" resetsById.attributes}}{{/if}}
        <span>{{localize "WOD5E.AttributesList.Attributes"}}</span>
    </header>
    <div class="wod5e-mage-riq-body">
        {{#each attributeGroups as |group|}}
            <span class="wod5e-mage-riq-occhiello">{{group.label}}</span>
            <div class="wod5e-mage-tratti-lista">
                {{#each group.rows as |attribute|}}
                    <div class="wod5e-mage-riga wod5e-mage-riga-tratto{{#if attribute.chosen}} scelta{{/if}}">
                        <button type="button" class="wod5e-mage-riga-nome" data-action="tiroAttribute" data-attribute="{{attribute.id}}" aria-pressed="{{attribute.chosen}}" title="{{localize 'WOD5E_MAGE.Tiro.AttributeHint'}}">
                            {{#if attribute.icon}}<img class="wod5e-mage-riga-icona" src="{{attribute.icon}}" alt="">{{/if}}
                            <span>{{attribute.displayName}}</span>
                        </button>
                        {{#if ../../settings.skillAttributeInputs}}
                            {{#if ../../locked}}
                                <b>{{attribute.value}}</b>
                            {{else}}
                                <input class="resource-value skill-attribute-input" name="system.attributes.{{attribute.id}}.value" type="number" value="{{attribute.value}}"/>
                            {{/if}}
                        {{else}}
                            <div class="resource-value" data-value="{{attribute.value}}" data-name="system.attributes.{{attribute.id}}.value">
                                <span class="resource-value-empty" data-action="dotCounterEmpty"></span>
                                {{#numLoop 5}}
                                    <span class="resource-value-step" data-action="dotCounterChange" data-index="{{this}}"></span>
                                {{/numLoop}}
                            </div>
                        {{/if}}
                    </div>
                {{/each}}
            </div>
        {{/each}}
    </div>
</section>
