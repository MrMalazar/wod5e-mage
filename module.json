{
  "id": "wod5e-mage",
  "title": "Mage for World of Darkness 5e",
  "description": "Adds Mage support to the World of Darkness 5e system.",
  "version": "0.9.7",
  "url": "https://github.com/Danilo-P-git/wod5e-mage",
  "manifest": "https://github.com/Danilo-P-git/wod5e-mage/releases/latest/download/module.json",
  "download": "https://github.com/Danilo-P-git/wod5e-mage/releases/download/0.9.7/wod5e-mage.zip",
  "authors": [
    {
      "name": "wod5e-mage contributors"
    }
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14.365"
  },
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/wod5e-mage.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "it",
      "name": "Italiano",
      "path": "lang/it.json"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "wod5e",
        "type": "system",
        "compatibility": {
          "minimum": "5.3.1"
        }
      }
    ]
  },
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "json",
        "png",
        "svg"
      ],
      "paths": [
        "lang",
        "assets",
        "styles",
        "templates"
      ]
    }
  }
}
